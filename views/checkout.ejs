<%- include("partials/header", { title: "Paiement" }) %>

  <div class="container-wide cart-layout">
    <div>
      <h1 style="margin-top:36px;">Paiement</h1>
<% if (payMode === "demo") { %>
      <p class="payment-badge"><%- icon('info', { size: 16 }) %> Mode démonstration : aucun paiement réel n'est effectué, aucune carte n'est débitée.</p>

      <form action="/commande" method="post" class="card card-pad payment-mock">
        <input type="hidden" name="expected_total" value="<%= expectedTotal %>">
        <div class="field-group">
          <label for="f-checkout-1">Numéro de carte</label>
          <input id="f-checkout-1" type="text" placeholder="4242 4242 4242 4242" maxlength="19" required>
        </div>
        <div class="field-row">
          <div class="field-group">
            <label for="f-checkout-2">Date d'expiration</label>
            <input id="f-checkout-2" type="text" placeholder="MM/AA" maxlength="5" required>
          </div>
          <div class="field-group">
            <label for="f-checkout-3">CVC</label>
            <input id="f-checkout-3" type="text" placeholder="123" maxlength="4" required>
          </div>
        </div>
        <div class="field-group">
          <label for="f-checkout-4">Nom sur la carte</label>
          <input id="f-checkout-4" type="text" placeholder="<%= currentUser.username %>" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Payer <%= formatPrice(total) %> (simulation)</button>
      </form>
<% } else if (payMode === "stripe") { %>
      <form action="/commande" method="post" class="card card-pad">
        <input type="hidden" name="expected_total" value="<%= expectedTotal %>">
        <p class="payment-badge"><%- icon('info', { size: 16 }) %> Paiement sécurisé par Stripe : vous serez redirigé vers sa page de paiement. Aucune donnée de carte ne passe par ce site.</p>
        <% if (total < minAmount) { %>
          <p class="field-error" role="alert">Le montant minimum payable par carte est de 0,50 €.</p>
        <% } %>
        <button type="submit" class="btn btn-primary btn-block btn-lg"<%= total < minAmount ? " disabled" : "" %>>Payer <%= formatPrice(total) %> par carte</button>
      </form>
<% } else if (payMode === "free") { %>
      <form action="/commande" method="post" class="card card-pad">
        <input type="hidden" name="expected_total" value="<%= expectedTotal %>">
        <p style="margin-top:0;">Aucun paiement n'est nécessaire pour cette commande.</p>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Valider la commande gratuite</button>
      </form>
<% } else { %>
      <div class="card card-pad">
        <p class="field-error" role="alert" style="margin:0;">Le paiement en ligne n'est pas encore disponible. Réessayez plus tard.</p>
      </div>
<% } %>
    </div>

    <aside class="card card-pad summary-card">
      <h3 style="margin-top:0;">Votre commande</h3>
      <% items.forEach(course => { %>
        <div class="summary-row"><span><%= course.title %></span><span><%- include("partials/price", { course }) %></span></div>
      <% }) %>
      <% if (discount) { %>
        <div class="summary-row"><span>Sous-total</span><span><%= formatPrice(subtotal) %></span></div>
        <div class="summary-row summary-discount"><span>Code « <%= coupon.code %> »</span><span>− <%= formatPrice(discount) %></span></div>
      <% } %>
      <div class="summary-row total"><span>Total</span><span><%= formatPrice(total) %></span></div>
      <form action="/commande/code-promo" method="post" class="promo-form">
        <label for="f-promo">Code promo</label>
        <% if (coupon) { %>
          <p class="promo-applied"><strong><%= coupon.code %></strong> appliqué</p>
          <button type="submit" name="retirer" value="1" class="btn btn-outline btn-sm">Retirer le code</button>
        <% } else { %>
          <div class="promo-row"><input id="f-promo" type="text" name="code" maxlength="30" autocomplete="off" autocapitalize="characters" spellcheck="false"><button type="submit" class="btn btn-outline btn-sm">Appliquer</button></div>
        <% } %>
        <% if (couponError) { %><p class="field-error" role="alert"><%= couponError %></p><% } else if (couponOk) { %><p class="promo-ok" role="status"><%= couponOk %></p><% } %>
      </form>
    </aside>
  </div>

<%- include("partials/footer") %>
