<%- include("../partials/header", { title }) %>
<%- include("_head", { heading: ticket.subject, subtitle: `Demande #${ticket.id} de ${ticket.student_name} (${ticket.student_email})${ticket.course_title ? " · " + ticket.course_title : ""}` }) %>
<div class="dash-grid-2">
  <section class="dpanel" aria-labelledby="s-thread">
    <h2 id="s-thread">Échanges</h2>
    <ol style="list-style:none;padding:0;">
      <% messages.forEach((m) => { %>
        <li class="dpanel" style="margin-bottom:10px;<%= m.is_staff ? "border-left:4px solid var(--dash-accent);" : "" %>">
          <strong><%= m.is_staff ? "Vous" : ticket.student_name %></strong> <small>· <%= formatDateTime(m.created_at) %></small>
          <p style="white-space:pre-wrap;margin:8px 0 0;"><%= m.body %></p>
        </li>
      <% }) %>
    </ol>
    <% if (ticket.status !== "closed") { %>
    <form method="post" action="/formateur/gestion/support/<%= ticket.id %>/repondre" class="g-form">
      <div class="g-field"><label for="s-reply">Votre réponse</label><textarea id="s-reply" name="message" rows="5" maxlength="5000" required></textarea></div>
      <div class="g-filter-actions"><button type="submit" class="btn btn-primary">Envoyer la réponse</button></div>
    </form>
    <% } %>
  </section>
  <aside class="dpanel" aria-labelledby="s-side">
    <h2 id="s-side">Suivi</h2>
    <dl class="g-dl">
      <dt>Statut</dt><dd><span class="dash-status <%= ticket.status === "closed" ? "is-archived" : ticket.status === "answered" ? "is-published" : "is-draft" %>"><%= statuses[ticket.status] %></span></dd>
      <dt>Créée le</dt><dd><%= formatDateTime(ticket.created_at) %></dd>
      <% if (ticket.closed_at) { %><dt>Close le</dt><dd><%= formatDateTime(ticket.closed_at) %></dd><% } %>
      <dt>Élève</dt><dd><a href="/formateur/gestion/eleves/<%= ticket.user_id %>"><%= ticket.student_name %></a></dd>
    </dl>
    <form method="post" action="/formateur/gestion/support/<%= ticket.id %>/priorite" class="g-form">
      <div class="g-field"><label for="s-prio">Priorité</label><select id="s-prio" name="priority"><% Object.entries(priorities).forEach(([k, v]) => { %><option value="<%= k %>"<%= ticket.priority === k ? " selected" : "" %>><%= v %></option><% }) %></select></div>
      <button type="submit" class="btn btn-outline btn-sm">Enregistrer</button>
    </form>
    <% if (ticket.status === "closed") { %>
      <form method="post" action="/formateur/gestion/support/<%= ticket.id %>/rouvrir"><button type="submit" class="btn btn-outline btn-sm">Rouvrir</button></form>
    <% } else { %>
      <form method="post" action="/formateur/gestion/support/<%= ticket.id %>/fermer"><button type="submit" class="btn btn-outline btn-sm">Clore la demande</button></form>
    <% } %>
  </aside>
</div>
<%- include("../partials/footer") %>
