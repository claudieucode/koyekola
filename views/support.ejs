<%- include("partials/header", { title: "Aide et support", seo: { noindex: true } }) %>

  <div class="container-wide kv-pagehead">
    <div>
      <h1>Aide et support</h1>
      <p>Une question sur une formation, un paiement ou votre compte ? Écrivez au formateur : vous serez prévenu(e) de sa réponse dans vos notifications.</p>
    </div>
    <div class="kv-pagehead-actions"><a href="/faq" class="btn btn-outline"><%- icon("help", { size: 16 }) %> Questions fréquentes</a></div>
  </div>

  <div class="container-wide kv-support">
    <form action="/support" method="post" class="card card-pad kv-support-form" novalidate aria-labelledby="t-form-title" data-support-form>
      <h2 id="t-form-title">Nouvelle demande</h2>
      <p class="kv-support-hint">Avant d'écrire, un coup d'œil aux <a href="/faq">questions fréquentes</a> peut vous faire gagner du temps.</p>
      <% if (errors.form) { %><p class="field-error" role="alert"><%= errors.form %></p><% } %>
      <% if (errors.course_id && !courses.length) { %><p class="field-error" role="alert"><%= errors.course_id %></p><% } %>
      <div class="field-group">
        <label for="t-subject">Sujet <span class="kv-req" aria-hidden="true">*</span></label>
        <input id="t-subject" type="text" name="subject" maxlength="120" required autocomplete="off" value="<%= form.subject || "" %>"<%- errors.subject ? ' aria-invalid="true" aria-describedby="t-subject-err"' : "" %>>
        <% if (errors.subject) { %><small class="field-error" id="t-subject-err"><%= errors.subject %></small><% } %>
      </div>
      <% if (courses.length) { %>
      <div class="field-group">
        <label for="t-course">Formation concernée (facultatif)</label>
        <select id="t-course" name="course_id"><option value="">Aucune en particulier</option><% courses.forEach((c) => { %><option value="<%= c.id %>"<%= String(form.course_id) === String(c.id) ? " selected" : "" %>><%= c.title %></option><% }) %></select>
        <% if (errors.course_id) { %><small class="field-error"><%= errors.course_id %></small><% } %>
      </div>
      <% } %>
      <div class="field-group">
        <label for="t-message">Votre message <span class="kv-req" aria-hidden="true">*</span></label>
        <textarea id="t-message" name="message" rows="6" maxlength="5000" required data-count="t-count"<%- errors.message ? ' aria-invalid="true" aria-describedby="t-message-err"' : "" %>><%= form.message || "" %></textarea>
        <div class="kv-count-row"><% if (errors.message) { %><small class="field-error" id="t-message-err"><%= errors.message %></small><% } else { %><small>10 caractères au minimum.</small><% } %><small id="t-count" aria-hidden="true"></small></div>
      </div>
      <button type="submit" class="btn btn-primary" data-pending="Envoi…">Envoyer la demande</button>
    </form>

    <section class="kv-support-list" aria-labelledby="t-list-title">
      <h2 id="t-list-title">Mes demandes <% if (counts.all) { %><span class="kv-count"><%= counts.all %></span><% } %></h2>
      <% if (counts.all > 0) { %>
        <nav class="kv-filter" aria-label="Filtrer mes demandes">
          <a href="/support" class="kv-chip"<%- !filter ? ' aria-current="page"' : "" %>>Toutes <b><%= counts.all %></b></a>
          <% if (counts.answered) { %><a href="/support?statut=answered" class="kv-chip"<%- filter === "answered" ? ' aria-current="page"' : "" %>>Réponse reçue <b><%= counts.answered %></b></a><% } %>
          <% if (counts.open) { %><a href="/support?statut=open" class="kv-chip"<%- filter === "open" ? ' aria-current="page"' : "" %>>En attente <b><%= counts.open %></b></a><% } %>
          <% if (counts.closed) { %><a href="/support?statut=closed" class="kv-chip"<%- filter === "closed" ? ' aria-current="page"' : "" %>>Résolues <b><%= counts.closed %></b></a><% } %>
        </nav>
      <% } %>
      <% if (!tickets.length) { %>
        <div class="empty-state kv-empty-flush">
          <span class="kv-empty-ico" aria-hidden="true"><%- icon("messageSquare", { size: 26 }) %></span>
          <h3><%= counts.all ? "Aucune demande dans cette catégorie" : "Aucune demande" %></h3>
          <p><%= counts.all ? "Choisissez « Toutes » pour revoir l'ensemble de vos demandes." : "Vous n'avez encore envoyé aucune demande." %></p>
        </div>
      <% } else { %>
        <ul class="kv-list">
          <% tickets.forEach((t) => { %>
            <li class="kv-row<%= t.status === "answered" ? " is-unread" : "" %>">
              <div class="kv-row-main">
                <a href="/support/<%= t.id %>"><strong><%= t.subject %></strong></a>
                <small>#<%= t.id %> · <%= t.message_count %> message<%= t.message_count > 1 ? "s" : "" %> · mise à jour le <%= formatDateTime(t.updated_at) %><%= t.course_title ? " · " + t.course_title : "" %></small>
              </div>
              <span class="dash-status <%= t.status === "closed" ? "is-archived" : t.status === "answered" ? "is-published" : "is-draft" %>"><%= statuses[t.status] %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
  <script src="<%= asset('/js/support.js') %>" defer></script>

<%- include("partials/footer") %>
