<%# Aperçu COMPLET d'un thème de la bibliothèque : son site de démonstration, isolé du site (aucun contenu lu, rien d'enregistré), page par page et par appareil. %><%- include("partials/top", { title, active }) %>
<div class="mk-th mk-tp" data-th-root>
  <header class="mk-tp-bar">
    <a class="btn btn-outline btn-sm" href="<%= to("") %>">← Thèmes</a>
    <div class="mk-tp-title"><h1><%= theme.name %></h1><span><%= theme.categoryLabel %></span></div>
    <nav class="mk-tp-pages" aria-label="Pages du site de démonstration">
      <% theme.pages.forEach((p) => { %><a href="<%= to("/" + theme.key + "/apercu", { page: p.key }) %>" data-tp-page="<%= p.key %>"<%- p.key === pageKey ? ' aria-current="page"' : "" %>><%= p.name %></a><% }) %>
    </nav>
    <div class="mk-tp-devices" role="group" aria-label="Appareil d'aperçu">
      <button type="button" class="btn btn-outline btn-sm" data-tp-width="100%" aria-pressed="true"><%- icon("monitor", { size: 16 }) %><span>Ordinateur</span></button>
      <button type="button" class="btn btn-outline btn-sm" data-tp-width="820px" aria-pressed="false"><%- icon("tablet", { size: 16 }) %><span>Tablette</span></button>
      <button type="button" class="btn btn-outline btn-sm" data-tp-width="390px" aria-pressed="false"><%- icon("smartphone", { size: 16 }) %><span>Mobile</span></button>
    </div>
    <div class="mk-tp-actions">
      <% if (!readOnly && canCustomize) { %><a class="btn btn-primary btn-sm" data-tp-customize href="/marketing/site-web/personnaliser?<%= T.siteId ? "site=" + T.siteId + "&" : "" %>theme=<%= theme.key %>">Personnaliser le site</a><% } %>
      <a class="btn btn-outline btn-sm" href="<%= to("/" + theme.key + "/details") %>">Détails</a>
      <% if (theme.state === "active") { %><span class="badge mk-status-ok">Thème actif</span>
      <% } else if (theme.state === "installed" && canActivate && !readOnly) { %><form method="post" action="<%= BASE %>/<%= theme.key %>/activer" data-th-form><%- siteField %><button class="btn btn-primary btn-sm" type="submit" data-confirm="Utiliser « <%= theme.name %> » sur « <%= T.name %> » ? Vos contenus ne sont pas modifiés ; l'apparence du site change." data-busy="Activation…">Utiliser ce thème</button></form>
      <% } else if (theme.state === "available" && canInstall && !readOnly) { %><form method="post" action="<%= BASE %>/installer" data-th-form><%- siteField %><input type="hidden" name="key" value="<%= theme.key %>"><button class="btn btn-primary btn-sm" type="submit" data-busy="Installation…">Installer</button></form><% } %>
    </div>
  </header>
  <p class="mk-th-site">Site de démonstration isolé : textes, chiffres, personnes et coordonnées sont fictifs, et rien de votre site <strong>« <%= T.name %> »</strong> n'est utilisé ni modifié. <a href="<%= to("/" + theme.key + "/apercu", { mode: "site" }) %>">Voir ce thème avec le contenu de mon site</a></p>
  <div class="mk-tp-stage" data-tp-stage><iframe class="mk-tp-frame" data-tp-frame sandbox="allow-scripts allow-forms" title="Aperçu du thème <%= theme.name %> : page « <%= (theme.pages.find((p) => p.key === pageKey) || {}).name %> »" src="<%= frame %>"></iframe></div>
</div>
<%- include("partials/bottom") %>
