<%- include("partials/top", { title, active }) %>
    <div class="mk-head"><h1>Conformité</h1></div>
    <p class="mk-lead">Les règles qui protègent vos contacts, et vous. Elles s'appliquent avant tout envoi. L'outil aide, mais la conformité légale (RGPD, ePrivacy…) reste de votre responsabilité.</p>

    <section class="mk-panel">
      <h2>Liste de suppression</h2>
      <p class="field-hint">Ces adresses ne reçoivent <strong>jamais</strong> de marketing. Un rebond ou une plainte ne peut pas être levé ; un blocage manuel le peut, mais la personne devra se réabonner elle-même.</p>
      <% if (mk.can("compliance.manage")) { %>
        <form action="/marketing/conformite/suppression" method="post" class="mk-inline-form mk-create">
          <label for="s-email" class="sr-only">Adresse à bloquer</label><input id="s-email" type="email" name="email" required maxlength="254" placeholder="adresse@exemple.fr">
          <label for="s-note" class="sr-only">Motif</label><input id="s-note" type="text" name="note" maxlength="500" placeholder="Motif (facultatif)">
          <button type="submit" class="btn btn-primary">Bloquer l'adresse</button>
        </form>
      <% } %>
      <% if (suppressions.length || hasQuery) { %>
        <form class="mk-filterbar" method="get" action="/marketing/conformite" role="search">
          <div class="mk-search"><%- icon("search", { size: 16 }) %><label class="sr-only" for="sup-q">Rechercher une adresse</label><input id="sup-q" type="search" name="q" value="<%= q %>" placeholder="Rechercher une adresse" maxlength="254"></div>
          <div class="field-group"><label class="sr-only" for="sup-motif">Motif</label>
            <select id="sup-motif" name="motif"><option value="">Tous les motifs</option>
              <option value="bounced" <%= reason === "bounced" ? "selected" : "" %>>Rebond</option>
              <option value="complained" <%= reason === "complained" ? "selected" : "" %>>Plainte</option>
              <option value="suppressed" <%= reason === "suppressed" ? "selected" : "" %>>Blocage manuel</option>
            </select></div>
          <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
          <% if (hasQuery) { %><a href="/marketing/conformite" class="btn btn-ghost btn-sm">Réinitialiser</a><% } %>
        </form>
      <% } %>
      <% if (!suppressions.length) { %>
        <% if (hasQuery) { %><p class="field-hint">Aucune adresse ne correspond à cette recherche. <a href="/marketing/conformite">Réinitialiser</a>.</p>
        <% } else { %><p class="field-hint">Aucune adresse bloquée.</p><% } %>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table">
          <caption class="sr-only">Adresses bloquées</caption>
          <thead><tr><th scope="col">Adresse</th><th scope="col">Motif</th><th scope="col">Note</th><th scope="col">Depuis le</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
          <tbody><% suppressions.forEach((s) => { %>
            <tr><td><%= s.email %></td><td><%= { bounced: "Rebond", complained: "Plainte", manual: "Blocage manuel", erasure: "Effacement demandé" }[s.reason] %></td><td><%= s.note %></td><td><%= mkh.fdate(s.created_at) %></td>
              <td><% if (mk.can("compliance.manage") && s.reason === "manual") { %><form action="/marketing/conformite/suppression/retirer" method="post"><input type="hidden" name="email" value="<%= s.email %>"><button type="submit" class="btn btn-outline btn-sm">Retirer</button></form><% } %></td></tr>
          <% }) %></tbody>
        </table></div>
        <% if (nextUrl) { %><p class="mk-more"><a class="btn btn-outline" href="<%= nextUrl %>">Page suivante</a></p><% } %>
      <% } %>
    </section>

    <section class="mk-panel">
      <h2>Catégories de préférences</h2>
      <p class="field-hint">Permettent à une personne de refuser certains types de messages sans se désinscrire de tout.</p>
      <% if (mk.can("compliance.manage")) { %>
        <form action="/marketing/conformite/categories" method="post" class="mk-form">
          <div class="field-row">
            <div class="field-group"><label for="k-label">Libellé</label><input id="k-label" type="text" name="label" maxlength="100" required placeholder="Promotions"></div>
            <div class="field-group"><label for="k-key">Clé</label><input id="k-key" type="text" name="key" maxlength="40" required placeholder="promotions"></div>
          </div>
          <div class="field-group"><label for="k-desc">Description affichée à la personne</label><input id="k-desc" type="text" name="description" maxlength="300" placeholder="Offres et réductions"></div>
          <button type="submit" class="btn btn-primary btn-sm">Créer la catégorie</button>
        </form>
      <% } %>
      <% if (!categories.length) { %><p class="field-hint">Aucune catégorie.</p>
      <% } else { %><ul class="mk-status-list"><% categories.forEach((k) => { %><li><strong><%= k.label %></strong> <code><%= k.key %></code> <%= k.description ? "— " + k.description : "" %></li><% }) %></ul><% } %>
    </section>
<%- include("partials/bottom") %>
