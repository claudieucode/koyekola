<%#
  Fiche d'une extension (Extensions → Détails). Tout vient du manifeste du registre et de l'état réel du site ; aucune action fictive : « Configurer » n'apparaît que si l'extension déclare des paramètres.
%><%- include("partials/top", { title, active, extUi: true }) %>
<%
  const here = (extra) => { const p = new URLSearchParams(); if (site && !inSite) p.set("site", site.id); Object.entries(extra || {}).forEach(([k, v]) => p.set(k, v)); const q = p.toString(); return q ? "?" + q : ""; };
  const on = Boolean(site) && item.enabled;
  const blocked = item.availability === "unavailable" || item.maintenance !== "stable";
  const first = item.menus && item.menus[0] && item.menus[0].items[0];
  const openHref = on && first ? (first.external ? first.href : `/marketing/site-web/sites/${site.id}/${first.key}`) : null;
  const depName = (d) => (registry.get(d.id) || { name: d.id }).name;
  const fmt = (d) => { const t = String(d || "").replace("T", " "); return t ? t.slice(8, 10) + "/" + t.slice(5, 7) + "/" + t.slice(0, 4) + " " + t.slice(11, 16) : "—"; };
  const avail = item.availability === "beta" ? "Bêta" : item.availability === "unavailable" ? "Non disponible" : item.maintenance === "maintenance" ? "En maintenance" : item.maintenance === "deprecated" ? "Obsolète" : "Disponible";
  const afterState = { enable: "Activée", disable: "Désactivée" };
%>
<a class="xd-back" href="<%= BASE %><%= inSite ? '' : here() %>"><%- icon("arrowLeft", { size: 14 }) %> Toutes les extensions</a>
<div class="xd" style="--xc-accent: <%= item.accent || 'var(--accent)' %>">
  <header class="xd-hero">
    <span class="xc-logo"><% if (item.logo) { %><img src="<%= item.logo %>" alt="" width="26" height="26" decoding="async"><% } else { %><span class="xc-initial"><%= item.name.charAt(0) %></span><% } %></span>
    <div class="xd-id">
      <h2><%= item.name %></h2>
      <p class="xd-sub"><span>Par <%= item.publisher %></span><span>v<%= item.version %></span><span><%= item.categoryLabel %></span>
        <% if (site) { %><span><span class="xc-pill <%= on ? 'is-on' : '' %>"><span class="xc-dot"></span><%= on ? "Activée" : "Désactivée" %> sur « <%= site.name %> »</span></span><% } %></p>
    </div>
    <div class="xd-actions">
      <% if (site && !on && !blocked) { %>
        <form method="post" action="<%= POSTBASE %>/sites/<%= site.id %>/<%= item.id %>/activer" data-xg-busy><input type="hidden" name="retour" value="detail"><% if (inSite) { %><input type="hidden" name="espace" value="1"><% } %><button class="btn btn-primary btn-sm" type="submit">Activer</button></form>
      <% } %>
      <% if (openHref) { %><a class="btn btn-primary btn-sm" href="<%= openHref %>">Ouvrir</a><% } %>
      <% if (on && item.settings.length) { %><a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: item.id }) %>">Configurer</a><% } %>
      <% if (on) { %><a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: item.id, confirmer: item.id }) %>">Désactiver</a><% } %>
      <a class="btn btn-outline btn-sm" href="<%= BASE %>/historique<%= here({ extension: item.id }) %>">Historique</a>
    </div>
  </header>

  <div>
    <section class="xd-card"><h3>Description</h3><p class="xd-lead"><%= item.description %></p></section>
    <% if (item.features && item.features.length) { %><section class="xd-card"><h3>Fonctionnalités</h3><ul class="xd-features"><% item.features.forEach((f) => { %><li><%= f %></li><% }) %></ul></section><% } %>
    <section class="xd-card"><h3>Activité sur ce site</h3>
      <% if (!events.length) { %><p class="mk-sub">Aucune opération enregistrée pour cette extension sur ce site.</p>
      <% } else { %><ul class="xd-log"><% events.forEach((e) => { %><li><time datetime="<%= e.created_at %>"><%= fmt(e.created_at) %></time><span><span class="xc-pill <%= e.action === 'enable' ? 'is-on' : (e.action === 'failed' || e.action === 'refused') ? 'is-warn' : '' %>"><span class="xc-dot"></span><%= ACTION[e.action] || e.action %></span></span><span class="xd-ver">v<%= e.version || item.version %></span><span class="mk-sub"><%= e.user_name || "" %></span></li><% }) %></ul><% } %>
    </section>
    <% if (settings.length) { %><section class="xd-card"><h3>Paramètres</h3><p class="mk-sub" style="margin-bottom:12px">Propres à « <%= site.name %> ».</p><a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: item.id }) %>">Modifier les paramètres</a></section><% } %>
  </div>

  <aside>
    <section class="xd-card">
      <h3>Informations</h3>
      <dl class="xd-facts">
        <dt>Version</dt><dd><%= item.version %></dd>
        <dt>Éditeur</dt><dd><%= item.publisher %></dd>
        <dt>Catégorie</dt><dd><%= item.categoryLabel %></dd>
        <dt>Compatibilité</dt><dd>Kolakisa <%= item.compatibility.kolakisa %></dd>
        <dt>Disponibilité</dt><dd><%= avail %></dd>
        <dt>Ajoutée le</dt><dd><%= item.added ? fmt(item.added + "T00:00").slice(0, 10) : "—" %></dd>
        <% if (!inSite) { %><dt>Sites actifs</dt><dd><%= item.activeSites %> / <%= totalSites %></dd><% } %>
      </dl>
      <hr class="xd-sep">
      <p class="xd-sec">Dépendances</p>
      <dl class="xd-facts">
        <dt>Nécessite</dt><dd><%= item.dependencies.length ? item.dependencies.map(depName).join(", ") : "Aucune" %></dd>
        <dt>Requise par</dt><dd><%= dependents.length ? dependents.join(", ") : "Aucune" %></dd>
        <dt>Incompatible</dt><dd><%= item.conflicts.length ? item.conflicts.join(", ") : "Rien" %></dd>
      </dl>
      <hr class="xd-sep">
      <p class="xd-sec">Permissions</p>
      <% if (item.permissions.length) { %><ul class="xd-codes"><% item.permissions.forEach((p) => { %><li><code><%= p %></code></li><% }) %></ul><% } else { %><p class="xd-note" style="margin-top:0">Aucune permission propre.</p><% } %>
      <p class="xd-note">Activation réservée à l'équipe (<code>sites.modules</code>).</p>
    </section>
  </aside>
</div>
<%- include("partials/bottom") %>
