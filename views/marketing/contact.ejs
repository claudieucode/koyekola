<%- include("partials/top", { title, active }) %>
    <p class="mk-back"><a href="/marketing/contacts">← Contacts</a></p>
    <div class="mk-head">
      <h1 class="mk-email"><%= contact.email %></h1>
      <span class="badge <%= mkh.statusClass(contact.status) %>"><%= mkh.statusLabel(contact.status) %></span>
    </div>
    <p class="mk-lead"><%= mkh.fullName(contact) || "Sans nom" %> · source : <%= contact.source %> · ajouté le <%= mkh.fdate(contact.created_at) %><% if (contact.lms_user_id) { %> · compte KOLAKISA lié<% } %></p>

    <% if (lms) { %>
    <section class="mk-panel" id="compte" aria-labelledby="lms-title">
      <h2 id="lms-title">Compte KOLAKISA</h2>
      <p><span class="badge"><%= (relations[lms.relation] || {}).label || lms.relation %></span> <span class="field-hint"><%= (relations[lms.relation] || {}).hint %></span></p>
      <% if (!lms.student) { %>
        <p class="field-hint">Compte « <%= lms.user.username %> » créé le <%= mkh.fdate(lms.user.created_at) %>, sans inscription à vos formations.</p>
      <% } else { %>
        <p><strong><%= lms.student.courses.length %></strong> formation(s) · <strong><%= mkh.euros(lms.student.spent) %></strong> d'achats · <%= lms.student.orders.length %> commande(s)</p>
        <ul class="dlist"><% lms.student.courses.forEach((c) => { %><li><%= c.title %> — <%= c.percent %> % <small>(<%= c.bought ? "achetée" : "gratuite" %>)</small></li><% }) %></ul>
        <p><a href="/formateur/gestion/eleves/<%= lms.user.id %>">Ouvrir la fiche élève</a></p>
      <% } %>
    </section>
    <% } %>

    <% if (mergedInto) { %><div class="mk-flash mk-flash-error" role="status"><span class="mk-flash-body"><p>Cette fiche a été fusionnée dans <a href="/marketing/contacts/<%= mergedInto.id %>"><%= mergedInto.email %></a> : elle est conservée pour l'historique et n'est plus jamais jointe.</p></span></div><% } %>
    <section class="mk-panel" id="coeur" aria-labelledby="core-title">
      <h2 id="core-title">Identité et origine</h2>
      <ul class="mk-status-list">
        <li><strong>Cycle de vie</strong> : <%= lifecycles[contact.lifecycle_stage] || contact.lifecycle_stage %></li>
        <li><strong>État de la fiche</strong> : <%= recordLabels[contact.record_status] || contact.record_status %><%= contact.archived_at ? " depuis le " + mkh.fdate(contact.archived_at) : "" %></li>
        <li><strong>Source</strong> : <%= mkh.sourceLabel(contact.source) %><%= contact.source_detail ? " — " + contact.source_detail : "" %></li>
        <li><strong>Site d'origine</strong> : <%= originSite ? originSite.name : "Site principal" %></li>
        <% if (contact.job_title) { %><li><strong>Fonction</strong> : <%= contact.job_title %></li><% } %>
        <% if (contact.normalized_phone) { %><li><strong>Téléphone normalisé</strong> : <%= contact.normalized_phone %></li><% } %>
        <% if (aliases.length) { %><li><strong>Autres adresses</strong> : <%= aliases.map((a) => a.email).join(", ") %></li><% } %>
        <% if (absorbed.length) { %><li><strong>Fiches fusionnées</strong> : <%= absorbed.map((a) => a.email).join(", ") %> (conservées, archivées)</li><% } %>
      </ul>
      <% if (contact.record_status !== "merged") { %>
      <div class="mk-actions">
        <% if (mk.can("contacts.write")) { %>
        <form action="/marketing/contacts/<%= contact.id %>/cycle-de-vie" method="post" class="mk-inline-form">
          <label for="cl-stage" class="sr-only">Étape du cycle de vie</label>
          <select id="cl-stage" name="etape"><% Object.entries(lifecycles).forEach(([k, label]) => { %><option value="<%= k %>" <%= contact.lifecycle_stage === k ? "selected" : "" %>><%= label %></option><% }) %></select>
          <button type="submit" class="btn btn-outline btn-sm">Changer l'étape</button>
        </form>
        <% } %>
        <% if (mk.can("contacts.archive")) { %>
        <form action="/marketing/contacts/<%= contact.id %>/etat" method="post" class="mk-inline-form">
          <% if (contact.record_status === "active") { %>
            <button type="submit" name="etat" value="inactive" class="btn btn-outline btn-sm">Désactiver</button>
            <button type="submit" name="etat" value="archived" class="btn btn-outline btn-sm">Archiver</button>
          <% } else { %>
            <button type="submit" name="etat" value="active" class="btn btn-outline btn-sm">Rétablir la fiche</button>
            <% if (contact.record_status === "inactive") { %><button type="submit" name="etat" value="archived" class="btn btn-outline btn-sm">Archiver</button><% } %>
          <% } %>
        </form>
        <% } %>
        <% if (mk.can("contacts.merge")) { %><a class="btn btn-outline btn-sm" href="/marketing/contacts/doublons">Chercher des doublons</a><% } %>
      </div>
      <p class="field-hint">Une fiche archivée ou désactivée n'est jamais jointe par le marketing, même si elle avait donné son accord. Le cycle de vie est indépendant du consentement.</p>
      <% } %>
    </section>

    <section class="mk-panel mk-verdict <%= sendable.ok ? "is-ok" : "is-no" %>">
      <h2>Peut-on lui écrire (marketing) ?</h2>
      <p><strong><%= sendable.ok ? "Oui." : "Non." %></strong> <%= sendable.ok ? "Consentement prouvé, adresse non bloquée." : mkh.reasonLabel(sendable.reason) %></p>
    </section>

    <% const smsReasons = { inactive_record: "Fiche archivée, désactivée ou fusionnée.", not_subscribed: "Pas d'accord SMS enregistré.", unsubscribed: "A retiré son accord SMS.", suppressed: "Numéro bloqué (STOP, numéro invalide ou blocage manuel).", no_phone: "Aucun numéro valide.", no_consent: "Pas de preuve d'accord SMS pour ce numéro.", not_found: "Contact introuvable." }; %>
    <% if (sensitiveOk) { %>
    <section class="mk-panel mk-verdict <%= smsSendable.ok ? "is-ok" : "is-no" %>" id="sms">
      <h2>Peut-on lui envoyer des SMS (marketing) ?</h2>
      <p><strong><%= smsSendable.ok ? "Oui." : "Non." %></strong> <%= smsSendable.ok ? "Accord SMS prouvé pour le " + smsPhoneMasked + ", numéro non bloqué." : smsReasons[smsSendable.reason] %></p>
      <% if (mk.can("compliance.manage") && contact.sms_status !== "unsubscribed") { %>
        <details class="mk-flash-details"><summary>Enregistrer un accord SMS</summary>
          <form action="/marketing/contacts/<%= contact.id %>/sms/consentement" method="post" class="mk-form">
            <div class="field-group"><label for="sms-c-phone">Numéro qui a donné son accord</label><input id="sms-c-phone" type="tel" name="phone" maxlength="40" value="<%= contact.phone %>" placeholder="+243 81 234 5678" required></div>
            <div class="field-group"><label for="sms-c-text">Preuve (obligatoire)</label>
              <textarea id="sms-c-text" name="text" rows="3" maxlength="1000" required placeholder="Où, quand et comment la personne a accepté de recevoir des SMS (ex. case cochée sur le bulletin d'inscription papier, le 3 mars)"></textarea>
              <span class="field-hint">L'accord e-mail ne vaut pas accord SMS : il en faut un spécifique.</span></div>
            <button type="submit" class="btn btn-outline btn-sm">Enregistrer l'accord SMS</button>
          </form>
        </details>
      <% } %>
      <% if (mk.can("contacts.write") && contact.sms_status === "subscribed") { %>
        <form action="/marketing/contacts/<%= contact.id %>/sms/desinscrire" method="post" class="mk-actions"><button type="submit" class="btn btn-outline btn-sm">Désinscrire des SMS</button></form>
      <% } %>
    </section>
    <% } %>

    <div class="mk-stats">
      <div class="mk-stat"><span class="mk-stat-label">E-mails reçus</span><span class="mk-stat-value"><%= mkh.fmt(summary.messages) %></span><span class="mk-stat-hint"><%= mkh.fmt(summary.clicked) %> avec clic</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Scénarios en cours</span><span class="mk-stat-value"><%= mkh.fmt(summary.runningAutomations) %></span></div>
      <div class="mk-stat"><span class="mk-stat-label">Dernière activité</span><span class="mk-stat-value mk-stat-small"><%= summary.lastActivity ? mkh.fdate(summary.lastActivity) : "—" %></span><span class="mk-stat-hint">clic ou ouverture d'un e-mail</span></div>
      <% if (score) { %><div class="mk-stat"><span class="mk-stat-label">Score</span><span class="mk-stat-value"><%= mkh.fmt(score.score) %></span><span class="mk-stat-hint"><%= score.level %><%= score.siteScore ? " · score du site" : "" %> · <a href="/marketing/score<%= score.siteScore ? "?site=" + mk.ctx.siteScope : "" %>"><%= score.siteScore ? "détails" : "règles" %></a></span></div><% } %>
    </div>
    <% if (score && score.history.length) { %>
      <details class="mk-panel mk-score-history"><summary>D'où vient ce score ? (20 dernières attributions)</summary>
        <ul class="mk-sw-recent"><% score.history.forEach((h) => { %><li><strong><%= h.points > 0 ? "+" : "" %><%= h.points %></strong> <%= h.label %><span class="mk-sub"><%= mkh.fdatetime(new Date(h.created_at).toISOString().replace("T", " ").slice(0, 19)) %></span></li><% }) %></ul>
      </details>
    <% } %>

    <section class="mk-panel mk-timeline-panel" aria-labelledby="tl-title">
      <h2 id="tl-title">Chronologie</h2>
      <ul class="mk-timeline">
        <% timeline.forEach((a) => { %>
          <li class="mk-timeline-item">
            <span class="mk-timeline-mark" aria-hidden="true"><%- icon(a.icon, { size: 16 }) %></span>
            <span class="mk-timeline-body"><%= a.text %><% if (a.href && mk.can(a.permission)) { %> <a href="<%= a.href %>">Ouvrir</a><% } %></span>
            <time class="mk-timeline-time" datetime="<%= new Date(a.at).toISOString() %>"><%= mkh.fdate(new Date(a.at).toISOString()) %></time>
          </li>
        <% }) %>
      </ul>
      <p class="field-hint">Les 50 événements les plus récents. Les ouvertures d'e-mails sont indicatives.</p>
    </section>

    <div class="mk-grid-2">
      <section class="mk-panel">
        <h2>Informations</h2>
        <form action="/marketing/contacts/<%= contact.id %>" method="post">
          <div class="field-row">
            <div class="field-group"><label for="e-fn">Prénom</label><input id="e-fn" type="text" name="first_name" value="<%= contact.first_name %>" maxlength="100" <%= mk.can("contacts.write") ? "" : "disabled" %>></div>
            <div class="field-group"><label for="e-ln">Nom</label><input id="e-ln" type="text" name="last_name" value="<%= contact.last_name %>" maxlength="100" <%= mk.can("contacts.write") ? "" : "disabled" %>></div>
          </div>
          <div class="field-row">
            <% if (!sensitiveOk) { %><div class="field-group"><label for="e-phone-m">Téléphone</label><input id="e-phone-m" type="text" value="•••" disabled aria-describedby="e-phone-h"><p class="field-hint" id="e-phone-h">Masqué : il faut le droit « voir les données sensibles ».</p></div><% } else { %><div class="field-group"><label for="e-phone">Téléphone</label><input id="e-phone" type="text" name="phone" value="<%= contact.phone %>" maxlength="40" <%= mk.can("contacts.write") ? "" : "disabled" %>></div><% } %>
            <div class="field-group"><label for="e-company">Société</label><input id="e-company" type="text" name="company" value="<%= contact.company %>" maxlength="200" <%= mk.can("contacts.write") ? "" : "disabled" %>></div>
          </div>
          <div class="field-row">
            <div class="field-group"><label for="e-country">Pays</label><input id="e-country" type="text" name="country" value="<%= contact.country %>" maxlength="100" <%= mk.can("contacts.write") ? "" : "disabled" %>></div>
            <div class="field-group"><label for="e-lang">Langue</label><input id="e-lang" type="text" name="language" value="<%= contact.language %>" maxlength="20" <%= mk.can("contacts.write") ? "" : "disabled" %>></div>
          </div>
          <div class="field-group"><label for="e-tz">Fuseau horaire</label>
            <input id="e-tz" type="text" name="timezone" value="<%= contact.timezone %>" maxlength="64" list="tz-list" placeholder="Africa/Kinshasa" aria-describedby="e-tz-hint" <%= mk.can("contacts.write") ? "" : "disabled" %>>
            <datalist id="tz-list"><% timeZones.forEach((z) => { %><option value="<%= z %>"><% }) %></datalist>
            <p class="field-hint" id="e-tz-hint">Utilisé pour l'envoi à l'heure locale. Fuseau retenu actuellement : <strong><%= zone.tz %></strong> (<%= zoneBasis[zone.basis] %>). Vide = déduit du compte KOLAKISA, du pays, sinon fuseau par défaut.</p>
          </div>
          <p class="field-hint">L'adresse e-mail est fixe. Le statut ne se modifie que par un consentement, une désinscription ou un blocage.</p>
          <% if (mk.can("contacts.write")) { %><button type="submit" class="btn btn-primary btn-sm">Enregistrer</button><% } %>
        </form>
      </section>

      <section class="mk-panel">
        <h2>Propriétés</h2>
        <% if (!defs.length) { %><p class="field-hint">Aucune propriété personnalisée. <a href="/marketing/proprietes">En créer une</a>.</p>
        <% } else { %>
          <form action="/marketing/contacts/<%= contact.id %>/proprietes" method="post">
            <% defs.forEach((d) => { const v = values[d.key]; const dis = mk.can("contacts.write") ? "" : "disabled"; %>
              <div class="field-group">
                <label for="p-<%= d.key %>"><%= d.label %> <span class="field-hint">(<%= d.type === "text" ? "texte" : d.type === "number" ? "nombre" : d.type === "date" ? "date AAAA-MM-JJ" : d.type === "boolean" ? "oui / non" : "choix" %>)</span></label>
                <% if (d.type === "select" && d.multiple === 1) { %>
                  <input id="p-<%= d.key %>" type="text" name="prop_<%= d.key %>" value="<%= Array.isArray(v) ? v.join(", ") : "" %>" maxlength="500" <%= dis %> aria-describedby="p-<%= d.key %>-h">
                  <p class="field-hint" id="p-<%= d.key %>-h">Séparez les valeurs par des virgules. Valeurs possibles : <%= JSON.parse(d.options).join(", ") %>.</p>
                <% } else if (d.type === "select") { %>
                  <select id="p-<%= d.key %>" name="prop_<%= d.key %>" <%= dis %>><option value="">—</option>
                    <% JSON.parse(d.options).forEach((o) => { %><option value="<%= o %>" <%= v === o ? "selected" : "" %>><%= o %></option><% }) %></select>
                <% } else if (d.type === "boolean") { %>
                  <select id="p-<%= d.key %>" name="prop_<%= d.key %>" <%= dis %>><option value="">—</option><option value="oui" <%= v === true ? "selected" : "" %>>Oui</option><option value="non" <%= v === false ? "selected" : "" %>>Non</option></select>
                <% } else { %>
                  <input id="p-<%= d.key %>" type="text" name="prop_<%= d.key %>" value="<%= v === undefined ? "" : Array.isArray(v) ? v.join(", ") : v %>" maxlength="500" <%= dis %>>
                <% } %>
              </div>
            <% }) %>
            <% if (mk.can("contacts.write")) { %><button type="submit" class="btn btn-primary btn-sm">Enregistrer les propriétés</button><% } %>
          </form>
        <% } %>
      </section>

      <section class="mk-panel">
        <h2>Étiquettes</h2>
        <div class="mk-chips">
          <% if (!tags.length) { %><span class="field-hint">Aucune étiquette.</span><% } %>
          <% tags.forEach((t) => { %>
            <span class="mk-chip"><%= t.name %>
              <% if (mk.can("contacts.write")) { %><form action="/marketing/contacts/<%= contact.id %>/etiquettes/retirer" method="post" class="mk-inline"><input type="hidden" name="name" value="<%= t.name %>"><button type="submit" class="mk-chip-x" aria-label="Retirer l'étiquette <%= t.name %>"><%- icon("close", { size: 12 }) %></button></form><% } %>
            </span>
          <% }) %>
        </div>
        <% if (mk.can("contacts.write")) { %>
          <form action="/marketing/contacts/<%= contact.id %>/etiquettes" method="post" class="mk-inline-form">
            <label for="t-name" class="sr-only">Nouvelle étiquette</label><input id="t-name" type="text" name="name" maxlength="64" placeholder="Nouvelle étiquette" required>
            <button type="submit" class="btn btn-outline btn-sm">Ajouter</button>
          </form>
        <% } %>
      </section>

      <section class="mk-panel">
        <h2>Listes</h2>
        <ul class="mk-status-list">
          <% if (!memberOf.length) { %><li class="field-hint">Dans aucune liste.</li><% } %>
          <% memberOf.forEach((l) => { %>
            <li><a href="/marketing/listes/<%= l.id %>"><%= l.name %></a> <span class="field-hint">— <%= l.stateLabel %></span>
              <% if (mk.can("contacts.write")) { %><form action="/marketing/contacts/<%= contact.id %>/listes/retirer" method="post" class="mk-inline"><input type="hidden" name="list_id" value="<%= l.id %>"><button type="submit" class="btn btn-outline btn-sm">Retirer</button></form><% } %>
            </li>
          <% }) %>
        </ul>
        <% if (mk.can("contacts.write") && allLists.length) { %>
          <form action="/marketing/contacts/<%= contact.id %>/listes" method="post" class="mk-inline-form">
            <label for="l-id" class="sr-only">Ajouter à une liste</label>
            <select id="l-id" name="list_id"><% allLists.forEach((l) => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select>
            <button type="submit" class="btn btn-outline btn-sm">Ajouter à la liste</button>
          </form>
          <p class="field-hint">Être dans une liste ne donne aucun consentement.</p>
        <% } %>
      </section>
    </div>

    <% if (commerce) { %>
    <section class="mk-panel" id="commerce" aria-labelledby="cm-title">
      <h2 id="cm-title">Commerce</h2>
      <% if (!commerce.count) { %><p class="field-hint">Ce contact n'a passé aucune commande.<%= commerce.abandoned ? ` ${commerce.abandoned} panier(s) ou commande(s) abandonné(s).` : "" %></p>
      <% } else { %>
        <p><strong><%= commerce.count %></strong> commande(s) · <strong><%= mkh.euros(commerce.netCents) %></strong> dépensés<%= commerce.refundedCents ? ` (dont ${mkh.euros(commerce.refundedCents)} remboursés)` : "" %> · première le <%= mkh.fdate(commerce.first) %>, dernière le <%= mkh.fdate(commerce.last) %><%= commerce.abandoned ? ` · ${commerce.abandoned} abandon(s)` : "" %></p>
        <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Commandes de ce contact</caption>
          <thead><tr><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Formations</th><th scope="col">Montant</th><th scope="col">Remboursé</th></tr></thead>
          <tbody><% commerce.recent.forEach((o) => { %><tr>
            <td><a href="/formateur/gestion/ventes/commandes/<%= o.id %>">n° <%= o.id %></a></td>
            <td><%= mkh.fdate(o.created_at) %></td>
            <td><%= o.products.map((p) => p.title).join(", ") || "—" %></td>
            <td><%= mkh.euros(o.total_cents) %><%= o.coupon_code ? ` (code ${o.coupon_code})` : "" %></td>
            <td><%= o.refunded_cents ? mkh.euros(o.refunded_cents) : "—" %></td></tr><% }) %></tbody>
        </table></div>
      <% } %>
    </section>
    <% } %>

    <% if (journeys) { %>
    <section class="mk-panel" id="tunnels" aria-labelledby="tn-title">
      <h2 id="tn-title">Tunnels</h2>
      <% if (!journeys.length) { %><p class="field-hint">Ce contact n'a encore aucun parcours enregistré dans un tunnel.</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Parcours de ce contact dans les tunnels</caption>
          <thead><tr><th scope="col">Tunnel</th><th scope="col">État</th><th scope="col">Étapes atteintes</th><th scope="col">Provenance</th><th scope="col">Dernière activité</th></tr></thead>
          <tbody><% journeys.forEach((j) => { %><tr>
            <td><a href="/marketing/tunnels/<%= j.funnelId %>"><%= j.name %></a></td>
            <td><%= j.state === "completed" ? "Terminé" : j.state === "abandoned" ? "Abandonné" : "En cours" %></td>
            <td><%= j.reached.length ? j.reached.join(" → ") : "—" %></td>
            <td><%= j.attribution ? j.attribution.source + (j.attribution.campaign ? " · " + j.attribution.campaign : "") : "—" %></td>
            <td><%= mkh.fdatetime(new Date(j.lastAt).toISOString().replace("T", " ").slice(0, 19)) %></td></tr><% }) %></tbody>
        </table></div>
      <% } %>
    </section>
    <% } %>

    <% if (autoRuns) { %>
    <section class="mk-panel" id="scenarios" aria-labelledby="sc-title">
      <h2 id="sc-title">Scénarios d'automatisation</h2>
      <% if (!autoRuns.length) { %><p class="field-hint">Ce contact n'est entré dans aucun scénario.</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Scénarios de ce contact</caption>
          <thead><tr><th scope="col">Scénario</th><th scope="col">État</th><th scope="col">Prochaine étape</th><th scope="col">Prochaine exécution</th><th scope="col">Erreur</th></tr></thead>
          <tbody><% autoRuns.forEach((r) => { %><tr>
            <td><a href="/marketing/automatisations/<%= r.automationId %>/passages/<%= r.id %>"><%= r.automation %></a> <span class="field-hint">v<%= r.version || 1 %></span></td>
            <td><%= r.state === "waiting" ? "En attente" : r.state === "due" ? "À exécuter" : r.statusLabel %></td>
            <td><%= r.nextStep || "—" %></td>
            <td><%= r.nextAt && r.state !== "completed" ? mkh.fdatetime(new Date(r.nextAt).toISOString().replace("T", " ").slice(0, 19)) : "—" %></td>
            <td><%= r.error || "—" %></td></tr><% }) %></tbody>
        </table></div>
      <% } %>
    </section>
    <% } %>

    <% if (files.length) { %>
    <section class="mk-panel" aria-labelledby="ct-files">
      <h2 id="ct-files">Fichiers envoyés</h2>
      <ul class="mk-sw-recent">
        <% files.forEach((f) => { %><li><a href="/marketing/contacts/<%= contact.id %>/fichiers/<%= f.id %>" download><%= f.original_name %></a>
          <span class="mk-sub"><%= f.mime === "application/pdf" ? "PDF" : "Image" %> · <%= f.size >= 1048576 ? (f.size / 1048576).toFixed(1).replace(".", ",") + " Mo" : Math.max(1, Math.round(f.size / 1024)) + " Ko" %> · <%= f.form_name ? `formulaire « ${f.form_name} »` : "formulaire supprimé" %> · <%= mkh.fdatetime(f.created_at) %></span></li><% }) %>
      </ul>
    </section>
    <% } %>

    <% if (eventsPage) { %>
    <section class="mk-panel" id="journal" aria-labelledby="ev-title">
      <h2 id="ev-title">Journal d'événements</h2>
      <% if (!eventsPage.events.length) { %><p class="field-hint">Aucun événement enregistré pour ce contact. Les formulaires, commentaires, inscriptions et commandes y apparaissent dès qu'ils se produisent.</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table">
          <caption class="sr-only">Événements enregistrés pour ce contact, du plus récent au plus ancien</caption>
          <thead><tr><th scope="col">Date</th><th scope="col">Événement</th><th scope="col">Source</th><th scope="col">Objet</th></tr></thead>
          <tbody><% eventsPage.events.forEach((e) => { %>
            <tr><td><time datetime="<%= new Date(e.at).toISOString() %>"><%= mkh.fdatetime(new Date(e.at).toISOString().replace("T", " ").slice(0, 19)) %></time></td><td><code><%= e.type %></code></td><td><%= e.source %></td><td><%= e.objectType ? e.objectType + (e.objectId ? " #" + e.objectId : "") : "—" %></td></tr>
          <% }) %></tbody>
        </table></div>
        <% if (eventsPage.next) { %><p><a href="?avant=<%= eventsPage.next %>#journal">Événements plus anciens</a></p><% } %>
      <% } %>
      <p class="field-hint">Le journal est un historique : un événement ne se modifie pas. Il peut provenir des fiches fusionnées dans celle-ci.</p>
    </section>
    <% } %>

    <% if (absorbedProofs.length) { %>
    <section class="mk-panel" aria-labelledby="ap-title">
      <h2 id="ap-title">Preuves de consentement des fiches fusionnées</h2>
      <div class="mk-table-wrap"><table class="mk-table">
        <caption class="sr-only">Preuves conservées sur les fiches absorbées</caption>
        <thead><tr><th scope="col">Date</th><th scope="col">Événement</th><th scope="col">Source</th><th scope="col">Texte présenté</th></tr></thead>
        <tbody><% absorbedProofs.forEach((k) => { %><tr><td><%= mkh.fdate(k.created_at) %></td><td><%= k.action === "granted" ? "Consentement donné" : "Retrait" %></td><td><%= k.source %></td><td><%= k.text_shown %></td></tr><% }) %></tbody>
      </table></div>
      <p class="field-hint">Ces preuves restent attachées à l'ancienne fiche (elles ne se modifient pas). Elles ne rendent PAS cette fiche abonnée : seul un consentement enregistré sur elle le fait.</p>
    </section>
    <% } %>

    <section class="mk-panel">
      <h2>Consentement et désinscription</h2>
      <% if (!history.length) { %><p class="field-hint">Aucune preuve de consentement enregistrée.</p>
      <% } else if (!sensitiveOk) { %><p class="field-hint"><%= history.length %> preuve<%= history.length > 1 ? "s" : "" %> enregistrée<%= history.length > 1 ? "s" : "" %> : le détail (texte présenté, adresse IP tronquée) demande le droit « voir les données sensibles ».</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table">
          <caption class="sr-only">Historique du consentement</caption>
          <thead><tr><th scope="col">Date</th><th scope="col">Événement</th><th scope="col">Source</th><th scope="col">Texte présenté</th><th scope="col">IP (tronquée)</th></tr></thead>
          <tbody>
            <% history.forEach((h) => { %>
              <tr><td><%= mkh.fdate(h.created_at) %></td><td><%= h.action === "granted" ? "Consentement donné" : "Retrait" %><%= h.purpose === "sms" ? " (SMS)" : h.purpose !== "marketing" ? " (" + h.purpose + ")" : "" %></td><td><%= h.source %></td><td><%= h.text_shown %></td><td><%= h.ip %></td></tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>
      <% if (preferences.length) { %>
        <h3>Préférences</h3>
        <ul class="mk-status-list"><% preferences.forEach((p) => { %><li><%= p.label %> : <%= p.subscribed ? "accepté" : "refusé" %></li><% }) %></ul>
      <% } %>

      <% if (mk.can("compliance.manage")) { %>
        <form action="/marketing/contacts/<%= contact.id %>/consentement" method="post" class="mk-form">
          <div class="field-group">
            <label for="cs-text">Enregistrer un consentement (preuve obligatoire)</label>
            <textarea id="cs-text" name="text" rows="4" maxlength="1000" required placeholder="Où, quand et comment la personne a donné son accord (ex. formulaire papier signé au salon, le 3 mars)"></textarea>
            <span class="field-hint">Ne réabonne jamais une personne désinscrite ni une adresse bloquée.</span>
          </div>
          <button type="submit" class="btn btn-outline btn-sm">Enregistrer le consentement</button>
        </form>
      <% } %>
      <div class="mk-actions">
        <% if (mk.can("contacts.write") && contact.status !== "unsubscribed") { %>
          <form action="/marketing/contacts/<%= contact.id %>/desinscrire" method="post"><button type="submit" class="btn btn-outline btn-sm">Marquer comme désinscrit</button></form>
        <% } %>
        <% if (mk.can("compliance.manage") && !["suppressed", "bounced", "complained"].includes(contact.status)) { %>
          <form action="/marketing/contacts/<%= contact.id %>/supprimer-adresse" method="post" class="mk-inline-form">
            <label for="sp-note" class="sr-only">Motif du blocage</label><input id="sp-note" type="text" name="note" maxlength="500" placeholder="Motif (facultatif)">
            <button type="submit" class="btn btn-outline btn-sm">Bloquer l'adresse</button>
          </form>
        <% } %>
      </div>
    </section>

    <% if (mk.can("contacts.delete")) { %>
      <section class="mk-panel mk-danger">
        <h2>Effacer ce contact</h2>
        <p class="field-hint">Supprime définitivement le contact, ses propriétés, étiquettes, appartenances et preuves. Action irréversible.</p>
        <form action="/marketing/contacts/<%= contact.id %>/effacer" method="post">
          <label class="checkbox-row"><input type="checkbox" name="confirm" value="on"> Je confirme l'effacement définitif</label>
          <label class="checkbox-row"><input type="checkbox" name="suppress" value="on"> Garder l'adresse bloquée (empêche un réimport)</label>
          <button type="submit" class="btn btn-danger btn-sm">Effacer</button>
        </form>
      </section>
    <% } %>
<%- include("partials/bottom") %>
