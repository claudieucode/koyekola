<%- include("partials/top", { title, active }) %>
<%
  const NEXT_DIR = { name: "asc", status: "asc", recipients: "desc", sent: "desc", clicks: "desc", created: "desc" };
  const sortHead = (key, label, cls) => {
    const on = result.sort === key;
    const next = on ? (result.dir === "asc" ? "desc" : "asc") : NEXT_DIR[key];
    const attr = on ? ` aria-sort="${result.dir === "asc" ? "ascending" : "descending"}"` : "";
    return `<th scope="col"${cls ? ` class="${cls}"` : ""}${attr}><a href="${mkh.esc(url({ tri: key, sens: next, page: null }))}">${label}</a></th>`;
  };
  const pageNumbers = [];
  for (let p = 1; p <= result.pages; p++) if (p === 1 || p === result.pages || Math.abs(p - result.page) <= 2) pageNumbers.push(p);
  const canWrite = mk.can("campaigns.write");
%>
    <div class="mk-head"><h1>Campagnes <span class="mk-count"><%= mkh.fmt(counts.all) %></span></h1></div>
    <%- include("partials/site-filter", { action: "/marketing/campagnes" }) %>
    <p class="mk-lead">Envoyez un modèle à une liste ou à un segment. Chaque message est revérifié (consentement, désinscription, blocage) au moment de partir.</p>
    <% if (provider === "console") { %><p class="mk-note">Fournisseur « console » : rien n'est réellement envoyé. Choisissez SMTP ou Resend dans <a href="/marketing/envoi">Envoi</a>.</p><% } %>
    <%- include("partials/worker-note", { workerOn, consequence: "aucune campagne ne partira tant qu'il n'est pas rétabli" }) %>

    <% if (counts.all === 0) { %>
      <div class="mk-empty">
        <%- icon("send", { size: 32 }) %>
        <h2>Aucune campagne</h2>
        <p>Une campagne envoie un modèle d'e-mail à une liste ou à un segment. Un assistant en sept étapes vous guide jusqu'à l'envoi, avec un contrôle avant lancement.</p>
        <% if (canWrite) { %><div class="mk-actions"><a class="btn btn-primary btn-sm" href="/marketing/campagnes/nouvelle">Créer une campagne</a></div><% } %>
      </div>
    <% } else { %>
      <nav class="mk-tabs" aria-label="Filtrer par statut">
        <% tabs.forEach(([key, label]) => { const n = key ? counts[key] : counts.all; %><a class="mk-tab" href="<%= url({ statut: key || null, page: null }) %>"<%- statut === key ? ' aria-current="page"' : "" %>><%= label %> <span class="mk-tab-count"><%= n %></span></a>
        <% }) %>
      </nav>

      <form class="mk-filterbar" method="get" action="/marketing/campagnes" role="search">
        <% if (statut) { %><input type="hidden" name="statut" value="<%= statut %>"><% } %>
        <% if (view.tri) { %><input type="hidden" name="tri" value="<%= view.tri %>"><input type="hidden" name="sens" value="<%= view.sens %>"><% } %>
        <div class="mk-search"><%- icon("search", { size: 16 }) %><label class="sr-only" for="f-q">Rechercher une campagne</label><input id="f-q" type="search" name="q" value="<%= q %>" placeholder="Nom de la campagne" maxlength="100"></div>
        <div class="field-group"><label for="f-taille">Par page</label>
          <select id="f-taille" name="taille"><% [10, 25, 50].forEach((n) => { %><option value="<%= n %>" <%= result.pageSize === n ? "selected" : "" %>><%= n %></option><% }) %></select></div>
        <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
        <% if (hasFilters) { %><a href="/marketing/campagnes" class="btn btn-ghost btn-sm">Réinitialiser</a><% } %>
      </form>
      <p class="mk-filter-count" role="status"><%= mkh.fmt(result.total) %> campagne<%= result.total > 1 ? "s" : "" %><%= hasFilters ? " correspondant aux filtres" : "" %></p>

      <% if (!rows.length) { %>
        <div class="mk-empty">
          <%- icon("search", { size: 32 }) %>
          <h2>Aucune campagne ne correspond</h2>
          <p>Élargissez la recherche ou changez d'onglet.</p>
          <div class="mk-actions"><a class="btn btn-outline btn-sm" href="/marketing/campagnes">Réinitialiser les filtres</a></div>
        </div>
      <% } else { %>
        <div class="mk-table-wrap">
          <table class="mk-table mk-datatable">
            <caption class="sr-only">Campagnes (<%= mkh.fmt(result.total) %>), triées</caption>
            <thead><tr>
              <%- sortHead("name", "Campagne") %>
              <%- sortHead("status", "Statut") %>
              <%- sortHead("recipients", "Destinataires") %>
              <th scope="col" class="mk-num">Ouvertures</th>
              <%- sortHead("clicks", "Clics", "mk-num") %>
              <%- sortHead("created", "Créée le") %>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr></thead>
            <tbody>
              <% rows.forEach((c) => { const st = mkh.campaignStatus(c.status); const deletable = ["draft", "cancelled", "failed"].includes(c.status); %>
                <tr>
                  <td data-label="Campagne"><a href="/marketing/campagnes/<%= c.id %>"><%= c.name %></a>
                    <span class="mk-sub"><%= c.is_ab ? "Test A/B" : "E-mail classique" %> · <%= c.status === "draft" ? "modifié le " + mkh.fdate(c.updated_at) : c.finished_at ? "terminé le " + new Date(c.finished_at).toLocaleDateString("fr-FR") : c.scheduled_at && c.status === "scheduled" ? "programmé le " + new Date(c.scheduled_at).toLocaleDateString("fr-FR") : "créé le " + mkh.fdate(c.created_at) %> · modèle « <%= c.template_name || "(supprimé)" %> »</span></td>
                  <td data-label="Statut"><span class="mk-status <%= st.cls %>"><%= st.label %></span></td>
                  <td data-label="Destinataires"><%= c.target_type === "list" ? "Liste" : "Segment" %> « <%= c.target_name || "(supprimée)" %> »<% if (c.status !== "draft") { %><span class="mk-sub"><%= mkh.fmt(c.total_recipients) %> destinataire<%= c.total_recipients > 1 ? "s" : "" %> · <%= mkh.fmt(c.sent_count) %> envoyé<%= c.sent_count > 1 ? "s" : "" %></span><% } %></td>
                  <td class="mk-num" data-label="Ouvertures"><% if (c.status === "draft") { %>—<% } else if (c.openRate === null) { %><span class="mk-sub">non suivies</span><% } else { %><strong><%= mkh.rate(c.openRate) %></strong><span class="mk-sub"><%= mkh.fmt(c.unique_open_count) %></span><% } %></td>
                  <td class="mk-num" data-label="Clics"><% if (c.status === "draft") { %>—<% } else { %><strong><%= mkh.rate(c.clickRate) %></strong><span class="mk-sub"><%= mkh.fmt(c.unique_click_count) %></span><% } %></td>
                  <td data-label="Créée le" class="mk-nowrap"><%= mkh.fdate(c.created_at) %></td>
                  <td data-label="Actions" class="mk-row-actions">
                    <a class="btn btn-outline btn-sm" href="/marketing/campagnes/<%= c.id %>"><%= c.status === "draft" ? (canWrite ? "Modifier" : "Voir") : "Voir le rapport" %></a>
                    <% if (canWrite) { %>
                      <div class="mk-dropdown" data-mk-dropdown>
                        <button type="button" class="icon-btn btn-sm" aria-haspopup="menu" aria-expanded="false" aria-controls="menu-campagne-<%= c.id %>" aria-label="Actions pour la campagne <%= c.name %>"><%- icon("moreVertical", { size: 18 }) %></button>
                        <div class="mk-menu" id="menu-campagne-<%= c.id %>" role="menu" hidden>
                          <form action="/marketing/campagnes/<%= c.id %>/dupliquer" method="post" role="none"><button type="submit" role="menuitem" aria-label="Dupliquer la campagne <%= c.name %>">Dupliquer</button></form>
                          <% if (deletable) { %><form action="/marketing/campagnes/<%= c.id %>/supprimer" method="post" role="none"><button type="submit" role="menuitem" class="mk-menu-danger" data-mk-confirm="<%= c.status === "draft" ? "Le brouillon « " + c.name + " » sera supprimé. Aucun message n'a été envoyé." : "La campagne « " + c.name + " » et ses statistiques seront supprimées." %>" data-mk-confirm-title="Supprimer cette campagne ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form><% } %>
                        </div>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="mk-pager">
          <span><%= mkh.fmt(range.from) %>–<%= mkh.fmt(range.to) %> sur <%= mkh.fmt(result.total) %></span>
          <% if (result.pages > 1) { %>
            <nav class="mk-pager-links" aria-label="Pagination">
              <% if (result.page > 1) { %><a href="<%= url({ page: result.page - 1 }) %>" rel="prev" aria-label="Page précédente">Précédent</a><% } %>
              <% let last = 0; pageNumbers.forEach((p) => { if (p - last > 1) { %><span aria-hidden="true">…</span><% } last = p; %>
                <% if (p === result.page) { %><span aria-current="page"><%= p %></span><% } else { %><a href="<%= url({ page: p }) %>" aria-label="Page <%= p %>"><%= p %></a><% } %>
              <% }) %>
              <% if (result.page < result.pages) { %><a href="<%= url({ page: result.page + 1 }) %>" rel="next" aria-label="Page suivante">Suivant</a><% } %>
            </nav>
          <% } %>
        </div>
      <% } %>
    <% } %>
<%- include("partials/bottom") %>
