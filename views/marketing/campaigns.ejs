<%- include("partials/top", { title, active }) %>
<%
  const NEXT_DIR = { name: "asc", status: "asc", recipients: "desc", sent: "desc", clicks: "desc", created: "desc" };
  const sortHead = (key, label, cls) => {
    const on = result.sort === key;
    const next = on ? (result.dir === "asc" ? "desc" : "asc") : NEXT_DIR[key];
    const attr = on ? ` aria-sort="${result.dir === "asc" ? "ascending" : "descending"}"` : "";
    return `<th scope="col"${cls ? ` class="${cls}"` : ""}${attr}><a href="${mkh.esc(url({ tri: key, sens: next, page: null }))}">${label}</a></th>`;
  };
  const canWrite = mk.can("campaigns.write");
%>
    <div class="mk-head">
      <div class="mk-head-main">
        <h1>Toutes les campagnes <span class="mk-count"><%= mkh.fmt(counts.all) %></span></h1>
        <p class="mk-head-sub">Envoyez un modèle à une liste ou à un segment. Chaque message est revérifié (consentement, désinscription, blocage) au moment de partir.</p>
      </div>
      <div class="mk-head-actions">
        <% if (mk.can("analytics.read")) { %><a class="btn btn-outline" href="/marketing/analytics" data-tip="Ouvre le détail de chaque envoi : délivrés, ouvertures, clics, rebonds, plaintes.">Voir les analyses</a><% } %>
        <% if (canWrite) { %><a class="btn btn-primary" href="/marketing/campagnes/nouvelle" data-tip="Lance l'assistant en sept étapes : modèle, destinataires, contrôle avant envoi.">Créer une campagne</a><% } %>
      </div>
    </div>
    <%- include("partials/site-filter", { action: "/marketing/campagnes" }) %>
    <% if (provider === "console") { %><div class="mk-banner is-warn" role="note"><%- icon("alertTriangle", { size: 18 }) %><p><strong>Rien n'est réellement envoyé</strong>Fournisseur « console » : aucun message ne part vraiment. Choisissez SMTP ou Resend dans <a href="/marketing/envoi">Envoi</a>.</p></div><% } %>
    <%- include("partials/worker-note", { workerOn, consequence: "aucune campagne ne partira tant qu'il n'est pas rétabli" }) %>

    <% if (counts.all === 0) { %>
      <div class="mk-empty"><div class="mk-empty-split">
        <div class="mk-es-text">
          <h2>Aucune campagne</h2>
          <p>Une campagne envoie un modèle d'e-mail à une liste ou à un segment. Un assistant en sept étapes vous guide jusqu'à l'envoi, avec un contrôle avant lancement.</p>
          <% if (canWrite) { %><div class="mk-actions"><a class="btn btn-primary" href="/marketing/campagnes/nouvelle">Créer une campagne</a><a class="btn btn-outline" href="/marketing/modeles">Voir les modèles</a></div><% } %>
        </div>
        <div class="mk-empty-art" aria-hidden="true"><%- include("partials/empty-art", { kind: "email" }) %></div>
      </div></div>
    <% } else { %>
      <nav class="mk-tabs" aria-label="Filtrer par statut">
        <% const TAB_TIPS = { "": "Toutes les campagnes, tous statuts confondus.", draft: "Pas encore envoyées : à terminer, tester ou programmer.", scheduled: "Prêtes : elles partiront toutes seules à la date prévue.", sending: "En cours : les messages partent par lots.", sent: "Terminées : consultez le rapport de résultats.", failed: "Interrompues par une erreur : ouvrez-les pour connaître la cause." }; %>
        <% tabs.forEach(([key, label]) => { const n = key ? counts[key] : counts.all; %><a class="mk-tab" href="<%= url({ statut: key || null, page: null }) %>"<%- statut === key ? ' aria-current="page"' : "" %> data-tip="<%= TAB_TIPS[key] || ("Campagnes : " + label.toLowerCase()) %>"><%= label %> <span class="mk-tab-count"><%= n %></span></a>
        <% }) %>
      </nav>

      <form class="mk-filterbar" method="get" action="/marketing/campagnes" role="search">
        <% if (statut) { %><input type="hidden" name="statut" value="<%= statut %>"><% } %>
        <% if (result.pageSize !== 25) { %><input type="hidden" name="taille" value="<%= result.pageSize %>"><% } %>
        <div class="mk-search"><%- icon("search", { size: 16 }) %><label class="sr-only" for="f-q">Rechercher une campagne</label><input id="f-q" type="search" name="q" value="<%= q %>" placeholder="Rechercher des campagnes" maxlength="100"></div>
        <div class="mk-toolbar-right">
          <div class="field-group" data-tip="Choisissez la colonne qui ordonne la liste. Le sens se change avec la flèche à droite, ou en cliquant sur un en-tête de colonne.">
            <label for="f-tri">Trier par</label>
            <select id="f-tri" name="tri"><% [["created", "Date de création"], ["name", "Nom"], ["status", "Statut"], ["recipients", "Destinataires"], ["clicks", "Clics"]].forEach(([k, l]) => { %><option value="<%= k %>"<%= result.sort === k ? " selected" : "" %>><%= l %></option><% }) %></select>
          </div>
          <input type="hidden" name="sens" value="<%= result.dir %>">
          <a class="btn btn-ghost btn-icon" href="<%= url({ tri: result.sort, sens: result.dir === "asc" ? "desc" : "asc", page: null }) %>" aria-label="Inverser le sens du tri (actuellement <%= result.dir === "asc" ? "croissant" : "décroissant" %>)" data-tip="Inverser le sens du tri : actuellement <%= result.dir === "asc" ? "croissant" : "décroissant" %>."><%- icon(result.dir === "asc" ? "arrowUp" : "arrowDown", { size: 16 }) %></a>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
        <% if (hasFilters) { %><a href="/marketing/campagnes" class="mk-filter-clear">Effacer</a><% } %>
      </form>
      <p class="mk-filter-count" role="status"><%= mkh.fmt(result.total) %> campagne<%= result.total > 1 ? "s" : "" %><%= hasFilters ? " correspondant aux filtres" : "" %></p>

      <% if (!rows.length) { %>
        <div class="mk-empty-center mk-card" style="padding:40px 20px">
          <%- icon("search", { size: 28 }) %><strong>Aucune campagne ne correspond</strong><span>Élargissez la recherche ou changez d'onglet.</span>
          <a class="btn btn-outline btn-sm" href="/marketing/campagnes">Réinitialiser les filtres</a>
        </div>
      <% } else { %>
        <div class="mk-table-wrap">
          <table class="mk-table mk-datatable">
            <caption class="sr-only">Campagnes (<%= mkh.fmt(result.total) %>), triées</caption>
            <thead><tr>
              <%- sortHead("name", "Campagne") %>
              <%- sortHead("status", "Statut") %>
              <%- sortHead("recipients", "Destinataires") %>
              <th scope="col" class="mk-num" data-tip="Part des destinataires qui ont ouvert le message. Les ouvertures sont estimées : certains logiciels de messagerie les masquent.">Ouvertures</th>
              <%- sortHead("clicks", "Clics", "mk-num") %>
              <%- sortHead("created", "Créée le") %>
              <th scope="col" class="mk-col-actions"><span class="sr-only">Actions</span></th>
            </tr></thead>
            <tbody>
              <% rows.forEach((c) => { const st = mkh.campaignStatus(c.status); const deletable = ["draft", "cancelled", "failed"].includes(c.status); %>
                <tr>
                  <td data-label="Campagne">
                    <div class="mk-cell-title">
                      <a href="/marketing/campagnes/<%= c.id %>"><%= c.name %></a>
                      <span class="mk-cell-meta"><%- icon(c.is_ab ? "shuffle" : "mail", { size: 14 }) %> <%= c.is_ab ? "Test A/B" : "E-mail classique" %> · <%= c.status === "draft" ? "modifié le " + mkh.fdate(c.updated_at) : c.finished_at ? "terminé le " + new Date(c.finished_at).toLocaleDateString("fr-FR") : c.scheduled_at && c.status === "scheduled" ? "programmé le " + new Date(c.scheduled_at).toLocaleString("fr-FR") : "créé le " + mkh.fdate(c.created_at) %> · modèle « <%= c.template_name || "(supprimé)" %> »</span>
                    </div>
                  </td>
                  <td data-label="Statut"><span class="mk-status <%= st.cls %>"><%= st.label %></span></td>
                  <td data-label="Destinataires"><span class="mk-cell-title"><strong style="font-weight:600;color:var(--accent-dark)"><%= c.target_type === "list" ? "Liste" : "Segment" %> « <%= c.target_name || "(supprimée)" %> »</strong><% if (c.status !== "draft") { %><span class="mk-cell-meta"><%= mkh.fmt(c.total_recipients) %> destinataire<%= c.total_recipients > 1 ? "s" : "" %> · <%= mkh.fmt(c.sent_count) %> envoyé<%= c.sent_count > 1 ? "s" : "" %></span><% } %></span></td>
                  <td class="mk-num" data-label="Ouvertures"><% if (c.status === "draft") { %><span class="mk-nil">—</span><% } else if (c.openRate === null) { %><span class="mk-cell-meta">non suivies</span><% } else { %><span class="mk-metric"><b><%= mkh.rate(c.openRate) %></b><span><%= mkh.fmt(c.unique_open_count) %></span></span><% } %></td>
                  <td class="mk-num" data-label="Clics"><% if (c.status === "draft") { %><span class="mk-nil">—</span><% } else { %><span class="mk-metric"><b><%= mkh.rate(c.clickRate) %></b><span><%= mkh.fmt(c.unique_click_count) %></span></span><% } %></td>
                  <td data-label="Créée le" class="mk-nowrap"><%= mkh.fdate(c.created_at) %></td>
                  <td data-label="Actions" class="mk-row-actions mk-col-actions">
                    <div class="mk-split">
                      <a class="btn btn-outline btn-sm" href="/marketing/campagnes/<%= c.id %>" data-tip="<%= c.status === "draft" ? (canWrite ? "Reprendre l'assistant là où vous l'avez laissé." : "Consulter ce brouillon.") : "Ouvrir le rapport : destinataires, ouvertures, clics, rebonds." %>"><%= c.status === "draft" ? (canWrite ? "Modifier" : "Voir") : "Voir le rapport" %></a>
                      <% if (canWrite) { %>
                        <div class="mk-dropdown" data-mk-dropdown>
                          <button type="button" class="icon-btn btn-sm" aria-haspopup="menu" aria-expanded="false" aria-controls="menu-campagne-<%= c.id %>" aria-label="Actions pour la campagne <%= c.name %>"><%- icon("chevronDown", { size: 16 }) %></button>
                          <div class="mk-menu" id="menu-campagne-<%= c.id %>" role="menu" hidden>
                            <form action="/marketing/campagnes/<%= c.id %>/dupliquer" method="post" role="none"><button type="submit" role="menuitem" aria-label="Dupliquer la campagne <%= c.name %>">Dupliquer</button></form>
                            <% if (deletable) { %><form action="/marketing/campagnes/<%= c.id %>/supprimer" method="post" role="none"><button type="submit" role="menuitem" class="mk-menu-danger" data-mk-confirm="<%= c.status === "draft" ? "Le brouillon « " + c.name + " » sera supprimé. Aucun message n'a été envoyé." : "La campagne « " + c.name + " » et ses statistiques seront supprimées." %>" data-mk-confirm-title="Supprimer cette campagne ?" data-mk-confirm-ok="Supprimer" aria-label="Supprimer la campagne <%= c.name %>">Supprimer</button></form><% } %>
                          </div>
                        </div>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <%- include("partials/pager", { result, url, sizes: [10, 25, 50] }) %>
        </div>
      <% } %>
    <% } %>
<%- include("partials/bottom") %>
