<%#
  KOLAKISA CMS → Catégories / Étiquettes (palier 5). Les chiffres (articles) sont calculés dans la base ; aucun compteur n'est stocké.
  Création, modification, suppression avec réassignation et fusion passent par des fenêtres qui envoient de vrais formulaires.
%><%- include("partials/top", { title, active }) %>
<%
  const hier = def.hierarchical;
  const one = key === "tag" ? "étiquette" : "catégorie";
  const S = typeof mkSiteId === "number" ? mkSiteId : ""; const siteQ = S ? "?site=" + S : ""; // site courant (accès limité ou site choisi) : conservé dans tous les liens
  const keep = (over = {}) => { const p = new URLSearchParams(); const o = { site: S, q: f.q, tri: f.tri === "nom" ? "" : f.tri, inutilises: f.inutilises ? "1" : "", parent: f.parent, ...over }; Object.entries(o).forEach(([k, v]) => { if (v) p.set(k, v); }); const t = p.toString(); return PATHS[key] + (t ? "?" + t : ""); };
  const filtered = Boolean(f.q || f.inutilises || f.parent);
  const here = keep({ page: page > 1 ? page : "" });
  const n = (v) => Number(v || 0);
  const plural = (v, w) => v + " " + w + (v > 1 ? "s" : "");
%>
    <div class="mk-head"><h1><%= def.plural %></h1>
      <% if (canWrite) { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-tx-new>Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></button></div><% } %></div>
    <p class="mk-lead"><%= key === "tag" ? "Les étiquettes sont des mots-clés transversaux (Google, Conversion…), sans hiérarchie : un article peut en avoir plusieurs." : "Les catégories classent les articles, de façon structurée : Marketing › SEO › SEO technique. Un article a une catégorie principale et peut en avoir d'autres." %></p>

    <nav class="mk-tabs mk-cms-tabs" aria-label="Taxonomies">
      <a class="mk-tab" href="<%= PATHS.category + siteQ %>"<%- key === "category" ? ' aria-current="page"' : "" %>>Catégories</a>
      <a class="mk-tab" href="<%= PATHS.tag + siteQ %>"<%- key === "tag" ? ' aria-current="page"' : "" %>>Étiquettes</a>
    </nav>

    <form class="mk-cms-toolbar mk-cms-filters" method="get" action="<%= PATHS[key] %>" role="search" aria-label="Rechercher parmi les <%= def.plural.toLowerCase() %>"><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
      <label class="mk-search"><span class="sr-only">Rechercher (nom, adresse, description)</span><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= f.q %>" placeholder="Rechercher une <%= one %>"></label>
      <% if (hier) { %><label class="sr-only" for="tx-f-parent">Catégorie parente</label>
      <select id="tx-f-parent" name="parent"><option value="">Tous les niveaux</option><option value="0"<%= f.parent === "0" ? " selected" : "" %>>Premier niveau seulement</option><% options.forEach((o) => { %><option value="<%= o.id %>"<%= String(o.id) === f.parent ? " selected" : "" %>>Sous « <%= o.name %> »</option><% }) %></select><% } %>
      <label class="sr-only" for="tx-f-tri">Trier par</label>
      <select id="tx-f-tri" name="tri"><% [["nom", "Nom A → Z"], ["nom_desc", "Nom Z → A"], ["utilisation", "Plus utilisées"], ["recent", "Plus récentes"], ["ancien", "Plus anciennes"]].forEach(([k, name]) => { %><option value="<%= k %>"<%= f.tri === k ? " selected" : "" %>><%= name %></option><% }) %></select>
      <label class="mk-cms-check"><input type="checkbox" name="inutilises" value="1"<%= f.inutilises ? " checked" : "" %>> Inutilisées</label>
      <button type="submit" class="btn btn-outline btn-sm">Filtrer</button><% if (filtered || f.tri !== "nom") { %><a class="btn btn-ghost btn-sm" href="<%= PATHS[key] + siteQ %>">Réinitialiser</a><% } %>
    </form>

    <% if (!rows.length) { %>
      <div class="mk-empty"><%- icon("tag", { size: 32 }) %><h2><%= filtered ? "Aucun résultat" : key === "tag" ? "Aucun tag" : "Aucune catégorie" %></h2>
        <p><%= filtered ? "Aucune " + one + " ne correspond à ces critères." : key === "tag" ? "Aucune étiquette pour l'instant : elles se créent ici ou directement dans l'éditeur d'un article." : "Aucune catégorie pour l'instant : créez la première, puis ses sous-catégories." %></p>
        <% if (canWrite && !filtered) { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-tx-new>Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></button></div><% } %></div>
    <% } else { %>
      <% if (canDelete) { %>
      <form id="tx-bulk" class="mk-cms-bulk" action="/marketing/site-web/articles/termes/actions" method="post" data-cms-bulk data-cms-delete-text="Aucun article n'est supprimé ; les termes utilisés sont refusés." data-cms-noun="<%= one %>"><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
        <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
        <label class="sr-only" for="tx-bulk-action">Action groupée</label><select id="tx-bulk-action" name="action" disabled><option value="">Action groupée</option><option value="supprimer">Supprimer</option></select>
        <button type="submit" class="btn btn-outline btn-sm" disabled>Appliquer</button><span class="mk-sub" data-cms-bulk-count aria-live="polite"></span>
      </form>
      <% } %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table mk-tx-table">
        <caption class="sr-only"><%= def.plural %></caption>
        <thead><tr><% if (canDelete) { %><th scope="col" class="mk-cms-check-col"><input type="checkbox" data-cms-select-all aria-label="Tout sélectionner"></th><% } %><th scope="col">Nom</th><th scope="col">Description</th><% if (hier) { %><th scope="col">Parent</th><% } %><th scope="col" class="mk-num">Articles</th><th scope="col" class="mk-num">En ligne</th><th scope="col" class="mk-cms-actions-col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% rows.forEach((t) => { const used = n(t.total ?? t.n); const data = { id: t.id, name: t.name, slug: t.slug, description: t.description, parent_id: t.parent_id || "", total: used, children: hier ? n(t.withChildren) : 0 }; %>
          <tr><% if (canDelete) { %><td class="mk-cms-check-col" data-label="Sélection"><input type="checkbox" name="ids" value="<%= t.id %>" form="tx-bulk" data-cms-row aria-label="Sélectionner « <%= t.name %> »"></td><% } %>
            <th scope="row" data-label="Nom"><span class="mk-tx-name" style="padding-left:<%= (t.depth || 0) * 18 %>px"><%= (t.depth || 0) ? "↳ " : "" %><a href="<%= base %>/<%= t.slug %>" target="_blank" rel="noopener"><%= t.name %></a><span class="mk-sub"><%= base %>/<%= t.slug %></span></span></th>
            <td data-label="Description"><%= t.description ? (t.description.length > 70 ? t.description.slice(0, 70) + "…" : t.description) : "—" %></td>
            <% if (hier) { %><td data-label="Parent"><%= t.parent_name || "—" %></td><% } %>
            <td class="mk-num" data-label="Articles"><%= used %><% if (hier && n(t.withChildren) > used) { %><span class="mk-sub"><%= n(t.withChildren) %> avec sous-catégories</span><% } %></td>
            <td class="mk-num" data-label="En ligne"><%= n(t.live) %></td>
            <td class="mk-row-actions mk-cms-actions-col"><div class="mk-cms-rowbtns">
              <% if (canWrite) { %><button type="button" class="btn btn-outline btn-sm" data-tx-edit="<%= JSON.stringify(data) %>">Modifier</button><% } %>
              <% if (canDelete) { %><div class="mk-dropdown" data-mk-dropdown>
                <button type="button" class="btn btn-ghost btn-sm mk-cms-more" aria-haspopup="menu" aria-expanded="false" aria-controls="tx-menu-<%= t.id %>" aria-label="Plus d'actions pour « <%= t.name %> »"><%- icon("moreHorizontal", { size: 18 }) %></button>
                <div class="mk-menu" id="tx-menu-<%= t.id %>" role="menu" hidden>
                  <a role="menuitem" href="<%= base %>/<%= t.slug %>" target="_blank" rel="noopener">Voir la page publique</a>
                  <button type="button" role="menuitem" data-tx-merge="<%= JSON.stringify(data) %>">Fusionner avec…</button>
                  <button type="button" role="menuitem" data-tx-delete="<%= JSON.stringify(data) %>">Supprimer…</button>
                </div></div><% } %>
            </div></td></tr>
        <% }) %></tbody>
      </table></div>
      <nav class="mk-cms-pager" aria-label="Pagination">
        <span><%= plural(total, one) %></span>
        <% if (pages > 1) { %><span class="mk-cms-pager-nav">
          <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: page - 1 }) %>">Précédent</a><% } %>
          <span>Page <%= page %> sur <%= pages %></span>
          <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: page + 1 }) %>">Suivant</a><% } %></span><% } %>
      </nav>
    <% } %>

    <% if (canWrite || canDelete) { %>
      <%# Une seule fenêtre de saisie (création et modification), une de suppression, une de fusion : remplies par public/js/cms-taxonomy.js %>
      <dialog class="mk-dialog mk-modal" id="tx-form" aria-labelledby="tx-form-title">
        <form method="post" action="/marketing/site-web/articles/termes" data-tx-form><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-form-title">Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body">
            <div class="field-group"><label for="tx-name">Nom *</label><input id="tx-name" type="text" name="name" maxlength="60" required autocomplete="off"></div>
            <div class="field-group"><label for="tx-slug">Adresse</label><input id="tx-slug" type="text" name="slug" maxlength="80" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off"><span class="field-hint" data-tx-slug-hint>Vide : tirée du nom. Lettres minuscules, chiffres et tirets. Modifier le nom ne change jamais l'adresse.</span></div>
            <% if (hier) { %><div class="field-group"><label for="tx-parent">Catégorie parente</label>
              <select id="tx-parent" name="parent_id"><option value="">Aucune (premier niveau)</option><% options.forEach((o) => { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% }) %></select></div><% } %>
            <div class="field-group"><label for="tx-desc">Description</label><textarea id="tx-desc" name="description" rows="3" maxlength="500"></textarea></div>
          </div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm" data-tx-submit>Enregistrer</button></div>
        </form>
      </dialog>
      <% if (canDelete) { %>
      <dialog class="mk-dialog mk-modal" id="tx-delete" aria-labelledby="tx-delete-title">
        <form method="post" action="" data-tx-delete-form>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-delete-title">Supprimer</h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><p data-tx-delete-text></p>
            <div class="field-group" data-tx-reassign hidden><label for="tx-reassign">Réassigner ses articles à *</label>
              <select id="tx-reassign" name="reassign_to"><option value="">— choisir —</option><% (hier ? options : tagNames.map(() => null)).forEach((o) => { if (o) { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% } }) %></select>
              <% if (!hier) { %><span class="field-hint">Pour une étiquette utilisée, utilisez plutôt « Fusionner avec… » : les articles passent à l'étiquette choisie.</span><% } %></div></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-danger btn-sm" data-tx-delete-ok>Supprimer</button></div>
        </form>
      </dialog>
      <dialog class="mk-dialog mk-modal" id="tx-merge" aria-labelledby="tx-merge-title">
        <form method="post" action="" data-tx-merge-form>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-merge-title">Fusionner</h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><p data-tx-merge-text></p>
            <% if (hier) { %><div class="field-group"><label for="tx-target">Elle sera fusionnée dans *</label><select id="tx-target" name="target_id" required><option value="">— choisir —</option><% options.forEach((o) => { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% }) %></select></div>
            <% } else { %><div class="field-group"><label for="tx-target-name">Elle sera fusionnée dans *</label><input id="tx-target-name" type="text" name="target_name" list="tx-tag-names" required autocomplete="off"><datalist id="tx-tag-names"><% tagNames.forEach((nm) => { %><option value="<%= nm %>"><% }) %></datalist></div><% } %>
            <p class="field-hint">Tous les articles passent au terme choisi ; celui-ci disparaît. Rien n'est perdu.</p></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Fusionner</button></div>
        </form>
      </dialog>
      <% } %>
    <% } %>
<%- include("partials/bottom") %>
