<%#
  KOLAKISA CMS → Catégories / Étiquettes (palier 5). Les chiffres (articles) sont calculés dans la base ; aucun compteur n'est stocké.
  Création, modification, suppression avec réassignation et fusion passent par des fenêtres qui envoient de vrais formulaires.
%><%- include("partials/top", { title, active }) %>
<%
  const hier = def.hierarchical;
  const one = key === "tag" ? "étiquette" : "catégorie";
  const S = typeof mkSiteId === "number" ? mkSiteId : ""; const siteQ = S ? "?site=" + S : ""; // site courant (accès limité ou site choisi) : conservé dans tous les liens
  const SORT_COLS = /^(nom|description|slug|total)(_desc)?$/;
  const sortBase = f.tri.replace(/_desc$/, ""), sortDesc = /_desc$/.test(f.tri);
  const keep = (over = {}) => {
    const p = new URLSearchParams();
    const o = { site: S, q: f.q, inutilises: f.inutilises ? "1" : "", parent: f.parent, ...over };
    if (!("orderby" in over) && !("tri" in over)) { if (SORT_COLS.test(f.tri)) { if (f.tri !== "nom") { o.orderby = sortBase; if (sortDesc) o.order = "desc"; } } else o.tri = f.tri; }
    Object.entries(o).forEach(([k, v]) => { if (v) p.set(k, v); });
    const t = p.toString(); return PATHS[key] + (t ? "?" + t : "");
  };
  const sortLink = (col) => keep({ page: "", orderby: col, order: sortBase === col && !sortDesc ? "desc" : "" });
  const ariaSort = (col) => (sortBase === col ? (sortDesc ? "descending" : "ascending") : "none");
  const filtered = Boolean(f.q || f.inutilises || f.parent);
  const here = keep({ page: page > 1 ? page : "" });
  const n = (v) => Number(v || 0);
  const plural = (v, w) => v + " " + w + (v > 1 ? "s" : "");
  const th = (col, label, cls) => `<th scope="col" class="${cls || ""}" aria-sort="${ariaSort(col)}"><a class="mk-ar-sort" href="${sortLink(col)}">${label}<span aria-hidden="true"> ${sortBase === col ? (sortDesc ? "▾" : "▴") : "↕"}</span></a></th>`;
%>
    <div class="mk-head">
      <div class="mk-head-main"><h1><%= def.plural %></h1></div></div>

    <nav class="mk-tabs mk-cms-tabs" aria-label="Taxonomies">
      <a class="mk-tab" href="<%= PATHS.category + siteQ %>"<%- key === "category" ? ' aria-current="page"' : "" %>>Catégories</a>
      <a class="mk-tab" href="<%= PATHS.tag + siteQ %>"<%- key === "tag" ? ' aria-current="page"' : "" %>>Étiquettes</a>
    </nav>

    <div class="mk-tx-layout">
      <%# ---------- Colonne gauche : « Ajouter une catégorie » (vrai formulaire, créé sur le site courant) ---------- %>
      <% if (canWrite) { %>
      <section class="mk-tx-add" aria-labelledby="tx-add-title">
        <h2 id="tx-add-title">Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></h2>
        <form method="post" action="/marketing/site-web/articles/termes" data-tx-add><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <div class="field-group"><label for="tx-add-name">Nom</label><input id="tx-add-name" type="text" name="name" maxlength="60" required autocomplete="off"><span class="field-hint">Le nom est la façon dont il apparaît sur votre site.</span></div>
          <div class="field-group"><label for="tx-add-slug">Slug</label><input id="tx-add-slug" type="text" name="slug" maxlength="80" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off"><span class="field-hint">Le « slug » est la version du nom normalisée pour les URL. Il ne contient que des lettres minuscules, des chiffres et des tirets. Laissé vide, il est tiré du nom ; il doit être unique.</span></div>
          <% if (hier) { %><div class="field-group"><label for="tx-add-parent">Catégorie parente</label>
            <select id="tx-add-parent" name="parent_id"><option value="">Aucune</option><% options.forEach((o) => { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% }) %></select>
            <span class="field-hint">Les catégories, contrairement aux étiquettes, peuvent avoir une hiérarchie. Vous pouvez avoir une catégorie nommée Jazz et, à l'intérieur, plusieurs catégories comme Bebop et Big Band. Ceci est totalement facultatif.</span></div><% } %>
          <div class="field-group"><label for="tx-add-desc">Description</label><textarea id="tx-add-desc" name="description" rows="5" maxlength="500"></textarea><span class="field-hint">La description est du texte brut (le HTML n'est pas interprété) ; elle n'est pas affichée par défaut, mais certains thèmes peuvent l'afficher.</span></div>
          <button type="submit" class="btn btn-primary" data-tx-add-submit>Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></button>
        </form>
      </section>
      <% } %>

      <%# ---------- Colonne droite : recherche, actions groupées, tableau ---------- %>
      <section class="mk-tx-list" aria-label="<%= def.plural %> existantes">
        <form class="mk-ar-search mk-tx-search" method="get" action="<%= PATHS[key] %>" role="search" aria-label="Rechercher parmi les <%= def.plural.toLowerCase() %>"><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
          <% if (f.tri !== "nom") { %><% if (SORT_COLS.test(f.tri)) { %><input type="hidden" name="orderby" value="<%= sortBase %>"><% if (sortDesc) { %><input type="hidden" name="order" value="desc"><% } %><% } else { %><input type="hidden" name="tri" value="<%= f.tri %>"><% } %><% } %>
          <label class="sr-only" for="tx-q">Rechercher des <%= def.plural.toLowerCase() %> (nom, slug, description)</label>
          <input id="tx-q" type="search" name="q" value="<%= f.q %>">
          <button type="submit" class="btn btn-outline btn-sm">Rechercher des <%= def.plural.toLowerCase() %></button>
          <% if (filtered) { %><a class="btn btn-ghost btn-sm" href="<%= PATHS[key] + siteQ %>">Réinitialiser</a><% } %>
        </form>
        <% if (f.q) { %><p class="mk-ar-found">Résultats de recherche pour : <strong><%= f.q %></strong></p><% } %>

        <% if (!rows.length) { %>
          <div class="mk-empty"><%- icon("tag", { size: 32 }) %><h2><%= filtered ? "Aucun résultat" : key === "tag" ? "Aucun tag" : "Aucune catégorie" %></h2>
            <p><%= filtered ? "Aucune " + one + " ne correspond à ces critères." : key === "tag" ? "Aucune étiquette pour l'instant : elles se créent ici ou directement dans l'éditeur d'un article." : "Aucune catégorie pour l'instant : créez la première avec le formulaire, puis ses sous-catégories." %></p></div>
        <% } else { %>
          <form id="tx-bulk" action="/marketing/site-web/articles/termes/actions" method="post" data-tx-bulk data-cms-noun="<%= one %>"><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
            <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
            <% if (canDelete) { %><div class="mk-ar-actions">
              <label class="sr-only" for="tx-bulk-action">Actions groupées</label><select id="tx-bulk-action" name="action" disabled data-tx-bulk-select><option value="">Actions groupées</option><option value="supprimer">Supprimer</option></select>
              <button type="submit" class="btn btn-outline btn-sm" disabled data-tx-bulk-apply>Appliquer</button><span class="mk-sub" data-tx-bulk-count aria-live="polite"></span>
              <span class="mk-ar-count"><%= plural(total, "élément") %></span></div><% } else { %><div class="mk-ar-actions"><span class="mk-ar-count"><%= plural(total, "élément") %></span></div><% } %>
            <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table mk-tx-table mk-ar-table">
              <caption class="sr-only"><%= def.plural %></caption>
              <% const head = `<tr>${canDelete ? '<td class="mk-cms-check-col"><input type="checkbox" data-tx-select-all aria-label="Tout sélectionner"></td>' : ""}${th("nom", "Nom")}${th("description", "Description")}${th("slug", "Slug")}${th("total", "Total", "mk-num")}</tr>`; %>
              <thead><%- head %></thead>
              <tbody><% rows.forEach((t) => { const used = n(t.total ?? t.n); const data = { id: t.id, name: t.name, slug: t.slug, description: t.description, parent_id: t.parent_id || "", total: used, children: hier ? n(t.withChildren) : 0 }; %>
                <tr><% if (canDelete) { %><td class="mk-cms-check-col"><input type="checkbox" name="ids" value="<%= t.id %>" data-tx-row aria-label="Sélectionner « <%= t.name %> »"></td><% } %>
                  <th scope="row" data-label="Nom"><span class="mk-tx-name" style="padding-left:<%= (t.depth || 0) * 18 %>px"><strong><%= (t.depth || 0) ? "— " : "" %><a href="<%= base %>/<%= t.slug %>" target="_blank" rel="noopener"><%= t.name %></a></strong>
                    <% if (flat && t.parent_name) { %><span class="mk-sub">Parent : <%= t.parent_name %></span><% } %>
                    <span class="mk-ar-rowlinks">
                      <% if (canWrite) { %><button type="button" class="mk-ar-linkbtn" data-tx-edit="<%= JSON.stringify(data) %>">Modifier</button><% } %>
                      <% if (canDelete) { %><button type="button" class="mk-ar-linkbtn" data-tx-merge="<%= JSON.stringify(data) %>">Fusionner…</button><button type="button" class="mk-ar-linkbtn is-danger" data-tx-delete="<%= JSON.stringify(data) %>">Supprimer</button><% } %>
                      <a href="<%= base %>/<%= t.slug %>" target="_blank" rel="noopener">Afficher</a>
                    </span></span></th>
                  <td data-label="Description"><%= t.description ? (t.description.length > 120 ? t.description.slice(0, 120) + "…" : t.description) : "—" %></td>
                  <td data-label="Slug"><%= t.slug %></td>
                  <td class="mk-num" data-label="Total"><% if (used) { %><a href="/marketing/site-web/articles?<%= key === "category" ? "categorie" : "etiquette" %>=<%= t.id %><%= S ? "&site=" + S : "" %>"><%= used %></a><% } else { %>0<% } %><% if (hier && n(t.withChildren) > used) { %><span class="mk-sub"><%= n(t.withChildren) %> avec sous-catégories</span><% } %></td></tr>
              <% }) %></tbody>
              <tfoot><%- head %></tfoot>
            </table></div>
            <% if (canDelete) { %><div class="mk-ar-actions mk-ar-actions-foot">
              <div class="mk-cms-bulk"><label class="sr-only" for="tx-bulk-action2">Actions groupées (bas du tableau)</label><select id="tx-bulk-action2" disabled data-tx-bulk-mirror><option value="">Actions groupées</option></select>
              <button type="button" class="btn btn-outline btn-sm" disabled data-tx-bulk-apply2>Appliquer</button></div>
              <span class="mk-ar-count"><%= plural(total, "élément") %></span></div><% } %>
          </form>
          <nav class="mk-cms-pager" aria-label="Pagination">
            <span><%= plural(total, one) %></span>
            <% if (pages > 1) { %><span class="mk-cms-pager-nav">
              <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: page - 1 }) %>">Précédent</a><% } %>
              <span>Page <%= page %> sur <%= pages %></span>
              <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: page + 1 }) %>">Suivant</a><% } %></span><% } %>
          </nav>
        <% } %>

        <% if (key === "category") { %>
        <div class="mk-tx-notes">
          <p>Supprimer une catégorie ne supprime <strong>jamais</strong> les articles. Une catégorie utilisée par des articles ne se supprime qu'en indiquant la catégorie qui les reprend (ou en la fusionnant) ; une catégorie vide se supprime directement. Ses sous-catégories remontent alors d'un niveau.</p>
          <p>Kolakisa n'impose pas de catégorie par défaut : un article peut n'avoir aucune catégorie. Le « Total » compte les articles existants (brouillons, programmés et publiés), pas ceux de la corbeille ; la liste des articles du site peut être filtrée par catégorie.</p>
        </div>
        <% } else { %>
        <div class="mk-tx-notes">
          <p>Supprimer une étiquette ne supprime <strong>jamais</strong> les articles : elle est simplement retirée des articles qui la portaient. « Fusionner… » garde le classement : les articles passent à l'étiquette choisie.</p>
          <p>Le « Total » compte les articles existants (brouillons, programmés et publiés), pas ceux de la corbeille. Les étiquettes, contrairement aux catégories, n'ont pas de hiérarchie. Chaque site a ses propres étiquettes.</p>
        </div>
        <% } %>
      </section>
    </div>

    <% if (canWrite || canDelete) { %>
      <%# Une seule fenêtre de saisie (création et modification), une de suppression, une de fusion : remplies par public/js/cms-taxonomy.js %>
      <dialog class="mk-dialog mk-modal" id="tx-form" aria-labelledby="tx-form-title">
        <form method="post" action="/marketing/site-web/articles/termes" data-tx-form><%- typeof mkSiteField === "string" ? mkSiteField : "" %>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-form-title">Ajouter <%= key === "tag" ? "une étiquette" : "une catégorie" %></h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body">
            <div class="field-group"><label for="tx-name">Nom *</label><input id="tx-name" type="text" name="name" maxlength="60" required autocomplete="off"></div>
            <div class="field-group"><label for="tx-slug">Adresse</label><input id="tx-slug" type="text" name="slug" maxlength="80" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off"><span class="field-hint" data-tx-slug-hint>Vide : tirée du nom. Lettres minuscules, chiffres et tirets. Modifier le nom ne change jamais l'adresse.</span></div>
            <% if (hier) { %><div class="field-group"><label for="tx-parent">Catégorie parente</label>
              <select id="tx-parent" name="parent_id"><option value="">Aucune (premier niveau)</option><% options.forEach((o) => { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% }) %></select></div><% } %>
            <div class="field-group"><label for="tx-desc">Description</label><textarea id="tx-desc" name="description" rows="3" maxlength="500"></textarea></div>
          </div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm" data-tx-submit>Enregistrer</button></div>
        </form>
      </dialog>
      <% if (canDelete) { %>
      <dialog class="mk-dialog mk-modal" id="tx-delete" aria-labelledby="tx-delete-title">
        <form method="post" action="" data-tx-delete-form>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-delete-title">Supprimer</h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><p data-tx-delete-text></p>
            <div class="field-group" data-tx-reassign hidden><label for="tx-reassign">Réassigner ses articles à *</label>
              <select id="tx-reassign" name="reassign_to"><option value="">— choisir —</option><% (hier ? options : tagNames.map(() => null)).forEach((o) => { if (o) { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% } }) %></select>
              <% if (!hier) { %><span class="field-hint">Pour une étiquette utilisée, utilisez plutôt « Fusionner avec… » : les articles passent à l'étiquette choisie.</span><% } %></div></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-danger btn-sm" data-tx-delete-ok>Supprimer</button></div>
        </form>
      </dialog>
      <dialog class="mk-dialog mk-modal" id="tx-merge" aria-labelledby="tx-merge-title">
        <form method="post" action="" data-tx-merge-form>
          <input type="hidden" name="taxonomy" value="<%= key %>"><input type="hidden" name="retour" value="<%= here %>">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="tx-merge-title">Fusionner</h2></div><button type="button" class="mk-dialog-close" data-tx-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><p data-tx-merge-text></p>
            <% if (hier) { %><div class="field-group"><label for="tx-target">Elle sera fusionnée dans *</label><select id="tx-target" name="target_id" required><option value="">— choisir —</option><% options.forEach((o) => { %><option value="<%= o.id %>"><%= "— ".repeat(o.depth) %><%= o.name %></option><% }) %></select></div>
            <% } else { %><div class="field-group"><label for="tx-target-name">Elle sera fusionnée dans *</label><input id="tx-target-name" type="text" name="target_name" list="tx-tag-names" required autocomplete="off"><datalist id="tx-tag-names"><% tagNames.forEach((nm) => { %><option value="<%= nm %>"><% }) %></datalist></div><% } %>
            <p class="field-hint">Tous les articles passent au terme choisi ; celui-ci disparaît. Rien n'est perdu.</p></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-tx-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Fusionner</button></div>
        </form>
      </dialog>
      <% } %>
    <% } %>
<%- include("partials/bottom") %>
