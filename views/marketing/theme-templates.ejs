<%- include("partials/top", { title, active }) %>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Modèles de thème</h1><p class="mk-head-sub">Choisissez une page du Page Builder comme modèle d'une famille de pages du site : l'article du blog, la liste du blog ou la page introuvable. Vous pouvez limiter un modèle à une catégorie ou à un public. Sans modèle <strong>en ligne</strong>, le site garde son affichage d'origine : un modèle ne peut pas casser le blog.</p></div></div>
    <% if (!templates.length) { %>
      <div class="mk-empty"><%- illu("layout", { className: "kx-empty-ill" }) %><h2>Aucun modèle</h2><p>Le blog et la page introuvable utilisent leur affichage d'origine. Ajoutez un modèle ci-dessous.</p></div>
    <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable">
        <caption class="sr-only">Modèles de thème</caption>
        <thead><tr><th scope="col">Famille de pages</th><th scope="col">Page modèle</th><th scope="col">Catégorie</th><th scope="col">Public</th><th scope="col">Exclusions</th><th scope="col">Modifié</th><th scope="col">État</th><% if (canWrite) { %><th scope="col"><span class="sr-only">Actions</span></th><% } %></tr></thead>
        <tbody><% templates.forEach((t) => { %>
          <tr>
            <th scope="row" data-label="Famille"><%= t.typeLabel %></th>
            <td data-label="Page"><% if (t.pageStatus === "missing") { %><%= t.pageName %><% } else { %><a href="/marketing/pages/<%= t.pageId %>/editeur"><%= t.pageName %></a><% } %></td>
            <td data-label="Catégorie"><%= t.category || "Toutes" %></td>
            <td data-label="Public"><%= t.audienceLabel || "Tout le monde" %></td>
            <td data-label="Exclusions"><%= t.exclude ? [].concat((t.exclude.category || []).map((c) => "catégorie " + c), (t.exclude.tag || []).map((c) => "étiquette " + c), (t.exclude.postId || []).map((c) => "article " + c)).join(", ") : "Aucune" %></td>
            <td data-label="Modifié"><%= t.updatedAt ? new Date(t.updatedAt).toLocaleDateString("fr-FR") : "—" %></td>
            <td data-label="État"><%= t.pageStatus === "published" ? "Actif (page en ligne)" : t.pageStatus === "missing" ? "Page supprimée" : "Inactif : publiez la page" %></td>
            <% if (canWrite) { %><td data-label="Actions"><details><summary class="btn btn-ghost btn-sm">Modifier</summary>
              <form action="/marketing/site-web/modeles-de-theme/<%= t.id %>/modifier" method="post" class="mk-form">
                <input type="hidden" name="page_id" value="<%= t.pageId %>">
                <label for="tt-ed-cat-<%= t.id %>">Catégorie</label><input id="tt-ed-cat-<%= t.id %>" name="category" maxlength="80" value="<%= t.category || "" %>">
                <label for="tt-ed-xc-<%= t.id %>">Catégories exclues (séparées par des virgules)</label><input id="tt-ed-xc-<%= t.id %>" name="exclude_category" maxlength="400" value="<%= ((t.exclude || {}).category || []).join(", ") %>">
                <label for="tt-ed-xt-<%= t.id %>">Étiquettes exclues</label><input id="tt-ed-xt-<%= t.id %>" name="exclude_tag" maxlength="400" value="<%= ((t.exclude || {}).tag || []).join(", ") %>">
                <button type="submit" class="btn btn-primary btn-sm">Enregistrer les conditions</button>
              </form></details>
              <form action="/marketing/site-web/modeles-de-theme/<%= t.id %>/supprimer" method="post"><button type="submit" class="btn btn-ghost btn-sm" aria-label="Retirer ce modèle">Retirer</button></form></td><% } %>
          </tr>
        <% }) %></tbody>
      </table></div>
    <% } %>
    <section class="mk-panel" aria-labelledby="tt-why"><h2 id="tt-why">Pourquoi ce modèle ?</h2>
      <p class="field-hint">Choisissez une famille de pages et, si besoin, une catégorie ou une étiquette : l'écran indique quel modèle le site utilise et pourquoi les autres ne sont pas utilisés. Rien n'est modifié.</p>
      <form action="/marketing/site-web/modeles-de-theme" method="get" class="mk-form">
        <label for="tt-why-type">Famille de pages</label>
        <select id="tt-why-type" name="why_type"><% Object.entries(types).forEach(([key, t]) => { %><option value="<%= key %>"<%= whyQuery.type === key ? " selected" : "" %>><%= t.label %></option><% }) %></select>
        <label for="tt-why-cat">Catégorie (facultative)</label><input id="tt-why-cat" name="why_category" maxlength="80" value="<%= whyQuery.category %>">
        <label for="tt-why-tag">Étiquette (facultative)</label><input id="tt-why-tag" name="why_tag" maxlength="80" value="<%= whyQuery.tag %>">
        <div class="mk-actions"><button type="submit" class="btn btn-ghost btn-sm">Expliquer</button></div>
      </form>
      <% if (why && why.error) { %><p class="mk-flash mk-flash-error" role="alert"><%= why.error %></p>
      <% } else if (why) { %>
        <div data-why role="status">
          <p><strong><%= why.winner ? "Modèle utilisé : « " + why.winner.pageName + " »" : "Aucun modèle utilisé" %></strong><%= why.fallback ? " : " + why.fallback : "" %></p>
          <% if (why.candidates.length) { %><ul class="mk-cms-list"><% why.candidates.forEach((c) => { %><li><span><strong><%= c.pageName %></strong> (<%= c.conditions.category || c.conditions.tag || c.conditions.audience || (c.conditions.postId ? "article " + c.conditions.postId : "général") %>) : <%= c.applied ? "utilisé. " : "non utilisé. " %><%= c.reason %></span></li><% }) %></ul>
          <% } else { %><p class="field-hint">Aucun modèle n'est affecté à cette famille de pages.</p><% } %>
          <p class="field-hint">Le public du visiteur n'est pas simulé ici : un modèle réservé à un public est compté comme s'il convenait.</p>
        </div>
      <% } %>
    </section>
    <% if (canWrite) { %>
      <section class="mk-panel" aria-labelledby="tt-add"><h2 id="tt-add">Ajouter un modèle</h2>
        <form action="/marketing/site-web/modeles-de-theme" method="post" class="mk-form">
          <label for="tt-type">Famille de pages</label>
          <select id="tt-type" name="type" required><% Object.entries(types).forEach(([key, t]) => { %><option value="<%= key %>"><%= t.label %></option><% }) %></select>
          <ul class="mk-cms-list"><% Object.values(types).forEach((t) => { %><li><span><strong><%= t.label %></strong> : <%= t.hint %></span></li><% }) %></ul>
          <label for="tt-page">Page modèle</label>
          <select id="tt-page" name="page_id" required><option value="">Choisir une page…</option><% pageChoices.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %><%= p.status === "published" ? "" : " (brouillon : à publier)" %></option><% }) %></select>
          <label for="tt-cat">Catégorie (facultative, articles seulement)</label>
          <input id="tt-cat" name="category" maxlength="80" list="tt-cats" placeholder="Toutes les catégories">
          <datalist id="tt-cats"><% categories.forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
          <label for="tt-xcat">Catégories exclues (facultatif, séparées par des virgules)</label>
          <input id="tt-xcat" name="exclude_category" maxlength="400" placeholder="Le modèle ne s'applique pas à ces catégories">
          <label for="tt-xtag">Étiquettes exclues (facultatif)</label>
          <input id="tt-xtag" name="exclude_tag" maxlength="400">
          <label for="tt-aud">Public</label>
          <select id="tt-aud" name="audience"><option value="">Tout le monde</option><% Object.entries(audiences).filter(([k]) => k !== "tag" && k !== "not_tag" && k !== "score_min").forEach(([k, label]) => { %><option value="<%= k %>"><%= label %></option><% }) %></select>
          <div class="mk-actions"><button type="submit" class="btn btn-primary btn-sm">Ajouter le modèle</button></div>
        </form>
      </section>
    <% } %>
<%- include("partials/bottom") %>
