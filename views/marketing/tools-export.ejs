<%- include("partials/top", { title, active }) %>
<%- include("partials/tools-head", { heading: "Exporter", intro: "Un fichier JSON structuré (format kolakisa-site@1), réimportable dans un autre site : les liens entre contenus sont gardés par références. Jamais de mot de passe, d'e-mail de compte ni de clé secrète. Les fichiers médias ne sont pas inclus : seuls leurs chemins et leurs métadonnées le sont.", tab, TABS, BASE, sites, siteId, q, siteOnly }) %>
<%
  const fdate = (v) => (v ? new Date(String(v).replace(" ", "T") + "Z").toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Paris" }) : "");
  const scopeLabel = { site: siteId ? "ce site" : "site principal", org: "organisation" };
%>
<section class="mk-panel" aria-labelledby="tl-x">
  <h2 id="tl-x">Que faut-il exporter ?</h2>
  <form method="post" action="<%= BASE %>/exporter<%= q %>" class="mk-tl-form">
    <fieldset class="mk-tl-fieldset"><legend>Ressources</legend>
      <% types.forEach((t) => { %>
        <div class="mk-tl-option">
          <input type="checkbox" id="tl-t-<%= t.key %>" name="types" value="<%= t.key %>"<%= t.allowed ? " checked" : " disabled" %>>
          <label for="tl-t-<%= t.key %>"><%= t.label %><% if (t.allowed) { %> <span class="mk-sub">(<%= t.count %> · <%= scopeLabel[t.scope] %>)</span><% } else { %> <span class="mk-sub">— indisponible pour ce site ou pour votre rôle</span><% } %></label>
        </div>
      <% }) %>
    </fieldset>
    <p class="mk-sub">Seul ce qui concerne le site choisi ci-dessus est exporté ; le contenu partagé de l'organisation (articles, catégories, médias) n'est proposé qu'à l'équipe de l'organisation. Les commentaires ne contiennent ni e-mail ni adresse IP et ne peuvent pas être réimportés.</p>
    <button type="submit" class="btn btn-primary btn-sm"><%- icon("download", { size: 16 }) %> Lancer l'export</button>
  </form>
</section>
<% if (recent.length) { %>
<section class="mk-panel" aria-labelledby="tl-xr"><h2 id="tl-xr">Exports récents</h2>
  <ul class="mk-tl-list"><% recent.forEach((r) => { %><li><a href="<%= BASE %>/exporter/<%= r.id %><%= r.site_id ? "?site=" + r.site_id : "" %>">Export du <%= fdate(r.created_at) %></a> — <%= { queued: "en attente", running: "en cours", done: r.hasResult ? "terminé" : "terminé (fichier expiré)", failed: "échec", cancelled: "annulé" }[r.status] %></li><% }) %></ul>
</section>
<% } %>
<%- include("partials/bottom") %>
