<%- include("partials/top", { title, active }) %>
<% const showCost = (mk.ctx.siteScope === undefined); /* R7 lot 6.1 : prix, coûts et réglages du fournisseur : équipe seulement */ %>
<%
  const money = (v) => v === null ? "—" : v.toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " " + (c.currency || "");
  const when = (ms) => ms ? new Date(ms).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" }) : "—";
  const STATUS_LABEL = { queued: "En attente", sending: "En cours", sent: "Envoyé", delivered: "Livré", undelivered: "Non livré", failed: "Échec", skipped: "Non envoyé" };
%>
    <p class="mk-back"><a href="/marketing/sms">← Campagnes SMS</a></p>
    <div class="mk-head"><h1><%= c.name %></h1><span class="badge <%= st[1] %>"><%= st[0] %></span></div>
    <p class="mk-lead"><%= targetLabel %> · expéditeur <strong><%= c.sender %></strong><% if (c.started_at) { %> · commencée le <%= when(c.started_at) %><% } else if (c.scheduled_at) { %> · programmée le <%= when(c.scheduled_at) %><% } %><% if (c.finished_at) { %> · terminée le <%= when(c.finished_at) %><% } %></p>
    <% if (c.error) { %><p class="mk-note"><strong>En pause :</strong> <%= c.error %></p><% } %>
    <% if (["scheduled", "sending", "paused"].includes(c.status)) { %>
      <%- include("partials/worker-note", { workerOn, consequence: "les SMS restants ne partiront pas tant qu'il n'est pas rétabli" }) %>
      <% if (report.queued) { %><p class="field-hint"><%= mkh.fmt(report.queued) %> SMS encore en attente<%= report.nextAttemptAt && report.nextAttemptAt > Date.now() ? " (prochain départ vers " + when(report.nextAttemptAt) + ", heures de silence ou plafond)" : "" %>.</p><% } %>
    <% } %>

    <div class="mk-stats">
      <div class="mk-stat"><span class="mk-stat-label">Destinataires</span><span class="mk-stat-value"><%= mkh.fmt(c.total_recipients) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.sent_count) %> envoyé(s)</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Livrés</span><span class="mk-stat-value"><%= report.rates.delivery %> %</span><span class="mk-stat-hint"><%= mkh.fmt(c.delivered_count) %> confirmé(s) par l'opérateur</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Clics</span><span class="mk-stat-value"><%= report.rates.click %> %</span><span class="mk-stat-hint"><%= mkh.fmt(c.click_count) %> personne(s)</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Désinscriptions</span><span class="mk-stat-value"><%= report.rates.unsubscribe %> %</span><span class="mk-stat-hint"><%= mkh.fmt(c.unsubscribe_count) %> personne(s)</span></div>
      <div class="mk-stat"><span class="mk-stat-label">SMS facturés</span><span class="mk-stat-value"><%= mkh.fmt(c.segments_count) %></span><span class="mk-stat-hint"><%= showCost ? "coût estimé : " + money(report.cost) : "" %></span></div>
      <div class="mk-stat"><span class="mk-stat-label">Non livrés / échecs</span><span class="mk-stat-value"><%= mkh.fmt(c.undelivered_count + c.failed_count) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.skipped_count) %> non envoyé(s)</span></div>
    </div>
    <p class="field-hint">« Livrés » dépend des accusés de réception des opérateurs (Twilio) : certains réseaux ne les renvoient pas, le chiffre réel peut être plus élevé.</p>

    <% if (canSend && ["scheduled", "sending", "paused"].includes(c.status)) { %>
      <div class="mk-actions">
        <% if (c.status === "paused") { %><form action="/marketing/sms/campagnes/<%= c.id %>/reprendre" method="post"><button type="submit" class="btn btn-primary btn-sm">Reprendre</button></form>
        <% } else { %><form action="/marketing/sms/campagnes/<%= c.id %>/pause" method="post"><button type="submit" class="btn btn-outline btn-sm">Mettre en pause</button></form><% } %>
        <form action="/marketing/sms/campagnes/<%= c.id %>/annuler" method="post"><button type="submit" class="btn btn-outline btn-sm" data-mk-confirm="Les SMS qui ne sont pas encore partis ne le seront pas. Ceux déjà envoyés ne peuvent pas être rappelés." data-mk-confirm-title="Annuler cette campagne ?" data-mk-confirm-ok="Annuler la campagne">Annuler la campagne</button></form>
      </div>
    <% } %>

    <div class="mk-grid-2">
      <section class="mk-panel">
        <h2>Message envoyé</h2>
        <div class="mk-sms-phone mk-sms-phone-small"><div class="mk-sms-thread"><p class="mk-sms-bubble"><%= c.body %>
STOP SMS : (lien personnel)</p></div></div>
      </section>
      <section class="mk-panel">
        <h2>Liens</h2>
        <% if (!report.links.length) { %><p class="field-hint">Aucun lien suivi dans ce message.</p>
        <% } else { %><ul class="mk-status-list"><% report.links.forEach((l) => { %><li><span class="mk-url"><%= l.url %></span> — <strong><%= mkh.fmt(l.click_count) %></strong> clic(s)</li><% }) %></ul><% } %>
        <% if (reasons.length) { %>
          <h3>Pourquoi certains SMS ne sont pas arrivés</h3>
          <ul class="mk-status-list"><% reasons.forEach((r) => { %><li><%= r.label %> : <strong><%= mkh.fmt(r.n) %></strong></li><% }) %></ul>
        <% } %>
      </section>
    </div>

    <section class="mk-panel">
      <h2>Destinataires <span class="mk-count"><%= mkh.fmt(recipients.length) %></span></h2>
      <% if (!recipients.length) { %><p class="field-hint">Aucun destinataire.</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table">
          <caption class="sr-only">Destinataires de la campagne</caption>
          <thead><tr><th scope="col">Contact</th><th scope="col">Numéro</th><th scope="col">Statut</th><th scope="col" class="mk-num">SMS facturés</th><th scope="col">Activité</th></tr></thead>
          <tbody><% recipients.forEach((r) => { %>
            <tr><td data-label="Contact"><% if (r.email) { %><a href="/marketing/contacts/<%= r.contact_id %>"><%= mkh.fullName(r) || r.email %></a><% } else { %>(contact supprimé)<% } %></td>
              <td data-label="Numéro"><%= r.masked %></td>
              <td data-label="Statut"><%= STATUS_LABEL[r.status] %><% if (r.why) { %><span class="mk-sub"><%= r.why %></span><% } %></td>
              <td class="mk-num" data-label="SMS facturés"><%= r.segments || "—" %></td>
              <td data-label="Activité"><%= [r.clicked_at ? "a cliqué" : "", r.unsubscribed_at ? "s'est désinscrit" : ""].filter(Boolean).join(" · ") || "—" %></td></tr>
          <% }) %></tbody>
        </table></div>
      <% } %>
    </section>

    <% if (canWrite) { %><div class="mk-actions"><form action="/marketing/sms/campagnes/<%= c.id %>/dupliquer" method="post"><button type="submit" class="btn btn-outline btn-sm">Dupliquer</button></form>
      <% if (c.status === "cancelled") { %><form action="/marketing/sms/campagnes/<%= c.id %>/supprimer" method="post"><button type="submit" class="btn btn-outline btn-sm" data-mk-confirm="La campagne annulée et ses chiffres seront supprimés." data-mk-confirm-title="Supprimer ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form><% } %></div><% } %>
<%- include("partials/bottom") %>
