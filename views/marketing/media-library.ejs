<%#
  KOLAKISA CMS → Médias → Médiathèque : gestionnaire de fichiers (barre latérale · zone centrale · panneau d'informations).
  Le serveur rend la liste (filtrée, triée, paginée dans la base) ; public/js/media-explorer.js ajoute la navigation fluide, les modes d'affichage, la sélection,
  le glisser-déposer, les menus contextuels, le panneau d'informations et la prévisualisation. Une médiathèque distincte par site.
%><%- include("partials/top", { title, active }) %>
<link rel="stylesheet" href="<%= asset('/css/media-explorer.css') %>">
<%
  const depthOf = (fo) => { let d = 0, cur = fo; while (cur && cur.parentId && d < 9) { cur = tree.folders.find((x) => x.id === cur.parentId); d++; } return d; };
  const ordered = []; const walk = (pid) => tree.folders.filter((x) => (x.parentId || null) === pid).forEach((x) => { ordered.push(x); walk(x.id); }); walk(null);
  const colsClass = prefs.columns.map((c) => "has-c-" + c).join(" ");
%>
<div class="mx <%= colsClass %>" data-mx data-sidebar="<%= prefs.sidebar %>" data-info="<%= prefs.info %>" data-view="<%= view %>" data-density="<%= prefs.density %>" style="--mx-size: <%= prefs.size %>px; --mx-info-w: <%= prefs.infoWidth %>px">
  <aside class="mx-side" id="mx-side" aria-label="Navigation de la médiathèque" data-mx-side><div class="mx-side-scroll" data-frag="side"><%- include("media/_side") %></div></aside>
  <div class="mx-main">
    <div data-frag="head"><%- include("media/_head") %></div>
    <div class="mx-stage" data-mx-main data-ml-main>
      <div class="mx-scroll" data-mx-scroll tabindex="-1"><div data-frag="body"><%- include("media/_body") %></div></div>
      <div class="mx-dropveil" data-mx-dropveil hidden aria-hidden="true"><%- icon("upload", { size: 28 }) %><strong>Déposez les fichiers pour les téléverser</strong><span data-mx-dropveil-dest></span></div>
    </div>
  </div>
  <div class="mx-resizer" data-mx-resizer role="separator" aria-orientation="vertical" aria-label="Largeur du panneau d'informations (flèches gauche et droite)" tabindex="0"></div>
  <aside class="mx-info" id="mx-info" data-ml-panel hidden aria-label="Informations" tabindex="-1"><button type="button" class="mx-iconbtn is-small mx-info-close" data-mx-info-close aria-label="Fermer le panneau d'informations" title="Fermer"><%- icon("close", { size: 16 }) %></button><div class="mx-info-body" data-mx-info-body></div></aside>
</div>

<% if (canUpload && !f.trashed) { %>
<div class="mx-import mk-ml-upload" id="ml-upload" <%= uploadOpen ? "" : "hidden" %> role="dialog" aria-modal="false" aria-labelledby="mx-import-title" data-mx-import>
  <header class="mx-import-head"><h2 id="mx-import-title">Importer des fichiers</h2>
    <button type="button" class="mx-iconbtn is-small" data-mx-import-min aria-label="Réduire la fenêtre d'importation" title="Réduire"><%- icon("minus", { size: 16 }) %></button>
    <button type="button" class="mx-iconbtn is-small" data-mx-import-close aria-label="Fermer la fenêtre d'importation" title="Fermer"><%- icon("close", { size: 16 }) %></button></header>
  <div class="mx-import-body">
    <div class="mx-import-opts">
      <label>Dossier de destination
        <select data-mx-import-dest aria-label="Dossier de destination"><option value="">Sans dossier (racine)</option><% ordered.forEach((fo) => { %><option value="<%= fo.id %>"<%= f.adv.folder === fo.id ? " selected" : "" %>><%= "  ".repeat(depthOf(fo)) + fo.name %></option><% }) %></select></label>
      <fieldset class="mx-conflict"><legend>Si un fichier du même nom existe déjà</legend>
        <label><input type="radio" name="mx-conflict" value="both" checked> Garder les deux (renommer)</label>
        <label><input type="radio" name="mx-conflict" value="skip"> Ignorer ce fichier</label>
        <label><input type="radio" name="mx-conflict" value="replace"> Importer quand même</label></fieldset>
    </div>
    <div class="mk-ml-drop" data-ml-drop tabindex="0" role="button" aria-label="Glissez-déposez vos fichiers ici, ou appuyez sur Entrée pour les choisir">
      <%- icon("upload", { size: 22 }) %><strong>Déposez les fichiers pour les téléverser</strong><span>ou cliquez pour les choisir · <%= formats %></span>
      <span class="mk-sub">Poids maximal : image <%= maxMb.image %> Mo · document <%= maxMb.document %> Mo · audio <%= maxMb.audio %> Mo · vidéo <%= maxMb.video %> Mo</span>
    </div>
    <div class="mx-import-more"><button type="button" class="btn btn-outline btn-sm" data-mx-import-folder><%- icon("folderPlus", { size: 16 }) %> Importer un dossier</button><span class="mk-sub">Les sous-dossiers sont recréés dans la médiathèque (navigateurs compatibles).</span></div>
    <input type="file" class="sr-only" data-ml-input multiple tabindex="-1" aria-label="Choisir des fichiers à envoyer" accept="<%= uploadCfg.accept %>">
    <input type="file" class="sr-only" data-mx-folder-input webkitdirectory tabindex="-1" aria-label="Choisir un dossier à envoyer">
    <div class="mk-ml-summary" data-ml-summary role="status" aria-live="polite" hidden></div>
    <ul class="mk-ml-queue" data-ml-queue aria-live="polite" aria-label="Envois en cours" hidden></ul>
  </div>
</div>
<% } %>
<script type="application/json" id="mu-config"><%- JSON.stringify(uploadCfg).replace(/</g, "\\u003c") %></script>
<script type="application/json" id="ml-config"><%- JSON.stringify({ canUpload, canWrite, canDelete, trashed: f.trashed, type: f.type, hasFilter: filtered, folder: f.adv.folder || null, folderEnabled: tree.enabled, scoped, view, section, pageKey, pageTitle, uploadOpen, prefs, retention, spaceBase, folders: tree.folders.map((x) => ({ id: x.id, parentId: x.parentId || null, name: x.name, color: x.color || "", description: x.description || "", count: x.count, starred: Boolean(x.starred) })), colors: ["bleu", "vert", "orange", "rouge", "violet", "jaune", "rose", "gris"], total: found.total, nextUrl: found.page < found.pages ? h.keep({ page: found.page + 1 }) : "" }).replace(/</g, "\\u003c") %></script>
<%- include("partials/bottom") %>
