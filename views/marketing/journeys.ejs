<%- include("partials/top", { title, active }) %>
<% const canWrite = mk.can("automations.write"); const kindLabel = { marketing: "Marketing · abonnés uniquement", transactional: "Transactionnel · tous les élèves concernés" }; %>
    <p class="mk-back"><a href="/marketing/automatisations">← Automatisations</a></p>
    <div class="mk-head"><h1>Parcours tout prêts</h1></div>
    <p class="mk-lead">Des parcours complets — déclencheur, délais, conditions et e-mails déjà rédigés — reliés aux événements réels de KOLAKISA. « Utiliser ce parcours » le crée <strong>en brouillon</strong> : vous relisez les e-mails, ajustez si besoin, puis l'activez. Rien n'est envoyé avant.</p>

    <nav class="mk-tabs" aria-label="Catégories de parcours">
      <% groups.forEach((g) => { %><a class="mk-tab" href="#g-<%= g.key %>"><%= g.label %> <span class="mk-tab-count"><%= g.items.length %></span></a>
      <% }) %>
    </nav>

    <% groups.forEach((g) => { %>
      <section class="mk-lib-section" id="g-<%= g.key %>" aria-labelledby="h-<%= g.key %>">
        <h2 id="h-<%= g.key %>" class="mk-h2"><%= g.label %></h2>
        <div class="mk-lib-grid">
          <% g.items.forEach((j) => { %>
            <article class="mk-lib-card<%= j.unavailable ? " mk-journey-off" : "" %>">
              <div class="mk-lib-body">
                <h3><%= j.label %></h3>
                <p class="field-hint"><%= j.objective %></p>
                <% if (j.unavailable) { %>
                  <p class="mk-lib-meta"><span class="mk-status mk-status-warn">Pas encore disponible</span></p>
                  <p class="mk-journey-reason"><%= j.unavailable %></p>
                <% } else { %>
                  <p class="mk-lib-meta"><span class="mk-status <%= j.kind === "transactional" ? "mk-status-info" : "" %>"><%= kindLabel[j.kind] %></span></p>
                  <p class="mk-journey-trigger"><%- icon("zap", { size: 14 }) %> <%= j.trigger.label %><%= j.trigger.filter ? ` (« ${j.trigger.filter.value} »)` : "" %></p>
                  <p class="field-hint"><% if (j.sms.length) { %><%= j.sms.length %> SMS<% } else { %><%= j.emailCount %> e-mail<%= j.emailCount > 1 ? "s" : "" %><% } %> · <%= j.stepCount %> étapes</p>
                  <div class="mk-lib-form">
                    <a class="btn btn-outline btn-sm" href="/marketing/automatisations/parcours/<%= j.key %>">Aperçu<span class="sr-only"> du parcours « <%= j.label %> »</span></a>
                    <% if (canWrite) { %><form action="/marketing/automatisations/parcours/<%= j.key %>" method="post"><button type="submit" class="btn btn-primary btn-sm">Utiliser ce parcours<span class="sr-only"> « <%= j.label %> »</span></button></form><% } %>
                  </div>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>
<%- include("partials/bottom") %>
