<%#
  KOLAKISA CMS → Apparence → Widgets : éditeur des zones de widgets du site (T). Les données (zones, blocs, mise en page enregistrée, version) sont dans le bloc JSON ci-dessous ;
  public/js/cms-widgets.js construit l'éditeur. Les enregistrements passent par le serveur (POST /enregistrer) qui valide tout et refuse une version périmée.
%><%- include("partials/top", { title, active }) %>
<link rel="stylesheet" href="<%= asset('/css/widgets.css') %>">
<div class="mk-wd" data-wd-root>
  <header class="mk-wd-bar" role="toolbar" aria-label="Barre d'outils des widgets">
    <h1 class="mk-wd-title">Widgets</h1>
    <div class="mk-wd-tools">
      <button type="button" class="mk-wd-btn mk-wd-btn--primary mk-wd-icon" data-wd-inserter aria-label="Ajouter un bloc" aria-pressed="false" title="Ajouter un bloc"<%- canEdit ? "" : " disabled" %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
      <button type="button" class="mk-wd-btn mk-wd-icon" data-wd-undo aria-label="Annuler" title="Annuler (Ctrl+Z)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3"/></svg></button>
      <button type="button" class="mk-wd-btn mk-wd-icon" data-wd-redo aria-label="Rétablir" title="Rétablir (Ctrl+Maj+Z)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5M20 9H10a6 6 0 0 0 0 12h3"/></svg></button>
      <button type="button" class="mk-wd-btn mk-wd-icon" data-wd-structure aria-label="Structure des blocs" title="Structure des blocs" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M8 12h12M12 18h8"/></svg></button>
    </div>
    <p class="mk-wd-state" data-wd-state role="status" aria-live="polite"></p>
    <div class="mk-wd-actions">
      <button type="button" class="mk-wd-btn mk-wd-btn--primary" data-wd-save disabled><span data-wd-save-label>Enregistrer</span></button>
      <button type="button" class="mk-wd-btn mk-wd-icon" data-wd-panel-toggle aria-label="Afficher ou masquer le panneau" title="Panneau latéral" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg></button>
      <div class="mk-wd-more">
        <button type="button" class="mk-wd-btn mk-wd-icon" data-wd-more aria-haspopup="menu" aria-expanded="false" aria-label="Plus d'actions" title="Plus d'actions"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/></svg></button>
        <div class="mk-wd-menu" role="menu" data-wd-more-menu hidden>
          <button type="button" role="menuitem" data-wd-act="collapse-all">Replier toutes les zones</button>
          <button type="button" role="menuitem" data-wd-act="expand-all">Déplier toutes les zones</button>
          <button type="button" role="menuitem" data-wd-act="reload">Annuler les modifications non enregistrées</button>
          <a role="menuitem" data-wd-menus-link href="#">Gérer les menus</a>
        </div>
      </div>
    </div>
  </header>
  <p class="mk-wd-site">Site : <strong><%= T.name %></strong> · chaque site a ses propres zones, blocs et widgets désactivés.<% if (readOnly) { %> Ce site est archivé ou supprimé : consultation seule.<% } else if (!canEdit) { %> Vous pouvez consulter les widgets ; l'enregistrement demande le droit « publier l'apparence ».<% } %></p>
  <div class="mk-wd-banner" data-wd-banner role="alert" hidden></div>

  <div class="mk-wd-body">
    <main class="mk-wd-canvas" id="mk-wd-canvas" data-wd-canvas tabindex="-1" aria-label="Zones de widgets"><p class="mk-wd-loading" data-wd-loading>Chargement de l'éditeur…</p></main>
    <aside class="mk-wd-panel" data-wd-panel aria-label="Panneau latéral">
      <div class="mk-wd-tabs" role="tablist">
        <button type="button" role="tab" id="wd-tab-blocks" aria-controls="wd-pane-blocks" aria-selected="true" data-wd-tab="blocks">Blocs</button>
        <button type="button" role="tab" id="wd-tab-settings" aria-controls="wd-pane-settings" aria-selected="false" data-wd-tab="settings" tabindex="-1">Réglages</button>
        <button type="button" role="tab" id="wd-tab-structure" aria-controls="wd-pane-structure" aria-selected="false" data-wd-tab="structure" tabindex="-1">Structure</button>
      </div>
      <div class="mk-wd-pane" id="wd-pane-blocks" role="tabpanel" aria-labelledby="wd-tab-blocks" data-wd-pane="blocks"></div>
      <div class="mk-wd-pane" id="wd-pane-settings" role="tabpanel" aria-labelledby="wd-tab-settings" data-wd-pane="settings" hidden></div>
      <div class="mk-wd-pane" id="wd-pane-structure" role="tabpanel" aria-labelledby="wd-tab-structure" data-wd-pane="structure" hidden></div>
    </aside>
  </div>
  <noscript><p class="mk-wd-banner">L'éditeur de widgets a besoin de JavaScript.</p></noscript>
  <script type="application/json" id="wd-data"><%- dataJson %></script>
</div>
<%- include("partials/bottom") %>
