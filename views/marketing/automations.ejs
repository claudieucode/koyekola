<%- include("partials/top", { title, active }) %>
<%
  const canWrite = mk.can("automations.write");
%>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Automatisations</h1><p class="mk-head-sub">Un scénario réagit à un événement (compte créé, achat, formation terminée…) et enchaîne des étapes : e-mail, attente, condition, étiquette, liste. Seuls les événements <strong>futurs</strong> les déclenchent.</p></div>
      <div class="mk-head-actions"><a class="btn btn-outline" href="/marketing/automatisations/parcours" data-tip="Des parcours complets prêts à activer : adaptez-les, puis lancez-les.">Parcours tout prêts</a><a class="btn btn-outline" href="/marketing/automatisations/historique" data-tip="Tous les passages de contacts dans vos scénarios, avec leur résultat.">Historique</a><% if (canWrite) { %><button type="button" class="btn btn-primary" data-mk-modal-open="nouveau" data-tip="Crée votre propre scénario : déclencheur puis étapes (e-mail, attente, condition, étiquette, liste).">Créer un scénario</button><% } %></div>
    </div>
    <%- include("partials/worker-note", { workerOn, consequence: "aucun scénario ne s'exécutera tant qu'il n'est pas rétabli" }) %>

    <%- include("partials/site-filter", { action: "/marketing/automatisations" }) %>
    <p><a href="/marketing/automatisations/historique">Historique de tous les passages</a></p>
    <% if (!automations.length) { %>
      <div class="mk-empty">
        <%- illu("zap", { className: "kx-empty-ill" }) %>
        <h2>Aucun scénario</h2>
        <p>Partez d'un parcours tout prêt (bienvenue, suivi après achat, relance…) ou créez votre propre scénario.</p>
        <div class="mk-actions"><a class="btn btn-primary btn-sm" href="/marketing/automatisations/parcours">Voir les parcours tout prêts</a><% if (canWrite) { %><button type="button" class="btn btn-outline btn-sm" data-mk-modal-open="nouveau">Créer un scénario</button><% } %></div>
      </div>
        <div class="mk-empty-art" aria-hidden="true"><%- include("partials/empty-art", { kind: "chart" }) %></div>
      </div></div>
    <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table">
        <caption class="sr-only">Scénarios</caption>
        <thead><tr><th scope="col">Nom</th><th scope="col">Type</th><th scope="col">Déclencheur</th><th scope="col">État</th><th scope="col">Étapes</th><th scope="col">Passages</th></tr></thead>
        <tbody><% automations.forEach((a) => { const st = STATUS[a.status]; %>
          <tr><td><a href="/marketing/automatisations/<%= a.id %>"><%= a.name %></a><% if (a.site_id && siteNames[a.site_id]) { %> <span class="mk-chip mk-chip-static"><%= siteNames[a.site_id] %></span><% } %></td><td><%= a.kind === "marketing" ? "Marketing" : "Transactionnel" %></td>
            <td><%= triggers[a.trigger_event] ? triggers[a.trigger_event].label : a.trigger_event %></td>
            <td><span class="badge <%= st[1] %>"><%= st[0] %></span></td><td><%= a.stepCount %></td><td><%= mkh.fmt(a.run_count) %> (<%= a.running_count %> en cours)</td></tr>
        <% }) %></tbody>
      </table></div>
    <% } %>

    <% if (canWrite) { %>
      <dialog class="mk-dialog mk-modal" id="nouveau" data-mk-modal data-mk-modal-hash="nouveau" aria-labelledby="na-title" aria-describedby="na-desc">
        <form action="/marketing/automatisations" method="post">
          <header class="mk-dialog-head">
            <div class="mk-dialog-titles">
              <h2 id="na-title">Nouveau scénario</h2>
              <p class="mk-dialog-desc" id="na-desc">Choisissez l'événement qui le déclenche ; les étapes (e-mail, attente, condition…) se construisent ensuite dans l'éditeur.</p>
            </div>
            <button type="button" class="mk-dialog-close" data-mk-modal-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button>
          </header>
          <div class="mk-dialog-body">
            <%- include("partials/site-field", { id: "a-site" }) %>
            <div class="field-group"><label for="a-name">Nom *</label><input id="a-name" type="text" name="name" maxlength="100" required placeholder="Bienvenue après inscription" data-mk-required-message="Le nom du scénario est obligatoire."></div>
            <div class="field-group"><label for="a-kind">Type</label>
              <select id="a-kind" name="kind"><option value="transactional">Transactionnel (lié au compte : bienvenue, confirmation…)</option><option value="marketing">Marketing (avec consentement et désinscription)</option></select></div>
            <div class="field-group"><label for="a-trigger">Déclencheur</label>
              <select id="a-trigger" name="trigger_event"><% Object.entries(triggers).forEach(([key, t]) => { %><option value="<%= key %>"><%= t.label %></option><% }) %></select></div>
            <details class="mk-advanced">
              <summary>Événement personnalisé</summary>
              <div class="field-group"><label for="a-trigger-custom">Nom de l'événement (remplace le déclencheur ci-dessus ; par exemple un événement envoyé par l'API)</label>
                <input id="a-trigger-custom" type="text" name="trigger_event_custom" maxlength="64" placeholder="mon_evenement.special" pattern="[a-z][a-z0-9_.]{1,63}"></div>
            </details>
          </div>
          <div class="mk-dialog-actions">
            <button type="button" class="btn btn-outline btn-sm" data-mk-modal-close>Annuler</button>
            <button type="submit" class="btn btn-primary btn-sm">Créer le scénario</button>
          </div>
        </form>
      </dialog>
      <%- include("partials/modal-reopen", { id: "nouveau" }) %>
    <% } %>
<%- include("partials/bottom") %>
