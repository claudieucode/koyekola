<%- include("partials/top", { title, active }) %>
<% const archived = Boolean(page.archived_at); const dis = canWrite && !archived ? "" : " disabled"; const c = content; %>
    <p class="mk-back"><a href="/marketing/pages">← Pages</a></p>
    <div class="mk-head"><div class="mk-builder-title"><h1><%= page.name %></h1><span class="mk-status <%= STATUS_CLASS[page.status] %>"><%= STATUSES[page.status] %></span></div>
      <% if (canWrite && !archived) { %><div class="mk-actions">
        <% if (page.status === "published") { %><a class="btn btn-outline btn-sm" href="/p/<%= page.slug %>" target="_blank" rel="noopener">Voir la page en ligne</a><% } %>
        <a class="btn btn-outline btn-sm" href="/marketing/pages/<%= page.id %>/apercu" target="_blank" rel="noopener"><%= page.hasDraft ? "Aperçu du brouillon" : "Aperçu" %></a>
        <% if (page.status !== "published" || page.hasDraft) { %><form action="/marketing/pages/<%= page.id %>/publier" method="post"><button type="submit" class="btn btn-primary btn-sm"<%= check.ready ? "" : " disabled" %>><%= page.status === "published" ? "Publier les modifications" : "Publier" %></button></form><% } %>
        <% if (page.status === "published") { %><form action="/marketing/pages/<%= page.id %>/depublier" method="post"><button type="submit" class="btn btn-outline btn-sm">Mettre hors ligne</button></form><% } %>
      </div><% } %>
    </div>
    <% if (archived) { %><div class="mk-callout"><span><strong>Page archivée</strong> (hors ligne, non modifiable). Restaurez-la pour la modifier ou la republier.</span>
      <% if (canWrite) { %><form action="/marketing/pages/<%= page.id %>/restaurer" method="post"><button type="submit" class="btn btn-outline btn-sm">Restaurer la page</button></form><% } %></div>
    <% } else if (page.hasDraft) { %><div class="mk-callout mk-callout-info" role="status"><span><strong>Modifications non publiées.</strong> <%= page.status === "published" ? "Les visiteurs voient toujours la version en ligne." : "La page n'est pas en ligne." %></span>
      <% if (canWrite) { %><form action="/marketing/pages/<%= page.id %>/brouillon/abandonner" method="post"><button type="submit" class="btn btn-ghost btn-sm" data-mk-confirm="Les modifications non publiées seront perdues ; l'éditeur reviendra à la version en ligne." data-mk-confirm-title="Abandonner le brouillon ?" data-mk-confirm-ok="Abandonner">Abandonner le brouillon</button></form><% } %></div><% } %>
    <% if (!archived && !check.ready && (page.status !== "published" || page.hasDraft)) { %><div class="mk-callout"><span><strong>Avant de publier :</strong> <%= check.errors.join(" ") %></span></div><% } %>

    <div class="mk-lp-layout">
      <form action="/marketing/pages/<%= page.id %>" method="post" class="mk-form mk-lp-editor" id="lp-form">
        <input type="hidden" name="revision" value="<%= page.revision %>">
        <section class="mk-panel" aria-labelledby="lp-settings">
          <h2 id="lp-settings">Réglages</h2>
          <div class="field-row">
            <div class="field-group"><label for="lp-name">Nom (interne)</label><input id="lp-name" type="text" name="name" maxlength="100" required value="<%= page.name %>"<%= dis %>></div>
            <div class="field-group"><label for="lp-slug">Adresse : /p/…</label><input id="lp-slug" type="text" name="slug" maxlength="60" required pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" value="<%= page.slug %>"<%= dis %>></div>
          </div>
          <div class="field-group"><label for="lp-site">Site</label>
            <select id="lp-site" name="site_id"<%= dis %>><option value="">Aucun (page isolée)</option><% sites.forEach((st) => { %><option value="<%= st.id %>"<%= page.site_id === st.id ? " selected" : "" %>><%= st.name %></option><% }) %></select>
            <span class="field-hint">Une page d'un site prend les couleurs et polices de son design system.</span></div>
          <div class="field-group"><label for="lp-form-id">Formulaire d'inscription (liste, consentement, double confirmation)</label>
            <select id="lp-form-id" name="form_id"<%= dis %>><option value="">Aucun</option><% forms.forEach((f) => { %><option value="<%= f.id %>"<%= page.form_id === f.id ? " selected" : "" %>><%= f.name %><%= f.status === "published" ? "" : " (non publié)" %></option><% }) %></select>
            <span class="field-hint"><a href="/marketing/formulaires">Gérer les formulaires</a></span></div>
          <div class="field-group"><label for="lp-tags">Étiquettes ajoutées aux inscrits de cette page (5 au plus, séparées par des virgules)</label><input id="lp-tags" type="text" name="tags" value="<%= page.tags.join(", ") %>" placeholder="page-guide-photo"<%= dis %>></div>
          <% if (page.site_id) { %><p class="field-hint">Couleurs et polices : celles du design system du site (Site Web → Sites).</p><% } else { %>
          <div class="mk-lp-colors">
            <div class="field-group"><label for="lp-c1">Couleur principale</label><input id="lp-c1" type="color" name="theme_accent" value="<%= c.theme.accent %>"<%= dis %>></div>
            <div class="field-group"><label for="lp-c2">Fond</label><input id="lp-c2" type="color" name="theme_background" value="<%= c.theme.background %>"<%= dis %>></div>
            <div class="field-group"><label for="lp-c3">Texte</label><input id="lp-c3" type="color" name="theme_text" value="<%= c.theme.text %>"<%= dis %>></div>
          </div><% } %>
        </section>

        <section class="mk-panel" aria-labelledby="lp-seo">
          <h2 id="lp-seo">Référencement (SEO)</h2>
          <div class="field-group"><label for="lp-title">Titre (onglet du navigateur et résultats de recherche)</label><input id="lp-title" type="text" name="title" maxlength="120" value="<%= c.title %>"<%= dis %>><span class="field-hint">60 caractères environ s'affichent dans les résultats de recherche.</span></div>
          <div class="field-group"><label for="lp-desc">Description (résultats de recherche et partage sur les réseaux)</label><textarea id="lp-desc" name="description" rows="2" maxlength="300"<%= dis %>><%= c.description %></textarea></div>
          <div class="field-row">
            <div class="field-group"><label for="lp-og">Image de partage (médiathèque)</label><select id="lp-og" name="seo_og_image"<%= dis %>><option value="">Image du bandeau</option><% images.forEach((im) => { %><option value="<%= im.path %>"<%= c.seo.ogImage === im.path ? " selected" : "" %>><%= im.name %></option><% }) %></select></div>
            <div class="field-group"><label for="lp-canon">Adresse canonique (facultative)</label><input id="lp-canon" type="url" name="seo_canonical" value="<%= c.seo.canonical || "" %>" placeholder="https://…"<%= dis %>></div>
          </div>
          <label class="checkbox-row"><input type="checkbox" name="indexable" value="on"<%= page.indexable ? " checked" : "" %><%= dis %>> Autoriser les moteurs de recherche à indexer la page (et l'ajouter au plan du site)</label>
        </section>

        <section class="mk-panel mk-lp-content" aria-labelledby="lp-sections-title">
          <h2 id="lp-sections-title">Contenu de la page</h2>
          <p><%= c.sections.length %> section<%= c.sections.length > 1 ? "s" : "" %> : <%= c.sections.slice(0, 6).map((s) => (s.name || SECTION_LABELS[s.type] || s.type)).join(" · ") %><%= c.sections.length > 6 ? " …" : "" %></p>
          <% if (!archived) { %><p><a class="btn btn-primary" href="/marketing/pages/<%= page.id %>/editeur"><%= canWrite ? "Ouvrir l'éditeur visuel" : "Voir dans l'éditeur visuel" %></a></p><% } %>
          <p class="field-hint">Glisser-déposer, calques, annuler/rétablir, aperçu ordinateur, tablette et mobile ; chaque modification est enregistrée automatiquement en brouillon.</p>
        </section>
        <% if (canWrite && !archived) { %><div class="mk-actions mk-lp-save"><button type="submit" name="action" value="save" class="btn btn-outline">Enregistrer les réglages</button></div><% } %>
      </form>

      <aside class="mk-lp-side" aria-label="Aperçu et statistiques">
        <section class="mk-panel" aria-labelledby="lp-report">
          <h2 id="lp-report">Statistiques (30 jours)</h2>
          <dl class="mk-journey-facts">
            <dt>Visiteurs uniques</dt><dd><%= mkh.fmt(report.visitors) %> (<%= mkh.fmt(report.views) %> visites)</dd>
            <dt>Inscriptions</dt><dd><%= mkh.fmt(report.signups) %></dd>
            <dt>Taux de conversion</dt><dd><%= report.conversion === null ? "—" : String(report.conversion).replace(".", ",") + " %" %></dd>
          </dl>
          <% if (report.clicks.length) { %><h3 class="mk-journey-sub">Clics</h3><ul class="mk-journey-emails"><% report.clicks.forEach((c) => { %><li><%= c.target %> : <%= mkh.fmt(c.n) %> (<%= mkh.fmt(c.u) %> visiteur<%= c.u > 1 ? "s" : "" %>)</li><% }) %></ul><% } %>
          <p class="field-hint">Visiteur compté une fois par jour, sans cookie ni adresse IP conservée ; les robots ne sont pas comptés.</p>
          <p><a class="btn btn-outline btn-sm" href="/marketing/pages/<%= page.id %>/analyse">Analyse détaillée (parcours des visiteurs)</a></p>
        </section>
        <section class="mk-panel mk-lp-preview" aria-labelledby="lp-prev">
          <h2 id="lp-prev">Aperçu</h2>
          <% if (page.status === "published") { %><p class="field-hint">En ligne : <a href="/p/<%= page.slug %>" target="_blank" rel="noopener"><%= publicUrl %></a></p><% } %>
          <iframe src="/marketing/pages/<%= page.id %>/apercu" title="Aperçu de la page" loading="lazy"></iframe>
        </section>
        <section class="mk-panel" aria-labelledby="lp-versions">
          <h2 id="lp-versions">Versions publiées</h2>
          <% if (!versions.length) { %><p class="field-hint">Aucune version : chaque publication en crée une.</p><% } else { %>
            <ul class="mk-lp-versions">
              <% versions.slice(0, 15).forEach((v, k) => { %><li>
                <span><strong>Version <%= v.number %></strong><% if (k === 0 && page.status === "published") { %> <span class="mk-status mk-status-ok">En ligne</span><% } %><span class="mk-sub"><%= mkh.fdatetime(v.created_at) %><%= v.author ? ` · ${v.author}` : "" %></span></span>
                <span class="mk-row-actions"><a class="btn btn-ghost btn-sm" href="/marketing/pages/<%= page.id %>/versions/<%= v.number %>/apercu" target="_blank" rel="noopener">Voir<span class="sr-only"> la version <%= v.number %></span></a>
                <% if (canWrite && !archived) { %><form action="/marketing/pages/<%= page.id %>/versions/<%= v.number %>/restaurer" method="post"><button type="submit" class="btn btn-ghost btn-sm" data-mk-confirm="Le contenu de la version <%= v.number %> remplace votre brouillon actuel. La page en ligne ne change pas tant que vous ne publiez pas." data-mk-confirm-title="Restaurer la version <%= v.number %> ?" data-mk-confirm-ok="Restaurer dans le brouillon">Restaurer<span class="sr-only"> la version <%= v.number %></span></button></form><% } %></span>
              </li><% }) %>
            </ul>
            <% if (versions.length > 15) { %><p class="field-hint"><%= versions.length - 15 %> version(s) plus ancienne(s) gardée(s).</p><% } %>
          <% } %>
        </section>
        <% if (canWrite) { %><div class="mk-actions mk-lp-danger">
          <% if (!archived) { %><form action="/marketing/pages/<%= page.id %>/dupliquer" method="post"><button type="submit" class="btn btn-outline btn-sm">Dupliquer</button></form>
          <form action="/marketing/pages/<%= page.id %>/archiver" method="post"><button type="submit" class="btn btn-outline btn-sm" data-mk-confirm="La page passe hors ligne et quitte la liste ; ses statistiques et versions sont gardées, vous pourrez la restaurer." data-mk-confirm-title="Archiver cette page ?" data-mk-confirm-ok="Archiver">Archiver</button></form><% } %>
          <form action="/marketing/pages/<%= page.id %>/supprimer" method="post"><button type="submit" class="btn btn-danger btn-sm" data-mk-confirm="La page, ses statistiques et ses versions seront supprimées définitivement ; son adresse ne fonctionnera plus." data-mk-confirm-title="Supprimer cette page ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form>
        </div><% } %>
      </aside>
    </div>
<%- include("partials/bottom") %>
