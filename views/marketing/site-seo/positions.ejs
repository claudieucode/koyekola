<%- include("../partials/top", { title, active }) %>
<%- include("_head") %>
    <div class="mk-cms-soon" role="note"><%- icon("info", { size: 18 }) %><p>Aucune position n'est inventée. Les mesures viennent de ce que vous saisissez, d'un export « Requêtes » de Search Console, ou de l'API Search Console de ce site si elle est connectée (<a href="<%= space.base %>/seo/connexions">Connexions</a>). La position de Search Console est une <strong>moyenne</strong> sur la période, pas un rang exact. Un écart négatif est une amélioration.</p></div>
    <section class="mk-panel mk-seo-appear" aria-labelledby="ps-main"><h2 id="ps-main">Mots-clés suivis (<%= v.total %>)</h2>
      <form method="get" class="mk-form"><div class="field-group"><label for="ps-q">Rechercher</label><input id="ps-q" type="search" name="q" value="<%= search %>" maxlength="100"></div></form>
      <% if (!v.keywords.length) { %><div class="mk-empty"><%- icon("trendingUp", { size: 32 }) %><p>Aucune mesure pour le moment.</p></div><% } else { %>
      <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Positions par mot-clé</caption><thead><tr><th scope="col">Mot-clé</th><th scope="col">Position</th><th scope="col">Écart</th><th scope="col">Mesurée le</th><th scope="col">Source</th><th scope="col">Historique</th></tr></thead>
        <tbody><% v.keywords.forEach((k) => { %><tr><td data-label="Mot-clé"><%= k.keyword %><% if (k.latest.page_url) { %><span class="mk-sub"><code><%= k.latest.page_url %></code></span><% } %></td>
          <td data-label="Position"><%= k.latest.position %></td>
          <td data-label="Écart"><%= k.delta === null ? "—" : (k.delta > 0 ? "+" : "") + k.delta %><% if (k.delta !== null && k.delta !== 0) { %> <span class="mk-sub"><%= k.delta < 0 ? "amélioration" : "recul" %></span><% } %></td>
          <td data-label="Mesurée le"><%= k.latest.measured_on %></td><td data-label="Source"><%= sources[k.latest.source] || k.latest.source %></td>
          <td data-label="Historique"><%= k.history.map((h) => h.position).join(" → ") %>
            <% if (canEdit) { %><form method="post" action="<%= space.base %>/seo/positions/<%= k.latest.id %>/supprimer" data-confirm="Supprimer la dernière mesure de ce mot-clé ?"><button type="submit" class="btn btn-outline btn-sm">Supprimer la dernière</button></form><% } %></td></tr><% }) %></tbody></table></div>
      <% } %>
    </section>
    <% if (canEdit) { %>
    <div class="rk-pair">
    <section class="mk-panel rk-panel mk-seo-appear" aria-labelledby="ps-add">
      <header class="rk-head"><h2 id="ps-add">Ajouter une mesure</h2><p>Relevez la position d'un mot-clé à une date donnée.</p></header>
      <form method="post" action="<%= space.base %>/seo/positions" class="rk-form" data-busy-form>
        <div class="rk-grid">
          <div class="rk-f rk-c8"><label for="ps-kw">Mot-clé</label><input id="ps-kw" name="keyword" maxlength="120" required autocomplete="off" aria-describedby="ps-kw-h"><p class="rk-h" id="ps-kw-h">Expression exacte suivie, jusqu'à 120 caractères.</p></div>
          <div class="rk-f rk-c4"><label for="ps-pos">Position</label><input id="ps-pos" name="position" inputmode="decimal" required autocomplete="off" class="rk-num" aria-describedby="ps-pos-h"><p class="rk-h" id="ps-pos-h">De 1 à 1000.</p></div>
          <div class="rk-f rk-c8"><label for="ps-url">Page <span class="rk-opt">facultatif</span></label><input id="ps-url" name="url" maxlength="500" placeholder="/ma-page" autocomplete="off" aria-describedby="ps-url-h"><p class="rk-h" id="ps-url-h">Adresse ou chemin de la page qui se positionne.</p></div>
          <div class="rk-f rk-c4"><label for="ps-date">Date de la mesure</label><input id="ps-date" type="date" name="date" aria-describedby="ps-date-h"><p class="rk-h" id="ps-date-h">Vide : aujourd'hui.</p></div>
        </div>
        <footer class="rk-foot"><button type="submit" class="btn btn-primary">Enregistrer</button></footer>
      </form>
    </section>
    <section class="mk-panel rk-panel mk-seo-appear" aria-labelledby="ps-imp">
      <header class="rk-head rk-head-row"><div><h2 id="ps-imp">Importer depuis Search Console</h2><p>Collez l'export « Requêtes » de Google Search Console.</p></div>
        <% const gs = { connected: "ok", error: "err", not_connected: "off", config_required: "warn", not_verified: "warn", available: "ok" }[gsc.state] || "off"; %>
        <a class="rk-gsc is-<%= gs %>" href="<%= space.base %>/seo/connexions" title="Gérer la connexion Google"><span class="rk-dot" aria-hidden="true"></span><span><strong>API Search Console</strong> <%= gsc.label %></span></a>
      </header>
      <form method="post" action="<%= space.base %>/seo/positions/import" class="rk-form" data-busy-form>
        <div class="rk-grid">
          <div class="rk-f rk-c12"><label for="ps-csv">Contenu du fichier « Requêtes.csv »</label><textarea id="ps-csv" name="csv" rows="7" spellcheck="false" wrap="off" maxlength="400000" class="rk-csv" placeholder="Requêtes les plus fréquentes,Clics,Impressions,CTR,Position" aria-describedby="ps-csv-h"></textarea><p class="rk-h" id="ps-csv-h">Ouvrez le fichier dans un éditeur de texte, copiez tout son contenu et collez-le ici.</p></div>
          <div class="rk-f rk-c4"><label for="ps-idate">Fin de la période exportée</label><input id="ps-idate" type="date" name="date" aria-describedby="ps-idate-h"><p class="rk-h" id="ps-idate-h">Vide : aujourd'hui.</p></div>
        </div>
        <footer class="rk-foot"><button type="submit" class="btn btn-primary">Importer</button></footer>
      </form>
      <% if (gsc.state === "connected") { %><form method="post" action="<%= space.base %>/seo/positions/api" class="rk-api" data-busy-form><p>Connexion active : relevez directement vos requêtes des 28 derniers jours.</p><button type="submit" class="btn btn-outline">Relever depuis l'API Search Console</button></form>
      <% } else if (gsc.detail) { %><p class="rk-api-note"><%= gsc.detail %></p><% } %>
    </section>
    </div>
    <% } %>
<%- include("../partials/bottom") %>
