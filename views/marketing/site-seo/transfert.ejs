<%- include("../partials/top", { title, active }) %>
<%- include("_head") %>
<% const rep = typeof report === "undefined" ? null : report; %>
    <% if (rep && rep.errors && rep.errors.length) { %><div class="sx-note is-bad" role="alert"><%- icon("alertTriangle", { size: 18 }) %><p><%= rep.errors.join(" ") %></p></div><% } %>
    <% if (rep && kind === "json" && rep.ok) { %><section class="sx-card sx-report sx-appear" role="status"><h2><%= rep.dryRun ? "Aperçu (rien n'est enregistré)" : "Import terminé" %></h2>
      <p>Réglages : <%= rep.settings.applied.length %> <%= rep.dryRun ? "à appliquer" : "appliqué(s)" %><%= rep.settings.ignored.length ? ` ; ${rep.settings.ignored.length} ignoré(s) car non modifiables pour un site (${rep.settings.ignored.join(", ")})` : "" %>.</p>
      <p>Redirections : <%= rep.redirects.created %> <%= rep.dryRun ? "à créer" : "créée(s)" %> ; <%= rep.redirects.skipped.length %> déjà présente(s) ; <%= rep.redirects.errors.length %> refusée(s).</p>
      <% if (rep.redirects.errors.length) { %><ul><% rep.redirects.errors.slice(0, 10).forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %></section><% } %>
    <% if (rep && kind === "wordpress" && rep.ok) { %><section class="sx-card sx-report sx-appear" role="status"><h2><%= rep.dryRun ? "Aperçu (rien n'est enregistré)" : "Import terminé : brouillons créés" %></h2>
      <p><%= rep.updated.length %> page(s) <%= rep.dryRun ? "à mettre à jour" : "mise(s) à jour en brouillon (à relire puis publier)" %> ; <%= rep.skipped.length %> ignorée(s).</p>
      <% if (rep.updated.length) { %><ul><% rep.updated.slice(0, 30).forEach((u) => { %><li><code><%= u.path %></code> — <%= u.fields.join(", ") %></li><% }) %></ul><% } %>
      <% if (rep.skipped.length) { %><details class="mk-seo-details"><summary>Lignes ignorées (<%= rep.skipped.length %>)</summary><ul><% rep.skipped.slice(0, 50).forEach((u) => { %><li><%= u %></li><% }) %></ul></details><% } %>
      <% if (rep.warnings.length) { %><details class="mk-seo-details" open><summary>Avertissements (<%= rep.warnings.length %>)</summary><ul><% rep.warnings.slice(0, 50).forEach((u) => { %><li><%= u %></li><% }) %></ul></details><% } %></section><% } %>
    <div class="sx-stack">
    <section class="sx-card sx-appear" aria-labelledby="tr-export">
      <header class="sx-card-head"><span class="sx-ico" aria-hidden="true"><%- icon("download", { size: 20 }) %></span><div class="sx-title"><h2 id="tr-export">Exporter les réglages SEO</h2><p>Un fichier JSON propre à ce site.</p></div>
        <div class="sx-head-tools"><a class="btn btn-primary btn-sm" href="<%= space.base %>/seo/transfert/export.json"><%- icon("download", { size: 14 }) %> Télécharger (.json)</a></div></header>
      <div class="sx-body"><ul class="sx-list"><li>Réglages SEO : identité, organisation, SEO local, modèles de titres, robots.</li><li>Redirections du site.</li><li>Aucune clé ni donnée de connexion Google.</li></ul></div>
    </section>
    <% if (canEdit) { %>
    <section class="sx-card sx-appear" aria-labelledby="tr-import">
      <header class="sx-card-head"><span class="sx-ico" aria-hidden="true"><%- icon("upload", { size: 20 }) %></span><div class="sx-title"><h2 id="tr-import">Importer un export KOLAKISA</h2><p>S'applique toujours à CE site, quel que soit le site d'origine du fichier.</p></div></header>
      <form method="post" action="<%= space.base %>/seo/transfert/import" class="sx-body sx-grid" data-busy-form>
        <div class="sx-field sx-col-12"><label for="tr-json">Fichier .json</label>
          <label class="sx-drop" data-sx-drop data-target="tr-json"><%- icon("upload", { size: 20 }) %><span><strong>Choisir le fichier</strong> ou le déposer ici</span><span class="sx-drop-name" data-sx-drop-name></span><input type="file" accept=".json,application/json"></label>
          <textarea id="tr-json" name="json" rows="4" spellcheck="false" maxlength="400000" class="sx-code" placeholder="Ou collez ici le contenu du fichier"></textarea></div>
        <div class="sx-col-12"><label class="sx-switch"><input type="checkbox" name="apply" value="1"><span class="sx-track" aria-hidden="true"></span><span>Enregistrer réellement<small>Désactivé : simple aperçu, rien n'est modifié.</small></span></label></div>
        <div class="sx-col-12 sx-actions"><button type="submit" class="btn btn-primary btn-sm">Vérifier / importer</button></div>
      </form>
    </section>
    <section class="sx-card sx-appear" aria-labelledby="tr-wp">
      <header class="sx-card-head"><span class="sx-ico" aria-hidden="true"><%- icon("fileText", { size: 20 }) %></span><div class="sx-title"><h2 id="tr-wp">Importer depuis Rank Math ou Yoast</h2><p>Les valeurs sont écrites dans le brouillon des pages, jamais publiées automatiquement.</p></div></header>
      <form method="post" action="<%= space.base %>/seo/transfert/wordpress" class="sx-body sx-grid" data-busy-form>
        <div class="sx-field sx-col-12"><label for="tr-table">Tableau (CSV ou JSON)</label>
          <textarea id="tr-table" name="table" rows="4" spellcheck="false" maxlength="400000" class="sx-code" placeholder="url, rank_math_title, rank_math_description…"></textarea>
          <details class="sx-hint"><summary>Colonnes reconnues</summary>Une colonne <code>url</code> et, selon l'extension : <code>rank_math_title</code>, <code>rank_math_description</code>, <code>rank_math_focus_keyword</code>, <code>rank_math_canonical_url</code> ou <code>_yoast_wpseo_title</code>, <code>_yoast_wpseo_metadesc</code>, <code>_yoast_wpseo_focuskw</code>, <code>_yoast_wpseo_canonical</code> (ou le format long <code>url, meta_key, meta_value</code>). Les pages sont retrouvées par leur adresse.</details></div>
        <div class="sx-col-12"><label class="sx-switch"><input type="checkbox" name="apply" value="1"><span class="sx-track" aria-hidden="true"></span><span>Enregistrer réellement dans les brouillons<small>Désactivé : simple aperçu, rien n'est modifié.</small></span></label></div>
        <div class="sx-col-12 sx-actions"><button type="submit" class="btn btn-primary btn-sm">Vérifier / importer</button></div>
      </form>
    </section>
    <% } %>
    </div>
<%- include("../partials/bottom") %>
