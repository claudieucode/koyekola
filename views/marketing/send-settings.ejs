<%- include("partials/top", { title, active }) %>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Réglages d'envoi</h1><p class="mk-head-sub">Par quel service partent vos e-mails, sous quel nom, et à quel rythme.</p></div></div>

    <section class="mk-panel">
      <h2>État</h2>
      <ul class="mk-status-list">
        <li><strong>Fournisseur actuel :</strong> <%= cfg.provider %></li>
        <li><strong>ENCRYPTION_KEY :</strong> <%= keyOk ? "définie (liens de désinscription signables, secrets chiffrables)." : "ABSENTE : définissez-la avant d'enregistrer une clé d'API ou d'envoyer une campagne." %></li>
        <li><strong>SMTP (e-mails du site) :</strong> <%= smtpOk ? "configuré (SMTP_HOST)." : "non configuré (SMTP_HOST vide) : confirmations d'achat, mot de passe oublié, accusés de contact… ne partent pas." %></li>
        <li><strong>Expéditeur des e-mails du site (SMTP_FROM) :</strong> <%= smtpFrom || "non défini" %></li>
        <li><strong>Réception des messages de contact (CONTACT_EMAIL) :</strong> <%= contactEmail || (smtpFrom ? smtpFrom + " (SMTP_FROM, faute de CONTACT_EMAIL)" : "non définie") %></li>
        <li><strong>Adresse publique (SITE_URL) :</strong> <%= baseUrl || "non définie : les liens de désinscription en dépendent." %></li>
        <li><strong>Traitement en arrière-plan :</strong> <% if (workerOn) { %>actif.<% } else { %><%= mkh.workerHuman("aucune campagne ne partira") %><details class="mk-flash-details"><summary>Détails techniques</summary><p><%= mkh.WORKER_DETAIL %></p></details><% } %></li>
      </ul>
      <% if (cfg.provider === "console") { %><p class="mk-note">Fournisseur « console » : rien n'est réellement envoyé (les messages sont seulement journalisés). C'est le réglage sûr par défaut.</p><% } %>
    </section>

    <% if (canEdit) { %>
    <section class="mk-panel" id="test">
      <h2>Envoyer un e-mail de test</h2>
      <p class="field-hint">Un court message fixe, pour vérifier que vos e-mails partent et arrivent bien en boîte de réception (10 par heure).</p>
      <form action="/marketing/envoi/test" method="post" class="mk-inline-form">
        <label for="t-to" class="sr-only">Adresse de réception</label><input id="t-to" type="email" name="to" required maxlength="254" placeholder="vous@exemple.com">
        <label for="t-channel" class="sr-only">Canal</label>
        <select id="t-channel" name="channel"><option value="site">E-mails du site (SMTP)</option><option value="campagnes">Campagnes (fournisseur choisi)</option></select>
        <button type="submit" class="btn btn-outline">Envoyer le test</button>
      </form>
    </section>
    <% } %>

    <section class="mk-panel" id="journal">
      <h2>E-mails du site : derniers envois</h2>
      <% const ST = { pending: ["En attente", "badge"], sending: ["En cours", "badge"], sent: ["Envoyé", "badge-success"], failed: ["Échec", "mk-badge-danger"], skipped: ["Non envoyé", "badge-warning"] }; const KIND = { purchase: "Confirmation d'achat", contact_notification: "Nouveau message de contact", contact_ack: "Accusé de réception (contact)", signup_welcome: "Bienvenue (inscription)", email_verification: "Confirmation de l'adresse e-mail", password_reset: "Mot de passe oublié", newsletter_confirm: "Confirmation newsletter" }; %>
      <p class="field-hint">Confirmations d'achat, mot de passe oublié, accusés de contact… Ils partent en arrière-plan ; un échec est réessayé 5 fois (1, 2, 4, 8 min).
        <% if (outbox.counts.failed) { %><strong><%= outbox.counts.failed %> en échec définitif.</strong><% } %></p>
      <% if (!outbox.rows.length) { %><p class="field-hint">Aucun e-mail du site pour l'instant.</p>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table">
          <caption class="sr-only">Derniers e-mails du site</caption>
          <thead><tr><th scope="col">Type</th><th scope="col">Destinataire</th><th scope="col">État</th><th scope="col">Date</th></tr></thead>
          <tbody><% outbox.rows.forEach((m) => { const st = ST[m.status] || [m.status, "badge"]; %>
            <tr><td data-label="Type"><%= KIND[m.kind] || m.kind %></td><td data-label="Destinataire"><%= mkh.maskEmail(m.to_email) %></td>
              <td data-label="État"><span class="badge <%= st[1] %>"><%= st[0] %></span><% if (m.last_error) { %><span class="mk-sub"><%= m.last_error %><%= m.status === "pending" ? " — essai " + (m.attempts + 1) + " à venir" : "" %></span><% } %></td>
              <td data-label="Date" class="mk-nowrap"><%= new Date(m.sent_at || m.created_at).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" }) %></td></tr>
          <% }) %></tbody>
        </table></div>
      <% } %>
    </section>

    <form action="/marketing/envoi" method="post" class="mk-form">
      <section class="mk-panel">
        <h2>Fournisseur et expéditeur</h2>
        <div class="field-group"><label for="s-provider">Fournisseur</label>
          <select id="s-provider" name="provider" <%= canEdit ? "" : "disabled" %>>
            <option value="console" <%= cfg.provider === "console" ? "selected" : "" %>>Console (essais : rien n'est envoyé)</option>
            <option value="smtp" <%= cfg.provider === "smtp" ? "selected" : "" %>>SMTP (variables SMTP_* du serveur)</option>
            <option value="resend" <%= cfg.provider === "resend" ? "selected" : "" %>>Resend (API, avec retours de livraison)</option>
          </select></div>
        <div class="field-row">
          <div class="field-group"><label for="s-from">Expéditeur</label><input id="s-from" type="text" name="from" maxlength="200" value="<%= cfg.from %>" placeholder="KOLAKISA &lt;no-reply@votre-domaine.fr&gt;" <%= canEdit ? "" : "disabled" %>>
            <span class="field-hint">Le domaine doit être authentifié (SPF, DKIM, DMARC), sinon vos messages iront en indésirables.</span>
            <% if (senderDomain) { %><span class="field-hint">Domaine <strong><%= senderDomain.domain %></strong> :
              <% if (senderDomain.free) { %><span class="mk-status mk-status-err">messagerie gratuite — à remplacer</span>
              <% } else if (!senderDomain.status) { %><span class="mk-status mk-status-warn">non ajouté</span> <a href="/marketing/domaines">Ajouter ce domaine</a>
              <% } else { %><span class="mk-status <%= senderDomain.status === "authenticated" ? "mk-status-ok" : "mk-status-warn" %>"><%= domainLabels[senderDomain.status] %></span> <a href="/marketing/domaines/<%= senderDomain.id %>">Voir le domaine</a><% } %>
            </span><% } %></div>
          <div class="field-group"><label for="s-reply">Adresse de réponse (facultatif)</label><input id="s-reply" type="text" name="reply_to" maxlength="200" value="<%= cfg.replyTo %>" <%= canEdit ? "" : "disabled" %>></div>
        </div>
      </section>
      <section class="mk-panel">
        <h2>Rythme (garde-fous)</h2>
        <div class="field-row">
          <div class="field-group"><label for="s-rate">Messages par minute</label><input id="s-rate" type="number" name="rate" min="1" max="6000" value="<%= cfg.ratePerMinute %>" <%= canEdit ? "" : "disabled" %>></div>
          <div class="field-group"><label for="s-daily">Plafond par jour (UTC)</label><input id="s-daily" type="number" name="daily" min="1" max="1000000" value="<%= cfg.dailyLimit %>" <%= canEdit ? "" : "disabled" %>>
            <span class="field-hint">Une campagne plus grosse continue le lendemain. Un plafond bas protège d'une erreur et de la réputation d'un domaine neuf.</span></div>
        </div>
      </section>
      <section class="mk-panel">
        <h2>Clés (Resend)</h2>
        <div class="field-group"><label for="s-key">Clé d'API</label><input id="s-key" type="password" name="api_key" autocomplete="new-password" placeholder="<%= cfg.apiKeySet ? "•••••••• (laisser vide pour conserver)" : "re_…" %>" <%= canEdit ? "" : "disabled" %>>
          <span class="field-hint"><%= cfg.apiKeySet ? "Clé enregistrée (chiffrée, jamais réaffichée)." : "Aucune clé enregistrée." %></span>
          <% if (canEdit && cfg.apiKeySet) { %><label class="checkbox-row"><input type="checkbox" name="clear_api_key" value="on"> Effacer la clé</label><% } %></div>
        <div class="field-group"><label for="s-wh">Secret de signature des webhooks</label><input id="s-wh" type="password" name="webhook_secret" autocomplete="new-password" placeholder="<%= cfg.webhookSecretSet ? "•••••••• (laisser vide pour conserver)" : "whsec_…" %>" <%= canEdit ? "" : "disabled" %>>
          <span class="field-hint"><%= cfg.webhookSecretSet ? "Secret enregistré (chiffré)." : "Aucun secret enregistré : les rebonds et plaintes ne seront pas reçus." %></span>
          <% if (canEdit && cfg.webhookSecretSet) { %><label class="checkbox-row"><input type="checkbox" name="clear_webhook_secret" value="on"> Effacer le secret</label><% } %></div>
        <p class="field-hint">Adresse à déclarer chez Resend (événements delivered, bounced, complained) :<br>
          <code><%= baseUrl ? baseUrl + "/webhooks/email/resend/" + orgId : "(définissez SITE_URL)/webhooks/email/resend/" + orgId %></code></p>
      </section>
      <% if (canEdit) { %><button type="submit" class="btn btn-primary">Enregistrer les réglages</button><% } else { %><p class="field-hint">Seul un administrateur peut modifier ces réglages.</p><% } %>
    </form>

    <section class="mk-panel" id="fuseau">
      <h2>Fuseau horaire par défaut</h2>
      <p class="field-hint">Utilisé pour l'envoi « à l'heure locale » des contacts dont le fuseau est inconnu (ni fourni par un formulaire, ni par leur compte KOLAKISA, ni déductible de leur pays), et pour la journée d'envoi « à la meilleure heure ».</p>
      <form action="/marketing/envoi/fuseau" method="post">
        <div class="field-group"><label for="s-tz">Fuseau</label>
          <select id="s-tz" name="timezone"<%= canEdit ? "" : " disabled" %>><% timeZones.forEach((z) => { %><option value="<%= z %>"<%= z === orgTz ? " selected" : "" %>><%= z %></option><% }) %></select></div>
        <% if (canEdit) { %><button type="submit" class="btn btn-outline btn-sm">Enregistrer le fuseau</button><% } %>
      </form>
    </section>
<%- include("partials/bottom") %>
