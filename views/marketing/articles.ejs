<%#
  KOLAKISA CMS → Articles (palier 4). Liste des articles du blog (table posts) : recherche, filtres, tri et pagination faits par la base ;
  actions groupées et menu d'actions selon l'état de l'article et les droits. L'écriture se fait dans l'éditeur du blog.
%><%- include("partials/top", { title, active }) %>
<%
  const keep = (over = {}) => { const p = new URLSearchParams(); const f = { q: filters.q, auteur: filters.auteur, categorie: filters.categorie, etiquette: filters.etiquette, periode: filters.periode, tri: filters.tri === "modifie" ? "" : filters.tri, ...over }; Object.entries(f).forEach(([k, v]) => { if (v) p.set(k, v); }); const t = p.toString(); return t ? "?" + t : ""; };
  const tabs = [["toutes", "Tous", "/marketing/site-web/articles"], ["publies", "Publiés", "/marketing/site-web/articles/publies"], ["programmes", "Programmés", "/marketing/site-web/articles/programmes"], ["brouillons", "Brouillons", "/marketing/site-web/articles/brouillons"], ["corbeille", "Corbeille", "/marketing/site-web/articles/corbeille"]];
  const here = tabs.find((t) => t[0] === state)[2];
  const fd = (v) => (v ? String(v).slice(0, 10).split("-").reverse().join("/") : "—");
  const fdt = (v) => (v ? fd(v) + " à " + String(v).slice(11, 16) + " UTC" : "—");
  const filtered = Boolean(filters.q || filters.auteur || filters.categorie || filters.etiquette || filters.periode);
  const inTrash = state === "corbeille";
  const mine = (p) => canWriteAll || p.author_id === me; // « articles.write » = tous ; sinon seulement les siens (articles.edit_own)
  const badge = { published: "mk-status-ok", scheduled: "mk-status-info", draft: "mk-status-off", review: "mk-status-warn", archived: "mk-status-off" };
%>
    <div class="mk-head"><h1>Articles</h1>
      <% if (canWrite && isCreator && !inTrash) { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouvel-article">Nouvel article</button></div><% } %></div>
    <p class="mk-lead">Les articles de votre blog. Un article s'écrit dans l'éditeur (texte riche, images de la médiathèque, aperçu, versions, référencement) ; ici vous les retrouvez, les publiez, les copiez ou les mettez à la corbeille.</p>

    <nav class="mk-tabs mk-cms-tabs" aria-label="Filtrer les articles par état">
      <% tabs.forEach(([k, name, href]) => { %><a class="mk-tab" href="<%= href + keep({ page: "" }) %>"<%- state === k ? ' aria-current="page"' : "" %>><%= name %> <span class="mk-tab-count"><%= result.counts[k === "toutes" ? "toutes" : k] %></span></a>
      <% }) %>
    </nav>
    <% if (inTrash) { %><p class="field-hint">Les articles de la corbeille sont hors ligne et restaurables (en brouillon). Seule la suppression définitive les efface, avec leurs versions.</p><% } %>

    <form class="mk-cms-toolbar mk-cms-filters" method="get" action="<%= here %>" role="search" aria-label="Rechercher et filtrer les articles">
      <label class="mk-search"><span class="sr-only">Rechercher un article (titre, adresse, extrait, contenu)</span><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= filters.q %>" placeholder="Rechercher un article"></label>
      <% if (authors.length > 1) { %><label class="sr-only" for="ar-auteur">Auteur</label>
      <select id="ar-auteur" name="auteur"><option value="">Tous les auteurs</option><% authors.forEach((u) => { %><option value="<%= u.id %>"<%= String(u.id) === filters.auteur ? " selected" : "" %>><%= u.username %></option><% }) %></select><% } %>
      <% if (categories.length) { %><label class="sr-only" for="ar-cat">Catégorie</label>
      <select id="ar-cat" name="categorie"><option value="">Toutes les catégories</option><% categories.forEach((c) => { %><option value="<%= c.id %>"<%= String(c.id) === filters.categorie ? " selected" : "" %>><%= "— ".repeat(c.depth) %><%= c.name %> (<%= c.n %>)</option><% }) %></select><% } %>
      <% if (filters.etiquette) { %><input type="hidden" name="etiquette" value="<%= filters.etiquette %>"><% } %>
      <label class="sr-only" for="ar-periode">Période</label>
      <select id="ar-periode" name="periode"><option value="">Toutes les dates</option><option value="7"<%= filters.periode === "7" ? " selected" : "" %>>7 derniers jours</option><option value="30"<%= filters.periode === "30" ? " selected" : "" %>>30 derniers jours</option><option value="90"<%= filters.periode === "90" ? " selected" : "" %>>90 derniers jours</option><option value="annee"<%= filters.periode === "annee" ? " selected" : "" %>>Cette année</option></select>
      <label class="sr-only" for="ar-tri">Trier par</label>
      <select id="ar-tri" name="tri"><% [["modifie", "Modifiés récemment"], ["recent", "Plus récents"], ["ancien", "Plus anciens"], ["titre", "Titre A → Z"], ["titre_desc", "Titre Z → A"], ["publie", "Date de publication"]].forEach(([k, name]) => { %><option value="<%= k %>"<%= filters.tri === k ? " selected" : "" %>><%= name %></option><% }) %></select>
      <button type="submit" class="btn btn-outline btn-sm">Filtrer</button><% if (filtered) { %><a class="btn btn-ghost btn-sm" href="<%= here %>">Réinitialiser</a><% } %>
    </form>

    <% if (!rows.length) { %>
      <div class="mk-empty"><%- icon("fileText", { size: 32 }) %><h2><%= filtered ? "Aucun article trouvé" : inTrash ? "La corbeille est vide" : state === "toutes" ? "Aucun article" : "Aucun article dans cet état" %></h2>
        <p><%= filtered ? "Aucun article ne correspond à ces critères." : inTrash ? "Les articles mis à la corbeille apparaissent ici ; vous pouvez les restaurer." : state === "toutes" ? "Créez votre premier article pour commencer." : "Rien à afficher pour l'instant." %></p>
        <% if (canWrite && isCreator && !inTrash && !filtered && state === "toutes") { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouvel-article">Créer un article</button></div><% } %></div>
    <% } else { %>
      <% if (canWrite) { %>
      <form id="pages-bulk" class="mk-cms-bulk" action="/marketing/site-web/articles/actions" method="post" data-cms-bulk data-cms-noun="article">
        <input type="hidden" name="retour" value="<%= here + keep({ page: result.page > 1 ? result.page : "" }) %>">
        <label class="sr-only" for="ar-bulk">Action groupée</label>
        <select id="ar-bulk" name="action" disabled><option value="">Actions groupées</option>
          <% if (inTrash) { %><option value="restaurer">Restaurer</option><% if (canDelete) { %><option value="supprimer">Supprimer définitivement</option><% } %>
          <% } else { %><% if (canPublish) { %><option value="publier">Publier</option><option value="depublier">Remettre en brouillon</option><% } %><option value="corbeille">Mettre à la corbeille</option><% } %></select>
        <button type="submit" class="btn btn-outline btn-sm" disabled>Appliquer</button>
        <span class="mk-sub" data-cms-bulk-count aria-live="polite"></span>
      </form>
      <% } %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table mk-ar-table">
        <caption class="sr-only"><%= inTrash ? "Articles dans la corbeille" : "Articles" %></caption>
        <thead><tr><% if (canWrite) { %><th scope="col" class="mk-cms-check-col"><input type="checkbox" data-cms-select-all aria-label="Tout sélectionner"></th><% } %><th scope="col">Article</th><th scope="col">État</th><th scope="col">Auteur</th><th scope="col">Catégorie</th><th scope="col" class="mk-num">Commentaires</th><th scope="col">Date</th><th scope="col">Modifié</th><th scope="col" class="mk-cms-actions-col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% rows.forEach((p) => { const menuId = "ar-menu-" + p.id; const stClass = inTrash ? "mk-status-off" : (badge[p.status] || "mk-status-off"); %>
          <tr><% if (canWrite && mine(p)) { %><td class="mk-cms-check-col" data-label="Sélection"><input type="checkbox" name="ids" value="<%= p.id %>" form="pages-bulk" data-cms-row aria-label="Sélectionner « <%= p.title %> »"></td><% } %>
            <th scope="row" data-label="Article"><span class="mk-ar-cell"><% if (p.cover_path) { %><img class="mk-ar-thumb" src="<%= p.cover_path %>" alt="" loading="lazy" width="48" height="36"><% } else { %><span class="mk-ar-thumb is-empty" aria-hidden="true"></span><% } %>
              <span><% if (isCreator && mine(p)) { %><a href="/formateur/blog/<%= p.id %>/modifier"><%= p.title %></a><% } else { %><%= p.title %><% } %><span class="mk-sub"><%= BLOG_BASE %>/<%= p.slug %></span></span></span></th>
            <td data-label="État"><span class="mk-status <%= stClass %>"><%= inTrash ? "Corbeille" : STATUSES[p.status] || p.status %></span><% if (!inTrash && p.status === "scheduled") { %><span class="mk-sub"><%= fdt(p.published_at) %></span><% } %></td>
            <td data-label="Auteur"><%= p.author || "—" %></td><td data-label="Catégorie"><%= p.primary_category || p.category || "—" %></td>
            <td class="mk-num" data-label="Commentaires"><% if (p.comments_approved || p.comments_pending) { %><a href="/marketing/site-web/commentaires?contenu=post:<%= p.id %>"><%= p.comments_approved %></a><% if (p.comments_pending) { %><span class="mk-sub"><%= p.comments_pending %> en attente</span><% } %><% } else { %><%= p.comments_enabled ? "0" : "Fermés" %><% } %></td>
            <td data-label="Date"><%= p.status === "published" ? fd(p.published_at) : fd(p.created_at) %></td><td data-label="Modifié"><%= fd(p.updated_at) %></td>
            <td class="mk-row-actions mk-cms-actions-col"><div class="mk-cms-rowbtns">
              <% if (canWrite && mine(p) && isCreator && !inTrash) { %><a class="btn btn-outline btn-sm" href="/formateur/blog/<%= p.id %>/modifier">Modifier</a><% } %>
              <% if (canWrite && mine(p) && inTrash) { %><form class="mk-inline" action="/marketing/site-web/articles/<%= p.id %>/restaurer" method="post"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" class="btn btn-outline btn-sm">Restaurer</button></form><% } %>
              <div class="mk-dropdown" data-mk-dropdown>
                <button type="button" class="btn btn-ghost btn-sm mk-cms-more" aria-haspopup="menu" aria-expanded="false" aria-controls="<%= menuId %>" aria-label="Plus d'actions pour « <%= p.title %> »"><%- icon("moreHorizontal", { size: 18 }) %></button>
                <div class="mk-menu" id="<%= menuId %>" role="menu" hidden>
                  <% if (mk.can("revisions.view") && mine(p)) { %><a role="menuitem" href="/marketing/site-web/historique/post/<%= p.id %>">Historique</a><% } %>
                  <% if (isCreator && mine(p)) { %><a role="menuitem" href="/formateur/blog/<%= p.id %>/modifier">Ouvrir dans l'éditeur</a><% if (!inTrash) { %><a role="menuitem" href="/formateur/blog/<%= p.id %>/apercu" target="_blank" rel="noopener">Prévisualiser</a><% } %><% } %>
                  <% if (!inTrash && p.status === "published") { %><a role="menuitem" href="<%= BLOG_BASE %>/<%= p.slug %>" target="_blank" rel="noopener">Voir l'article en ligne</a><% } %>
                  <% if (!inTrash && canWrite && mine(p)) { %>
                    <% if (canPublish && p.status !== "published") { %><form action="/marketing/site-web/articles/<%= p.id %>/publier" method="post" role="none"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" role="menuitem">Publier maintenant</button></form><% } %>
                    <% if (canPublish && (p.status === "published" || p.status === "scheduled")) { %><form action="/marketing/site-web/articles/<%= p.id %>/depublier" method="post" role="none"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" role="menuitem">Remettre en brouillon</button></form><% } %>
                    <form action="/marketing/site-web/articles/<%= p.id %>/dupliquer" method="post" role="none"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" role="menuitem">Dupliquer</button></form>
                    <form action="/marketing/site-web/articles/<%= p.id %>/corbeille" method="post" role="none"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" role="menuitem" data-mk-confirm="L'article « <%= p.title %> » passera hors ligne et ira à la corbeille. Vous pourrez le restaurer.">Mettre à la corbeille</button></form>
                  <% } %>
                  <% if (inTrash && canDelete) { %><form action="/marketing/site-web/articles/<%= p.id %>/supprimer" method="post" role="none"><input type="hidden" name="retour" value="<%= here %>"><button type="submit" role="menuitem" data-mk-confirm="« <%= p.title %> » sera supprimé définitivement, avec ses versions. Cette action est irréversible.">Supprimer définitivement</button></form><% } %>
                </div>
              </div>
            </div></td></tr>
        <% }) %></tbody>
      </table></div>
      <nav class="mk-cms-pager" aria-label="Pagination">
        <span><%= result.total %> article<%= result.total > 1 ? "s" : "" %></span>
        <% if (result.pages > 1) { %><span class="mk-cms-pager-nav">
          <% if (result.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= here + keep({ page: result.page - 1 }) %>">Précédent</a><% } %>
          <span>Page <%= result.page %> sur <%= result.pages %></span>
          <% if (result.page < result.pages) { %><a class="btn btn-ghost btn-sm" href="<%= here + keep({ page: result.page + 1 }) %>">Suivant</a><% } %></span><% } %>
      </nav>
    <% } %>

    <% if (canWrite && isCreator) { %>
      <dialog class="mk-dialog mk-modal" id="nouvel-article" data-mk-modal aria-labelledby="ar-new-title">
        <form action="/marketing/site-web/articles" method="post">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="ar-new-title">Nouvel article</h2><p class="mk-dialog-desc">Donnez-lui un titre : l'article est créé en brouillon, puis l'éditeur s'ouvre. Rien n'est en ligne avant la publication.</p></div>
            <button type="button" class="mk-dialog-close" data-mk-modal-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><div class="field-group"><label for="ar-new-name">Titre de l'article *</label><input id="ar-new-name" type="text" name="title" maxlength="150" required placeholder="Comment réussir son référencement naturel"></div></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-mk-modal-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Créer et ouvrir l’éditeur</button></div>
        </form>
      </dialog>
    <% } %>
<%- include("partials/bottom") %>
