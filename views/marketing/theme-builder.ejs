<%- include("partials/top", { title, active }) %>
<link rel="stylesheet" href="/css/site-wizard.css">
<link rel="stylesheet" href="<%= asset('/css/theme-builder.css') %>">
<div class="sw tb" id="tb" data-base="<%= base %>" data-write="<%= perms.write ? 1 : 0 %>" data-remove="<%= perms.remove ? 1 : 0 %>">
  <header class="tb-bar">
    <span class="tb-logo" aria-hidden="true">K</span><span class="tb-brand">Theme Builder</span><span class="tb-site"><%= siteName %></span>
    <div class="tb-theme" id="tb-theme" role="radiogroup" aria-label="Thème de l'interface">
      <button type="button" role="radio" aria-checked="false" data-tb-theme="light" title="Mode clair"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg><span class="sr-only">Clair</span></button>
      <button type="button" role="radio" aria-checked="false" data-tb-theme="dark" title="Mode sombre"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/></svg><span class="sr-only">Sombre</span></button>
      <button type="button" role="radio" aria-checked="false" data-tb-theme="auto" title="Automatique (suit votre appareil)"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="11" rx="1.5"/><path d="M9 20h6M12 16v4"/></svg><span class="sr-only">Automatique</span></button>
    </div>
    <a class="tb-close" id="tb-exit" href="<%= backUrl %>" aria-label="Retour <%= backIsCustom ? 'à l\'écran précédent' : 'au tableau de bord de « ' + siteName + ' »' %>"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Retour</span></a>
  </header>
  <div class="tb-layout">
    <nav class="tb-side" aria-label="Types de modèles"><ul id="tb-types"></ul></nav>
    <main class="tb-main" id="tb-main">
      <div class="tb-head">
        <div class="tb-head-text"><button type="button" class="tb-back" id="tb-back" hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span id="tb-back-l">Retour</span></button><h1 id="tb-title">Personnalisez chaque partie de votre site</h1><p class="tb-lead" id="tb-lead"></p></div>
        <div class="tb-top-actions">
          <% if (perms.write) { %><button class="btn btn-primary" type="button" id="tb-new">Ajouter un modèle</button>
          <% } %><button class="btn btn-outline" type="button" id="tb-lib-open">Bibliothèque de modèles</button>
          <% if (perms.write) { %>
          <label class="btn btn-outline" for="tb-import">Importer<input id="tb-import" type="file" accept="application/json,.json" hidden></label>
          <button class="btn btn-outline" type="button" id="tb-legacy" title="Reprendre l'en-tête, le pied de page et les modèles de thème déjà configurés pour ce site">Récupérer l'existant</button><% } %>
        </div>
      </div>
      <form class="tb-tools" id="tb-tools" role="search" aria-label="Filtrer les modèles">
        <label class="sw-field">Recherche<input type="search" id="tb-q" maxlength="80" placeholder="Nom ou type  ( / )" autocomplete="off"></label>
        <label class="sw-field">État<select id="tb-st"><option value="">Tous (hors archives)</option><option value="published">Publiés</option><option value="draft">Brouillons</option><option value="archived">Archivés</option></select></label>
        <label class="sw-field">Trier par<select id="tb-sort"><option value="recent">Modifiés récemment</option><option value="name">Nom (A → Z)</option><option value="status">État</option></select></label>
        <button class="btn btn-outline" type="button" id="tb-why">Pourquoi ce modèle ?</button>
        <div class="tb-views" role="group" aria-label="Mode d'affichage">
          <button type="button" id="tb-v-grid" data-view="grid" aria-pressed="true" aria-label="Affichage en grille" title="Grille ( v )"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2"/></svg></button>
          <button type="button" id="tb-v-list" data-view="list" aria-pressed="false" aria-label="Affichage en liste" title="Liste ( v )"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg></button>
        </div>
      </form>
      <div class="tb-status" id="tb-status" role="status" aria-live="polite"></div>
      <section id="tb-conflicts" class="tb-conflicts" aria-label="Conflits" hidden></section>
      <h2 class="tb-mine-h" id="tb-mine-h" hidden>Mes modèles</h2>
      <div class="tb-cards" id="tb-cards" data-view="grid" aria-live="polite" aria-busy="false"></div>
      <section class="tb-cat" id="tb-cat" aria-labelledby="tb-cat-h" hidden>
        <div class="tb-cat-head"><h2 id="tb-cat-h">Modèles prédéfinis</h2><span class="tb-cat-count" id="tb-cat-count"></span></div>
        <p class="tb-cat-none sw-muted" id="tb-cat-none" hidden></p>
        <div id="tb-cat-body" hidden>
          <p class="sw-muted tb-cat-lead">Parcourez, prévisualisez puis ajoutez un modèle à votre site. « Utiliser ce modèle » crée votre copie en brouillon : rien n'est publié et vos modèles existants restent intacts.</p>
          <form class="tb-tools tb-cat-tools" id="tb-cat-tools" role="search" aria-label="Filtrer les modèles prédéfinis">
            <label class="sw-field">Recherche<input type="search" id="tb-cat-q" maxlength="80" placeholder="Nom, style, usage…" autocomplete="off"></label>
            <label class="sw-field">Identité<select id="tb-cat-skin"><option value="">Toutes les identités</option></select></label>
            <label class="sw-field">Mise en page<select id="tb-cat-layout"><option value="">Toutes les mises en page</option></select></label>
          </form>
          <p class="tb-cat-status" id="tb-cat-status" role="status" hidden></p>
          <div class="tb-cards tb-cat-cards" id="tb-cat-cards" aria-busy="false"></div>
          <div class="tb-lib-pager tb-cat-pager" id="tb-cat-pager" hidden><button class="btn btn-sm btn-outline" type="button" id="tb-cat-prev">Précédent</button><span id="tb-cat-page"></span><button class="btn btn-sm btn-outline" type="button" id="tb-cat-next">Suivant</button></div>
        </div>
      </section>
    </main>
  </div>

  <dialog id="tb-dlg-new" aria-labelledby="tb-dlg-new-h"><form method="dialog" id="tb-form-new">
    <h2 id="tb-dlg-new-h">Nouveau modèle</h2>
    <label class="sw-field">Type<select id="tb-new-type" required></select></label>
    <label class="sw-field">Nom<input id="tb-new-name" required maxlength="100"></label>
    <p class="sw-muted">Le modèle est créé en brouillon ; vous le modifiez ensuite dans l'éditeur de pages puis le publiez.</p>
    <div class="tb-dlg-actions"><button class="btn btn-outline" value="cancel" type="button" data-close>Annuler</button><button class="btn btn-primary" type="submit">Créer et ouvrir l'éditeur</button></div>
  </form></dialog>

  <dialog id="tb-lib" class="tb-prev tb-lib" aria-labelledby="tb-lib-h">
    <header class="tb-prev-bar">
      <button type="button" class="tb-back" id="tb-lib-back"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Retour</span></button>
      <div class="tb-prev-title"><h2 id="tb-lib-h">Bibliothèque de modèles</h2><p class="tb-prev-sub" id="tb-lib-sub">100 modèles par type, prêts à personnaliser. « Utiliser » crée votre propre copie en brouillon.</p></div>
    </header>
    <form class="tb-tools tb-lib-tools" id="tb-lib-tools" role="search" aria-label="Filtrer la bibliothèque">
      <label class="sw-field">Type<select id="tb-lib-type"></select></label>
      <label class="sw-field">Recherche<input type="search" id="tb-lib-q" maxlength="80" placeholder="Nom, style, usage…" autocomplete="off"></label>
      <label class="sw-field">Identité<select id="tb-lib-skin"><option value="">Toutes</option></select></label>
      <label class="sw-field">Mise en page<select id="tb-lib-layout"><option value="">Toutes</option></select></label>
      <div class="tb-views" role="group" aria-label="Mode d'affichage">
        <button type="button" data-lview="grid" aria-pressed="true" aria-label="Grille" title="Grille"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2"/></svg></button>
        <button type="button" data-lview="list" aria-pressed="false" aria-label="Liste" title="Liste"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg></button>
      </div>
    </form>
    <div class="tb-status" id="tb-lib-status" role="status" aria-live="polite"></div>
    <div class="tb-lib-body"><div class="tb-cards" id="tb-lib-cards" data-view="grid" aria-live="polite"></div></div>
    <nav class="tb-lib-pager" aria-label="Pagination de la bibliothèque"><button class="btn btn-outline btn-sm" type="button" id="tb-lib-prev">Précédent</button><span id="tb-lib-page" aria-live="polite"></span><button class="btn btn-outline btn-sm" type="button" id="tb-lib-next">Suivant</button></nav>
  </dialog>

  <dialog id="tb-dlg-ren" aria-labelledby="tb-dlg-ren-h"><form method="dialog" id="tb-form-ren">
    <h2 id="tb-dlg-ren-h">Renommer le modèle</h2>
    <label class="sw-field">Nom<input id="tb-ren-name" required maxlength="100"></label>
    <div class="tb-dlg-actions"><button class="btn btn-outline" type="button" data-close>Annuler</button><button class="btn btn-primary" type="submit">Renommer</button></div>
  </form></dialog>

  <dialog id="tb-prev" class="tb-prev" aria-labelledby="tb-prev-h">
    <header class="tb-prev-bar">
      <button type="button" class="tb-back" id="tb-prev-back"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Retour aux modèles</span></button>
      <div class="tb-prev-title"><h2 id="tb-prev-h">Aperçu</h2><p id="tb-prev-sub" class="tb-prev-sub"></p></div>
      <div class="tb-devices" role="group" aria-label="Appareil">
        <button type="button" data-dev="desktop" aria-pressed="true">Ordinateur</button><button type="button" data-dev="tablet" aria-pressed="false">Tablette</button><button type="button" data-dev="mobile" aria-pressed="false">Mobile</button>
      </div>
      <label class="sw-field tb-prev-page" id="tb-prev-pagew" hidden>Page d'exemple<select id="tb-prev-page"></select></label>
      <a class="btn btn-outline btn-sm" id="tb-prev-open" target="_blank" rel="noopener">Ouvrir dans un onglet</a>
      <a class="btn btn-primary btn-sm" id="tb-prev-edit">Modifier</a>
    </header>
    <div class="tb-prev-stage" id="tb-prev-stage"><div class="tb-prev-wrap" id="tb-prev-wrap"><iframe id="tb-prev-frame" title="Aperçu du modèle" referrerpolicy="same-origin"></iframe></div>
      <div class="tb-prev-load" id="tb-prev-load" role="status">Chargement de l'aperçu…</div></div>
    <p class="tb-prev-note">Rendu du modèle tel qu'il est enregistré. Les contenus dynamiques (article, produit, archive) affichent le contenu d'exemple du modèle.</p>
  </dialog>

  <dialog id="tb-dlg-cond" aria-labelledby="tb-dlg-cond-h"><form method="dialog" id="tb-form-cond">
    <h2 id="tb-dlg-cond-h">Conditions d'affichage</h2>
    <p class="sw-muted">Le modèle s'affiche si <strong>une</strong> inclusion correspond et qu'<strong>aucune</strong> exclusion ne correspond. Sans condition : tout le site. Les critères d'une même ligne se combinent (ET).</p>
    <h3>Afficher sur</h3><div id="tb-inc" class="tb-rows"></div><button class="btn btn-sm" type="button" id="tb-add-inc">+ Ajouter une inclusion</button>
    <h3>Sauf sur</h3><div id="tb-exc" class="tb-rows"></div><button class="btn btn-sm" type="button" id="tb-add-exc">+ Ajouter une exclusion</button>
    <p class="tb-warn" id="tb-cond-msg" role="alert" hidden></p>
    <div class="tb-dlg-actions"><button class="btn btn-outline" type="button" data-close>Annuler</button><button class="btn btn-primary" type="submit">Enregistrer</button></div>
  </form></dialog>

  <dialog id="tb-dlg-info" aria-labelledby="tb-dlg-info-h"><div>
    <h2 id="tb-dlg-info-h">Détails</h2><div id="tb-info"></div>
    <div class="tb-dlg-actions"><button class="btn btn-primary" type="button" data-close>Fermer</button></div>
  </div></dialog>

  <dialog id="tb-dlg-why" aria-labelledby="tb-dlg-why-h"><form method="dialog" id="tb-form-why">
    <h2 id="tb-dlg-why-h">Pourquoi ce modèle ?</h2>
    <p class="sw-muted">Simulez une page de votre site : le moteur dit quel modèle gagne et pourquoi les autres sont écartés. Rien n'est modifié.</p>
    <div class="tb-grid2">
      <label class="sw-field">Type<select id="tb-why-type"></select></label>
      <label class="sw-field">Page vue<select id="tb-why-view"><option value="front">Accueil</option><option value="page">Page</option><option value="post">Article</option><option value="archive">Archive</option><option value="search">Recherche</option><option value="not_found">404</option><option value="product">Produit</option><option value="product_archive">Archive produits</option></select></label>
      <label class="sw-field">Identifiant du contenu<input id="tb-why-id" inputmode="numeric"></label>
      <label class="sw-field">Catégories (virgules)<input id="tb-why-cat"></label>
      <label class="sw-field">Étiquettes (virgules)<input id="tb-why-tag"></label>
      <label class="sw-field">Archive<select id="tb-why-arch"><option value="">—</option><option value="blog">Blog</option><option value="category">Catégorie</option><option value="tag">Étiquette</option><option value="author">Auteur</option><option value="search">Recherche</option><option value="shop">Boutique</option></select></label>
      <label class="sw-field">Nom de l'archive<input id="tb-why-name"></label>
    </div>
    <div id="tb-why-out" aria-live="polite"></div>
    <div class="tb-dlg-actions"><button class="btn btn-outline" type="button" data-close>Fermer</button><button class="btn btn-primary" type="submit">Simuler</button></div>
  </form></dialog>
</div>
<script src="<%= asset('/js/theme-builder.js') %>" defer></script>
<%- include("partials/bottom") %>
