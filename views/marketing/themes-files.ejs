<%#
  KOLAKISA CMS → Apparence → Éditeur de fichiers des thèmes. Les « fichiers » sont les vues JSON du manifeste d'un thème installé SUR CE SITE (aucun accès au disque) ;
  voir src/services/themeFiles.js. Le contenu initial est rendu côté serveur ; public/js/cms-theme-files.js charge l'éditeur de code et gère l'ouverture, l'enregistrement et l'historique.
%><%- include("partials/top", { title, active }) %>
<%
  const initial = first ? { theme: chosen.key, path: first.path, etag: first.etag, language: first.language, editable: first.editable && canWrite, generated: first.generated } : null;
  const dirs = tree ? [...new Set(tree.files.map((f) => f.dir))] : [];
  const itemClass = (f) => (first && f.path === first.path ? "tf-item is-current" : "tf-item");
  const stateLabel = chosen ? (chosen.state === "active" ? "Actif" : chosen.state === "incompatible" ? "Incompatible" : "Inactif") : "";
%>
<div class="tf" data-tf-root data-tf-site="<%= T.siteId || "" %>" data-tf-base="<%= BASE %>/fichiers" data-tf-can-write="<%= canWrite ? "1" : "0" %>"<%- initial ? ` data-tf-init='${JSON.stringify(initial).replace(/'/g, "&#39;")}'` : "" %>>
  <header class="kx-hero is-compact tf-hero">
    <div class="kx-hero-body">
      <p class="kx-eyebrow"><%= T.name %></p>
      <h1>Éditeur de fichiers des thèmes</h1>
      <p class="kx-hero-lead">Consultez et modifiez les fichiers de configuration d'un thème installé sur ce site. Un thème Kolakisa ne contient que des données de design : aucun code PHP ni script n'est exécuté.</p>
    </div>
    <div class="kx-hero-art" aria-hidden="true"><%- illu("themes") %></div>
  </header>

  <% if (typeof gate !== "undefined" && gate) { %>
  <%# Avertissement obligatoire AVANT l'éditeur : aucun contenu de fichier, aucun script d'édition n'est envoyé tant que la personne n'a pas confirmé (voir la route POST /fichiers/acces). %>
  <dialog class="tf-warn" data-tf-gate open aria-labelledby="tf-warn-title" aria-describedby="tf-warn-desc" data-tf-back="<%= backHref %>">
    <form method="post" action="<%= BASE %>/fichiers/acces<%= T.siteId ? "?site=" + T.siteId : "" %>" data-tf-gate-form>
      <% if (T.siteId) { %><input type="hidden" name="site" value="<%= T.siteId %>"><% } %>
      <input type="hidden" name="theme" value="<%= carry.theme %>"><input type="hidden" name="fichier" value="<%= carry.fichier %>">
      <div class="tf-warn-head"><span class="tf-warn-icon" aria-hidden="true"><%- icon("alertTriangle", { size: 22 }) %></span><h2 id="tf-warn-title">Attention : modification des fichiers d'un thème</h2></div>
      <div id="tf-warn-desc" class="tf-warn-body">
        <p>La modification directe des fichiers d'un thème est une opération avancée qui peut affecter le fonctionnement, la sécurité et la stabilité de votre site.</p>
        <p>Une modification incorrecte peut provoquer des erreurs, rendre certaines fonctionnalités indisponibles ou empêcher le site de s'afficher correctement.</p>
        <p>Les modifications effectuées directement dans les fichiers peuvent également être écrasées lors d'une mise à jour du thème.</p>
        <h3>Conseils de sécurité</h3>
        <ul>
          <li>Effectuez une sauvegarde vérifiée avant toute modification.</li>
          <li>Testez les changements dans un environnement de préproduction lorsque cela est possible.</li>
          <li>Ne modifiez que les fichiers que vous comprenez.</li>
          <li>Privilégiez les paramètres du thème (Personnaliser, Styles) lorsqu'ils permettent d'obtenir le même résultat.</li>
          <li>En cas de problème, assurez-vous de disposer d'une méthode de restauration : l'historique des versions de chaque fichier.</li>
        </ul>
      </div>
      <div class="tf-warn-actions">
        <a class="btn btn-outline" href="<%= backHref %>" data-tf-gate-back>Retour en sécurité</a>
        <button type="submit" class="btn btn-primary" data-tf-gate-continue>Je comprends les risques, continuer</button>
      </div>
    </form>
  </dialog>
  <% } else if (!chosen || !tree) { %>
    <%- include("partials/kx-empty", { art: "themes", title: "Aucun thème à afficher", text: "Installez un thème pour pouvoir consulter ses fichiers.", primary: { label: "Ajouter un thème", href: to("/ajouter") } }) %>
  <% } else { %>
  <% if (readOnly) { %><div class="mk-th-notice mk-th-notice--warn" role="status"><p>Ce site est archivé ou supprimé : les fichiers sont en consultation seule.</p></div><% } else if (!canWrite) { %><div class="mk-th-notice" role="status"><p>Vous pouvez consulter les fichiers ; la modification demande le droit de publier l'apparence.</p></div><% } %>

  <section class="tf-shell" aria-label="Éditeur de fichiers">
    <div class="tf-bar">
      <div class="tf-bar-main">
        <label class="tf-theme-label" for="tf-theme">Thème</label>
        <select id="tf-theme" class="tf-theme-select" data-tf-theme>
          <% themesList.forEach((th) => { %><option value="<%= th.key %>"<%= th.key === chosen.key ? " selected" : "" %>><%= th.name %> · <%= th.state === "active" ? "actif" : th.state === "incompatible" ? "incompatible" : "inactif" %><%= th.version ? " · v" + th.version : "" %></option><% }) %>
        </select>
        <span class="mk-status <%= chosen.state === "active" ? "mk-status-ok" : chosen.state === "incompatible" ? "mk-status-warn" : "mk-status-off" %>" data-tf-theme-state><%= stateLabel %></span>
        <span class="tf-sep" aria-hidden="true"></span>
        <span class="tf-file" data-tf-file-name><%= first ? first.path : "" %></span>
        <span class="tf-doc is-saved" data-tf-doc role="status" aria-live="polite"><span class="tf-dot" aria-hidden="true"></span><span data-tf-doc-text>Enregistré</span></span>
      </div>
      <div class="tf-bar-actions">
        <button type="button" class="btn btn-ghost btn-sm" data-tf-help aria-expanded="false" aria-controls="tf-help"><%- icon("info", { size: 16 }) %>Aide et sécurité</button>
        <button type="button" class="btn btn-outline btn-sm" data-tf-history aria-expanded="false" aria-controls="tf-history" disabled><%- icon("clock", { size: 16 }) %>Historique</button>
        <button type="button" class="btn btn-outline btn-sm" data-tf-revert disabled>Annuler les modifications</button>
        <button type="button" class="btn btn-primary btn-sm" data-tf-save disabled><%- icon("checkCircle", { size: 16 }) %>Enregistrer</button>
      </div>
    </div>

    <section id="tf-help" class="tf-panel" hidden aria-label="Aide et sécurité">
      <h2>Comment ça marche</h2>
      <ul>
        <li><strong>Fichiers de CE site.</strong> Ce sont des vues JSON du thème installé sur « <%= T.name %> » ; modifier un thème ici ne change ni les autres sites ni les fichiers du serveur.</li>
        <li><strong>Validation.</strong> Chaque enregistrement est validé par le moteur de thèmes (JSON réel, couleurs, tailles, polices). Un contenu invalide est refusé et le thème reste inchangé.</li>
        <li><strong>Thème actif.</strong> Enregistrer un fichier du thème actif met à jour le site public ; le rendu est vérifié, sinon l'état précédent est rétabli.</li>
        <li><strong>Conflits.</strong> Si le fichier a changé depuis son ouverture, l'enregistrement est refusé et votre texte est conservé.</li>
        <li><strong>Historique.</strong> Chaque enregistrement conserve une version (50 au plus par fichier) que vous pouvez consulter et restaurer ; une restauration crée une nouvelle version.</li>
        <li><strong>Lecture seule.</strong> <code>style.css</code> est généré à partir des jetons ; le thème d'origine de Kolakisa est intégré au moteur et ne se modifie pas. L'éditeur visuel et les modèles de pages restent l'outil normal pour construire les pages.</li>
      </ul>
    </section>

    <div class="tf-body" data-tf-body>
      <aside class="tf-side" aria-label="Fichiers du thème">
        <label class="tf-search"><span class="sr-only">Rechercher un fichier</span><%- icon("search", { size: 16 }) %><input type="search" placeholder="Rechercher un fichier…" data-tf-search autocomplete="off"></label>
        <nav class="tf-tree" data-tf-tree aria-label="Arborescence">
          <ul>
            <% tree.files.filter((f) => !f.dir).forEach((f) => { %><li><button type="button" class="<%= itemClass(f) %>" data-tf-path="<%= f.path %>" <%- first && f.path === first.path ? 'aria-current="true"' : "" %>><%- icon("fileText", { size: 15 }) %><span class="tf-item-name"><%= f.name %></span><% if (!f.editable) { %><span class="tf-lock" title="Lecture seule"><%- icon("eye", { size: 13 }) %></span><% } %></button></li><% }) %>
            <% dirs.filter(Boolean).forEach((d) => { %><li class="tf-dir is-open" data-tf-dir="<%= d %>">
              <button type="button" class="tf-dir-btn" aria-expanded="true" data-tf-dir-toggle><%- icon("chevronRight", { size: 14, className: "tf-caret" }) %><%- icon("layers", { size: 15 }) %><span><%= d %></span></button>
              <ul><% tree.files.filter((f) => f.dir === d).forEach((f) => { %><li><button type="button" class="<%= itemClass(f) %>" data-tf-path="<%= f.path %>" <%- first && f.path === first.path ? 'aria-current="true"' : "" %>><%- icon("fileText", { size: 15 }) %><span class="tf-item-name"><%= f.name %></span><% if (!f.editable) { %><span class="tf-lock" title="Lecture seule"><%- icon("eye", { size: 13 }) %></span><% } %></button></li><% }) %></ul>
            </li><% }) %>
          </ul>
          <p class="tf-none" data-tf-none hidden>Aucun fichier ne correspond.</p>
        </nav>
      </aside>
      <div class="tf-resize" data-tf-resize role="separator" aria-orientation="vertical" aria-label="Redimensionner l'explorateur" aria-valuemin="180" aria-valuemax="460" aria-valuenow="260" tabindex="0"></div>
      <div class="tf-main">
        <div class="tf-pathbar"><span class="tf-path" data-tf-path-label><%= first ? first.path : "" %></span><span class="tf-badge" data-tf-ro hidden>Lecture seule</span></div>
        <div class="tf-editor" data-tf-editor>
          <textarea class="tf-fallback" data-tf-fallback readonly aria-label="Contenu du fichier"><%= first ? first.content : "" %></textarea>
        </div>
        <div class="tf-alert" data-tf-alert role="alert" hidden></div>
        <div class="tf-foot"><span data-tf-lang><%= first ? first.language.toUpperCase() : "" %></span><span data-tf-lines></span><span data-tf-size></span><span class="tf-foot-hint">Ctrl/Cmd+S enregistrer · Ctrl/Cmd+F rechercher</span></div>
      </div>
    </div>

    <section id="tf-history" class="tf-panel" hidden aria-label="Historique du fichier">
      <h2>Historique de <span data-tf-history-file></span></h2>
      <p class="field-hint" data-tf-history-empty hidden>Aucune version enregistrée pour ce fichier : la première modification créera la version d'origine.</p>
      <ul class="tf-versions" data-tf-versions></ul>
      <div class="tf-version-view" data-tf-version-view hidden>
        <p class="field-hint" data-tf-version-title></p>
        <pre class="tf-version-code" data-tf-version-code tabindex="0"></pre>
        <div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-tf-restore>Restaurer cette version</button><button type="button" class="btn btn-ghost btn-sm" data-tf-version-close>Fermer</button></div>
      </div>
    </section>
  </section>

  <dialog class="tf-dialog" data-tf-dialog aria-labelledby="tf-dialog-title">
    <form method="dialog">
      <h2 id="tf-dialog-title">Modifications non enregistrées</h2>
      <p data-tf-dialog-text>Ce fichier contient des modifications non enregistrées.</p>
      <div class="mk-actions">
        <button type="submit" value="save" class="btn btn-primary btn-sm" data-tf-dialog-save>Enregistrer puis continuer</button>
        <button type="submit" value="discard" class="btn btn-outline btn-sm">Abandonner les modifications</button>
        <button type="submit" value="cancel" class="btn btn-ghost btn-sm" autofocus>Annuler</button>
      </div>
    </form>
  </dialog>
  <% } %>
</div>
<%- include("partials/bottom") %>
