<%#
  KOLAKISA CMS → Navigation → un menu (palier 7) : ajouter des éléments (recherche réelle côté serveur), organiser (boutons et
  glisser-déposer, enregistrés en base), réglages du menu, emplacements. La structure est rendue par nav-item.ejs (récursif).
%><%- include("partials/top", { title, active }) %>
<%
  const typeSearch = [["page", "Pages"], ["article", "Articles"], ["category", "Catégories"], ["tag", "Étiquettes"]];
%>
    <div class="mk-head"><h1><%= menu.name %></h1>
      <div class="mk-actions"><a class="btn btn-outline btn-sm" href="<%= BASE %>">← Tous les menus</a>
        <% if (canWrite) { %><form method="post" action="<%= BASE %>/menus/<%= menu.id %>/dupliquer" class="mk-inline"><button type="submit" class="btn btn-outline btn-sm">Dupliquer</button></form><% } %>
        <% if (canDelete) { %><form id="menu-del" method="post" action="<%= BASE %>/menus/<%= menu.id %>/supprimer" class="mk-inline"><button type="submit" class="btn btn-outline btn-sm mk-btn-danger-outline" data-mk-confirm="Le menu « <%= menu.name %> » et ses <%= count %> élément<%= count > 1 ? "s" : "" %> seront supprimés<%= Object.keys(assigned).some((k) => assigned[k] === menu.id) ? " ; ses emplacements reviendront à l'affichage d'origine" : "" %>. Les pages, articles et catégories ne sont pas touchés." data-mk-confirm-title="Supprimer ce menu ?" data-mk-confirm-ok="Supprimer le menu">Supprimer</button></form><% } %></div></div>
    <p class="mk-lead"><span class="mk-status <%= menu.status === "published" ? "mk-status-ok" : "mk-status-off" %>"><%= menu.status === "published" ? "Publié" : "Brouillon" %></span>
      <%= count %> élément<%= count > 1 ? "s" : "" %><% if (broken) { %> · <strong class="mk-nav-warn"><%= broken %> lien<%= broken > 1 ? "s" : "" %> à réparer</strong><% } %>
      · Emplacements : <%= Object.keys(assigned).filter((k) => assigned[k] === menu.id).map((k) => locations[k].label).join(", ") || "aucun" %></p>

    <div class="mk-nav-layout">
      <% if (canWrite) { %>
      <aside class="mk-nav-add" aria-label="Ajouter des éléments">
        <h2>Ajouter des éléments</h2>
        <% typeSearch.forEach(([type, label]) => { %>
        <details class="mk-nav-section"<%= type === "page" ? " open" : "" %>><summary><%= label %></summary>
          <form method="post" action="<%= BASE %>/menus/<%= menu.id %>/elements" data-nav-picker data-type="<%= type %>">
            <input type="hidden" name="type" value="<%= type %>">
            <label class="sr-only" for="ns-<%= type %>">Rechercher parmi : <%= label.toLowerCase() %></label>
            <input id="ns-<%= type %>" type="search" placeholder="Rechercher…" autocomplete="off" data-nav-search>
            <ul class="mk-nav-results" data-nav-results aria-live="polite"></ul>
            <button type="submit" class="btn btn-outline btn-sm" disabled>Ajouter au menu</button>
          </form>
        </details>
        <% }) %>
        <details class="mk-nav-section"><summary>Accueil</summary>
          <form method="post" action="<%= BASE %>/menus/<%= menu.id %>/elements"><input type="hidden" name="type" value="home"><button type="submit" class="btn btn-outline btn-sm">Ajouter « Accueil »</button></form></details>
        <details class="mk-nav-section"><summary>Lien personnalisé</summary>
          <form method="post" action="<%= BASE %>/menus/<%= menu.id %>/elements" class="mk-form">
            <input type="hidden" name="type" value="custom">
            <div class="field-group"><label for="cu-label">Texte du lien *</label><input id="cu-label" type="text" name="label" maxlength="80" required></div>
            <div class="field-group"><label for="cu-url">Adresse *</label><input id="cu-url" type="text" name="url" maxlength="500" required placeholder="/contact, https://… ou #tarifs"><span class="field-hint">Page du site (/contact), site externe (https://…), ancre (#tarifs ou /page#tarifs), mailto: ou tel:.</span></div>
            <label class="mk-cms-check"><input type="checkbox" name="new_tab" value="1"> Ouvrir dans un nouvel onglet</label>
            <button type="submit" class="btn btn-outline btn-sm">Ajouter au menu</button>
          </form></details>
      </aside>
      <% } %>

      <section class="mk-nav-structure" aria-labelledby="structure-title">
        <h2 id="structure-title">Structure du menu</h2>
        <% if (canWrite && count > 1) { %><p class="field-hint">Glissez les éléments par la poignée pour les réorganiser (un élément déposé sur un autre devient son sous-élément), ou utilisez les flèches. <span data-nav-status role="status" aria-live="polite"></span></p><% } %>
        <% if (!count) { %><p class="mk-empty-line" data-nav-empty>Ce menu ne contient aucun élément.</p><% } %>
        <ol class="mk-nav-tree" data-nav-tree data-site="<%= navSite === null ? "" : navSite %>" data-menu="<%= menu.id %>" data-max-depth="<%= maxDepth %>" data-save="<%= BASE %>/menus/<%= menu.id %>/organiser" data-can-write="<%= canWrite ? 1 : 0 %>">
          <% nodes.forEach((n) => { %><%- include("nav-item", { node: n, depth: 1, BASE, types, canWrite, REL }) %><% }) %>
        </ol>
      </section>
    </div>

    <section class="mk-nav-slots" aria-labelledby="menu-settings">
      <h2 id="menu-settings">Réglages du menu</h2>
      <form method="post" action="<%= BASE %>/menus/<%= menu.id %>" class="mk-form">
        <fieldset<%= canWrite ? "" : " disabled" %>>
          <div class="field-group"><label for="m-name">Nom</label><input id="m-name" type="text" name="name" value="<%= menu.name %>" maxlength="80" required></div>
          <div class="field-group"><label for="m-desc">Description</label><input id="m-desc" type="text" name="description" value="<%= menu.description %>" maxlength="300"></div>
          <div class="field-group"><label for="m-status">État</label><select id="m-status" name="status"><option value="published"<%= menu.status === "published" ? " selected" : "" %>>Publié</option><option value="draft"<%= menu.status === "draft" ? " selected" : "" %>>Brouillon (jamais affiché sur le site)</option></select></div>
        </fieldset>
        <% if (canWrite) { %><div class="mk-actions"><button type="submit" class="btn btn-primary btn-sm">Enregistrer</button></div><% } %>
      </form>
      <h3>Afficher ce menu sur le site</h3>
      <form method="post" action="<%= BASE %>/emplacements" class="mk-form">
        <input type="hidden" name="retour" value="<%= BASE %>/menus/<%= menu.id %>"><input type="hidden" name="menu" value="<%= menu.id %>">
        <% Object.values(locations).forEach((loc) => { const cur = assigned[loc.key]; %>
          <div class="field-group"><input type="hidden" name="<%= loc.key %>" value=""><label class="mk-cms-check"><input type="checkbox" name="<%= loc.key %>" value="<%= menu.id %>"<%= cur === menu.id ? " checked" : "" %><%= canPublish ? "" : " disabled" %>> <%= loc.label %></label>
            <span class="field-hint"><%= loc.hint %><% if (cur && cur !== menu.id) { %> Occupé par « <%= (menus.find((m) => m.id === cur) || {}).name %> » : cocher le remplace.<% } %></span></div>
        <% }) %>
        <% if (canPublish) { %><div class="mk-actions"><button type="submit" class="btn btn-primary btn-sm">Appliquer au site</button></div><% } else { %><p class="field-hint">Seuls les administrateurs affectent un menu à un emplacement.</p><% } %>
      </form>
    </section>
<%- include("partials/bottom") %>
