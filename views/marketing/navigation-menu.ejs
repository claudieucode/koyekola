<%#
  KOLAKISA CMS → Apparence → Menus → un menu. L'éditeur (public/js/cms-navigation.js) est construit à partir du JSON #nm-data posé par le serveur :
  il garde la structure en mémoire et l'écrit EN UNE FOIS (« Enregistrer le menu », tout ou rien, version contrôlée). Aucune donnée simulée.
%><%- include("partials/top", { title, active }) %>
<div class="mk-nm" data-nm data-can-write="<%= canWrite ? "1" : "0" %>">
  <div class="mk-nm-head">
    <div class="mk-head-main">
      <p class="mk-nm-crumb"><a href="<%= BASE %><%= navSite === null ? "" : "?site=" + navSite %>">← Tous les menus</a></p>
      <h1 data-nm-title><%= menu.name %></h1>
      <% if (siblings.length > 1) { %><p class="mk-nm-switch"><label for="nm-pick">Menu à modifier</label>
        <select id="nm-pick" data-nm-pick>
          <% siblings.forEach(function (m) { %><option value="<%= BASE %>/menus/<%= m.id %><%= navSite === null ? "" : "?site=" + navSite %>"<%= m.id === menu.id ? " selected" : "" %>><%= m.name %></option><% }) %>
        </select></p><% } %>
      <p class="mk-head-sub" data-nm-summary><span class="mk-status <%= menu.status === "published" ? "mk-status-ok" : "mk-status-off" %>"><%= menu.status === "published" ? "Publié" : "Brouillon" %></span>
        <%= count %> élément<%= count > 1 ? "s" : "" %><% if (broken) { %> · <strong class="mk-nav-warn"><%= broken %> lien<%= broken > 1 ? "s" : "" %> à réparer</strong><% } %> · Emplacements : <%= locNames.join(", ") || "aucun" %></p>
    </div>
    <div class="mk-nm-actions">
      <button type="button" class="mk-wd-btn" data-nm-preview>Aperçu</button>
      <% if (canWrite) { %><form method="post" action="<%= BASE %>/menus/<%= menu.id %>/dupliquer<%= navSite === null ? "" : "?site=" + navSite %>" class="mk-inline" data-nm-dirty-guard><button type="submit" class="mk-wd-btn">Dupliquer</button></form><% } %>
      <% if (canDelete) { %><form method="post" action="<%= BASE %>/menus/<%= menu.id %>/supprimer<%= navSite === null ? "" : "?site=" + navSite %>" class="mk-inline"><button type="submit" class="mk-wd-btn mk-wd-btn--danger" data-mk-confirm="Le menu « <%= menu.name %> » et ses <%= count %> élément<%= count > 1 ? "s" : "" %> seront supprimés ; ses emplacements reviendront à l'affichage d'origine. Les pages, articles et catégories ne sont pas touchés." data-mk-confirm-title="Supprimer ce menu ?" data-mk-confirm-ok="Supprimer le menu">Supprimer</button></form><% } %>
    </div>
  </div>

  <div class="mk-wd-bar mk-nm-bar" role="toolbar" aria-label="Enregistrement du menu">
    <p class="mk-wd-state" data-nm-state role="status" aria-live="polite">Aucune modification.</p>
    <div class="mk-wd-actions">
      <button type="button" class="mk-wd-btn" data-nm-undo disabled>Annuler</button>
      <button type="button" class="mk-wd-btn" data-nm-redo disabled>Rétablir</button>
      <% if (canWrite) { %><button type="button" class="mk-wd-btn mk-wd-btn--primary" data-nm-save disabled>Enregistrer le menu</button><% } else { %><span class="mk-wd-state">Lecture seule : vous ne pouvez pas modifier les menus.</span><% } %>
    </div>
  </div>
  <div class="mk-wd-banner" data-nm-banner hidden role="alert"><span data-nm-banner-text></span><button type="button" class="mk-wd-btn" data-nm-banner-action hidden></button></div>

  <noscript><p class="mk-wd-banner">L'éditeur de menus a besoin de JavaScript.</p></noscript>
  <p class="mk-wd-loading" data-nm-loading>Chargement du menu…</p>

  <div class="mk-nm-layout" data-nm-layout hidden>
    <% if (canWrite) { %><aside class="mk-nm-add" aria-labelledby="nm-add-title">
      <h2 id="nm-add-title">Ajouter des éléments</h2>
      <div data-nm-sections></div>
    </aside><% } %>

    <section class="mk-nm-structure" aria-labelledby="nm-structure-title">
      <h2 id="nm-structure-title">Structure du menu</h2>
      <div class="mk-nm-meta">
        <div class="field-group"><label for="nm-name">Nom du menu</label><input id="nm-name" type="text" maxlength="80" autocomplete="off" data-nm-name></div>
        <div class="field-group"><label for="nm-status">État</label><select id="nm-status" data-nm-status><option value="published">Publié</option><option value="draft">Brouillon (jamais affiché)</option></select></div>
        <div class="field-group mk-nm-meta-wide"><label for="nm-desc">Description</label><input id="nm-desc" type="text" maxlength="300" autocomplete="off" data-nm-desc></div>
      </div>
      <p class="field-hint" data-nm-help></p>
      <div data-nm-empty class="mk-empty-line" hidden>Ce menu ne contient aucun élément. Ajoutez des pages, des articles, des catégories ou des liens depuis le panneau « Ajouter des éléments ».</div>
      <ol class="mk-nm-tree" data-nm-tree aria-label="Éléments du menu"></ol>

      <h3 class="mk-nm-h3">Réglages du menu</h3>
      <fieldset class="mk-nm-slots" data-nm-locations><legend>Emplacements d'affichage</legend></fieldset>
    </section>
  </div>
  <p class="sr-only" role="status" aria-live="assertive" data-nm-live></p>

  <dialog class="mk-dialog mk-modal mk-nm-dialog" data-nm-dialog aria-labelledby="nm-preview-title">
    <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="nm-preview-title">Aperçu du menu</h2></div><button type="button" class="mk-dialog-close" data-nm-dialog-close aria-label="Fermer">×</button></header>
    <div class="mk-dialog-body"><p class="field-hint" data-nm-preview-note></p><div class="mk-nm-preview" data-nm-preview-body></div></div>
  </dialog>
  <script type="application/json" id="nm-data"><%- dataJson %></script>
</div>
<%- include("partials/bottom") %>
