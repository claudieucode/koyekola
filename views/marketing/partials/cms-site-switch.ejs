<%# Sélecteur de site de KOLAKISA CMS, placé en tête du menu latéral (comme l'espace de travail d'un outil SaaS) : le site ouvert reste visible en permanence.
    Mêmes classes et mêmes identifiants qu'auparavant (.mk-cms-site-btn, #mk-site-menu) ; la liste est filtrée par le serveur selon les droits. %>
<div class="mk-dropdown mk-cms-site" data-mk-dropdown>
  <button type="button" class="mk-cms-site-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="mk-site-menu" title="Changer de site">
    <span class="mk-cms-site-ico" aria-hidden="true"><%- icon("globe", { size: 16 }) %></span>
    <span class="mk-cms-site-text mk-nav-label"><small>Site</small><span class="mk-cms-site-name"><%= space ? space.name : cmsSites.length === 1 ? cmsSites[0].name : cmsSites.length ? "Tous les sites" : "Aucun site" %></span></span>
    <%- icon("chevronDown", { size: 14, className: "mk-cms-site-caret" }) %>
  </button>
  <div class="mk-menu" id="mk-site-menu" role="menu" hidden>
    <% if (!cmsSites.length) { %><span class="mk-cms-menu-note" role="none">Aucun site pour l'instant.</span><% } %>
    <%# Changer de site : uniquement les sites que cette personne a le droit d'ouvrir (liste filtrée par le serveur) ; le site principal est réservé à l'équipe de l'organisation %>
    <% if (mk.ctx.siteScope === undefined) { %><a role="menuitem" href="/marketing/site-web/principal/tableau-de-bord"<%- space && space.principal ? ' aria-current="true"' : "" %>>Site principal</a><% } %>
    <% cmsSites.forEach((s) => { %><a role="menuitem" href="/marketing/site-web/sites/<%= s.id %>/tableau-de-bord"<%- space && space.siteId === s.id ? ' aria-current="true"' : "" %>><%= s.name %></a><% }) %>
    <% if (mk.ctx.siteScope === undefined) { %><a role="menuitem" href="/marketing/site-web/sites">Gérer les sites</a><% } %>
  </div>
</div>
