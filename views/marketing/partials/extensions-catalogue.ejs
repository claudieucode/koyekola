<%#
  Catalogue des extensions : UNE seule liste de données, deux présentations (Galerie / Liste) qui ne diffèrent que par le CSS ; recherche, filtres et tri se font dans la page (public/js/extensions.js), sans rechargement.
  Paramètres : items, site, inSite, sites, totalSites, BASE, POSTBASE, preset ("", "on", "off"), CATEGORY.
%><%
  const here = (extra) => { const p = new URLSearchParams(); if (site && !inSite) p.set("site", site.id); Object.entries(extra || {}).forEach(([k, v]) => p.set(k, v)); const q = p.toString(); return q ? "?" + q : ""; };
  const cats = [...new Set(items.map((m) => m.category))];
  const fresh0 = (m) => m.added && (Date.now() - new Date(m.added).getTime()) < 30 * 864e5;
  const freshAll = items.every(fresh0);
  const fresh = (m) => fresh0(m) && !freshAll; // si tout est récent, le badge n'apprend rien
  const detailUrl = (m) => `${BASE}/detail/${m.id}${here()}`;
  const unavailable = (m) => m.availability === "unavailable" || m.maintenance !== "stable";
%>
<section class="xc" data-xc data-preset="<%= preset || '' %>" aria-label="Catalogue des extensions">
  <div class="xc-bar">
    <% if (!inSite && sites.length) { %><form method="get" action="<%= BASE %><%= preset === 'on' ? '/activees' : preset === 'off' ? '/desactivees' : '' %>" class="xc-sel xc-site"><span>Site</span><select name="site" data-xc-site><% sites.forEach((s) => { %><option value="<%= s.id %>" <%= site && site.id === s.id ? "selected" : "" %>><%= s.name %></option><% }) %></select><noscript><button class="btn btn-outline btn-sm" type="submit">Afficher</button></noscript></form><% } %>
    <label class="xc-search"><span class="sr-only">Rechercher une extension</span><%- icon("search", { size: 16 }) %><input type="search" data-xc-search placeholder="Rechercher…" autocomplete="off"></label>
    <label class="xc-sel"><span>Catégorie</span><select data-xc-cat><option value="">Toutes</option><% cats.forEach((c) => { %><option value="<%= c %>"><%= CATEGORY[c] || c %></option><% }) %></select></label>
    <% if (!preset) { %><label class="xc-sel"><span>État</span><select data-xc-state><option value="">Tous</option><option value="on">Activées</option><option value="off">Désactivées</option></select></label><% } %>
    <label class="xc-sel"><span>Tri</span><select data-xc-sort><option value="name">Nom (A → Z)</option><option value="added">Récemment ajoutées</option><option value="version">Version (récente d'abord)</option></select></label>
    <div class="xc-view" role="group" aria-label="Présentation du catalogue">
      <button type="button" class="xc-view-btn" data-xc-view="gallery" aria-pressed="true" title="Galerie"><%- icon("grid", { size: 16 }) %><span class="sr-only">Galerie</span></button>
      <button type="button" class="xc-view-btn" data-xc-view="list" aria-pressed="false" title="Liste"><%- icon("list", { size: 16 }) %><span class="sr-only">Liste</span></button>
    </div>
  </div>
  <p class="xc-count" role="status" aria-live="polite" data-xc-count></p>

  <ul class="xc-grid" data-xc-grid data-view="gallery">
    <li class="xc-row xc-head" aria-hidden="true"><span></span><span>Extension</span><span>Catégorie</span><span>Version</span><span>Éditeur</span><span>Disponibilité</span><span><%= inSite || site ? "Sur ce site" : "Sites" %></span><span></span></li>
    <% items.forEach((m) => { const on = Boolean(site) && m.enabled; %>
      <li class="xc-card xc-row" data-xc-item data-name="<%= m.name.toLowerCase() %>" data-cat="<%= m.category %>" data-state="<%= site ? (on ? 'on' : 'off') : '' %>" data-version="<%= m.version %>" data-added="<%= m.added || '' %>" data-text="<%= (m.name + ' ' + m.description + ' ' + (CATEGORY[m.category] || '') + ' ' + m.publisher).toLowerCase() %>" style="--xc-accent: <%= m.accent || 'var(--accent)' %>">
        <a class="xc-logo" href="<%= detailUrl(m) %>" tabindex="-1" aria-hidden="true"><% if (m.logo) { %><img src="<%= m.logo %>" alt="" width="56" height="56" loading="lazy" decoding="async"><% } else { %><span class="xc-initial"><%= m.name.charAt(0) %></span><% } %></a>
        <div class="xc-main">
          <h3 class="xc-name"><a href="<%= detailUrl(m) %>"><%= m.name %></a><% if (fresh(m)) { %> <span class="xc-new">Nouveau</span><% } %></h3>
          <p class="xc-desc"><%= m.description %></p>
        </div>
        <div class="xc-meta">
        <p class="xc-cat"><span class="xc-chip"><%= m.categoryLabel %></span></p>
        <p class="xc-ver"><span class="xc-k">Version</span> <%= m.version %></p>
        <p class="xc-pub"><span class="xc-k">Par</span> <%= m.publisher %></p>
        <p class="xc-avail"><%= m.availability === "beta" ? "Bêta" : m.availability === "unavailable" ? "Non disponible" : m.maintenance === "maintenance" ? "En maintenance" : m.maintenance === "deprecated" ? "Obsolète" : "Disponible" %></p>
        </div>
        <p class="xc-state"><% if (site) { %><span class="xc-dot <%= on ? 'is-on' : '' %>"></span><span><%= on ? "Activée" : "Désactivée" %></span><% } else { %><span class="xc-k">Aucun site</span><% } %><% if (!inSite) { %><small><%= m.activeSites %> / <%= totalSites %> site<%= totalSites > 1 ? "s" : "" %></small><% } %></p>
        <div class="xc-actions">
          <% if (site && !on && !unavailable(m)) { %>
            <form method="post" action="<%= POSTBASE %>/sites/<%= site.id %>/<%= m.id %>/activer"><input type="hidden" name="retour" value="catalogue"><% if (inSite) { %><input type="hidden" name="espace" value="1"><% } %><button class="btn btn-primary btn-sm" type="submit">Activer</button></form>
          <% } else if (site && on) { %>
            <a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: m.id, confirmer: m.id }) %>">Désactiver</a>
          <% } else if (site) { %><span class="btn btn-outline btn-sm is-disabled" aria-disabled="true">Indisponible</span><% } %>
          <a class="xc-more" href="<%= detailUrl(m) %>">Détails</a>
        </div>
      </li>
    <% }) %>
  </ul>
  <div class="mk-empty" data-xc-empty hidden role="status"><p><strong>Aucune extension ne correspond</strong></p><p class="mk-sub">Modifiez la recherche ou les filtres.</p><button type="button" class="btn btn-outline btn-sm" data-xc-reset>Réinitialiser</button></div>
</section>
