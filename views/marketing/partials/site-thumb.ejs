<%#
  Miniature d'un site : SCHÉMA de mise en page peint avec les couleurs RÉELLES du site (jetons de couleur enregistrés), jamais une capture ni un faux résultat.
  Paramètres : colors (objet de jetons : primary, secondary, accent, background, surface), kind (vitrine | blog | boutique | formation | autre), label (texte alternatif).
  Les couleurs sont revalidées (#rrggbb) avant d'être posées dans un attribut style : une valeur inattendue retombe sur la couleur de la charte.
%><%
  const HEX = /^#[0-9a-f]{6}$/i;
  const pick = (k, d) => (colors && HEX.test(String(colors[k] || "")) ? colors[k] : d);
  const P = pick("primary", "#0277b6"), S = pick("secondary", "#0b2a40"), A = pick("accent", "#f59e0b"), B = pick("background", "#f3f8fc"), W = pick("surface", "#ffffff");
  const K = ["blog", "boutique", "formation"].includes(kind) ? kind : "vitrine";
%><svg class="kx-site-thumb-svg" viewBox="0 0 120 80" role="img" aria-label="<%= label %>" xmlns="http://www.w3.org/2000/svg">
  <rect x="1" y="1" width="118" height="78" rx="7" fill="<%= B %>" stroke="#c5d0de" stroke-width="1.2"/>
  <path d="M1 12V8a7 7 0 0 1 7-7h104a7 7 0 0 1 7 7v4z" fill="<%= S %>"/><circle cx="9" cy="6.5" r="1.7" fill="#fff" opacity=".8"/><rect x="82" y="4.5" width="9" height="4" rx="2" fill="#fff" opacity=".55"/><rect x="94" y="4.5" width="9" height="4" rx="2" fill="#fff" opacity=".55"/>
  <% if (K === "blog") { %>
    <rect x="10" y="18" width="62" height="6" rx="3" fill="<%= S %>"/><rect x="10" y="29" width="56" height="4" rx="2" fill="<%= P %>" opacity=".55"/><rect x="10" y="37" width="62" height="4" rx="2" fill="<%= P %>" opacity=".3"/><rect x="10" y="45" width="48" height="4" rx="2" fill="<%= P %>" opacity=".3"/><rect x="10" y="56" width="62" height="14" rx="4" fill="<%= W %>" stroke="#c5d0de"/>
    <rect x="80" y="18" width="30" height="22" rx="4" fill="<%= P %>" opacity=".85"/><rect x="80" y="46" width="30" height="24" rx="4" fill="<%= W %>" stroke="#c5d0de"/><rect x="84" y="51" width="22" height="3.5" rx="1.7" fill="<%= A %>"/>
  <% } else if (K === "boutique") { %>
    <rect x="8" y="17" width="104" height="18" rx="5" fill="<%= P %>"/><rect x="14" y="22" width="40" height="4.5" rx="2.2" fill="#fff"/><rect x="14" y="29" width="26" height="3" rx="1.5" fill="#fff" opacity=".7"/><rect x="88" y="22" width="18" height="8" rx="4" fill="<%= A %>"/>
    <% for (let i = 0; i < 3; i++) { %><rect x="<%= 8 + i * 36 %>" y="41" width="32" height="30" rx="4" fill="<%= W %>" stroke="#c5d0de"/><rect x="<%= 12 + i * 36 %>" y="45" width="24" height="14" rx="3" fill="<%= P %>" opacity="<%= i === 1 ? .9 : .4 %>"/><rect x="<%= 12 + i * 36 %>" y="62" width="14" height="3.5" rx="1.7" fill="<%= S %>"/><rect x="<%= 28 + i * 36 %>" y="62" width="8" height="3.5" rx="1.7" fill="<%= A %>"/><% } %>
  <% } else if (K === "formation") { %>
    <rect x="8" y="17" width="66" height="38" rx="5" fill="<%= S %>"/><circle cx="41" cy="36" r="9" fill="<%= P %>"/><path d="M38 31l9 5-9 5z" fill="#fff"/><rect x="8" y="60" width="66" height="4" rx="2" fill="<%= P %>" opacity=".25"/><rect x="8" y="60" width="40" height="4" rx="2" fill="<%= P %>"/>
    <% for (let i = 0; i < 3; i++) { %><circle cx="88" cy="<%= 24 + i * 16 %>" r="4" fill="<%= i < 2 ? P : "#c5d0de" %>"/><rect x="96" y="<%= 22 + i * 16 %>" width="16" height="4" rx="2" fill="<%= i < 2 ? S : "#c5d0de" %>" opacity=".7"/><% } %>
  <% } else { %>
    <rect x="8" y="17" width="104" height="26" rx="5" fill="<%= P %>"/><rect x="15" y="23" width="46" height="5" rx="2.5" fill="#fff"/><rect x="15" y="32" width="64" height="3.5" rx="1.7" fill="#fff" opacity=".7"/><rect x="88" y="26" width="18" height="9" rx="4.5" fill="<%= A %>"/>
    <% for (let i = 0; i < 3; i++) { %><rect x="<%= 8 + i * 36 %>" y="49" width="32" height="22" rx="4" fill="<%= W %>" stroke="#c5d0de"/><circle cx="<%= 17 + i * 36 %>" cy="57" r="3.5" fill="<%= i === 1 ? A : P %>"/><rect x="<%= 23 + i * 36 %>" y="55" width="14" height="3" rx="1.5" fill="<%= S %>" opacity=".6"/><rect x="<%= 13 + i * 36 %>" y="63" width="22" height="3" rx="1.5" fill="#c5d0de"/><% } %>
  <% } %>
</svg>
