<%# Résultats de la galerie (cartes + pagination) : rendus en entier ou en fragment (?fragment=1) pour les filtres sans rechargement.
    Le fragment porte aussi les compteurs EXACTS (catégories, états, styles) calculés avec tous les autres filtres : le script ne fait que les afficher. %>
<script type="application/json" data-tg-meta><%- JSON.stringify({ total: g.total, page: g.page, pages: g.pages, all: g.categoryTotal, cats: g.categories, state: g.byState, styles: g.styles }) %></script>
<div class="mk-tg-bar">
  <p class="mk-th-status" aria-live="polite" data-th-status><%= hasFilter ? (g.total ? g.total + " thème" + (g.total > 1 ? "s" : "") + " trouvé" + (g.total > 1 ? "s" : "") + "." : "Aucun thème ne correspond à cette recherche.") : "" %></p>
  <% if (hasFilter) { %><a class="mk-tg-reset" href="<%= to("") %>" data-tg-reset>Réinitialiser les filtres</a><% } %>
</div>
<% if (hasFilter) { const chips = [];
  if (f.q) chips.push(["q", "Recherche : « " + f.q + " »"]);
  if (f.category) chips.push(["categorie", (CATEGORIES.find((c) => c.key === f.category) || {}).label || f.category]);
  if (f.style) chips.push(["style", "Style : " + (STYLE_LABELS[f.style] || f.style)]);
  if (f.state) chips.push(["etat", STATES[f.state]]); %>
<ul class="mk-tg-chips" aria-label="Filtres actifs"><% chips.forEach((c) => { %><li><button type="button" data-tg-remove="<%= c[0] %>" aria-label="Retirer le filtre : <%= c[1] %>"><span><%= c[1] %></span><%- icon("close", { size: 12 }) %></button></li><% }) %></ul>
<% } %>
<% if (!hasFilter && g.page === 1 && g.featured.length) { %>
<section class="mk-tg-featured" aria-labelledby="tg-feat">
  <h2 id="tg-feat">Recommandés</h2>
  <ul class="mk-tg-grid mk-tg-grid--feat">
    <% g.featured.forEach((t) => { %><%- include("themes-card", { t, eager: true }) %><% }) %>
  </ul>
</section>
<% } %>
<% if (!g.items.length) { %>
  <div class="mk-th-empty" role="status"><strong>Aucun thème ne correspond à cette recherche.</strong><p>Vérifiez l'orthographe, choisissez une autre catégorie, ou <a href="<%= to("") %>" data-tg-reset>affichez tous les thèmes</a>.</p></div>
<% } else { %>
  <h2 class="mk-tg-all" id="tg-all"><%= hasFilter ? "Résultats" : "Tous les thèmes" %> <small>(<%= g.total %>)</small></h2>
  <ul class="mk-tg-grid" data-th-grid aria-labelledby="tg-all">
    <% g.items.forEach((t, i) => { %><%- include("themes-card", { t, eager: i < 3 && (hasFilter || g.page > 1 || !g.featured.length) }) %><% }) %>
  </ul>
  <% if (g.pages > 1) { %>
  <nav class="mk-tg-pager" aria-label="Pages de résultats">
    <% if (g.page > 1) { %><a class="btn btn-outline btn-sm" href="<%= url({ page: g.page - 1 }) %>" rel="prev">← Précédent</a><% } %>
    <span>Page <%= g.page %> sur <%= g.pages %></span>
    <% if (g.page < g.pages) { %><a class="btn btn-outline btn-sm" href="<%= url({ page: g.page + 1 }) %>" rel="next">Suivant →</a><% } %>
  </nav>
  <% } %>
<% } %>
