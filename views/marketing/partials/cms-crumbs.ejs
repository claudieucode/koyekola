<%# Fil d'Ariane du CMS : intégré à la zone de contenu (bandeau de contexte du site), jamais une barre globale au-dessus du menu. Paramètre : trail. %>
<nav class="mk-breadcrumb mk-cms-crumbs" aria-label="Fil d'Ariane">
  <ol>
    <% trail.forEach((c, i) => { const last = i === trail.length - 1; %><li<%- last ? ' aria-current="page"' : "" %>><% if (c.href && !last) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><%= c.label %><% } %></li>
    <% }) %>
  </ol>
</nav>
