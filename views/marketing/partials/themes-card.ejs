<%# Carte d'un thème : aperçu réel (capture du rendu), nom, catégorie, description, état et actions adaptées à l'état RÉEL. %>
<li class="mk-tg-card mk-tg-card--<%= t.state %>" data-th-card>
  <a class="mk-tg-shotlink" href="<%= to("/" + t.key + "/details") %>" aria-label="Détails du thème <%= t.name %>">
    <% if (t.previews) { %>
      <img class="mk-tg-shot" src="<%= t.previews.card || t.previews.home %>" width="480" height="300" loading="lazy" decoding="async" alt="Aperçu de la page d'accueil du thème <%= t.name %>">
      <img class="mk-tg-phone" src="<%= t.previews.phone || t.previews.mobile %>" width="64" height="139" loading="lazy" decoding="async" alt="">
    <% } else { %>
      <span class="mk-tg-shot mk-tg-swatch" aria-hidden="true"><% t.palette.forEach((c) => { %><i style="background:<%= c %>"></i><% }) %><b style="font-family:<%= fontStack(t.fonts.heading) %>"><%= t.name %></b></span>
    <% } %>
    <% if (t.state === "active") { %><span class="mk-tg-flag mk-tg-flag--active">Actif</span><% } else if (t.installed) { %><span class="mk-tg-flag">Installé</span><% } else if (t.isNew) { %><span class="mk-tg-flag mk-tg-flag--new">Nouveau</span><% } %>
  </a>
  <div class="mk-tg-body">
    <h3><a href="<%= to("/" + t.key + "/details") %>"><%= t.name %></a><% if (t.state === "incompatible") { %> <span class="badge mk-status-warn">Incompatible</span><% } %></h3>
    <p class="mk-tg-cat"><%= t.categoryLabel %></p>
    <p class="mk-tg-desc"><%= t.description %></p>
    <% if (t.pages.length) { %><p class="mk-tg-meta"><%= t.pages.length %> pages : <%= t.pages.slice(0, 4).map((p) => p.name).join(", ") %><%= t.pages.length > 4 ? "…" : "" %></p><% } %>
  </div>
  <div class="mk-tg-foot">
    <% if (t.hasDemo) { %><a class="btn btn-outline btn-sm" href="<%= to("/" + t.key + "/apercu") %>">Prévisualiser</a><% } %>
    <% if (t.state === "active") { %>
      <a class="btn btn-primary btn-sm" href="/marketing/site-web/personnaliser<%= T.siteId ? "?site=" + T.siteId : "" %>">Personnaliser</a>
    <% } else if (t.state === "installed" && canActivate && !readOnly) { %>
      <form method="post" action="<%= BASE %>/<%= t.key %>/activer" data-th-form><%- siteField %><button class="btn btn-primary btn-sm" type="submit" data-confirm="Utiliser « <%= t.name %> » sur « <%= T.name %> » ? Vos contenus ne sont pas modifiés ; l'apparence du site change." data-busy="Activation…">Utiliser ce thème</button></form>
    <% } else if (t.state === "available" && canInstall && !readOnly) { %>
      <form method="post" action="<%= BASE %>/installer" data-th-form><%- siteField %><input type="hidden" name="key" value="<%= t.key %>"><button class="btn btn-primary btn-sm" type="submit" data-busy="Installation…">Installer</button></form>
    <% } %>
    <% if (!t.hasDemo) { %><a class="btn btn-outline btn-sm" href="<%= to("/" + t.key + "/apercu") %>">Prévisualiser</a><% } %>
  </div>
</li>
