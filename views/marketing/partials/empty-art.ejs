<%#
  Illustrations abstraites des états vides (traits et formes aux couleurs de la charte, aucune image externe). kind : email | template | list | chart | people | folder.
%><%
  const K = typeof kind !== "undefined" ? kind : "email";
%><% if (K === "template") { %>
<svg viewBox="0 0 160 110" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Aperçu d'un modèle"><rect x="10" y="6" width="140" height="98" rx="8" fill="var(--mk-surface)" stroke="var(--mk-border-strong)"/><rect x="20" y="16" width="120" height="22" rx="4" fill="var(--k-navy-900)" opacity=".92"/><rect x="28" y="23" width="46" height="8" rx="3" fill="#fff" opacity=".85"/><rect x="20" y="46" width="56" height="40" rx="4" fill="var(--accent-light)"/><rect x="84" y="48" width="56" height="6" rx="3" fill="var(--mk-border-strong)"/><rect x="84" y="60" width="48" height="6" rx="3" fill="var(--mk-border)"/><rect x="84" y="72" width="52" height="6" rx="3" fill="var(--mk-border)"/><rect x="20" y="92" width="34" height="7" rx="3.5" fill="var(--k-accent-solid)"/></svg>
<% } else if (K === "list") { %>
<svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="14" width="192" height="122" rx="12" fill="var(--mk-surface)" stroke="var(--mk-border-strong)"/><rect x="26" y="28" width="168" height="16" rx="4" fill="var(--mk-hover)"/><% for (let i = 0; i < 4; i++) { %><circle cx="38" cy="<%= 66 + i * 20 %>" r="6" fill="var(--accent-light)" stroke="var(--accent)"/><rect x="54" y="<%= 62 + i * 20 %>" width="<%= 70 + (i % 2) * 30 %>" height="7" rx="3.5" fill="var(--mk-border-strong)"/><rect x="150" y="<%= 62 + i * 20 %>" width="34" height="7" rx="3.5" fill="var(--mk-border)"/><% } %></svg>
<% } else if (K === "chart") { %>
<svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="14" width="192" height="122" rx="12" fill="var(--mk-surface)" stroke="var(--mk-border-strong)"/><% [40, 62, 50, 82, 70, 98].forEach((h, i) => { %><rect x="<%= 34 + i * 28 %>" y="<%= 120 - h %>" width="16" height="<%= h %>" rx="4" fill="<%= i === 5 ? 'var(--k-accent-solid)' : 'var(--accent-light)' %>"/><% }) %><path d="M30 120h160" stroke="var(--mk-border-strong)"/></svg>
<% } else if (K === "people") { %>
<svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="14" width="192" height="122" rx="12" fill="var(--mk-surface)" stroke="var(--mk-border-strong)"/><circle cx="82" cy="62" r="16" fill="var(--accent-light)" stroke="var(--accent)"/><path d="M52 112c3-16 15-24 30-24s27 8 30 24" fill="var(--accent-light)" stroke="var(--accent)"/><circle cx="142" cy="66" r="12" fill="var(--mk-hover)" stroke="var(--mk-border-strong)"/><path d="M120 112c2-12 11-18 22-18s20 6 22 18" fill="var(--mk-hover)" stroke="var(--mk-border-strong)"/></svg>
<% } else if (K === "folder") { %>
<svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M26 44a8 8 0 0 1 8-8h40l14 14h78a8 8 0 0 1 8 8v62a8 8 0 0 1-8 8H34a8 8 0 0 1-8-8z" fill="var(--accent-light)" stroke="var(--accent)"/><rect x="48" y="78" width="124" height="7" rx="3.5" fill="var(--mk-surface)"/><rect x="48" y="94" width="86" height="7" rx="3.5" fill="var(--mk-surface)"/></svg>
<% } else { %>
<svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="22" y="24" width="150" height="104" rx="12" fill="var(--mk-surface)" stroke="var(--mk-border-strong)"/><rect x="36" y="38" width="122" height="30" rx="6" fill="var(--k-navy-900)" opacity=".92"/><rect x="46" y="48" width="56" height="9" rx="4" fill="#fff" opacity=".85"/><rect x="36" y="78" width="54" height="36" rx="6" fill="var(--accent-light)"/><rect x="100" y="80" width="58" height="7" rx="3.5" fill="var(--mk-border-strong)"/><rect x="100" y="94" width="46" height="7" rx="3.5" fill="var(--mk-border)"/><rect x="100" y="108" width="52" height="7" rx="3.5" fill="var(--mk-border)"/><rect x="132" y="12" width="74" height="104" rx="10" fill="var(--mk-surface)" stroke="var(--accent)" stroke-width="1.5"/><rect x="142" y="26" width="54" height="8" rx="4" fill="var(--accent)" opacity=".8"/><rect x="142" y="42" width="54" height="36" rx="5" fill="var(--accent-light)"/><rect x="142" y="86" width="40" height="6" rx="3" fill="var(--mk-border-strong)"/><rect x="142" y="98" width="30" height="6" rx="3" fill="var(--mk-border)"/></svg>
<% } %>
