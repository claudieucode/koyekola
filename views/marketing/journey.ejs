<%- include("partials/top", { title, active }) %>
<%
  const j = journey; const canWrite = mk.can("automations.write");
  const tone = { ok: "mk-status-ok", warn: "mk-status-warn", info: "mk-status-info", tracking: "mk-status-track", off: "mk-status-off" }[j.tone || (j.status === "tracking" ? "tracking" : "off")] || "";
  const needsList = (j.needs || []).includes("list");
  const back = "/marketing/automatisations/parcours/" + j.key;
  // Classes complètes (jamais assemblées en morceaux : chaque classe doit exister telle quelle dans la feuille de style)
  const flowClass = { email: "mk-flow-email", sms: "mk-flow-sms", wait: "mk-flow-wait", condition: "mk-flow-condition", action: "mk-flow-action", end: "mk-flow-end" };
  const exitClass = (label) => (label === "Oui" || label === "A" ? "mk-flow-exit-yes" : "mk-flow-exit-no");
  const depClass = (ok) => (ok === true ? "is-ok" : ok === false ? "is-missing" : "is-todo");
%>
    <p class="mk-back"><a href="/marketing/automatisations/parcours">← Parcours tout prêts</a></p>
    <div class="mk-head"><h1><%= j.label %></h1>
      <form action="/marketing/automatisations/parcours/<%= j.key %>/favori" method="post" class="mk-fav-form">
        <input type="hidden" name="retour" value="<%= back %>">
        <button type="submit" class="btn btn-ghost btn-sm mk-fav<%= j.favorite ? " is-on" : "" %>" aria-pressed="<%= j.favorite ? "true" : "false" %>"><%- icon(j.favorite ? "star" : "starOutline", { size: 16 }) %> <%= j.favorite ? "Dans mes favoris" : "Ajouter aux favoris" %></button>
      </form>
    </div>
    <p class="mk-lead"><%= j.objective %></p>
    <p class="mk-lib-meta"><span class="mk-status <%= tone %>"><%= j.statusLabel %></span><% if (j.uses) { %> <span class="field-hint">Utilisé <%= j.uses %> fois dans votre organisation</span><% } %></p>

    <% if (!j.usable) { %>
      <div class="mk-callout"><%- icon("info", { size: 18 }) %><div><strong><%= j.status === "tracking" ? "Nécessite le suivi des visiteurs" : "Pas encore disponible" %></strong><p><%= j.missing[0] || j.unavailable %></p></div></div>
    <% } else { %>
      <%- include("partials/worker-note", { workerOn, consequence: "une fois activé, le parcours ne s'exécutera pas tant qu'il n'est pas rétabli" }) %>
      <% if (j.status === "config") { %>
        <div class="mk-callout mk-callout-warn"><%- icon("alertTriangle", { size: 18 }) %><div><strong>À configurer avant l'activation</strong>
          <ul class="mk-journey-todo"><% j.missing.forEach((m) => { %><li><%= m %></li><% }) %></ul>
          <% if (j.siteEvent) { %><p class="mk-journey-code"><span>Exemple d'envoi à l'API :</span> <code>POST /api/v1/events</code> <code><%= j.siteEvent.payload %></code></p><% } %></div></div>
      <% } %>

      <section class="mk-lib-card mk-journey-use" id="utiliser" aria-labelledby="j-use">
        <div class="mk-lib-body">
          <h2 id="j-use" class="mk-h2">Utiliser ce parcours</h2>
          <p class="field-hint">Crée une <strong>copie</strong> du parcours en brouillon (scénario, étapes, délais, conditions et <%= j.sms.length && !j.emails.length ? "SMS" : "e-mails" %> modifiables), puis l'ouvre dans l'éditeur. Le modèle de la bibliothèque n'est jamais modifié.</p>
          <% if (canWrite) { %>
            <form action="/marketing/automatisations/parcours/<%= j.key %>" method="post" class="mk-journey-use-form">
              <% if (needsList) { %>
                <div class="field-group"><label for="j-liste">Liste concernée</label>
                  <% if (j.lists.length) { %><select id="j-liste" name="liste" required><option value="">Choisir une liste…</option><% j.lists.forEach((l) => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select>
                  <% } else { %><p class="field-hint">Aucune liste n'existe encore. <a href="/marketing/listes">Créez-en une</a> (par exemple celle de votre formulaire), puis revenez ici.</p><% } %>
                </div>
              <% } %>
              <button type="submit" class="btn btn-primary"<%- needsList && !j.lists.length ? " disabled" : "" %>>Utiliser ce parcours</button>
            </form>
          <% } else { %><p class="field-hint">Vous pouvez consulter ce parcours ; seul un membre autorisé à modifier les automatisations peut le créer.</p><% } %>
        </div>
      </section>
    <% } %>

    <% if (j.usable) { %>
      <div class="mk-grid-2 mk-journey">
        <div class="mk-journey-col">
          <section class="mk-lib-card" aria-labelledby="j-about">
            <div class="mk-lib-body">
              <h2 id="j-about" class="mk-h2">Comment il fonctionne</h2>
              <p><%= j.description %></p>
              <dl class="mk-journey-facts">
                <dt>Déclencheur</dt><dd><%= j.trigger.label %><%= j.trigger.filter && j.trigger.filter.key === "tag" ? ` — étiquette « ${j.trigger.filter.value} »` : "" %></dd>
                <dt>Audience</dt><dd><%= j.audienceLabel %></dd>
                <dt>Objectif</dt><dd><%= j.goalLabel %></dd>
                <dt>Canal</dt><dd><%= j.channelLabel %></dd>
                <dt>Type</dt><dd><%= j.kind === "transactional" ? "Transactionnel : lié à un achat ou une formation, sans contenu promotionnel, envoyé à tous les élèves concernés." : "Marketing : envoyé uniquement aux contacts abonnés, avec lien de désinscription." %></dd>
                <dt>Étapes</dt><dd><%= j.stepCount %> étape<%= j.stepCount > 1 ? "s" : "" %><%= j.duration >= 1 ? ` · durée maximale : ${j.durationLabel}` : "" %></dd>
                <dt>Catégorie</dt><dd><%= j.groupLabel %></dd>
                <dt>À savoir</dt><dd><%= j.note %></dd>
              </dl>
              <% if (j.emails.length) { %>
                <h3 class="mk-journey-sub">E-mails créés (modifiables)</h3>
                <ol class="mk-journey-emails"><% j.emails.forEach((e) => { %><li><strong><%= e.name %></strong> — objet : « <%= e.subject %> »</li><% }) %></ol>
              <% } %>
              <% if (j.sms.length) { %>
                <h3 class="mk-journey-sub">SMS du parcours (modifiables dans le scénario)</h3>
                <ol class="mk-journey-emails"><% j.sms.forEach((m) => { %><li><strong><%= m.name %></strong> — « <%= m.body %> »</li><% }) %></ol>
              <% } %>
            </div>
          </section>

          <section class="mk-lib-card" aria-labelledby="j-rules">
            <div class="mk-lib-body">
              <h2 id="j-rules" class="mk-h2">Entrée et règles d'arrêt</h2>
              <ul class="mk-journey-rules"><% j.stopRules.forEach((r) => { %><li><%= r %></li><% }) %></ul>
            </div>
          </section>

          <section class="mk-lib-card" aria-labelledby="j-deps">
            <div class="mk-lib-body">
              <h2 id="j-deps" class="mk-h2">Dépendances techniques</h2>
              <ul class="mk-journey-deps"><% j.requirements.forEach((r) => { %>
                <li class="<%= depClass(r.ok) %>"><span class="mk-dep-mark" aria-hidden="true"><%- icon(r.ok === true ? "checkCircle" : r.ok === false ? "alertCircle" : "info", { size: 16 }) %></span><span><strong><%= r.label %></strong> — <%= r.detail %> <span class="sr-only"><%= r.ok === true ? "(disponible)" : r.ok === false ? "(à rétablir)" : "(à prévoir)" %></span></span></li>
              <% }) %></ul>
            </div>
          </section>
        </div>

        <section class="mk-lib-card" aria-labelledby="j-steps">
          <div class="mk-lib-body">
            <h2 id="j-steps" class="mk-h2">Schéma du parcours</h2>
            <ol class="mk-flow" aria-label="Étapes du parcours, dans l'ordre">
              <li class="mk-flow-node is-trigger"><span class="mk-journey-icon" aria-hidden="true"><%- icon("zap", { size: 16 }) %></span><div class="mk-flow-body"><span class="mk-journey-n">Déclencheur</span><span><%= j.trigger.label %><%= j.trigger.filter && j.trigger.filter.key === "tag" ? ` (« ${j.trigger.filter.value} »)` : "" %></span></div></li>
              <% j.flow.forEach((n) => { %>
                <li class="mk-flow-node <%= flowClass[n.kind] %>" id="etape-<%= n.n %>">
                  <span class="mk-journey-icon" aria-hidden="true"><%- icon(n.icon, { size: 16 }) %></span>
                  <div class="mk-flow-body">
                    <span class="mk-journey-n">Étape <%= n.n %></span>
                    <span><%= n.text %></span>
                    <% if (n.exits.length) { %>
                      <ul class="mk-flow-exits"><% n.exits.forEach((x) => { %>
                        <li class="mk-flow-exit <%= exitClass(x.label) %>"><span class="mk-flow-exit-label"><%= x.label %></span>
                          <% if (x.exit) { %><span class="mk-flow-to">→ Fin du parcours</span><% } else { %><a class="mk-flow-to" href="#etape-<%= x.n %>">→ Étape <%= x.n %> · <%= x.text %></a><% } %></li>
                      <% }) %></ul>
                    <% } else if (n.jump) { %>
                      <span class="mk-flow-jump">Puis → <% if (n.jump.exit) { %>fin du parcours<% } else { %><a href="#etape-<%= n.jump.n %>">étape <%= n.jump.n %></a><% } %></span>
                    <% } %>
                  </div>
                </li>
              <% }) %>
              <% const last = j.flow[j.flow.length - 1]; if (last && last.type !== "end") { %><li class="mk-flow-node mk-flow-end"><span class="mk-journey-icon" aria-hidden="true"><%- icon("stopCircle", { size: 16 }) %></span><div class="mk-flow-body"><span class="mk-journey-n">Fin</span><span>Fin du parcours</span></div></li><% } %>
            </ol>
          </div>
        </section>
      </div>
    <% } %>
<%- include("partials/bottom") %>
