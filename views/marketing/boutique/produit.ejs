<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: product ? product.name : "Nouveau produit" }) %>
<% const v = product ? { name: product.name, type: product.type, status: product.status, sku: product.sku, short_description: product.short_description, description: product.description, price: (product.price_cents / 100).toFixed(2), sale_price: product.sale_price_cents != null ? (product.sale_price_cents / 100).toFixed(2) : "", sale_starts_at: product.sale_starts_at, sale_ends_at: product.sale_ends_at, manage_stock: product.manage_stock, stock_qty: product.stock_qty, weight_grams: product.weight_grams, length_mm: product.length_mm, width_mm: product.width_mm, height_mm: product.height_mm, requires_shipping: product.requires_shipping, image_url: product.image_url, gallery: product.gallery.join("\n"), tags: product.tags.join(", "), is_featured: product.is_featured, seo_title: product.seo_title, seo_description: product.seo_description, attributes: product.attributes.map((a) => a.name + ": " + a.values.join(", ")).join("\n") } : values; const sel = product ? product.categories.map((c) => c.id) : [].concat(values.category_ids || []).map(Number); const dis = canWrite ? "" : " disabled"; %>
<form class="mk-form mk-panel bq-cols-4" method="post" action="<%= base %>/produits<%= product ? "/" + product.id : "" %>">
  <h2>Informations</h2>
  <div class="field-group"><label for="f-name">Nom</label><input type="text" id="f-name" name="name" value="<%= v.name || "" %>" required maxlength="200"<%= dis %>></div>
  <div class="field-group"><label for="f-type">Type de produit</label>
    <select id="f-type" name="type"<%= dis %>><option value="simple"<%= (v.type || "simple") === "simple" ? " selected" : "" %>>Simple (physique)</option><option value="variable"<%= v.type === "variable" ? " selected" : "" %>>Variable (avec variantes)</option><option value="digital"<%= v.type === "digital" ? " selected" : "" %>>Numérique (sans livraison)</option></select>
    <p class="field-hint">Les types « téléchargeable » et « groupé » ne sont pas encore pris en charge.</p></div>
  <div class="field-group"><label for="f-status">Statut</label><select id="f-status" name="status"<%= dis %>><% [["draft","Brouillon"],["published","En ligne"],["archived","Archivé"]].forEach(([k,l]) => { %><option value="<%= k %>"<%= (v.status || "draft") === k ? " selected" : "" %>><%= l %></option><% }) %></select></div>
  <div class="field-group"><label for="f-short">Description courte</label><input type="text" id="f-short" name="short_description" value="<%= v.short_description || "" %>" maxlength="600"<%= dis %>></div>
  <div class="field-group"><label for="f-desc">Description complète</label><textarea id="f-desc" name="description" rows="6" maxlength="20000"<%= dis %>><%= v.description || "" %></textarea></div>
  <h2>Prix</h2>
  <div class="field-group"><label for="f-price">Prix normal (<%= shopSettings.currency.toUpperCase() %>)</label><input type="text" id="f-price" name="price" inputmode="decimal" value="<%= v.price || "" %>" required<%= dis %>></div>
  <div class="field-group"><label for="f-sale">Prix promotionnel</label><input type="text" id="f-sale" name="sale_price" inputmode="decimal" value="<%= v.sale_price || "" %>"<%= dis %>><p class="field-hint">Doit être inférieur au prix normal. Laissez vide pour aucune promotion.</p></div>
  <div class="field-group"><label for="f-s1">Début de la promotion</label><input type="text" id="f-s1" name="sale_starts_at" value="<%= v.sale_starts_at || "" %>" placeholder="AAAA-MM-JJ"<%= dis %>></div>
  <div class="field-group"><label for="f-s2">Fin de la promotion</label><input type="text" id="f-s2" name="sale_ends_at" value="<%= v.sale_ends_at || "" %>" placeholder="AAAA-MM-JJ"<%= dis %>></div>
  <h2>Stock et expédition</h2>
  <div class="field-group"><label for="f-sku">Référence (SKU)</label><input type="text" id="f-sku" name="sku" value="<%= v.sku || "" %>" maxlength="80"<%= dis %>></div>
  <div class="field-group"><label><input type="checkbox" name="manage_stock" value="1"<%= v.manage_stock ? " checked" : "" %><%= dis %>> Gérer le stock (produit simple ou numérique)</label></div>
  <div class="field-group"><label for="f-stock">Quantité en stock</label><input id="f-stock" name="stock_qty" type="number" min="0" value="<%= v.stock_qty ?? 0 %>"<%= dis %>></div>
  <div class="field-group"><label><input type="checkbox" name="requires_shipping" value="1"<%= (product ? v.requires_shipping : (v.requires_shipping !== undefined ? v.requires_shipping : 1)) ? " checked" : "" %><%= dis %>> Produit à livrer</label></div>
  <div class="field-group"><label for="f-w">Poids (grammes)</label><input id="f-w" name="weight_grams" type="number" min="0" value="<%= v.weight_grams ?? "" %>"<%= dis %>></div>
  <div class="field-group"><label for="f-l">Dimensions (mm) : longueur / largeur / hauteur</label><input id="f-l" name="length_mm" type="number" min="0" value="<%= v.length_mm ?? "" %>"<%= dis %>> <input name="width_mm" type="number" min="0" value="<%= v.width_mm ?? "" %>" aria-label="Largeur"<%= dis %>> <input name="height_mm" type="number" min="0" value="<%= v.height_mm ?? "" %>" aria-label="Hauteur"<%= dis %>></div>
  <h2>Classement et images</h2>
  <div class="field-group"><label for="f-cat">Catégories</label><select id="f-cat" name="category_ids" multiple size="5"<%= dis %>><% categories.forEach((c) => { %><option value="<%= c.id %>"<%= sel.includes(c.id) ? " selected" : "" %>><%= c.name %></option><% }) %></select></div>
  <div class="field-group"><label for="f-tags">Étiquettes (séparées par des virgules)</label><input type="text" id="f-tags" name="tags" value="<%= v.tags || "" %>"<%= dis %>></div>
  <div class="field-group"><label for="f-img">Image principale (adresse de la médiathèque)</label><input type="text" id="f-img" name="image_url" value="<%= v.image_url || "" %>" placeholder="/uploads/…"<%= dis %>></div>
  <div class="field-group"><label for="f-gal">Galerie (une adresse par ligne)</label><textarea id="f-gal" name="gallery" rows="3"<%= dis %>><%= v.gallery || "" %></textarea></div>
  <div class="field-group"><label><input type="checkbox" name="is_featured" value="1"<%= v.is_featured ? " checked" : "" %><%= dis %>> Produit mis en avant</label></div>
  <div class="field-group"><label for="f-attr">Attributs (produit variable) — un par ligne : « Taille: S, M, L »</label><textarea id="f-attr" name="attributes" rows="3"<%= dis %>><%= v.attributes || "" %></textarea></div>
  <h2>Référencement</h2>
  <div class="field-group"><label for="f-st">Titre SEO</label><input type="text" id="f-st" name="seo_title" value="<%= v.seo_title || "" %>" maxlength="160"<%= dis %>></div>
  <div class="field-group"><label for="f-sd">Description SEO</label><input type="text" id="f-sd" name="seo_description" value="<%= v.seo_description || "" %>" maxlength="320"<%= dis %>></div>
  <% if (canWrite) { %><button class="btn btn-primary" type="submit">Enregistrer</button><% } %>
</form>
<% if (product) { const pz = typeof personalization !== "undefined" ? personalization : null; %>
<section class="mk-panel" aria-labelledby="pz-h"><h2 id="pz-h">Personnalisation (gravure, initiales, message)</h2>
  <p class="field-hint">Le client saisit un court texte avant d'ajouter au panier ; il apparaît sur la commande et dans l'e-mail. Le prix ne change pas.</p>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/personnalisation">
    <div class="field-group"><label><input type="checkbox" name="enabled" value="1"<%= pz ? " checked" : "" %><%= canWrite ? "" : " disabled" %>> Proposer une personnalisation sur ce produit</label></div>
    <div class="field-group"><label for="pz-l">Ce que le client personnalise</label><input type="text" id="pz-l" name="label" maxlength="60" value="<%= pz ? pz.label : "Texte à graver" %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label for="pz-h2">Aide affichée dans le champ (facultatif)</label><input type="text" id="pz-h2" name="hint" maxlength="160" value="<%= pz ? pz.hint : "" %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label for="pz-m">Nombre de caractères maximum</label><input id="pz-m" name="max_length" type="number" min="1" max="200" value="<%= pz ? pz.maxLength : 20 %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label><input type="checkbox" name="required" value="1"<%= pz && pz.required ? " checked" : "" %><%= canWrite ? "" : " disabled" %>> Champ obligatoire</label></div>
    <% if (canWrite) { %><button class="btn btn-primary btn-sm" type="submit">Enregistrer la personnalisation</button><% } %>
  </form>
</section>
<% } %>
<% if (product) { %>
<section class="mk-panel" aria-labelledby="sp-h"><h2 id="sp-h">Caractéristiques (comparateur)</h2>
  <p class="field-hint">Une caractéristique par ligne, au format « Libellé: valeur » (ex. « Poids: 250 g »), 20 au maximum. Elles s'affichent dans le comparateur de produits.</p>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/specifications">
    <div class="field-group"><label for="sp-t">Caractéristiques</label><textarea id="sp-t" name="specs" rows="6" maxlength="4000"<%= canWrite ? "" : " disabled" %>><%= typeof specs !== "undefined" ? specs : "" %></textarea></div>
    <% if (canWrite) { %><button class="btn btn-primary btn-sm" type="submit">Enregistrer les caractéristiques</button><% } %>
  </form>
</section>
<% } %>
<% if (product && typeof plans !== "undefined") { %>
<section class="mk-panel" aria-labelledby="ab-h"><h2 id="ab-h">Abonnement (récurrent)</h2>
  <p class="field-hint">Proposez ce produit en abonnement, à côté de l'achat unique (qui reste toujours disponible). Chaque formule fixe le prix TOUT COMPRIS prélevé à chaque échéance (livraison et taxes incluses : le client ne paie rien d'autre). Une remise n'est affichée que si vous la saisissez et qu'elle correspond au prix. Le client peut mettre en pause, changer de formule ou résilier en un clic. <%= stripeReady ? "" : "Les clés Stripe du serveur et le secret de webhook ne sont pas posés : rien n'est proposé au public tant que ce n'est pas fait." %></p>
  <% if (plans.length) { %><ul><% plans.forEach((p) => { %><li><strong><%= p.label %></strong> : <%= money(p.price_cents) %> <%= p.interval_count === 1 ? (p.interval_unit === "week" ? "chaque semaine" : "chaque mois") : "tous les " + p.interval_count + (p.interval_unit === "week" ? " semaines" : " mois") %><%= p.discount_percent ? " (remise annoncée : " + p.discount_percent + " %)" : "" %>
    <% if (canWrite) { %><form class="mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/formules/<%= p.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Retirer cette formule ? Les abonnements en cours gardent leur prix." data-mk-confirm-ok="Retirer">Retirer</button></form><% } %></li><% }) %></ul>
  <% } else { %><p class="mk-empty">Aucune formule : ce produit ne s'achète qu'à l'unité.</p><% } %>
  <% if (canWrite) { %>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/formules">
    <div class="field-group"><label for="ab-l">Nom de la formule</label><input type="text" id="ab-l" name="label" maxlength="60" required placeholder="Chaque mois"></div>
    <div class="field-group"><label for="ab-c">Tous les</label><input id="ab-c" name="interval_count" type="number" min="1" max="12" value="1" required></div>
    <div class="field-group"><label for="ab-u">Unité</label><select id="ab-u" name="interval_unit"><option value="week">semaine(s)</option><option value="month" selected>mois</option></select></div>
    <div class="field-group"><label for="ab-p">Prix tout compris à chaque échéance (€)</label><input type="text" id="ab-p" name="price" inputmode="decimal" placeholder="29,90"></div>
    <div class="field-group"><label for="ab-d">Remise annoncée en % (facultatif, laissez vide si aucune)</label><input id="ab-d" name="discount_percent" type="number" min="0" max="90"></div>
    <button class="btn btn-primary btn-sm" type="submit">Ajouter la formule</button>
  </form>
  <% } %>
</section>
<% } %>
<% if (product) { const ag = typeof ageLevel !== "undefined" ? ageLevel : 0; %>
<section class="mk-panel" aria-labelledby="ag-h"><h2 id="ag-h">Contrôle d'âge (alcool, tabac…)</h2>
  <p class="field-hint">La fiche reste visible, mais l'achat exige que le client déclare avoir l'âge minimum (ajout au panier et commande). Attention : c'est une simple déclaration sur l'honneur, sans vérification d'identité ; la livraison peut exiger une pièce d'identité. L'âge peut aussi être réglé par catégorie (le plus élevé s'applique).</p>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/age">
    <div class="field-group"><label for="ag-n">Âge minimum</label><select id="ag-n" name="min_age"<%= canWrite ? "" : " disabled" %>><% [[0, "Aucun contrôle"], [16, "16 ans"], [18, "18 ans"], [21, "21 ans"]].forEach((o) => { %><option value="<%= o[0] %>"<%= ag === o[0] ? " selected" : "" %>><%= o[1] %></option><% }) %></select></div>
    <% if (canWrite) { %><button class="btn btn-primary btn-sm" type="submit">Enregistrer</button><% } %>
  </form>
</section>
<% } %>
<% if (product && product.type === "variable") { %>
<% if (product.type === "digital") { %>
<section class="mk-panel" aria-labelledby="dl-h"><h2 id="dl-h">Fichiers à télécharger</h2>
  <p class="field-hint">Les fichiers sont stockés en privé et ne sont remis qu'aux acheteurs d'une commande payée, par un lien personnel limité en nombre et en durée. Formats : PDF, ZIP, EPUB, audio, vidéo, images, Office, texte (25 Mo au plus).</p>
  <% if (!files.length) { %><p class="mk-empty">Aucun fichier : un produit numérique sans fichier ne livre rien. Ajoutez-en au moins un avant de le publier.</p><% } else { %>
  <ul><% files.forEach((f) => { %><li><strong><%= f.label %></strong> — <%= f.original_name %> (<%= Math.max(1, Math.round(f.size_bytes / 1024)) %> Ko)
    <% if (canWrite) { %><form class="mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/fichiers/<%= f.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Supprimer ce fichier ? Les acheteurs ne pourront plus le télécharger." data-mk-confirm-ok="Supprimer">Supprimer</button></form><% } %></li><% }) %></ul><% } %>
  <% if (canWrite) { %>
  <form class="mk-form" method="post" enctype="multipart/form-data" action="<%= base %>/produits/<%= product.id %>/fichiers">
    <div class="field-group"><label for="dl-l">Nom affiché à l'acheteur</label><input type="text" id="dl-l" name="label" maxlength="120"></div>
    <div class="field-group"><label for="dl-f">Fichier</label><input id="dl-f" name="file" type="file" required></div>
    <button class="btn btn-primary btn-sm" type="submit">Ajouter le fichier</button>
  </form>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/telechargement">
    <div class="field-group"><label for="dl-n">Téléchargements autorisés par achat</label><input type="text" id="dl-n" name="download_limit" inputmode="numeric" value="<%= dl.download_limit == null ? "" : dl.download_limit %>" placeholder="5 (0 = illimité)"></div>
    <div class="field-group"><label for="dl-d">Durée du lien, en jours</label><input type="text" id="dl-d" name="download_days" inputmode="numeric" value="<%= dl.download_days == null ? "" : dl.download_days %>" placeholder="30 (0 = sans limite)"></div>
    <button class="btn btn-outline btn-sm" type="submit">Enregistrer les règles</button>
  </form>
  <% } %>
</section>
<% } %>
<% if (canWrite) { %><section class="mk-panel"><form method="post" action="<%= base %>/produits/<%= product.id %>/dupliquer"><button class="btn btn-outline btn-sm" type="submit">Dupliquer ce produit (brouillon)</button></form></section><% } %>
<section class="mk-panel" aria-labelledby="cl-h"><h2 id="cl-h">Classes de taxe et d'expédition</h2>
  <p class="field-hint">Une classe de taxe applique son propre taux (ex. taux réduit) ; une classe d'expédition ajoute son supplément de livraison. Créez-les dans « Taxes et expédition ». Sans classe, le produit suit les règles standard.</p>
  <% if (canWrite) { %><form class="mk-form mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/classes">
    <div class="field-group"><label for="cl-t">Classe de taxe</label><select id="cl-t" name="tax_class_id"><option value="">Standard</option><% taxClasses.forEach((c) => { %><option value="<%= c.id %>"<%= cls && cls.tax_class_id === c.id ? " selected" : "" %>><%= c.name %></option><% }) %></select></div>
    <div class="field-group"><label for="cl-s">Classe d'expédition</label><select id="cl-s" name="shipping_class_id"><option value="">Aucune</option><% shipClasses.forEach((c) => { %><option value="<%= c.id %>"<%= cls && cls.shipping_class_id === c.id ? " selected" : "" %>><%= c.name %></option><% }) %></select></div>
    <button class="btn btn-outline btn-sm" type="submit">Enregistrer</button>
  </form><% } %>
</section>
<section class="mk-panel" aria-labelledby="var-h"><h2 id="var-h">Variantes</h2>
  <% if (canWrite && product.type === "variable" && product.attributes.length) { %><form class="mk-form mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/generer-variantes">
    <p class="field-hint">Crée toutes les combinaisons des attributs qui n'existent pas encore (200 au plus).</p>
    <div class="field-group"><label for="gv-s">Stock initial de chaque variante</label><input id="gv-s" name="stock" type="number" min="0" value="0"></div>
    <div class="field-group"><label><input type="checkbox" name="manage_stock" value="1" checked> Suivre le stock</label></div>
    <button class="btn btn-outline btn-sm" type="submit">Générer les variantes</button></form><% } %>
  <% if (!product.attributes.length) { %><p class="mk-empty">Définissez d'abord les attributs (ex. « Taille: S, M, L »), enregistrez, puis ajoutez les variantes.</p><% } else { %>
  <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Variantes</caption><thead><tr><th scope="col">Combinaison</th><th scope="col">SKU</th><th scope="col">Prix</th><th scope="col">Stock</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
  <% variants.forEach((x) => { %><tr><th scope="row"><%= Object.values(x.options).join(" / ") %></th><td><%= x.sku || "—" %></td><td><%= x.price_cents != null ? money(x.price_cents) : "prix du produit" %></td><td><%= x.manage_stock ? x.stock_qty : "illimité" %></td>
    <td><% if (canWrite) { %><form method="post" action="<%= base %>/produits/<%= product.id %>/variantes/<%= x.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Supprimer cette variante ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form><% } %></td></tr><% }) %>
  </tbody></table></div>
  <% if (canWrite) { %>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/variantes"><h3>Ajouter une variante</h3>
    <% product.attributes.forEach((a) => { %><div class="field-group"><label for="o-<%= a.name %>"><%= a.name %></label><select id="o-<%= a.name %>" name="opt_<%= a.name %>" required><% a.values.forEach((val) => { %><option><%= val %></option><% }) %></select></div><% }) %>
    <div class="field-group"><label for="v-sku">SKU</label><input type="text" id="v-sku" name="sku"></div>
    <div class="field-group"><label for="v-price">Prix (vide = prix du produit)</label><input type="text" id="v-price" name="price" inputmode="decimal"></div>
    <div class="field-group"><label for="v-stock">Stock</label><input id="v-stock" name="stock_qty" type="number" min="0" value="0"></div>
    <button class="btn btn-primary btn-sm" type="submit">Ajouter</button></form>
  <% } %><% } %>
</section>
<% } %>
<% if (product && canWrite) { %>
<section class="mk-panel"><h2>Ajuster le stock</h2>
  <form class="mk-form mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/stock">
    <% if (product.type === "variable") { %><div class="field-group"><label for="s-v">Variante</label><select id="s-v" name="variant_id"><% variants.forEach((x) => { %><option value="<%= x.id %>"><%= Object.values(x.options).join(" / ") %> (<%= x.stock_qty %>)</option><% }) %></select></div><% } %>
    <div class="field-group"><label for="s-d">Variation (+ ou −)</label><input id="s-d" name="delta" type="number" required></div>
    <button class="btn btn-outline btn-sm" type="submit">Ajuster</button></form>
  <form method="post" action="<%= base %>/produits/<%= product.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Le produit disparaîtra du catalogue ; les commandes passées sont conservées." data-mk-confirm-title="Supprimer ce produit ?" data-mk-confirm-ok="Supprimer">Supprimer le produit</button></form>
</section>
<% } %>
<%- include("../partials/bottom") %>
