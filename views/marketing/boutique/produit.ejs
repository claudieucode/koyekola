<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: product ? product.name : "Nouveau produit" }) %>
<% const v = product ? { name: product.name, type: product.type, status: product.status, sku: product.sku, short_description: product.short_description, description: product.description, price: (product.price_cents / 100).toFixed(2), sale_price: product.sale_price_cents != null ? (product.sale_price_cents / 100).toFixed(2) : "", sale_starts_at: product.sale_starts_at, sale_ends_at: product.sale_ends_at, manage_stock: product.manage_stock, stock_qty: product.stock_qty, weight_grams: product.weight_grams, length_mm: product.length_mm, width_mm: product.width_mm, height_mm: product.height_mm, requires_shipping: product.requires_shipping, image_url: product.image_url, gallery: product.gallery.join("\n"), tags: product.tags.join(", "), is_featured: product.is_featured, seo_title: product.seo_title, seo_description: product.seo_description, attributes: product.attributes.map((a) => a.name + ": " + a.values.join(", ")).join("\n") } : values; const sel = product ? product.categories.map((c) => c.id) : [].concat(values.category_ids || []).map(Number); const dis = canWrite ? "" : " disabled"; %>
<form class="mk-form mk-panel" method="post" action="<%= base %>/produits<%= product ? "/" + product.id : "" %>">
  <h2>Informations</h2>
  <div class="field-group"><label for="f-name">Nom</label><input id="f-name" name="name" value="<%= v.name || "" %>" required maxlength="200"<%= dis %>></div>
  <div class="field-group"><label for="f-type">Type de produit</label>
    <select id="f-type" name="type"<%= dis %>><option value="simple"<%= (v.type || "simple") === "simple" ? " selected" : "" %>>Simple (physique)</option><option value="variable"<%= v.type === "variable" ? " selected" : "" %>>Variable (avec variantes)</option><option value="digital"<%= v.type === "digital" ? " selected" : "" %>>Numérique (sans livraison)</option></select>
    <p class="field-hint">Les types « téléchargeable » et « groupé » ne sont pas encore pris en charge.</p></div>
  <div class="field-group"><label for="f-status">Statut</label><select id="f-status" name="status"<%= dis %>><% [["draft","Brouillon"],["published","En ligne"],["archived","Archivé"]].forEach(([k,l]) => { %><option value="<%= k %>"<%= (v.status || "draft") === k ? " selected" : "" %>><%= l %></option><% }) %></select></div>
  <div class="field-group"><label for="f-short">Description courte</label><input id="f-short" name="short_description" value="<%= v.short_description || "" %>" maxlength="600"<%= dis %>></div>
  <div class="field-group"><label for="f-desc">Description complète</label><textarea id="f-desc" name="description" rows="6" maxlength="20000"<%= dis %>><%= v.description || "" %></textarea></div>
  <h2>Prix</h2>
  <div class="field-group"><label for="f-price">Prix normal (<%= shopSettings.currency.toUpperCase() %>)</label><input id="f-price" name="price" inputmode="decimal" value="<%= v.price || "" %>" required<%= dis %>></div>
  <div class="field-group"><label for="f-sale">Prix promotionnel</label><input id="f-sale" name="sale_price" inputmode="decimal" value="<%= v.sale_price || "" %>"<%= dis %>><p class="field-hint">Doit être inférieur au prix normal. Laissez vide pour aucune promotion.</p></div>
  <div class="field-group"><label for="f-s1">Début de la promotion</label><input id="f-s1" name="sale_starts_at" value="<%= v.sale_starts_at || "" %>" placeholder="AAAA-MM-JJ"<%= dis %>></div>
  <div class="field-group"><label for="f-s2">Fin de la promotion</label><input id="f-s2" name="sale_ends_at" value="<%= v.sale_ends_at || "" %>" placeholder="AAAA-MM-JJ"<%= dis %>></div>
  <h2>Stock et expédition</h2>
  <div class="field-group"><label for="f-sku">Référence (SKU)</label><input id="f-sku" name="sku" value="<%= v.sku || "" %>" maxlength="80"<%= dis %>></div>
  <div class="field-group"><label><input type="checkbox" name="manage_stock" value="1"<%= v.manage_stock ? " checked" : "" %><%= dis %>> Gérer le stock (produit simple ou numérique)</label></div>
  <div class="field-group"><label for="f-stock">Quantité en stock</label><input id="f-stock" name="stock_qty" type="number" min="0" value="<%= v.stock_qty ?? 0 %>"<%= dis %>></div>
  <div class="field-group"><label><input type="checkbox" name="requires_shipping" value="1"<%= (product ? v.requires_shipping : (v.requires_shipping !== undefined ? v.requires_shipping : 1)) ? " checked" : "" %><%= dis %>> Produit à livrer</label></div>
  <div class="field-group"><label for="f-w">Poids (grammes)</label><input id="f-w" name="weight_grams" type="number" min="0" value="<%= v.weight_grams ?? "" %>"<%= dis %>></div>
  <div class="field-group"><label for="f-l">Dimensions (mm) : longueur / largeur / hauteur</label><input id="f-l" name="length_mm" type="number" min="0" value="<%= v.length_mm ?? "" %>"<%= dis %>> <input name="width_mm" type="number" min="0" value="<%= v.width_mm ?? "" %>" aria-label="Largeur"<%= dis %>> <input name="height_mm" type="number" min="0" value="<%= v.height_mm ?? "" %>" aria-label="Hauteur"<%= dis %>></div>
  <h2>Classement et images</h2>
  <div class="field-group"><label for="f-cat">Catégories</label><select id="f-cat" name="category_ids" multiple size="5"<%= dis %>><% categories.forEach((c) => { %><option value="<%= c.id %>"<%= sel.includes(c.id) ? " selected" : "" %>><%= c.name %></option><% }) %></select></div>
  <div class="field-group"><label for="f-tags">Étiquettes (séparées par des virgules)</label><input id="f-tags" name="tags" value="<%= v.tags || "" %>"<%= dis %>></div>
  <div class="field-group"><label for="f-img">Image principale (adresse de la médiathèque)</label><input id="f-img" name="image_url" value="<%= v.image_url || "" %>" placeholder="/uploads/…"<%= dis %>></div>
  <div class="field-group"><label for="f-gal">Galerie (une adresse par ligne)</label><textarea id="f-gal" name="gallery" rows="3"<%= dis %>><%= v.gallery || "" %></textarea></div>
  <div class="field-group"><label><input type="checkbox" name="is_featured" value="1"<%= v.is_featured ? " checked" : "" %><%= dis %>> Produit mis en avant</label></div>
  <div class="field-group"><label for="f-attr">Attributs (produit variable) — un par ligne : « Taille: S, M, L »</label><textarea id="f-attr" name="attributes" rows="3"<%= dis %>><%= v.attributes || "" %></textarea></div>
  <h2>Référencement</h2>
  <div class="field-group"><label for="f-st">Titre SEO</label><input id="f-st" name="seo_title" value="<%= v.seo_title || "" %>" maxlength="160"<%= dis %>></div>
  <div class="field-group"><label for="f-sd">Description SEO</label><input id="f-sd" name="seo_description" value="<%= v.seo_description || "" %>" maxlength="320"<%= dis %>></div>
  <% if (canWrite) { %><button class="btn btn-primary" type="submit">Enregistrer</button><% } %>
</form>
<% if (product) { const pz = typeof personalization !== "undefined" ? personalization : null; %>
<section class="mk-panel" aria-labelledby="pz-h"><h2 id="pz-h">Personnalisation (gravure, initiales, message)</h2>
  <p class="field-hint">Le client saisit un court texte avant d'ajouter au panier ; il apparaît sur la commande et dans l'e-mail. Le prix ne change pas.</p>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/personnalisation">
    <div class="field-group"><label><input type="checkbox" name="enabled" value="1"<%= pz ? " checked" : "" %><%= canWrite ? "" : " disabled" %>> Proposer une personnalisation sur ce produit</label></div>
    <div class="field-group"><label for="pz-l">Ce que le client personnalise</label><input id="pz-l" name="label" maxlength="60" value="<%= pz ? pz.label : "Texte à graver" %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label for="pz-h2">Aide affichée dans le champ (facultatif)</label><input id="pz-h2" name="hint" maxlength="160" value="<%= pz ? pz.hint : "" %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label for="pz-m">Nombre de caractères maximum</label><input id="pz-m" name="max_length" type="number" min="1" max="200" value="<%= pz ? pz.maxLength : 20 %>"<%= canWrite ? "" : " disabled" %>></div>
    <div class="field-group"><label><input type="checkbox" name="required" value="1"<%= pz && pz.required ? " checked" : "" %><%= canWrite ? "" : " disabled" %>> Champ obligatoire</label></div>
    <% if (canWrite) { %><button class="btn btn-primary btn-sm" type="submit">Enregistrer la personnalisation</button><% } %>
  </form>
</section>
<% } %>
<% if (product && product.type === "variable") { %>
<section class="mk-panel" aria-labelledby="var-h"><h2 id="var-h">Variantes</h2>
  <% if (!product.attributes.length) { %><p class="mk-empty">Définissez d'abord les attributs (ex. « Taille: S, M, L »), enregistrez, puis ajoutez les variantes.</p><% } else { %>
  <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Variantes</caption><thead><tr><th scope="col">Combinaison</th><th scope="col">SKU</th><th scope="col">Prix</th><th scope="col">Stock</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
  <% variants.forEach((x) => { %><tr><th scope="row"><%= Object.values(x.options).join(" / ") %></th><td><%= x.sku || "—" %></td><td><%= x.price_cents != null ? money(x.price_cents) : "prix du produit" %></td><td><%= x.manage_stock ? x.stock_qty : "illimité" %></td>
    <td><% if (canWrite) { %><form method="post" action="<%= base %>/produits/<%= product.id %>/variantes/<%= x.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Supprimer cette variante ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form><% } %></td></tr><% }) %>
  </tbody></table></div>
  <% if (canWrite) { %>
  <form class="mk-form" method="post" action="<%= base %>/produits/<%= product.id %>/variantes"><h3>Ajouter une variante</h3>
    <% product.attributes.forEach((a) => { %><div class="field-group"><label for="o-<%= a.name %>"><%= a.name %></label><select id="o-<%= a.name %>" name="opt_<%= a.name %>" required><% a.values.forEach((val) => { %><option><%= val %></option><% }) %></select></div><% }) %>
    <div class="field-group"><label for="v-sku">SKU</label><input id="v-sku" name="sku"></div>
    <div class="field-group"><label for="v-price">Prix (vide = prix du produit)</label><input id="v-price" name="price" inputmode="decimal"></div>
    <div class="field-group"><label for="v-stock">Stock</label><input id="v-stock" name="stock_qty" type="number" min="0" value="0"></div>
    <button class="btn btn-primary btn-sm" type="submit">Ajouter</button></form>
  <% } %><% } %>
</section>
<% } %>
<% if (product && canWrite) { %>
<section class="mk-panel"><h2>Ajuster le stock</h2>
  <form class="mk-form mk-inline-form" method="post" action="<%= base %>/produits/<%= product.id %>/stock">
    <% if (product.type === "variable") { %><div class="field-group"><label for="s-v">Variante</label><select id="s-v" name="variant_id"><% variants.forEach((x) => { %><option value="<%= x.id %>"><%= Object.values(x.options).join(" / ") %> (<%= x.stock_qty %>)</option><% }) %></select></div><% } %>
    <div class="field-group"><label for="s-d">Variation (+ ou −)</label><input id="s-d" name="delta" type="number" required></div>
    <button class="btn btn-outline btn-sm" type="submit">Ajuster</button></form>
  <form method="post" action="<%= base %>/produits/<%= product.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="Le produit disparaîtra du catalogue ; les commandes passées sont conservées." data-mk-confirm-title="Supprimer ce produit ?" data-mk-confirm-ok="Supprimer">Supprimer le produit</button></form>
</section>
<% } %>
<%- include("../partials/bottom") %>
