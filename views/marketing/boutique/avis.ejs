<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: "Avis clients" }) %>
<section class="mk-panel">
<p class="field-hint">Ces avis viennent uniquement de clients ayant payé le produit. Vous pouvez les publier, les refuser ou les supprimer, mais pas en écrire.</p>
<nav class="mk-tabs bq-subtabs" aria-label="Filtrer les avis">
  <a class="mk-tab" href="<%= base %>/avis"<%- !query.statut ? ' aria-current="page"' : "" %>>Tous<% if (list.pending) { %> <span class="mk-tab-count"><%= list.pending %> à relire</span><% } %></a>
  <a class="mk-tab" href="<%= base %>/avis?statut=pending"<%- query.statut === "pending" ? ' aria-current="page"' : "" %>>À relire</a>
  <a class="mk-tab" href="<%= base %>/avis?statut=published"<%- query.statut === "published" ? ' aria-current="page"' : "" %>>Publiés</a>
  <a class="mk-tab" href="<%= base %>/avis?statut=rejected"<%- query.statut === "rejected" ? ' aria-current="page"' : "" %>>Refusés</a>
</nav>
<% if (!list.items.length) { %><%- include("_vide", { titre: "Aucun avis pour le moment", texte: query.statut ? "Aucun avis dans cette catégorie." : "Dès qu'un client ayant payé un produit laisse un avis, il apparaît ici pour relecture.", action: query.statut ? { href: base + "/avis", label: "Voir tous les avis" } : null }) %><% } else { %>
<div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Avis clients</caption>
<thead><tr><th scope="col">Produit</th><th scope="col">Note</th><th scope="col">Avis</th><th scope="col">Commande</th><th scope="col">Statut</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
<% const labels = { pending: "À relire", published: "Publié", rejected: "Refusé" }; const chip = { pending: "mk-status mk-status-warn", published: "mk-status mk-status-ok", rejected: "mk-status" }; list.items.forEach((r) => { %>
<tr><th scope="row"><%= r.product_name %></th><td class="mk-num" aria-label="Note : <%= r.rating %> sur 5"><span aria-hidden="true"><%= "★".repeat(r.rating) %><span class="mk-sub" style="display:inline"><%= "★".repeat(5 - r.rating) %></span></span></td><td><% if (r.title) { %><strong><%= r.title %></strong><br><% } %><%= r.body || "" %><span class="mk-sub"><%= r.author_name %> · <%= String(r.created_at).slice(0, 10) %></span></td><td><%= r.order_number %></td><td><span class="<%= chip[r.status] || "mk-status" %>"><%= labels[r.status] %></span></td>
<td><% if (canWrite) { %>
  <% if (r.status !== "published") { %><form class="mk-inline-form" method="post" action="<%= base %>/avis/<%= r.id %>/statut"><input type="hidden" name="statut" value="published"><button class="btn btn-outline btn-sm" type="submit">Publier</button></form><% } %>
  <% if (r.status !== "rejected") { %><form class="mk-inline-form" method="post" action="<%= base %>/avis/<%= r.id %>/statut"><input type="hidden" name="statut" value="rejected"><button class="btn btn-ghost btn-sm" type="submit">Refuser</button></form><% } %>
  <form class="mk-inline-form" method="post" action="<%= base %>/avis/<%= r.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="L'avis sera définitivement supprimé." data-mk-confirm-title="Supprimer cet avis ?" data-mk-confirm-ok="Supprimer">Supprimer</button></form>
<% } %></td></tr>
<% }) %></tbody></table></div>
<% } %>
</section>
<%- include("../partials/bottom") %>
