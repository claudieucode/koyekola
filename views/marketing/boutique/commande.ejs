<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: "Commande " + order.number }) %>
<% const PS = { unpaid: "Non payée", pending: "Paiement en cours", paid: "Payée", failed: "Paiement échoué", refunded: "Remboursée" }; %>
<section class="mk-panel"><h2>Résumé</h2>
  <p>Statut : <strong><%= statusLabels[order.status] %></strong> · Paiement : <strong><%= PS[order.payment_status] %></strong> (<%= order.payment_method %>) · Client : <%= order.email %> · <%= String(order.created_at).slice(0, 16) %></p>
  <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Articles</caption><thead><tr><th scope="col">Article</th><th scope="col">SKU</th><th scope="col">Qté</th><th scope="col">Prix unitaire</th><th scope="col">Total</th></tr></thead><tbody>
  <% order.items.forEach((i) => { %><tr><th scope="row"><%= i.name %><%= i.variant_label ? " (" + i.variant_label + ")" : "" %><% if (i.custom_text) { %><br><small><strong><%= i.custom_label || "Personnalisation" %> :</strong> « <%= i.custom_text %> »</small><% } %></th><td><%= i.sku || "—" %></td><td><%= i.quantity %></td><td><%= money(i.unit_price_cents) %></td><td><%= money(i.line_subtotal_cents - i.discount_cents) %></td></tr><% }) %>
  </tbody></table></div>
  <p>Sous-total <%= money(order.subtotal_cents) %><% if (order.discount_cents) { %> · Réduction − <%= money(order.discount_cents) %> (<%= order.coupon_code %>)<% } %> · Livraison <%= money(order.shipping_cents) %><%= order.shipping_method_name ? " (" + order.shipping_method_name + ")" : "" %> · Taxes <%= money(order.tax_cents) %> <%= order.prices_include_tax ? "(incluses)" : "(en sus)" %> · <strong>Total <%= money(order.total_cents) %></strong></p>
  <% if (order.shippingAddress && order.shippingAddress.line1) { const a = order.shippingAddress; %><p>Livraison : <%= a.name %>, <%= a.line1 %> <%= a.line2 %>, <%= a.postal_code %> <%= a.city %>, <%= a.country %></p><% } %>
  <% if (order.delivery_date) { %><p><strong>Créneau de livraison :</strong> <%= slotText %></p><% } %>
  <% if (order.age_confirmed_at) { %><p><strong>Contrôle d'âge :</strong> le client a déclaré avoir au moins <%= order.age_confirmed_min %> ans le <%= String(order.age_confirmed_at).slice(0, 16) %> (case cochée à la commande). <small>Simple déclaration sur l'honneur, sans vérification d'identité : la livraison peut exiger une pièce d'identité.</small></p><% } %>
  <% if (order.tracking_number) { %><p>Suivi : <%= order.tracking_number %></p><% } %>
</section>
<% if (canOrders && next.length) { %>
<section class="mk-panel"><h2>Changer le statut</h2>
  <% next.forEach((t) => { const sensitive = t === "paid" || t === "refunded"; %>
    <% if (!sensitive || canPay) { %>
    <form class="mk-form mk-inline-form" method="post" action="<%= base %>/commandes/<%= order.id %>/statut">
      <input type="hidden" name="statut" value="<%= t %>">
      <% if (t === "shipped") { %><div class="field-group"><label for="t-<%= t %>">Numéro de suivi</label><input id="t-<%= t %>" name="tracking" maxlength="80"></div><% } %>
      <div class="field-group"><label for="n-<%= t %>">Note (facultatif)</label><input id="n-<%= t %>" name="note" maxlength="300"></div>
      <button class="btn <%= t === "cancelled" || t === "refunded" ? "btn-outline" : "btn-primary" %> btn-sm" type="submit"<% if (t === "paid") { %> data-mk-confirm="Confirmez-vous avoir reçu le paiement de <%= money(order.total_cents) %> ?" data-mk-confirm-title="Confirmer le paiement" data-mk-confirm-ok="Confirmer"<% } else if (t === "refunded") { %> data-mk-confirm="Cela enregistre le remboursement ; il doit être effectué chez le fournisseur de paiement." data-mk-confirm-ok="Enregistrer"<% } %>><%= { paid: "Confirmer le paiement reçu", processing: "Mettre en préparation", shipped: "Marquer comme expédiée", completed: "Marquer comme terminée", cancelled: "Annuler la commande", refunded: "Enregistrer un remboursement" }[t] %></button>
    </form>
    <% } %>
  <% }) %>
</section>
<% } %>
<% const refundedCents = (order.refunds || []).filter((r) => r.status === "succeeded" || r.status === "pending").reduce((n, r) => n + r.amount_cents, 0); const refundable = ["paid", "processing", "shipped", "completed"].includes(order.status) && order.payment_status === "paid"; const left = order.total_cents - refundedCents; %>
<% if (refundedCents > 0 || (refundable && canPay)) { %>
<% if (docs && docs.length) { %><section class="mk-panel"><h2>Factures et avoirs</h2><ul><% docs.forEach((d) => { %><li><a href="<%= base %>/commandes/<%= order.id %>/factures/<%= d.id %>" target="_blank" rel="noopener"><%= d.kind === "invoice" ? "Facture" : "Avoir" %> <%= d.number %></a> — <%= money(d.total_cents) %>, émis le <%= String(d.issued_at).slice(0, 10) %></li><% }) %></ul></section><% } %>
<section class="mk-panel" id="remboursement"><h2>Remboursements</h2>
  <p>Remboursé : <strong><%= money(refundedCents) %></strong> sur <%= money(order.total_cents) %><% if (left > 0 && refundedCents > 0) { %> · reste <%= money(left) %><% } %></p>
  <% if ((order.refunds || []).length) { %><ul class="mk-list"><% order.refunds.forEach((r) => { %><li><%= String(r.created_at).slice(0, 16) %> — <%= money(r.amount_cents) %> · <%= r.provider === "stripe" ? "Stripe" : "hors plateforme" %> · <%= { pending: "en cours", succeeded: "effectué", failed: "refusé" }[r.status] %><%= r.restock ? " · remis en stock" : "" %><%= r.reason ? " — " + r.reason : "" %></li><% }) %></ul><% } %>
  <% if (refundable && canPay && left > 0) { %>
  <form class="mk-form" method="post" action="<%= base %>/commandes/<%= order.id %>/remboursement">
    <input type="hidden" name="idempotency_key" value="<%= require("node:crypto").randomBytes(12).toString("hex") %>">
    <p class="mk-sub">Laissez le montant vide pour rembourser tout le reste (<%= money(left) %>), ou indiquez un montant, ou des quantités d'articles : le montant est alors calculé (prix, remise et taxes au prorata).</p>
    <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Articles à rembourser</caption><thead><tr><th scope="col">Article</th><th scope="col">Quantité à rembourser</th></tr></thead><tbody>
    <% order.items.forEach((i) => { %><tr><th scope="row"><%= i.name %> (commandé : <%= i.quantity %>)</th><td><input type="number" min="0" max="<%= i.quantity %>" name="qty_<%= i.id %>" value="0" aria-label="Quantité à rembourser : <%= i.name %>"></td></tr><% }) %>
    </tbody></table></div>
    <div class="field-group"><label for="rf-amount">Montant à rembourser (facultatif)</label><input id="rf-amount" name="amount" inputmode="decimal" placeholder="<%= (left / 100).toFixed(2) %>"></div>
    <div class="field-group"><label><input type="checkbox" name="shipping" value="1"> Rembourser aussi la livraison (<%= money(order.shipping_cents) %>) avec les articles</label></div>
    <div class="field-group"><label><input type="checkbox" name="restock" value="1"> Remettre les articles remboursés en stock</label></div>
    <div class="field-group"><label for="rf-reason">Motif (facultatif)</label><input id="rf-reason" name="reason" maxlength="300"></div>
    <button class="btn btn-outline btn-sm" type="submit" data-mk-confirm="Le remboursement sera effectué chez le fournisseur de paiement et ne peut pas être annulé." data-mk-confirm-title="Rembourser" data-mk-confirm-ok="Rembourser">Rembourser</button>
  </form>
  <% } %>
</section>
<% } %>
<section class="mk-panel"><h2>Historique</h2>
  <ul class="mk-list"><% order.events.forEach((e) => { %><li><span class="mk-sub"><%= String(e.created_at).slice(0, 16) %></span> — <%= e.to_status ? statusLabels[e.to_status] : e.kind %> <span class="mk-sub">(<%= e.actor %>)</span><%= e.note ? " — " + e.note : "" %></li><% }) %></ul>
  <% if (order.payments.length) { %><h3>Paiements</h3><ul class="mk-list"><% order.payments.forEach((p) => { %><li><%= p.provider %> · <%= money(p.amount_cents) %> · <%= p.status %><%= p.failure_reason ? " — " + p.failure_reason : "" %></li><% }) %></ul><% } %>
</section>
<%- include("../partials/bottom") %>
