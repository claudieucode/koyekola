<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: "Commandes" }) %>
<section class="mk-panel">
  <form method="get" class="mk-form mk-inline-form" role="search">
    <div class="field-group"><label for="o-q">Numéro ou e-mail</label><input type="search" id="o-q" name="q" value="<%= query.q || "" %>" maxlength="80"></div>
    <div class="field-group"><label for="o-st">Statut</label><select id="o-st" name="statut"><option value="">Tous</option><% Object.entries(statusLabels).forEach(([k, l]) => { %><option value="<%= k %>"<%= query.statut === k ? " selected" : "" %>><%= l %></option><% }) %></select></div>
    <button class="btn btn-outline btn-sm" type="submit">Filtrer</button>
    <% if (canOrders) { %><a class="btn btn-primary btn-sm" href="<%= base %>/commandes/nouvelle">Nouvelle commande</a><% } %>
  </form>
  <% if (!list.items.length) { %><%- include("_vide", { titre: (query.q || query.statut) ? "Aucune commande ne correspond" : "Aucune commande", texte: (query.q || query.statut) ? "Essayez un autre numéro ou e-mail, ou retirez le filtre de statut." : "Les commandes passées par vos clients apparaîtront ici. Vous pouvez aussi en créer une à la main.", action: (query.q || query.statut) ? { href: base + "/commandes", label: "Voir toutes les commandes" } : (canOrders ? { href: base + "/commandes/nouvelle", label: "Nouvelle commande" } : null) }) %><% } else { %>
  <form method="post" action="<%= base %>/commandes/lot">
  <div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Commandes</caption><thead><tr><% if (canOrders) { %><th scope="col"><span class="sr-only">Sélection</span></th><% } %><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Client</th><th scope="col">Statut</th><th scope="col">Paiement</th><th scope="col">Total</th></tr></thead><tbody>
  <% const PS = { unpaid: "Non payée", pending: "En cours", paid: "Payée", failed: "Échec", refunded: "Remboursée" }; %>
  <% list.items.forEach((o) => { %><tr><% if (canOrders) { %><td><input type="checkbox" name="ids" value="<%= o.id %>" aria-label="Sélectionner <%= o.number %>"></td><% } %><th scope="row"><a href="<%= base %>/commandes/<%= o.id %>"><%= o.number %></a></th><td><%= String(o.created_at).slice(0, 16).replace("T", " ") %></td><td><%= o.email %></td><td><span class="mk-status"><%= statusLabels[o.status] %></span></td><td><span class="mk-status <%= { paid: "mk-status-ok", failed: "mk-status-err", pending: "mk-status-info", refunded: "mk-status-warn" }[o.payment_status] || "" %>"><%= PS[o.payment_status] %></span></td><td class="mk-num"><%= money(o.total_cents) %></td></tr><% }) %>
  </tbody></table></div>
  <% if (canOrders) { %><p class="mk-inline-form"><label for="bulk-o">Pour les commandes cochées :</label> <select id="bulk-o" name="action"><option value="processing">En préparation</option><option value="shipped">Expédiée</option><option value="completed">Terminée</option><option value="cancelled">Annuler (non payées)</option></select> <button class="btn btn-outline btn-sm" type="submit" data-mk-confirm="Appliquer cette action aux commandes cochées ? Celles qui ne peuvent pas passer à ce statut sont ignorées." data-mk-confirm-ok="Appliquer">Appliquer</button></p><% } %>
  </form>
  <%- include("_pager", { list, nom: "commandes" }) %>
  <% } %>
</section>
<%- include("../partials/bottom") %>
