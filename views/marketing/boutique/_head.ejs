<%#
  En-tête commun des écrans de la boutique : titre, navigation secondaire (onglets) et alertes d'état réelles (module, ouverture).
  Paramètres : heading (titre), tab (facultatif : onglet actif quand il diffère de « active »).
%><%
  const bqTab = typeof tab !== "undefined" && tab ? tab : active;
  const bqGroups = [
    [["boutique", "", "Produits"], ["boutique/categories", "/categories", "Catégories"], ["boutique/avis", "/avis", "Avis"]],
    [["boutique/commandes", "/commandes", "Commandes"], ["boutique/clients", "/clients", "Clients"], ["boutique/abonnements", "/abonnements", "Abonnements"], ["boutique/rendez-vous", "/rendez-vous", "Rendez-vous"], ["boutique/listes-cadeaux", "/listes-cadeaux", "Listes cadeaux"]],
    [["boutique/rapports", "/rapports", "Rapports"], ["boutique/factures", "/factures", "Factures"], ["boutique/acces", "/acces", "Accès membre"]],
    [["boutique/classes", "/classes", "Taxes et expédition"], ["boutique/paiements", "/paiements", "Paiements"], ["boutique/reglages", "/reglages", "Réglages"]],
  ];
%>
<div class="mk-head"><div class="mk-head-main"><h1><%= heading %></h1>
  <p class="mk-head-sub">Boutique de « <%= space.name %> » — produits, commandes et clients propres à ce site.</p></div></div>
<nav class="mk-tabs bq-tabs" aria-label="Boutique" data-bq-tabs>
  <% bqGroups.forEach((group, gi) => { %><% if (gi) { %><span class="bq-sep" aria-hidden="true"></span><% } %><% group.forEach(([key, path, label]) => { %><a class="mk-tab" href="<%= base %><%= path %>"<%- bqTab === key ? ' aria-current="page"' : "" %>><%= label %></a><% }) %><% }) %>
</nav>
<% if (!moduleOn || !shopSettings.enabled) { %><div class="bq-notices">
<% if (!moduleOn) { %><p class="mk-callout mk-callout-warn bq-notice" role="status"><%- icon("info", { size: 16 }) %><span>Le module « Commerce » n'est pas activé pour ce site : la boutique publique reste fermée. L'équipe de l'organisation l'active dans les réglages du site.</span></p><% } %>
<% if (!shopSettings.enabled) { %><p class="mk-callout bq-notice" role="status"><%- icon("info", { size: 16 }) %><span>La boutique n'est pas ouverte au public. Ouvrez-la dans <a href="<%= base %>/reglages">Réglages</a> une fois les produits, la livraison et le paiement prêts.</span></p><% } %>
</div><% } %>
