<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title><%= inv.kind === "invoice" ? "Facture" : "Avoir" %> <%= inv.number %></title>
<style>
  body{font:14px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#111;margin:0;background:#f4f4f5}
  .page{max-width:820px;margin:24px auto;background:#fff;padding:40px;border:1px solid #ddd}
  h1{font-size:1.6rem;margin:0 0 4px} .muted{color:#555} .row{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
  table{width:100%;border-collapse:collapse;margin:24px 0} th,td{padding:8px;border-bottom:1px solid #e5e5e5;text-align:left} th:nth-child(n+2),td:nth-child(n+2){text-align:right}
  .tot td{border:0;padding:3px 8px} .tot td:first-child{text-align:right} .big{font-weight:700;font-size:1.1rem}
  .bar{max-width:820px;margin:16px auto 0;text-align:right} button{padding:8px 14px;border:1px solid #111;background:#111;color:#fff;border-radius:6px;cursor:pointer}
  pre{font:inherit;white-space:pre-wrap;margin:0}
  @media print{body{background:#fff}.page{border:0;margin:0;padding:0}.bar{display:none}}
</style></head><body>
<div class="bar"><button type="button" onclick="window.print()">Imprimer / enregistrer en PDF</button></div>
<% const d = inv.data, sg = inv.kind === "credit_note" ? -1 : 1; const m = (c) => money(c); const b = d.buyer.billing && d.buyer.billing.line1 ? d.buyer.billing : d.buyer.shipping || {}; %>
<main class="page">
  <div class="row">
    <div><h1><%= inv.kind === "invoice" ? "Facture" : "Avoir" %> n° <%= inv.number %></h1>
      <div class="muted">Émis le <%= String(inv.issued_at).slice(0, 10) %> · Commande <%= d.orderNumber %> du <%= String(d.orderDate).slice(0, 10) %><% if (inv.kind === "credit_note") { %> · Avoir sur la facture <%= d.creditNote.invoiceNumber %><% } %></div></div>
    <div style="text-align:right"><strong><%= d.seller.name || "Vendeur" %></strong><br><pre><%= d.seller.address %></pre>
      <% if (d.seller.vat) { %>TVA : <%= d.seller.vat %><br><% } %><% if (d.seller.registration) { %>Immatriculation : <%= d.seller.registration %><br><% } %><% if (d.seller.email) { %><%= d.seller.email %><br><% } %><% if (d.seller.phone) { %><%= d.seller.phone %><% } %></div>
  </div>
  <p><strong>Facturé à</strong><br><%= b.name || d.buyer.email %><br><% if (b.line1) { %><%= b.line1 %><%= b.line2 ? ", " + b.line2 : "" %><br><%= b.postal_code %> <%= b.city %> <%= b.country %><br><% } %><%= d.buyer.email %></p>
  <% if (inv.kind === "credit_note") { %>
    <table><thead><tr><th>Désignation</th><th>Montant</th></tr></thead><tbody><tr><td>Remboursement de la commande <%= d.orderNumber %><%= d.creditNote.reason ? " — " + d.creditNote.reason : "" %></td><td>− <%= m(inv.total_cents) %></td></tr></tbody></table>
    <table class="tot"><tr><td class="big">Total remboursé</td><td class="big">− <%= m(inv.total_cents) %></td></tr></table>
  <% } else { %>
    <table><thead><tr><th>Désignation</th><th>Qté</th><th>Prix unitaire</th><th>Total ligne</th></tr></thead><tbody>
      <% d.items.forEach((i) => { %><tr><td><%= i.name %><%= i.variant_label ? " (" + i.variant_label + ")" : "" %><%= i.sku ? " — " + i.sku : "" %></td><td><%= i.quantity %></td><td><%= m(i.unit_price_cents) %></td><td><%= m(i.line_subtotal_cents) %></td></tr><% }) %>
    </tbody></table>
    <table class="tot">
      <tr><td>Sous-total</td><td><%= m(d.subtotalCents) %></td></tr>
      <% if (d.discountCents) { %><tr><td>Remise<%= d.couponCode ? " (" + d.couponCode + ")" : "" %></td><td>− <%= m(d.discountCents) %></td></tr><% } %>
      <tr><td>Livraison<%= d.shippingMethod ? " (" + d.shippingMethod + ")" : "" %></td><td><%= m(d.shippingCents) %></td></tr>
      <% (d.taxLines || []).forEach((t) => { %><tr><td><%= d.pricesIncludeTax ? "dont " : "" %><%= t.name || "TVA" %><%= t.rateBp ? " " + (t.rateBp / 100) + " %" : "" %></td><td><%= m(t.amountCents || 0) %></td></tr><% }) %>
      <tr><td class="big">Total <%= d.pricesIncludeTax ? "TTC" : "" %></td><td class="big"><%= m(d.totalCents) %></td></tr>
    </table>
    <p class="muted">Réglée le <%= String(d.paidAt || "").slice(0, 10) %> — <%= d.paymentMethod === "stripe" ? "carte bancaire" : d.paymentMethod === "manual" ? "paiement manuel" : d.paymentMethod || "" %>.</p>
  <% } %>
  <% if (d.seller.footer) { %><p class="muted"><pre><%= d.seller.footer %></pre></p><% } %>
</main></body></html>
