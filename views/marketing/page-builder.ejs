<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <%# Doublon de l'en-tête HTTP (le CDN de l'hébergeur remplace la politique envoyée par le serveur) %>
  <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Site Web · KOLAKISA</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/page-builder.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/page-builder-menu.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/site-settings.css') %>">
</head>
<body class="pb-body">
  <a class="skip-link" href="#pb-canvas">Aller au canevas</a>
  <%# ---------- Barre supérieure : actions permanentes + zone contextuelle (selon la sélection) ---------- %>
  <header class="pb-top">
    <div class="pb-top-left">
      <button type="button" class="pb-icon-btn pb-mainmenu-btn" data-pb-mainmenu aria-haspopup="menu" aria-expanded="false" data-tip="Menu principal" aria-label="Menu principal"><%- icon("menu", { size: 18 }) %></button>
      <% const cmsBack = typeof backTo !== "undefined" && backTo; const backText = cmsBack ? "Retour aux pages" : page.back ? "Retour à la fiche du site" : "Réglages de la page"; %><a class="pb-back" href="<%= cmsBack || page.back || `/marketing/pages/${page.id}` %>" data-tip="<%= backText %>"><%- icon("arrowLeft", { size: 16 }) %><span class="sr-only"><%= backText %></span></a>
      <div class="pb-title"><h1><%= page.name %></h1><span class="pb-status" data-pb-status></span></div>
      <div class="pb-group-btns">
        <button type="button" class="pb-icon-btn" data-pb-undo data-tip="Annuler (Ctrl/⌘ + Z)" aria-label="Annuler" disabled><%- icon("undo", { size: 16 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-redo data-tip="Rétablir (Ctrl/⌘ + Maj + Z)" aria-label="Rétablir" disabled><%- icon("redo", { size: 16 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-history aria-haspopup="menu" data-tip="Historique des actions" aria-label="Historique des actions"><%- icon("history", { size: 16 }) %></button>
      </div>
      <button type="button" class="pb-icon-btn" data-pb-layers-open aria-pressed="true" data-tip="Panneau Structure : afficher / masquer" aria-label="Afficher ou masquer le panneau Structure"><%- icon("layers", { size: 16 }) %></button>
            <%# Deux façons de travailler sur le MÊME document : la page telle qu'affichée, ou sa structure en blocs %>
      <div class="pb-seg pb-mode-seg" role="radiogroup" aria-label="Mode d'édition">
        <button type="button" role="radio" aria-checked="true" data-pb-mode="visual" data-tip="Éditeur visuel : la page telle qu'elle s'affiche (Ctrl/⌘ + Maj + E pour basculer)"><%- icon("monitor", { size: 15 }) %><span>Éditeur visuel</span></button>
        <button type="button" role="radio" aria-checked="false" data-pb-mode="structure" data-tip="Éditeur en blocs : la page en blocs à écrire, déplacer, imbriquer (Ctrl/⌘ + Maj + E pour basculer)"><%- icon("listChecks", { size: 15 }) %><span>Éditeur en blocs</span></button>
      </div>
    </div>
    <div class="pb-context" data-pb-context role="toolbar" aria-label="Réglages rapides de la sélection"></div>
    <div class="pb-top-right">
      <div class="pb-devices" role="radiogroup" aria-label="Écran modifié et affiché">
        <button type="button" role="radio" aria-checked="true" data-device="desktop" data-tip="Ordinateur"><%- icon("monitor", { size: 16 }) %><span class="sr-only">Ordinateur</span></button>
        <button type="button" role="radio" aria-checked="false" data-device="tablet" data-tip="Tablette (820 px)"><%- icon("tablet", { size: 16 }) %><span class="sr-only">Tablette</span></button>
        <button type="button" role="radio" aria-checked="false" data-device="mobile" data-tip="Mobile (390 px)"><%- icon("smartphone", { size: 16 }) %><span class="sr-only">Mobile</span></button>
      </div>
      <div class="pb-group-btns" role="group" aria-label="Aides visuelles">
        <button type="button" class="pb-icon-btn" data-pb-toggle="grid" aria-pressed="false" data-tip="Grille de 12 colonnes" aria-label="Grille"><%- icon("columns", { size: 15 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-toggle="outlines" aria-pressed="false" data-tip="Contours de tous les éléments" aria-label="Contours des éléments"><%- icon("borderBox", { size: 15 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-toggle="rulers" aria-pressed="false" data-tip="Règles et guides (R)" aria-label="Règles"><%- icon("spacing", { size: 15 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-toggle="snap" aria-pressed="true" data-tip="Magnétisme (Maj + M) : les tailles s'accrochent aux guides, à la grille et aux autres éléments. Alt : mouvement libre" aria-label="Magnétisme"><%- icon("grip", { size: 15 }) %></button>
        <button type="button" class="pb-icon-btn" data-pb-rules-menu aria-haspopup="menu" aria-expanded="false" data-tip="Règles, guides et magnétisme : réglages" aria-label="Règles, guides et magnétisme : réglages"><%- icon("sliders", { size: 15 }) %></button>
      </div>
      <span class="pb-save" data-pb-save role="status" aria-live="polite"></span>
      <button type="button" class="pb-icon-btn" data-pb-command data-tip="Commandes (Ctrl/⌘ + K)" aria-label="Rechercher une commande"><%- icon("search", { size: 16 }) %></button>
      <button type="button" class="btn btn-outline btn-sm" data-pb-save-now>Enregistrer</button>
      <button type="button" class="btn btn-outline btn-sm" data-pb-preview>Aperçu</button>
      <span class="pb-publish-group"><button type="button" class="btn btn-primary btn-sm" data-pb-publish hidden>Publier</button><button type="button" class="btn btn-primary btn-sm pb-publish-more" data-pb-publish-menu aria-haspopup="menu" aria-label="Plus d'options de publication" data-tip="Publication : dépublier, voir la page en ligne…"><%- icon("chevronDown", { size: 15 }) %></button></span>
    </div>
  </header>

  <div class="pb-main" data-pb-main>
    <%# ---------- Barre d'outils verticale ---------- %>
    <nav class="pb-tools" aria-label="Outils" data-pb-tools></nav>

    <%# ---------- Panneau gauche : éléments, blocs, composants, page ---------- %>
    <aside class="pb-left" aria-label="Éléments à ajouter" data-pb-left>
      <div class="pb-tabs" role="tablist" aria-label="Panneau de gauche">
        <button type="button" role="tab" id="pb-tab-elements" aria-controls="pb-pane-elements" aria-selected="true">Éléments</button>
        <button type="button" role="tab" id="pb-tab-blocks" aria-controls="pb-pane-blocks" aria-selected="false" tabindex="-1">Blocs</button>
        <button type="button" role="tab" id="pb-tab-page" aria-controls="pb-pane-page" aria-selected="false" tabindex="-1">Page</button>
      </div>
      <div class="pb-pane" id="pb-pane-elements" role="tabpanel" aria-labelledby="pb-tab-elements">
        <div class="pb-subtabs" role="tablist" aria-label="Bibliothèque">
          <button type="button" role="tab" id="pb-lib-widgets" aria-controls="pb-lib-pane-widgets" aria-selected="true">Widgets</button>
          <button type="button" role="tab" id="pb-lib-components" aria-controls="pb-lib-pane-components" aria-selected="false" tabindex="-1">Composants</button>
          <button type="button" role="tab" id="pb-lib-globals" aria-controls="pb-lib-pane-globals" aria-selected="false" tabindex="-1">Globales</button>
        </div>
        <div id="pb-lib-pane-widgets" role="tabpanel" aria-labelledby="pb-lib-widgets">
          <label class="sr-only" for="pb-el-search">Rechercher un widget</label>
          <input class="pb-search" id="pb-el-search" type="search" placeholder="Rechercher un widget..." data-pb-el-search autocomplete="off">
          <p class="pb-hint">Glissez un widget dans la page ou dans les calques ; un clic l'ajoute après la sélection (ou dedans, si c'est un conteneur).</p>
          <div data-pb-elements></div>
        </div>
        <div id="pb-lib-pane-components" role="tabpanel" aria-labelledby="pb-lib-components" hidden>
          <p class="pb-hint">Composants de ce site. « Synchronisé » : s'affiche partout dans sa dernière version (modifier la source modifie toutes les pages). « Copie » : indépendante.</p>
          <label class="sr-only" for="pb-comp-q-site">Rechercher un composant</label><input class="pb-search" id="pb-comp-q-site" type="search" placeholder="Rechercher un composant..." data-pb-comp-q autocomplete="off">
          <ul class="pb-components" data-pb-components></ul>
        </div>
        <div id="pb-lib-pane-globals" role="tabpanel" aria-labelledby="pb-lib-globals" hidden>
          <p class="pb-hint">Éléments globaux : partagés par tous les sites de votre organisation. Insérés « Synchronisé », une modification de la source s'applique partout.</p>
          <label class="sr-only" for="pb-comp-q-global">Rechercher un élément global</label><input class="pb-search" id="pb-comp-q-global" type="search" placeholder="Rechercher un élément global..." data-pb-comp-q autocomplete="off">
          <ul class="pb-components" data-pb-globals></ul>
        </div>
      </div>
      <div class="pb-pane" id="pb-pane-blocks" role="tabpanel" aria-labelledby="pb-tab-blocks" hidden>
        <p class="pb-hint">Blocs prêts à l'emploi, faits de vrais éléments entièrement modifiables. Les textes entre crochets sont à remplacer.</p>
        <div data-pb-blocks></div>
      </div>
      <div class="pb-pane" id="pb-pane-page" role="tabpanel" aria-labelledby="pb-tab-page" hidden>
        <div data-pb-page-settings></div>
      </div>
    </aside>
    <div class="pb-resizer" data-pb-resize="left" role="separator" aria-orientation="vertical" aria-label="Largeur du panneau des éléments (flèches gauche et droite)" tabindex="0"></div>

    <%# ---------- Canevas ---------- %>
    <main class="pb-canvas" id="pb-canvas" tabindex="-1" aria-label="Page en cours d'édition" data-pb-canvas>
      <p class="pb-error" data-pb-render-error role="alert" hidden></p>
      <div class="pb-ruler-corner" data-pb-ruler-corner hidden title="Unité : pixels. Clic droit : guides">px</div>
      <canvas class="pb-ruler pb-ruler-x" data-pb-ruler-x aria-hidden="true" hidden title="Règle horizontale : tirez vers la page pour créer un guide horizontal"></canvas>
      <canvas class="pb-ruler pb-ruler-y" data-pb-ruler-y aria-hidden="true" hidden title="Règle verticale : tirez vers la page pour créer un guide vertical"></canvas>
      <div class="pb-doc" data-pb-doc hidden aria-label="Structure de la page (blocs)"></div>
      <div class="pb-stage" data-pb-stage>
        <div class="pb-frame-wrap" data-pb-frame-wrap data-device="desktop">
          <iframe class="pb-frame" data-pb-frame title="Page en cours d'édition"></iframe>
        </div>
      </div>
      <%# Navigation du canevas (bas droite) : zoom réel, partagé avec les règles, les guides et le magnétisme %>
      <div class="pb-gizmo" role="group" aria-label="Zoom du canevas">
        <button type="button" class="pb-icon-btn" data-pb-zoom="-" data-tip="Zoom arrière (Ctrl/⌘ + -)" aria-label="Zoom arrière"><%- icon("minus", { size: 15 }) %></button>
        <output class="pb-zoom-value" data-pb-zoom-value aria-live="polite" title="Niveau de zoom">100 %</output>
        <button type="button" class="pb-icon-btn" data-pb-zoom="+" data-tip="Zoom avant (Ctrl/⌘ + +)" aria-label="Zoom avant"><%- icon("plus", { size: 15 }) %></button>
        <span class="pb-gizmo-sep" aria-hidden="true"></span>
        <button type="button" class="pb-gizmo-btn" data-pb-zoom="100" data-tip="Taille réelle : 100 % (Ctrl/⌘ + 0)" aria-label="Zoom à 100 %">1:1</button>
        <button type="button" class="pb-icon-btn" data-pb-zoom="fit" data-tip="Ajuster à l'écran : toute la largeur de la page visible (Maj + 1)" aria-label="Ajuster à l'écran"><%- icon("maximize", { size: 15 }) %></button>
      </div>
    </main>
    <div class="pb-resizer" data-pb-resize="right" role="separator" aria-orientation="vertical" aria-label="Largeur du panneau des calques (flèches gauche et droite)" tabindex="0"></div>

    <%# ---------- Panneau droit : calques (haut) + inspecteur (bas) ---------- %>
    <aside class="pb-right" aria-label="Calques et réglages" data-pb-right>
      <section class="pb-layers-panel" aria-labelledby="pb-layers-title" data-pb-layers-panel>
        <div class="pb-panel-head" data-pb-layers-head><h2 id="pb-layers-title">Structure</h2>
          <span class="pb-panel-actions">
            <button type="button" class="pb-panel-toggle" data-pb-layers-add data-tip="Ajouter une structure (Flexbox ou Grille)" aria-label="Ajouter une structure (Flexbox ou Grille)"><%- icon("plus", { size: 16 }) %></button>
            <button type="button" class="pb-panel-toggle" data-pb-layers-dock aria-pressed="false" data-tip="Détacher le panneau Structure" aria-label="Détacher le panneau Structure"><%- icon("externalLink", { size: 16 }) %></button>
            <button type="button" class="pb-panel-toggle" data-pb-layers-close data-tip="Fermer le panneau Structure" aria-label="Fermer le panneau Structure"><%- icon("close", { size: 16 }) %></button>
            <button type="button" class="pb-panel-toggle" data-pb-layers-toggle aria-expanded="true" aria-controls="pb-layers-body" aria-label="Replier le panneau Structure"><%- icon("chevronDown", { size: 16 }) %></button>
          </span></div>
        <div class="pb-page-row" data-pb-page-row><span class="pb-page-name"><%- icon("layout", { size: 14 }) %> Page</span><span class="pb-page-count" data-pb-page-count></span>
          <span class="pb-panel-actions"><button type="button" class="pb-flag" data-pb-expand-all data-tip="Tout déplier" aria-label="Tout déplier"><%- icon("chevronDown", { size: 14 }) %></button><button type="button" class="pb-flag" data-pb-collapse-all data-tip="Tout replier" aria-label="Tout replier"><%- icon("chevronRight", { size: 14 }) %></button></span></div>
        <div class="pb-layers-search"><label class="sr-only" for="pb-layers-q">Rechercher un calque</label><input id="pb-layers-q" type="search" placeholder="Rechercher un calque…" data-pb-layers-q autocomplete="off"></div>
        <ul class="pb-tree" id="pb-layers-body" role="tree" aria-labelledby="pb-layers-title" aria-multiselectable="true" data-pb-layers></ul>
      </section>
      <div class="pb-hsplit" data-pb-split role="separator" aria-orientation="horizontal" aria-label="Hauteur des calques (flèches haut et bas)" tabindex="0"></div>
      <section class="pb-inspector" aria-label="Inspecteur" data-pb-inspector></section>
    </aside>
  </div>

  <%# ---------- Fenêtres : aperçu, médiathèque, commandes, demande de contenu ---------- %>
  <dialog class="pb-modal pb-preview-modal" data-pb-preview-dialog aria-labelledby="pb-preview-title">
    <div class="pb-modal-head"><h2 id="pb-preview-title">Aperçu</h2>
      <div class="pb-devices" role="radiogroup" aria-label="Écran de l'aperçu">
        <button type="button" role="radio" aria-checked="true" data-preview-device="desktop"><%- icon("monitor", { size: 16 }) %><span class="sr-only">Ordinateur</span></button>
        <button type="button" role="radio" aria-checked="false" data-preview-device="tablet"><%- icon("tablet", { size: 16 }) %><span class="sr-only">Tablette</span></button>
        <button type="button" role="radio" aria-checked="false" data-preview-device="mobile"><%- icon("smartphone", { size: 16 }) %><span class="sr-only">Mobile</span></button>
      </div>
      <span class="pb-modal-spacer"></span>
      <a class="btn btn-ghost btn-sm" href="/marketing/pages/<%= page.id %>/apercu" target="_blank" rel="noopener">Ouvrir dans un onglet</a>
      <button type="button" class="pb-icon-btn" data-pb-close aria-label="Fermer l'aperçu"><%- icon("close", { size: 18 }) %></button></div>
    <div class="pb-preview-stage"><iframe class="pb-preview-frame" data-pb-preview-frame data-device="desktop" title="Aperçu de la page"></iframe></div>
  </dialog>

  <dialog class="pb-modal pb-media-modal" data-pb-media aria-labelledby="pb-media-title">
    <div class="pb-modal-head"><h2 id="pb-media-title">Médiathèque</h2><span class="pb-modal-spacer"></span><button type="button" class="pb-icon-btn" data-pb-close aria-label="Fermer la médiathèque"><%- icon("close", { size: 18 }) %></button></div>
    <div class="pb-media-body">
      <div class="pb-media-bar">
        <label class="sr-only" for="pb-media-q">Rechercher une image</label><input class="pb-search" id="pb-media-q" type="search" placeholder="Rechercher (nom, texte de remplacement)…" data-pb-media-q>
        <label class="sr-only" for="pb-media-src">Bibliothèque</label><select id="pb-media-src" data-pb-media-src><option value="all">Toutes les images</option><option value="marketing">Marketing</option><option value="site">Site (blog, Centre de gestion)</option></select>
        <label class="btn btn-primary btn-sm pb-upload">Envoyer une image<input type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-pb-upload class="sr-only"></label>
      </div>
      <div class="pb-drop" data-pb-drop>Ou déposez une image ici (JPEG, PNG, GIF ou WebP, 5 Mo au plus)</div>
      <p class="pb-hint" data-pb-media-status role="status" aria-live="polite"></p>
      <div class="pb-media-layout">
        <ul class="pb-media-grid" data-pb-media-grid aria-label="Images"></ul>
        <div class="pb-media-detail" data-pb-media-detail></div>
      </div>
    </div>
  </dialog>

  <dialog class="pb-modal pb-layout-dialog" data-pb-layout aria-labelledby="pb-layout-title">
    <div class="pb-modal-head"><h2 id="pb-layout-title" data-pb-layout-title>Quelle mise en page utiliser ?</h2><span class="pb-modal-spacer"></span><button type="button" class="pb-icon-btn" data-pb-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></div>
    <div class="pb-layout-body" data-pb-layout-body></div>
  </dialog>

  <%# Règles et magnétisme : fenêtre flottante, le canevas reste visible et suit chaque réglage %>
  <dialog class="pb-navmgr pb-rules" data-pb-rules aria-labelledby="pb-rules-title">
    <div class="pb-modal-head" data-pb-rules-head><h2 id="pb-rules-title">Règles et magnétisme</h2><span class="pb-modal-spacer"></span><button type="button" class="pb-icon-btn" data-pb-close aria-label="Fermer"><%- icon("close", { size: 16 }) %></button></div>
    <div class="pb-navmgr-body pb-rules-body" data-pb-rules-body></div>
  </dialog>

  <%# Réglages du menu de navigation (menu principal de l'éditeur) : fenêtre flottante, le canevas reste visible et se met à jour %>
  <dialog class="pb-navmgr" data-pb-navmgr aria-labelledby="pb-navmgr-title">
    <div class="pb-modal-head" data-pb-navmgr-head><h2 id="pb-navmgr-title">Réglages du menu de navigation</h2><span class="pb-modal-spacer"></span><button type="button" class="pb-icon-btn" data-pb-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></div>
    <div class="pb-navmgr-body" data-pb-navmgr-body></div>
  </dialog>

  <dialog class="pb-modal pb-command" data-pb-command-dialog aria-label="Commandes">
    <label class="sr-only" for="pb-cmd-q">Rechercher une commande</label>
    <input class="pb-search" id="pb-cmd-q" type="search" placeholder="Que voulez-vous faire ? (ajouter un titre, grouper, aperçu…)" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="pb-cmd-list" data-pb-cmd-q>
    <ul class="pb-cmd-list" id="pb-cmd-list" role="listbox" aria-label="Commandes" data-pb-cmd-list></ul>
  </dialog>

  <%# Raccourcis clavier (menu principal) : la liste réelle de ce que gère l'éditeur %>
  <dialog class="pb-modal pb-shortcuts" data-pb-shortcuts aria-labelledby="pb-sc-title">
    <h2 id="pb-sc-title">Raccourcis clavier</h2>
    <dl class="pb-sc-list">
      <% [["Ctrl/⌘ + S", "Enregistrer"], ["Ctrl/⌘ + Z / Maj + Z", "Annuler / rétablir"], ["Ctrl/⌘ + K", "Commandes et recherche"], ["Ctrl/⌘ + Maj + Y", "Afficher / masquer le panneau Structure"], ["Ctrl/⌘ + Maj + E", "Éditeur visuel / Éditeur en blocs"], ["Ctrl/⌘ + C / X / V", "Copier, couper, coller"], ["Ctrl/⌘ + Alt + C / V", "Copier / coller le style"], ["Ctrl/⌘ + D", "Dupliquer"], ["Suppr", "Supprimer"], ["Ctrl/⌘ + G / Maj + G", "Grouper / dissocier"], ["Ctrl/⌘ + Maj + H / L", "Masquer / verrouiller"], ["Alt + ↑ / ↓", "Monter / descendre"], ["Entrée", "Écrire dans le texte sélectionné"], ["Échap", "Désélectionner"], ["Ctrl/⌘ + + / − / 0", "Zoom"], ["Maj + 1", "Ajuster à l'écran"], ["R", "Règles"], ["V / H", "Sélection / main"], ["T / I / B", "Ajouter un texte, une image, un bouton"]].forEach((k) => { %><dt><kbd><%= k[0] %></kbd></dt><dd><%= k[1] %></dd><% }) %>
    </dl>
    <form method="dialog"><button class="btn btn-outline btn-sm">Fermer</button></form>
  </dialog>
  <input type="file" accept="application/json,.json" hidden data-pb-import-file>

  <dialog class="pb-modal pb-ask" data-pb-ask aria-labelledby="pb-ask-title">
    <form data-pb-ask-form><h2 id="pb-ask-title" data-pb-ask-title></h2><div data-pb-ask-fields></div>
      <p class="pb-note is-warn" data-pb-ask-error role="alert" hidden></p>
      <div class="pb-row"><button type="submit" class="btn btn-primary btn-sm">Valider</button><button type="button" class="btn btn-ghost btn-sm" data-pb-close>Annuler</button></div></form>
  </dialog>

  <div class="pb-menu" data-pb-menu role="menu" aria-label="Actions" hidden></div>
  <div class="pb-toast" data-pb-toast role="status" aria-live="polite" hidden></div>

  <% ["eye", "eyeOff", "lock", "copy", "trash", "grip", "chevronDown", "chevronRight", "plus", "close", "check", "arrowUp", "arrowDown", "alignLeft", "alignCenter", "alignRight", "alignJustify", "link", "list", "listOrdered", "indentMore", "indentLess", "clearFormat", "highlighter", "mousePointer", "edit", "upload", "layers", "search", "type", "image", "video", "columns", "layout", "borderBox", "spacing", "minus", "star", "graduation", "clock", "quote", "braces", "listChecks", "moveVertical", "play", "fileText", "chevronLeft", "arrowRightLeft", "maximize", "monitor", "tablet", "smartphone", "sliders", "moreHorizontal", "listPlus", "listMinus", "undo", "redo", "sun", "moon"].concat(spec.types.map((t) => t.icon), spec.icons).filter((v, i, a) => a.indexOf(v) === i && iconExists(v)).forEach((name) => { %><template data-pb-icon="<%= name %>"><%- icon(name, { size: 16 }) %></template><% }) %>
  <script type="application/json" id="pb-boot"><%- boot %></script>
  <script src="<%= asset('/js/page-builder-effects.js') %>" defer></script>
  <script src="<%= asset('/js/page-builder-snap.js') %>" defer></script>
  <script src="<%= asset('/js/page-builder.js') %>" defer></script>
  <script src="<%= asset('/js/page-builder-menu.js') %>" defer></script>
  <script src="<%= asset('/js/page-builder-rules.js') %>" defer></script>
  <script src="<%= asset('/js/site-settings.js') %>" defer></script>
</body>
