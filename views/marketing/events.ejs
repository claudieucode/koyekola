<%- include("partials/top", { title, active }) %>
<%
  // Tables lues par le pont (bridge/events.js), traduites pour l'affichage seulement
  const BRIDGE_SOURCES = { users: "Comptes", orders: "Commandes", enrollments: "Inscriptions aux formations", lesson_progress: "Leçons terminées", reviews: "Avis", favorites: "Favoris" };
  const lastRead = cursors.map((c) => c.updated_at).sort().pop();
%>
    <div class="mk-head"><h1>Événements</h1></div>
    <p class="mk-lead">Ce qui se passe sur KOLAKISA et déclenche vos scénarios : le pont lit régulièrement les comptes, commandes, inscriptions, leçons, avis et favoris.</p>

    <%- include("partials/worker-note", { workerOn, consequence: "le pont ne lit plus le site et aucun scénario ne se déclenche" }) %>

    <section class="mk-panel">
      <h2>Pont KOLAKISA</h2>
      <p class="field-hint">Le pont lit le site sans jamais le modifier, toutes les 30 secondes environ quand le traitement en arrière-plan est actif. Au premier passage il se place à la fin de l'historique : <strong>les événements passés ne déclenchent jamais rien</strong>.</p>
      <% if (!cursors.length) { %><p class="mk-note">Le pont n'est pas encore initialisé. Il le sera à sa première synchronisation.</p>
      <% } else { %>
        <p>Dernière lecture du site : <strong><%= mkh.fdatetime(lastRead) %></strong></p>
        <details class="mk-advanced">
          <summary>Détail de la lecture, par type de donnée</summary>
          <div class="mk-table-wrap"><table class="mk-table mk-datatable"><caption class="sr-only">Lecture du site par type de donnée</caption>
            <thead><tr><th scope="col">Donnée lue</th><th scope="col" class="mk-num">Dernier identifiant lu</th><th scope="col">Suivie depuis le</th><th scope="col">Dernière lecture</th></tr></thead>
            <tbody><% cursors.forEach((c) => { %><tr>
              <td data-label="Donnée lue"><%= BRIDGE_SOURCES[c.source] || c.source %></td>
              <td data-label="Dernier identifiant lu" class="mk-num"><%= mkh.fmt(c.last_id) %></td>
              <td data-label="Suivie depuis le"><%= mkh.fdate(c.initialized_at) %></td>
              <td data-label="Dernière lecture"><%= mkh.fdatetime(c.updated_at) %></td>
            </tr><% }) %></tbody></table></div>
        </details>
      <% } %>
      <% if (canSync) { %><form action="/marketing/evenements/synchroniser" method="post"><button type="submit" class="btn btn-outline btn-sm">Synchroniser maintenant</button></form><% } %>
    </section>

    <h2 class="mk-h2">Événements récents</h2>
    <% if (!events.length) { %>
      <div class="mk-empty">
        <%- icon("activity", { size: 32 }) %>
        <h2>Aucun événement</h2>
        <p>Ils apparaîtront ici dès que quelque chose se passera : un compte créé, une commande, une inscription à une formation, un contact qui s'abonne…</p>
      </div>
    <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable"><caption class="sr-only">Événements récents (100 au plus)</caption>
        <thead><tr><th scope="col">Événement</th><th scope="col">Contact</th><th scope="col">Origine</th><th scope="col">Date</th><th scope="col">État</th></tr></thead>
        <tbody><% events.forEach((e) => { const label = mkh.eventLabel(e.name); %><tr>
          <td data-label="Événement"><%= label || "Événement personnalisé" %> <code class="mk-sub"><%= e.name %></code></td>
          <td data-label="Contact"><%= e.email || "—" %></td>
          <td data-label="Origine"><%= mkh.eventSourceLabel(e.source) %></td>
          <td data-label="Date"><%= mkh.fdatetime(e.occurred_at) %></td>
          <td data-label="État"><% if (e.processed_at) { %><span class="mk-status mk-status-ok">Traité</span><% } else { %><span class="mk-status mk-status-warn">En attente</span><% } %></td>
        </tr><% }) %></tbody></table></div>
    <% } %>
<%- include("partials/bottom") %>
