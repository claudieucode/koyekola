<%# Fiche d'un thème : informations, état et actions. %><%- include("partials/top", { title, active }) %>
<div class="mk-th" data-th-root>
  <div class="mk-th-head"><h1><%= theme.name %></h1><a class="btn btn-outline btn-sm" href="<%= to("") %>">← Thèmes installés</a></div>
  <p class="mk-th-site">Site : <strong><%= T.name %></strong></p>
  <div class="mk-th-detail">
    <div class="mk-th-detail-shot"><%- include("partials/theme-shot", { theme, fontStack }) %></div>
    <div>
      <p class="mk-th-state"><span class="badge <%= theme.state === "active" ? "mk-status-ok" : theme.state === "incompatible" ? "mk-status-warn" : "mk-status-off" %>"><%= theme.state === "active" ? "Actif" : theme.state === "incompatible" ? "Incompatible" : "Installé (inactif)" %></span></p>
      <dl class="mk-th-dl">
        <dt>Version</dt><dd><%= theme.version %></dd>
        <dt>Auteur</dt><dd><%= theme.author %></dd>
        <dt>Source</dt><dd><%= theme.source === "integre" ? "Intégré à Kolakisa" : theme.source === "catalogue" ? "Catalogue Kolakisa" : "Paquet importé" %></dd>
        <dt>Compatibilité</dt><dd><%= theme.compatible ? "Compatible (format " + theme.api + ")" : "Incompatible : format " + theme.api + " plus récent que celui de ce Kolakisa" %></dd>
        <% if (theme.installedAt) { %><dt>Installé le</dt><dd><%= String(theme.installedAt).slice(0, 10).split("-").reverse().join("/") %></dd><% } %>
        <dt>Description</dt><dd><%= theme.description || "—" %></dd>
        <dt>Couleurs</dt><dd class="mk-th-sw"><% ["primary", "secondary", "accent", "background", "surface", "text"].forEach((k) => { %><span title="<%= k %> : <%= theme.tokens.colors[k] %>" style="background:<%= theme.tokens.colors[k] %>"></span><% }) %></dd>
      </dl>
      <div class="mk-th-actions">
        <% if (theme.state === "inactive") { %>
          <a class="btn btn-outline" href="<%= to("/" + theme.key + "/apercu") %>">Prévisualiser</a>
          <% if (canActivate && !readOnly) { %><form method="post" action="<%= BASE %>/<%= theme.key %>/activer" data-th-form><%- siteField %><button class="btn btn-primary" type="submit" data-confirm="Activer « <%= theme.name %> » sur « <%= T.name %> » ? Les couleurs, polices et boutons du site public changent immédiatement. Vous pourrez revenir au thème précédent.">Activer</button></form><% } %>
        <% } %>
        <% if (theme.state === "active" && theme.hasPrevious && canActivate && !readOnly) { %><form method="post" action="<%= BASE %>/revenir" data-th-form><%- siteField %><button class="btn btn-outline" type="submit" data-confirm="Rétablir l'apparence précédente de « <%= T.name %> » ?">Revenir au thème précédent</button></form><% } %>
        <% if (theme.removable && canDelete && !readOnly) { %><form method="post" action="<%= BASE %>/<%= theme.key %>/supprimer" data-th-form><%- siteField %><button class="btn btn-danger" type="submit" data-confirm="Supprimer le thème « <%= theme.name %> » de « <%= T.name %> » ? Les pages, médias et réglages du site ne sont pas touchés.">Supprimer</button></form><% } %>
      </div>
      <% if (theme.state === "active") { %><p class="mk-th-note">Le thème actif ne peut pas être supprimé : activez d'abord un autre thème.</p><% } %>
      <% if (theme.builtin) { %><p class="mk-th-note">Le thème d'origine fait partie de Kolakisa : il ne peut pas être supprimé.</p><% } %>
    </div>
  </div>
</div>
<%- include("partials/bottom") %>
