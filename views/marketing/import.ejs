<%- include("partials/top", { title, active }) %>
    <p class="mk-back"><a href="<%= importBase %>">← Importer</a></p>
    <h1 class="mk-email"><%= imp.filename %></h1>
    <p class="mk-lead"><%= mkh.fmt(imp.total_rows) %> ligne<%= imp.total_rows > 1 ? "s" : "" %> de données · séparateur « <%= imp.delimiter === "\t" ? "tabulation" : imp.delimiter %> » · ajouté le <%= mkh.fdate(imp.created_at) %></p>
    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
    <% const plural = (n, one, many) => n + " " + (n > 1 ? many : one); %>

    <% if (imp.status === "done") { %>
      <section class="mk-panel mk-verdict is-ok">
        <h2>Import terminé</h2>
        <ul class="mk-status-list">
          <li><strong><%= mkh.fmt(imp.created_count) %></strong> contact<%= imp.created_count > 1 ? "s" : "" %> créé<%= imp.created_count > 1 ? "s" : "" %></li>
          <li><strong><%= mkh.fmt(imp.updated_count) %></strong> contact<%= imp.updated_count > 1 ? "s" : "" %> existant<%= imp.updated_count > 1 ? "s" : "" %> complété<%= imp.updated_count > 1 ? "s" : "" %> · <%= mkh.fmt(imp.unchanged_count) %> inchangé<%= imp.unchanged_count > 1 ? "s" : "" %></li>
          <li><%= mkh.fmt(imp.subscribed_count) %> abonné<%= imp.subscribed_count > 1 ? "s" : "" %> (consentement déclaré) · <%= mkh.fmt(imp.blocked_unsubscribed_count) %> désinscrit<%= imp.blocked_unsubscribed_count > 1 ? "s" : "" %> non réabonné<%= imp.blocked_unsubscribed_count > 1 ? "s" : "" %></li>
          <li><%= plural(imp.invalid_count, "ligne invalide", "lignes invalides") %> · <%= plural(imp.duplicate_count, "doublon", "doublons") %> · <%= plural(imp.suppressed_count, "adresse bloquée ignorée", "adresses bloquées ignorées") %></li>
        </ul>
        <% if (canSeeRejects !== false && imp.invalid_count + imp.duplicate_count + imp.suppressed_count > 0) { %><p><a class="btn btn-outline btn-sm" href="<%= importBase %>/<%= imp.id %>/rejets.csv">Télécharger les lignes rejetées (CSV)</a></p><% } %>
        <p><a class="btn btn-primary btn-sm" href="/marketing/contacts">Voir les contacts</a></p>
      </section>
    <% } else if (imp.status === "running") { %>
      <section class="mk-panel">
        <h2>Import en cours</h2>
        <p><%= mkh.fmt(imp.processed_rows) %> / <%= mkh.fmt(imp.total_rows) %> lignes traitées.</p>
        <p><a class="btn btn-outline btn-sm" href="<%= importBase %>/<%= imp.id %>">Actualiser</a></p>
      </section>
    <% } else if (imp.status === "failed") { %>
      <section class="mk-panel mk-danger">
        <h2>Import interrompu</h2>
        <p><%= imp.error %></p>
        <p class="field-hint">Rien n'a été écrit pour la tranche en cours : la reprise ne crée aucun doublon.</p>
        <form action="<%= importBase %>/<%= imp.id %>/reprendre" method="post"><button type="submit" class="btn btn-primary btn-sm">Reprendre l'import</button></form>
      </section>
    <% } else if (setup) { %>
      <form method="post" class="mk-form-wide">
        <section class="mk-panel">
          <h2>1. Correspondance des colonnes</h2>
          <div class="mk-table-wrap"><table class="mk-table">
            <caption class="sr-only">Correspondance des colonnes du fichier</caption>
            <thead><tr><th scope="col">Colonne du fichier</th><th scope="col">Exemples</th><th scope="col">Importer comme…</th></tr></thead>
            <tbody>
              <% setup.headers.forEach((h, i) => { const chosen = form.mapping[i] || "ignore"; %>
                <tr>
                  <td><strong><%= h || "(sans titre)" %></strong></td>
                  <td><%= setup.sample.slice(0, 3).map((r) => r[i] || "").filter(Boolean).join(" · ") %></td>
                  <td>
                    <label class="sr-only" for="map-<%= i %>">Cible de la colonne <%= h %></label>
                    <select id="map-<%= i %>" name="map_<%= i %>">
                      <% [["ignore", "— Ignorer —"], ["email", "E-mail (obligatoire)"], ["first_name", "Prénom"], ["last_name", "Nom"], ["phone", "Téléphone"], ["company", "Société"], ["country", "Pays"], ["language", "Langue"], ["tags", "Étiquettes (séparées par , ; ou |)"]].forEach(([v, l]) => { %>
                        <option value="<%= v %>" <%= chosen === v ? "selected" : "" %>><%= l %></option>
                      <% }) %>
                      <% setup.properties.forEach((p) => { %><option value="property:<%= p.key %>" <%= chosen === "property:" + p.key ? "selected" : "" %>>Propriété : <%= p.label %></option><% }) %>
                    </select>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
          <p class="field-hint">Le statut d'abonnement ne peut pas être importé : il dépend d'un consentement prouvé (voir plus bas).</p>
        </section>

        <section class="mk-panel">
          <h2>2. Options</h2>
          <div class="field-group"><label for="o-mode">Contacts déjà connus</label>
            <select id="o-mode" name="update_existing">
              <option value="fill" <%= form.updateExisting === "fill" ? "selected" : "" %>>Compléter les champs vides (recommandé)</option>
              <option value="overwrite" <%= form.updateExisting === "overwrite" ? "selected" : "" %>>Écraser avec les valeurs du fichier</option>
              <option value="skip" <%= form.updateExisting === "skip" ? "selected" : "" %>>Ne pas les modifier</option>
            </select></div>
          <div class="field-row">
            <div class="field-group"><label for="o-list">Ajouter à une liste</label>
              <select id="o-list" name="list_id"><option value="">— Aucune —</option><% lists.forEach((l) => { %><option value="<%= l.id %>" <%= String(form.listId) === String(l.id) ? "selected" : "" %>><%= l.name %></option><% }) %></select></div>
            <div class="field-group"><label for="o-tag">Poser une étiquette</label><input id="o-tag" type="text" name="tag" maxlength="64" value="<%= form.tag %>" placeholder="ex. Salon 2027"></div>
          </div>
        </section>

        <section class="mk-panel">
          <h2>3. Consentement (facultatif)</h2>
          <p class="field-hint">Sans déclaration, les contacts importés ne pourront recevoir <strong>aucun</strong> e-mail marketing.</p>
          <label class="checkbox-row optin-row"><input type="checkbox" name="consent_declared" value="on" <%= form.consentDeclared ? "checked" : "" %>>
            <span>Je certifie que ces personnes ont donné leur accord pour recevoir nos e-mails marketing, et je peux le prouver.</span></label>
          <div class="field-group"><label for="o-proof">Preuve du consentement (où, quand, comment)</label>
            <textarea id="o-proof" name="consent_text" rows="3" maxlength="1000" placeholder="Ex. Inscrits à la newsletter au salon de mars 2027, formulaire papier signé"><%= form.consentText %></textarea>
            <span class="field-hint">Enregistrée comme preuve pour chaque contact abonné. Ne réabonne jamais un désinscrit ni une adresse bloquée.</span></div>
        </section>

        <% if (analysis) { %>
          <section class="mk-panel mk-verdict is-ok" aria-live="polite">
            <h2>Résultat de l'analyse (rien n'est encore importé)</h2>
            <ul class="mk-status-list">
              <li><strong><%= plural(analysis.willCreate, "contact", "contacts") %> à créer</strong></li>
              <li><%= plural(analysis.willUpdate, "contact existant", "contacts existants") %> à compléter · <%= analysis.unchanged %> inchangé<%= analysis.unchanged > 1 ? "s" : "" %></li>
              <li><%= plural(analysis.invalid, "ligne invalide", "lignes invalides") %></li>
              <li><%= plural(analysis.duplicatesInFile, "doublon", "doublons") %> dans le fichier</li>
              <li><%= plural(analysis.suppressed, "adresse bloquée ignorée", "adresses bloquées ignorées") %></li>
              <% if (form.consentDeclared) { %><li><%= plural(analysis.willSubscribe, "contact sera abonné", "contacts seront abonnés") %> · <%= plural(analysis.blockedUnsubscribed, "désinscrit ne sera pas réabonné", "désinscrits ne seront pas réabonnés") %></li><% } %>
            </ul>
            <% if (analysis.examples.invalid.length) { %><h3>Lignes invalides (exemples)</h3><ul class="mk-status-list"><% analysis.examples.invalid.forEach((e) => { %><li>ligne <%= e.line %> : <code><%= e.email || "(vide)" %></code> — <%= e.reason %></li><% }) %></ul><% } %>
            <% if (analysis.examples.duplicatesInFile.length) { %><h3>Doublons (exemples)</h3><ul class="mk-status-list"><% analysis.examples.duplicatesInFile.forEach((e) => { %><li>ligne <%= e.line %> : <code><%= e.email %></code> — déjà à la ligne <%= e.firstLine %></li><% }) %></ul><% } %>
          </section>
        <% } %>

        <div class="mk-actions">
          <button type="submit" class="btn btn-outline" formaction="<%= importBase %>/<%= imp.id %>/analyser">Analyser (sans rien importer)</button>
          <button type="submit" class="btn btn-primary" formaction="<%= importBase %>/<%= imp.id %>/lancer">Lancer l'import</button>
        </div>
      </form>
    <% } %>
<%- include("partials/bottom") %>
