<%#
  Gabarit unique des écrans de KOLAKISA CMS (voir src/marketing/web/cmsScreens.js). Il n'affiche que ce que le modèle d'écran
  fournit : titre, bandeau « prochain palier », onglets, barre d'outils, cartes, tableau, médias, arbre de navigation,
  formulaire désactivé. Aucune action n'est simulée : une commande sans fonction réelle est désactivée et dit pourquoi.
%><%- include("partials/top", { title, active }) %>
<%
  const soonTitle = "Disponible dans un prochain palier";
  const rowsAll = typeof table !== "undefined" && table ? table.rows : [];
  const pageNo = Math.max(1, Math.min(Number(query && query.page) || 1, Math.max(1, Math.ceil(rowsAll.length / PER_PAGE))));
  const pageRows = rowsAll.slice((pageNo - 1) * PER_PAGE, pageNo * PER_PAGE);
  const pageCount = Math.max(1, Math.ceil(rowsAll.length / PER_PAGE));
  const pageHref = (n) => { const p = new URLSearchParams(query || {}); p.set("page", n); return "?" + p; };
  const cellOf = (c) => (c !== null && typeof c === "object" ? c : { text: String(c ?? "") });
%>
    <div class="mk-head">
      <h1><%= title %></h1>
      <% if (typeof newPage !== "undefined" && newPage) { %><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouvelle">Nouvelle page</button><% } %>
      <% if (typeof actions !== "undefined" && actions && actions.length) { %><div class="mk-actions">
        <% actions.forEach((a) => { %>
          <% if (a.disabled) { %><button type="button" class="btn btn-outline btn-sm" disabled title="<%= a.title || soonTitle %>"><%= a.label %></button>
          <% } else { %><a class="btn <%= a.variant === 'primary' ? 'btn-primary' : 'btn-outline' %> btn-sm" href="<%= a.href %>"><%= a.label %></a><% } %>
        <% }) %></div><% } %>
    </div>
    <% if (typeof lead !== "undefined" && lead) { %><p class="mk-lead"><%= lead %></p><% } %>

    <% if (typeof note !== "undefined" && note) { %>
      <div class="mk-cms-soon" role="note"><%- icon("info", { size: 18 }) %><p><%= note %></p></div>
    <% } %>
    <% if (typeof newPage !== "undefined" && newPage) { %><%- include("partials/new-page-dialog", newPage) %><% } %>
    <% if (typeof createForm !== "undefined" && createForm) { %>
      <form id="nouvelle" action="<%= createForm.action %>" method="post" class="mk-form mk-cms-create">
        <% Object.entries(createForm.hidden || {}).forEach(([k, v]) => { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
        <div class="field-group"><label for="cms-create-field"><%= createForm.label %></label><input id="cms-create-field" type="text" name="<%= createForm.field %>" maxlength="100" required placeholder="<%= createForm.placeholder %>"></div>
        <button type="submit" class="btn btn-primary btn-sm"><%= createForm.button %></button>
      </form>
    <% } %>

    <% if (typeof soon !== "undefined" && soon) { %>
      <div class="mk-cms-soon" role="note"><%- icon("info", { size: 18 }) %><p><strong>Prochain palier.</strong> <%= soon %></p></div>
    <% } %>

    <% if (typeof tabs !== "undefined" && tabs && tabs.length) { %>
      <nav class="mk-tabs mk-cms-tabs" aria-label="Vues de <%= title %>">
        <% tabs.forEach((t) => { %><a class="mk-tab" href="<%= t.href %>"<%- t.current ? ' aria-current="page"' : "" %>><%= t.label %><% if (t.count !== undefined && t.count !== null) { %> <span class="mk-tab-count"><%= t.count %></span><% } %></a>
        <% }) %>
      </nav>
    <% } %>

    <% if (typeof search !== "undefined" && search) { %>
      <form class="mk-cms-toolbar" method="get" role="search" aria-label="Rechercher dans <%= title %>">
        <% Object.entries(search.hidden || {}).forEach(([k, v]) => { if (v) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } }) %>
        <label class="mk-search"><span class="sr-only"><%= search.placeholder %></span><%- icon("search", { size: 16 }) %>
          <input type="search" name="q" value="<%= search.q || '' %>" placeholder="<%= search.placeholder %>"<%- search.enabled ? "" : " disabled" %>></label>
        <% if (search.enabled) { %><button type="submit" class="btn btn-outline btn-sm">Rechercher</button><% if (search.q) { %><a class="btn btn-ghost btn-sm" href="?">Effacer</a><% } %><% } %>
      </form>
    <% } %>

    <% if (typeof stats !== "undefined" && stats) { %>
      <div class="mk-stats mk-stats-4"><% stats.forEach((s) => { %>
        <a class="mk-stat mk-cms-stat" href="<%= s.href %>"><span class="mk-stat-label"><%= s.label %></span><span class="mk-stat-value"><%= s.value === null || s.value === undefined ? "—" : mkh.fmt(s.value) %></span><% if (s.hint) { %><span class="mk-stat-hint"><%= s.hint %></span><% } %></a>
      <% }) %></div>
    <% } %>

    <% if (typeof activity !== "undefined" && activity) { %>
      <section class="mk-panel" aria-labelledby="cms-activity"><h2 id="cms-activity">Activité récente</h2>
        <% if (activity.unavailable) { %><p class="field-hint">Le journal d'activité est momentanément indisponible.</p>
        <% } else if (!activity.rows.length) { %><p class="field-hint">Aucune activité enregistrée pour ce site.</p>
        <% } else { %><div class="mk-table-wrap"><table class="mk-table"><caption class="sr-only">Activité récente du site</caption>
          <thead><tr><th scope="col">Quand</th><th scope="col">Qui</th><th scope="col">Action</th></tr></thead>
          <tbody><% activity.rows.forEach((r) => { %><tr><td data-label="Quand"><%= r.at %></td><td data-label="Qui"><%= r.who %></td><td data-label="Action"><code><%= r.action %></code></td></tr><% }) %></tbody></table></div><% } %>
      </section>
    <% } %>

    <% if (typeof cards !== "undefined" && cards && cards.length) { %>
      <div class="mk-cms-cards">
        <% cards.forEach((c) => { %>
          <article class="mk-cms-card">
            <span class="mk-cms-card-icon" aria-hidden="true"><%- icon(c.icon, { size: 20 }) %></span>
            <h2><%= c.title %></h2><p><%= c.text %></p>
            <% if (c.href) { %><a class="btn btn-outline btn-sm" href="<%= c.href %>"><%= c.label %></a>
            <% } else { %><button type="button" class="btn btn-outline btn-sm" disabled title="<%= c.disabledText || soonTitle %>"><%= c.label %></button><% } %>
          </article>
        <% }) %>
      </div>
    <% } %>

    <% if (typeof table !== "undefined" && table) { %>
      <% if (!rowsAll.length) { %>
        <div class="mk-empty"><%- icon(table.empty.icon || "inbox", { size: 32 }) %><% if (table.empty.title) { %><h2><%= table.empty.title %></h2><% } %>
          <% if (table.empty.text) { %><p><%= table.empty.text %></p><% } %>
          <% if (table.empty.cta) { %><div class="mk-actions"><a class="btn btn-primary btn-sm" href="<%= table.empty.cta.href %>"><%= table.empty.cta.label %></a></div><% } %></div>
        <div class="mk-table-wrap mk-cms-ghost" aria-hidden="true"><table class="mk-table"><thead><tr><% table.columns.forEach((c) => { %><th scope="col"<%- c.num ? ' class="mk-num"' : "" %>><%= c.label %></th><% }) %></tr></thead></table></div>
      <% } else { %>
        <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table">
          <caption class="sr-only"><%= table.caption %></caption>
          <thead><tr><% table.columns.forEach((c) => { %><th scope="col"<%- c.num ? ' class="mk-num"' : "" %>><%= c.label %></th><% }) %><% if (rowsAll.some((r) => r.actions && r.actions.length)) { %><th scope="col" class="mk-cms-actions-col"><span class="sr-only">Actions</span></th><% } %></tr></thead>
          <tbody><% pageRows.forEach((r) => { %>
            <tr><% r.cells.forEach((raw, i) => { const c = cellOf(raw); const col = table.columns[i] || {}; %>
              <% if (i === 0) { %><th scope="row" data-label="<%= col.label %>"><% if (c.href) { %><a href="<%= c.href %>"><%= c.text %></a><% } else { %><%= c.text %><% } %><% if (c.sub) { %><span class="mk-sub"><%= c.sub %></span><% } %></th>
              <% } else { %><td<%- col.num ? ' class="mk-num"' : "" %> data-label="<%= col.label %>"><% if (c.status) { %><span class="mk-status <%= c.status.cls %>"><%= c.status.label %></span><% } else if (c.href) { %><a href="<%= c.href %>"><%= c.text %></a><% } else { %><%= c.text %><% } %></td><% } %>
            <% }) %>
              <% if (rowsAll.some((x) => x.actions && x.actions.length)) { %><td class="mk-row-actions mk-cms-actions-col"><% (r.actions || []).forEach((a) => { %><a class="btn btn-ghost btn-sm" href="<%= a.href %>"><%= a.label %></a><% }) %></td><% } %></tr>
          <% }) %></tbody>
        </table></div>
        <nav class="mk-cms-pager" aria-label="Pagination">
          <span><%= rowsAll.length %> élément<%= rowsAll.length > 1 ? "s" : "" %></span>
          <% if (pageCount > 1) { %><span class="mk-cms-pager-nav">
            <% if (pageNo > 1) { %><a class="btn btn-ghost btn-sm" href="<%= pageHref(pageNo - 1) %>">Précédent</a><% } %>
            <span>Page <%= pageNo %> sur <%= pageCount %></span>
            <% if (pageNo < pageCount) { %><a class="btn btn-ghost btn-sm" href="<%= pageHref(pageNo + 1) %>">Suivant</a><% } %></span><% } %>
        </nav>
      <% } %>
    <% } %>

    <% if (typeof tree !== "undefined" && tree) { %>
      <div class="mk-cms-split">
        <section class="mk-panel" aria-labelledby="nav-pick"><h2 id="nav-pick"><%= tree.pickerTitle %></h2><p class="field-hint"><%= tree.pickerHint %></p>
          <% if (!tree.candidates.length) { %><p class="field-hint">Aucune page pour l'instant.</p><% } else { %>
            <ul class="mk-cms-picklist"><% tree.candidates.forEach((c) => { %><li><label><input type="checkbox" disabled> <span><%= c.name %><span class="mk-sub"><%= c.hint %></span></span></label></li><% }) %></ul><% } %>
          <button type="button" class="btn btn-outline btn-sm" disabled title="<%= soonTitle %>">Ajouter au menu</button>
        </section>
        <section class="mk-panel" aria-labelledby="nav-tree"><h2 id="nav-tree"><%= tree.treeTitle %></h2>
          <div class="mk-cms-dropzone" aria-hidden="true"><%- icon("menu", { size: 24 }) %><p><%= tree.emptyText %></p></div>
          <button type="button" class="btn btn-outline btn-sm" disabled title="<%= soonTitle %>">Ajouter un élément</button>
        </section>
      </div>
    <% } %>

    <% if (typeof form !== "undefined" && form) { %>
      <form class="mk-panel mk-cms-form" onsubmit="return false" aria-label="<%= title %> (aperçu de l'interface)">
        <fieldset disabled>
          <% form.fields.forEach((f, i) => { const id = "cmsf-" + i; %>
            <div class="field-group">
              <% if (f.type === "checkbox") { %><label class="mk-cms-check"><input id="<%= id %>" type="checkbox"> <%= f.label %></label>
              <% } else { %><label for="<%= id %>"><%= f.label %></label>
                <% if (f.type === "textarea") { %><textarea id="<%= id %>" rows="3"><%= f.value || "" %></textarea>
                <% } else if (f.type === "select") { %><select id="<%= id %>"><% f.options.forEach((o) => { %><option><%= o %></option><% }) %></select>
                <% } else if (f.type === "file") { %><input id="<%= id %>" type="file">
                <% } else { %><input id="<%= id %>" type="text" value="<%= f.value || '' %>"><% } %><% } %>
              <% if (f.hint) { %><p class="field-hint"><%= f.hint %></p><% } %>
            </div>
          <% }) %>
        </fieldset>
        <div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" disabled title="<%= soonTitle %>"><%= form.submit %></button></div>
      </form>
    <% } %>
<%- include("partials/bottom") %>
