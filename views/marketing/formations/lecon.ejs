<%- include("../partials/top", { title, active }) %>
<%- include("_head", { heading: lesson.title }) %>
<p class="lm-crumb"><a href="<%= base %>/<%= course.id %>">← <%= course.title %></a></p>
<section class="mk-panel lm-lesson">
  <h2>Leçon</h2>
  <form method="post" action="<%= base %>/lecons/<%= lesson.id %>" class="mk-form">
    <div class="field-group"><label for="l-title">Titre</label><input id="l-title" name="title" required maxlength="120" value="<%= lesson.title %>"></div>
    <div class="lm-row">
      <div class="field-group"><label for="l-sec">Chapitre</label><select id="l-sec" name="section_id"><% sections.forEach((s) => { %><option value="<%= s.id %>"<%= s.id === lesson.section_id ? " selected" : "" %>><%= s.title %></option><% }) %></select></div>
      <div class="field-group"><label for="l-dur">Durée (minutes)</label><input id="l-dur" name="duration_minutes" type="number" min="0" max="10000" value="<%= lesson.duration_minutes || 0 %>"></div>
    </div>
    <div class="field-group"><label for="l-vid">Lien vidéo</label><input id="l-vid" name="video_url" value="<%= lesson.video_url || "" %>" placeholder="https://… (YouTube, Vimeo, .mp4) ou identifiant Bunny Stream">
      <% if (lesson.video_path) { %><span class="mk-sub">Une vidéo envoyée existe déjà. Un nouveau lien la remplace.</span><% } %></div>
    <% if (lesson.video_url || lesson.video_path) { %><label class="lm-check"><input type="checkbox" name="remove_video" value="1"> Retirer la vidéo</label><% } %>
    <div class="field-group"><label for="l-desc">Contenu de la leçon</label><textarea id="l-desc" name="description" rows="14" maxlength="50000"><%= lesson.description %></textarea></div>
    <label class="lm-check"><input type="checkbox" name="is_preview" value="1"<%= lesson.is_preview ? " checked" : "" %>> Aperçu gratuit (visible avant l'inscription)</label>
    <% if (canWrite) { %><div class="lm-bar"><button class="btn btn-primary btn-sm" type="submit">Enregistrer</button><a class="btn btn-ghost btn-sm" href="<%= base %>/<%= course.id %>">Retour au programme</a></div><% } %>
  </form>
  <% if (canWrite) { %><div class="lm-danger"><form method="post" action="<%= base %>/lecons/<%= lesson.id %>/supprimer"><button class="btn btn-outline btn-sm" type="submit" data-mk-confirm="La leçon sera supprimée définitivement." data-mk-confirm-title="Supprimer cette leçon ?" data-mk-confirm-ok="Supprimer">Supprimer la leçon</button></form></div><% } %>
  <p class="mk-sub lm-adv">Pièces jointes et téléversement de fichiers : <a href="/formateur/cours/<%= course.id %>/curriculum?lecon=<%= lesson.id %>">éditeur avancé</a> (réservé au compte créateur de la plateforme pour l'instant).</p>
</section>
<section class="mk-panel lm-quiz" id="quiz">
  <h2>Quiz</h2>
  <% if (!quiz) { %>
    <p class="mk-sub">Aucun quiz sur cette leçon. Un quiz évalue l'étudiant avec des questions à choix unique.</p>
    <% if (canWrite) { %><form method="post" action="<%= base %>/lecons/<%= lesson.id %>/quiz"><button class="btn btn-outline btn-sm" type="submit">Ajouter un quiz</button></form><% } %>
  <% } else { %>
    <form method="post" action="<%= base %>/quiz/<%= quiz.id %>" class="mk-form">
      <div class="lm-row">
        <div class="field-group"><label for="q-title">Titre</label><input id="q-title" name="title" maxlength="120" value="<%= quiz.title %>"></div>
        <div class="field-group"><label for="q-pass">Seuil de réussite (%)</label><input id="q-pass" name="pass_percentage" type="number" min="0" max="100" value="<%= quiz.pass_percentage %>"></div>
        <div class="field-group"><label for="q-max">Tentatives maximales</label><input id="q-max" name="max_attempts" type="number" min="1" max="100" value="<%= quiz.max_attempts || "" %>" placeholder="Illimité"></div>
      </div>
      <% if (canWrite) { %><div class="lm-bar"><button class="btn btn-primary btn-sm" type="submit">Enregistrer le quiz</button></div><% } %>
    </form>
    <p class="mk-sub"><%= quiz.stats.attempts %> tentative<%= quiz.stats.attempts > 1 ? "s" : "" %><% if (quiz.stats.attempts) { %> · <%= quiz.stats.passed %> réussie<%= quiz.stats.passed > 1 ? "s" : "" %> · score moyen <%= quiz.stats.avg %> %<% } %></p>
    <ol class="lm-questions">
    <% quiz.questions.forEach((q) => { %>
      <li><div class="lm-qhead"><strong><%= q.question %></strong><% if (canWrite) { %><form method="post" action="<%= base %>/questions/<%= q.id %>/supprimer"><button class="btn btn-ghost btn-sm" type="submit" data-mk-confirm="La question et ses réponses seront supprimées." data-mk-confirm-title="Supprimer cette question ?" data-mk-confirm-ok="Supprimer" aria-label="Supprimer la question"><%- icon("trash", { size: 16 }) %></button></form><% } %></div>
        <ul class="lm-options"><% q.options.forEach((o) => { %><li class="<%= o.is_correct ? "is-correct" : "" %>"><%= o.option_text %><% if (o.is_correct) { %> <span class="mk-status mk-status-ok">Bonne réponse</span><% } %></li><% }) %></ul></li>
    <% }) %>
    </ol>
    <% if (!quiz.questions.length) { %><p class="mk-sub">Aucune question pour l'instant.</p><% } %>
    <% if (canWrite) { %>
    <form method="post" action="<%= base %>/quiz/<%= quiz.id %>/questions" class="mk-form lm-newq">
      <h3>Nouvelle question</h3>
      <div class="field-group"><label for="nq-q">Question</label><input id="nq-q" name="question" maxlength="500" required></div>
      <% [1, 2, 3, 4].forEach((i) => { %><div class="field-group lm-opt"><label for="nq-<%= i %>">Réponse <%= i %></label><input id="nq-<%= i %>" name="option_<%= i %>" maxlength="300" <%= i < 3 ? "required" : "" %>></div><% }) %>
      <div class="field-group"><label for="nq-c">Bonne réponse</label><select id="nq-c" name="correct"><% [1, 2, 3, 4].forEach((i) => { %><option value="<%= i %>">Réponse <%= i %></option><% }) %></select></div>
      <div class="lm-bar"><button class="btn btn-outline btn-sm" type="submit">Ajouter la question</button>
        <button class="btn btn-ghost btn-sm" type="submit" formaction="<%= base %>/quiz/<%= quiz.id %>/supprimer" formnovalidate data-mk-confirm="Le quiz, ses questions et les résultats associés seront supprimés." data-mk-confirm-title="Supprimer ce quiz ?" data-mk-confirm-ok="Supprimer">Supprimer le quiz</button></div>
    </form>
    <% } %>
  <% } %>
</section>
<%- include("../partials/bottom") %>
