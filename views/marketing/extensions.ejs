<%#
  Menu « Extensions » (src/marketing/web/extensions.js) : cinq rubriques, une seule vue. Tout vient du registre central et de l'état réel des sites ; aucune action n'est simulée.
%><%- include("partials/top", { title, active }) %>
<%
  const here = (extra) => { const p = new URLSearchParams(); if (site) p.set("site", site.id); Object.entries(extra || {}).forEach(([k, v]) => p.set(k, v)); const q = p.toString(); return q ? "?" + q : ""; };
  const pageUrl = (slug) => BASE + (slug ? "/" + slug : "");
  const stateChip = (m) => m.enabled ? '<span class="mk-status mk-status-ok">Activée</span>' : '<span class="mk-status mk-status-off">Désactivée</span>';
  const maint = { stable: "", maintenance: "En maintenance", deprecated: "Obsolète" };
  const avail = { available: "", beta: "Bêta", unavailable: "Pas encore disponible" };
%>
<div class="mk-head">
  <div class="mk-head-main"><h1><%= title %></h1>
    <p class="mk-head-sub">Les extensions sont communes à tous les sites ; chaque site choisit les siennes. Activer ou désactiver une extension n'a aucun effet sur les autres sites, et <strong>désactiver ne supprime jamais de données</strong>.</p></div>
</div>
<nav class="mk-tabs mk-cms-tabs" aria-label="Rubriques des extensions">
  <% tabs.forEach((t) => { %><a class="mk-tab" href="<%= t.href %><%= site && t.slug && t.slug !== 'historique' ? '?site=' + site.id : '' %>"<%- t.current ? ' aria-current="page"' : "" %>><%= t.label %></a><% }) %>
</nav>

<% if (tab === "") { %>
  <div class="mk-table-wrap"><table class="mk-table">
    <caption class="sr-only">Catalogue des extensions disponibles</caption>
    <thead><tr><th scope="col">Extension</th><th scope="col">Catégorie</th><th scope="col">Version</th><th scope="col">Éditeur</th><th scope="col" class="num">Sites actifs</th><th scope="col">État</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
    <tbody>
      <% items.forEach((m) => { %>
        <tr>
          <td><strong><%= m.name %></strong><br><span class="mk-sub"><%= m.description %></span></td>
          <td><%= m.categoryLabel %></td>
          <td><%= m.version %></td>
          <td><%= m.publisher %></td>
          <td class="num"><%= m.activeSites %> / <%= totalSites %></td>
          <td><%= [avail[m.availability], maint[m.maintenance]].filter(Boolean).join(" · ") || "Disponible" %></td>
          <td><a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: m.id }) %>">Gérer</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } else if (tab === "activees" || tab === "desactivees") { %>
  <%- include("partials/extensions-site-picker", { sites, site, BASE, tab }) %>
  <% const list = items.filter((m) => (tab === "activees") === m.enabled); %>
  <% if (!site) { %>
    <div class="mk-empty" role="status"><p><strong>Aucun site</strong></p><p class="mk-sub">Créez un site pour pouvoir y activer des extensions.</p><a class="btn btn-primary btn-sm" href="/marketing/site-web/sites#nouveau">Créer un site</a></div>
  <% } else if (!list.length) { %>
    <div class="mk-empty" role="status"><p><strong><%= tab === "activees" ? "Aucune extension activée" : "Toutes les extensions sont activées" %></strong></p><p class="mk-sub"><%= tab === "activees" ? "Ce site n'utilise encore aucune extension." : "Rien à activer pour ce site." %></p></div>
  <% } else { %>
    <div class="mk-table-wrap"><table class="mk-table">
      <caption class="sr-only"><%= title %> pour <%= site.name %></caption>
      <thead><tr><th scope="col">Extension</th><th scope="col">Version</th><th scope="col">État</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
      <tbody>
        <% list.forEach((m) => { %>
          <tr><td><strong><%= m.name %></strong><br><span class="mk-sub"><%= m.description %></span></td><td><%= m.version %></td><td><%- stateChip(m) %></td>
            <td><a class="btn <%= m.enabled ? 'btn-outline' : 'btn-primary' %> btn-sm" href="<%= BASE %>/gestion<%= here({ extension: m.id }) %>"><%= m.enabled ? 'Gérer' : 'Activer…' %></a></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
<% } else if (tab === "gestion") { %>
  <%- include("partials/extensions-site-picker", { sites, site, BASE, tab }) %>
  <% if (!site) { %>
    <div class="mk-empty" role="status"><p><strong>Aucun site</strong></p><p class="mk-sub">Créez un site pour pouvoir y gérer des extensions.</p></div>
  <% } else { %>
    <% if (confirmPlan) { const cm = confirmPlan.extension; const enabling = !confirmPlan.enabledNow; %>
      <section class="mk-card" role="alertdialog" aria-label="Confirmation" style="margin:0 0 16px">
        <h2><%= enabling ? "Activer" : "Désactiver" %> « <%= cm.name %> » pour « <%= site.name %> » ?</h2>
        <ul><% confirmPlan.effects.forEach((e) => { %><li><%= e %></li><% }) %></ul>
        <% if (confirmPlan.blockers.length) { %>
          <p role="alert"><strong>Impossible pour l'instant :</strong></p>
          <ul><% confirmPlan.blockers.forEach((b) => { %><li><%= b.message %></li><% }) %></ul>
          <a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: cm.id }) %>">Retour</a>
        <% } else { %>
          <form method="post" action="<%= BASE %>/sites/<%= site.id %>/<%= cm.id %>/<%= enabling ? 'activer' : 'desactiver' %>" class="mk-inline">
            <input type="hidden" name="confirmer" value="1">
            <button class="btn <%= enabling ? 'btn-primary' : 'btn-outline' %> btn-sm" type="submit"><%= enabling ? "Confirmer l'activation" : "Confirmer la désactivation" %></button>
            <a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: cm.id }) %>">Annuler</a>
          </form>
        <% } %>
      </section>
    <% } %>
    <div class="mk-table-wrap"><table class="mk-table">
      <caption class="sr-only">Extensions de <%= site.name %></caption>
      <thead><tr><th scope="col">Extension</th><th scope="col">Version</th><th scope="col">État</th><th scope="col">Dépendances</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% items.forEach((m) => { %>
          <tr<%- detail && detail.id === m.id ? ' aria-current="true"' : "" %>>
            <td><strong><%= m.name %></strong><br><span class="mk-sub"><%= m.description %></span></td>
            <td><%= m.version %></td>
            <td><%- stateChip(m) %></td>
            <td><%= m.dependencies.length ? m.dependencies.map((d) => (registry.get(d.id) || { name: d.id }).name).join(", ") : "Aucune" %></td>
            <td>
              <a class="btn btn-outline btn-sm" href="<%= BASE %>/gestion<%= here({ extension: m.id }) %>">Détails</a>
              <a class="btn <%= m.enabled ? 'btn-outline' : 'btn-primary' %> btn-sm" href="<%= BASE %>/gestion<%= here({ extension: m.id, confirmer: m.id }) %>"><%= m.enabled ? "Désactiver" : "Activer" %></a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (detail) { const d = detail; %>
      <section class="mk-card" style="margin-top:16px">
        <h2><%= d.name %> <span class="mk-sub">version <%= d.version %></span></h2>
        <p><%= d.description %></p>
        <dl>
          <dt>Éditeur</dt><dd><%= d.publisher %></dd>
          <dt>Compatibilité</dt><dd>Kolakisa <%= d.compatibility.kolakisa %></dd>
          <dt>Permissions concernées</dt><dd><%= d.permissions.length ? d.permissions.join(", ") : "Aucune propre" %></dd>
          <dt>Dépend de</dt><dd><%= d.dependencies.length ? d.dependencies.map((x) => x.id + " " + x.range).join(", ") : "Rien" %></dd>
          <dt>Utilisée par</dt><dd><%= dependents.length ? dependents.join(", ") : "Aucune autre extension" %></dd>
          <dt>Incompatible avec</dt><dd><%= d.conflicts.length ? d.conflicts.join(", ") : "Rien" %></dd>
          <dt>Maintenance</dt><dd><%= { stable: "Stable", maintenance: "En maintenance", deprecated: "Obsolète" }[d.maintenance] %></dd>
          <dt>Documentation</dt><dd><code><%= d.docs %></code></dd>
        </dl>
        <% if (settings.length) { %>
          <h3>Paramètres pour « <%= site.name %> »</h3>
          <form method="post" action="<%= BASE %>/sites/<%= site.id %>/<%= d.id %>/parametres">
            <% settings.forEach((s) => { %>
              <p><label><%= s.label %>
                <% if (s.type === "boolean") { %><input type="checkbox" name="<%= s.key %>" value="1" <%= s.value ? "checked" : "" %>>
                <% } else if (s.type === "select") { %><select name="<%= s.key %>"><% s.options.forEach((o) => { %><option <%= String(s.value) === o ? "selected" : "" %>><%= o %></option><% }) %></select>
                <% } else { %><input name="<%= s.key %>" type="<%= s.type === 'number' ? 'number' : 'text' %>" value="<%= s.value %>"><% } %></label></p>
            <% }) %>
            <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>
          </form>
        <% } %>
        <p><a href="<%= BASE %>/historique?site=<%= site.id %>&extension=<%= d.id %>">Voir l'historique de cette extension</a></p>
      </section>
    <% } %>
  <% } %>
<% } else if (tab === "historique") { %>
  <form method="get" action="<%= BASE %>/historique" class="mk-inline" style="margin:0 0 12px">
    <label>Site <select name="site"><option value="tous" <%= filterAll ? "selected" : "" %>>Tous les sites</option><% sites.forEach((s) => { %><option value="<%= s.id %>" <%= !filterAll && site && site.id === s.id ? "selected" : "" %>><%= s.name %></option><% }) %></select></label>
    <label>Extension <select name="extension"><option value="">Toutes</option><% items.forEach((m) => { %><option value="<%= m.id %>" <%= filterExt === m.id ? "selected" : "" %>><%= m.name %></option><% }) %></select></label>
    <button class="btn btn-outline btn-sm" type="submit">Filtrer</button>
  </form>
  <% if (!events.length) { %>
    <div class="mk-empty" role="status"><p><strong>Aucune activité</strong></p><p class="mk-sub">Chaque activation, désactivation, refus ou échec est consigné ici.</p></div>
  <% } else { %>
    <div class="mk-table-wrap"><table class="mk-table">
      <caption class="sr-only">Historique des extensions</caption>
      <thead><tr><th scope="col">Date</th><th scope="col">Site</th><th scope="col">Extension</th><th scope="col">Opération</th><th scope="col">Détail</th></tr></thead>
      <tbody>
        <% events.forEach((e) => { const ex = registry.get(e.extension); %>
          <tr><td><%= String(e.created_at).replace("T", " ").slice(0, 16) %></td><td><%= e.site_name %></td><td><%= ex ? ex.name : e.extension %> <span class="mk-sub"><%= e.version || "" %></span></td>
            <td><span class="mk-status <%= e.action === 'enable' ? 'mk-status-ok' : (e.action === 'disable' ? 'mk-status-off' : 'mk-status-warn') %>"><%= ACTION[e.action] || e.action %></span></td>
            <td class="mk-sub"><%= e.detail.error || e.detail.code || e.detail.key || "" %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
<% } %>
<%- include("partials/bottom") %>
