<%- include("partials/top", { title, active }) %>
    <div class="mk-head"><h1>Recherche</h1></div>
    <% if (!q) { %>
      <p class="mk-lead">Saisissez un mot dans la barre du haut pour retrouver une page, un article, un média ou un menu.</p>
    <% } else if (!total) { %>
      <p class="mk-lead">Aucun résultat pour « <%= q %> » parmi ce que vous pouvez consulter.</p>
    <% } else { %>
      <p class="mk-lead"><%= total %> résultat<%= total > 1 ? "s" : "" %> pour « <%= q %> ».</p>
      <% if (found.pages.length) { %><section class="mk-panel"><h2>Pages</h2><ul>
        <% found.pages.forEach((p) => { %><li><a href="/marketing/pages/<%= p.id %>"><%= p.name %></a> <span class="mk-sub">/p/<%= p.slug %> · <%= p.status === "published" ? "en ligne" : "brouillon" %></span></li><% }) %>
      </ul></section><% } %>
      <% if (found.articles.length) { %><section class="mk-panel"><h2>Articles</h2><ul>
        <% found.articles.forEach((p) => { %><li><a href="/marketing/site-web/articles?q=<%= encodeURIComponent(p.title) %>"><%= p.title %></a> <span class="mk-sub">/blog/<%= p.slug %> · <%= p.status === "published" ? "en ligne" : p.status === "scheduled" ? "programmé" : "brouillon" %></span></li><% }) %>
      </ul></section><% } %>
      <% if (found.media.length) { %><section class="mk-panel"><h2>Médias</h2><ul>
        <% found.media.forEach((m) => { %><li><a href="/marketing/site-web/mediatheque?q=<%= encodeURIComponent(m.name) %>"><%= m.name %></a></li><% }) %>
      </ul></section><% } %>
      <% if (found.menus.length) { %><section class="mk-panel"><h2>Menus</h2><ul>
        <% found.menus.forEach((m) => { %><li><a href="/marketing/site-web/navigation/menus/<%= m.id %>"><%= m.name %></a></li><% }) %>
      </ul></section><% } %>
    <% } %>
<%- include("partials/bottom") %>
