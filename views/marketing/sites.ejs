<%- include("partials/top", { title, active }) %>
<%
  const VUES = [["actifs", "Actifs"], ["archives", "Archivés"], ["supprimes", "Supprimés"], ["tous", "Tous"]];
  const VIDE = { actifs: "Aucun site actif", archives: "Aucun site archivé", supprimes: "La corbeille est vide", tous: "Aucun site" };
  const href = (v) => "/marketing/site-web/sites?vue=" + v + (q ? "&q=" + encodeURIComponent(q) : "");
%>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Mes sites</h1><p class="mk-head-sub">Le point d'entrée de tous vos sites. Chaque site a son propre espace d'administration : ses pages, son design system, ses contenus, ses contacts et son équipe restent séparés de ceux des autres sites. Ouvrez un site pour travailler dans son espace ; le site principal s'ouvre de la même façon.</p></div><% if (canWrite) { %><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouveau">Créer un site</button><% } %></div>

    <div class="mk-stats mk-stats-4" aria-label="Vue d'ensemble des sites">
      <div class="mk-stat"><span class="mk-stat-label">Sites actifs</span><span class="mk-stat-value"><%= mkh.fmt(totals.actifs + (main ? 1 : 0)) %></span><span class="mk-stat-hint">site principal compris</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Sites archivés</span><span class="mk-stat-value"><%= mkh.fmt(totals.archives) %></span><span class="mk-stat-hint">pages hors ligne, rien d'effacé</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Pages en ligne</span><span class="mk-stat-value"><%= mkh.fmt(totals.publiees) %></span><span class="mk-stat-hint">tous les sites actifs</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Modules activés</span><span class="mk-stat-value"><%= mkh.fmt(totals.modules) %></span><span class="mk-stat-hint">par site, à l'initiative de l'équipe</span></div>
    </div>

    <nav class="mk-tabs" aria-label="Filtrer les sites par état">
      <% VUES.forEach(([key, label]) => { %><a class="mk-tab" href="<%= href(key) %>"<%- view === key ? ' aria-current="page"' : "" %>><%= label %> (<%= counts[key] %>)</a><% }) %>
    </nav>

    <form class="mk-filterbar" method="get" action="/marketing/site-web/sites" role="search">
      <input type="hidden" name="vue" value="<%= view %>">
      <div class="mk-search"><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= q %>" maxlength="80" placeholder="Rechercher par nom, identifiant ou description" aria-label="Rechercher un site"></div>
      <button type="submit" class="btn btn-outline btn-sm">Rechercher</button>
      <% if (q) { %><a class="btn btn-ghost btn-sm" href="/marketing/site-web/sites?vue=<%= view %>">Effacer</a><% } %>
      <span class="mk-filter-count"><%= sites.length %> site<%= sites.length > 1 ? "s" : "" %></span>
    </form>

    <% if (main || sites.length) { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-site-manager">
        <caption class="sr-only">Mes sites</caption>
        <thead><tr><th scope="col">Site</th><th scope="col">État</th><th scope="col">Domaine</th><th scope="col" class="mk-num">Pages</th><th scope="col" class="mk-num">En ligne</th><th scope="col" class="mk-num">Équipe</th><th scope="col" class="mk-num">Contacts</th><th scope="col">Modules</th><th scope="col">Modifié le</th><th scope="col">Actions</th></tr></thead>
        <tbody>
<% if (main) { %>          <tr data-site="principal">
            <th scope="row" data-label="Site"><a href="<%= main.openHref %>"><%= main.name %></a> <span class="mk-status mk-status-ok">Principal</span>
              <span class="mk-sub"><%= main.description %></span></th>
            <td data-label="État"><span class="mk-status mk-status-ok">Actif</span></td>
            <td data-label="Domaine"><%= main.domain || "—" %></td>
            <td class="mk-num" data-label="Pages"><%= mkh.fmt(main.pages) %></td>
            <td class="mk-num" data-label="En ligne"><%= mkh.fmt(main.published) %></td>
            <td class="mk-num" data-label="Équipe"><%= mkh.fmt(main.members) %></td>
            <td class="mk-num" data-label="Contacts" title="Contacts non rattachés à un site"><%= mkh.fmt(main.contacts) %></td>
            <td data-label="Modules"><span class="mk-sub">Tous (site principal)</span></td>
            <td data-label="Modifié le"><%= main.lastEdit ? String(main.lastEdit).slice(0, 10) : "—" %></td>
            <td data-label="Actions"><div class="mk-actions"><a class="btn btn-outline btn-sm" href="<%= main.openHref %>">Ouvrir<span class="sr-only"> le site principal</span></a></div></td>
          </tr>
<% } %>        <% sites.forEach((st) => {
          const domaine = st.settings && st.settings.seo && st.settings.seo.publicUrl ? st.settings.seo.publicUrl.replace(/^https?:\/\//, "") : "";
          const etat = st.deleted_at ? ["Supprimé", "mk-status-warn"] : st.status === "archived" ? ["Archivé", "mk-status-warn"] : ["Actif", "mk-status-ok"];
        %>
          <tr data-site="<%= st.id %>">
            <th scope="row" data-label="Site"><a href="/marketing/site-web/sites/<%= st.id %>"><%= st.name %></a>
              <span class="mk-sub"><code><%= st.slug %></code><%= st.site_type ? " · " + (siteTypes[st.site_type] || st.site_type) : "" %><%= st.description ? " · " + st.description : "" %></span></th>
            <td data-label="État"><span class="mk-status <%= etat[1] %>"><%= etat[0] %></span></td>
            <td data-label="Domaine"><%= domaine || "—" %></td>
            <td class="mk-num" data-label="Pages"><%= mkh.fmt(st.pages) %></td>
            <td class="mk-num" data-label="En ligne"><%= mkh.fmt(st.published) %></td>
            <td class="mk-num" data-label="Équipe"><%= mkh.fmt(st.members) %></td>
            <td class="mk-num" data-label="Contacts"><%= mkh.fmt(st.contacts) %></td>
            <td data-label="Modules"><% if (!st.modules.length) { %><span class="mk-sub">Aucun</span><% } else { %><span class="mk-chips"><% st.modules.forEach((m) => { %><span class="mk-status"><%= m.label %></span> <% }) %></span><% } %></td>
            <td data-label="Modifié le" title="Créé le <%= st.created_at ? String(st.created_at).slice(0, 10) : '—' %>"><%= st.lastEdit ? String(st.lastEdit).slice(0, 10) : (st.created_at ? String(st.created_at).slice(0, 10) : "—") %></td>
            <td data-label="Actions"><div class="mk-actions">
              <% if (!st.deleted_at) { %><a class="btn btn-outline btn-sm" href="/marketing/site-web/sites/<%= st.id %>/tableau-de-bord">Ouvrir<span class="sr-only"> <%= st.name %></span></a><% } %>
              <% if (canModules && !st.deleted_at && st.status === "active") { %><a class="btn btn-ghost btn-sm" href="/marketing/site-web/sites/<%= st.id %>/modules">Modules<span class="sr-only"> de <%= st.name %></span></a><% } %>
              <% if (mk.can("sites.domains") && !st.deleted_at && st.status === "active") { %><a class="btn btn-ghost btn-sm" href="/marketing/site-web/sites/<%= st.id %>/domaines">Domaines<span class="sr-only"> de <%= st.name %></span></a><% } %>
              <% if (canWrite && !st.deleted_at && st.status === "active") { %>
                <form action="/marketing/site-web/sites/<%= st.id %>/dupliquer" method="post"><input type="hidden" name="contenu" value="pages"><button type="submit" class="btn btn-ghost btn-sm" title="Copie le design system, les réglages et les pages (en brouillon)">Dupliquer</button></form>
                <form action="/marketing/site-web/sites/<%= st.id %>/archiver" method="post"><button type="submit" class="btn btn-ghost btn-sm" data-mk-confirm="Les pages en ligne de « <%= st.name %> » passent hors ligne. Rien n'est effacé et vous pourrez le restaurer.">Archiver</button></form>
              <% } else if (canWrite && !st.deleted_at) { %>
                <form action="/marketing/site-web/sites/<%= st.id %>/restaurer" method="post"><button type="submit" class="btn btn-ghost btn-sm">Restaurer</button></form>
                <% if (canDelete) { %><a class="btn btn-ghost btn-sm" href="/marketing/site-web/sites/<%= st.id %>#zone-sensible">Supprimer…</a><% } %>
              <% } else if (canWrite && st.deleted_at) { %>
                <form action="/marketing/site-web/sites/<%= st.id %>/recuperer" method="post"><button type="submit" class="btn btn-outline btn-sm">Récupérer</button></form>
              <% } %>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    <% } %>

    <% if (!sites.length) { %>
      <div class="mk-empty"><%- illu("globe", { className: "kx-empty-ill" }) %>
        <h2><%= q ? "Aucun site ne correspond à « " + q + " »" : VIDE[view] %></h2>
        <p><%= q ? "Essayez un autre mot, ou changez de filtre." : view === "supprimes" ? "Un site supprimé reste ici, récupérable." : view === "archives" ? "Un site archivé a ses pages hors ligne ; rien n'est effacé." : "Créez votre premier site : vous y rattacherez des pages et réglerez son design system." %></p>
        <% if (canWrite && !q && (view === "actifs" || view === "tous")) { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouveau">Créer un site</button></div><% } %></div>
    <% } %>

    <% if (canWrite) { %>
      <dialog class="mk-dialog mk-modal" id="nouveau" data-mk-modal data-mk-modal-hash="nouveau" aria-labelledby="site-new-title">
        <form action="/marketing/site-web/sites" method="post">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="site-new-title">Créer un site</h2><p class="mk-dialog-desc">Le site démarre avec le design system par défaut de KOLAKISA, que vous pourrez modifier.</p></div>
            <button type="button" class="mk-dialog-close" data-mk-modal-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body">
            <div class="field-group"><label for="site-name">Nom du site *</label><input id="site-name" type="text" name="name" maxlength="100" required placeholder="Académie Photoshop"></div>
            <div class="field-group"><label for="site-slug">Identifiant lisible</label><input id="site-slug" type="text" name="slug" maxlength="60" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="academie-photoshop"><p class="field-hint">Facultatif : créé d'après le nom. Lettres minuscules, chiffres et tirets. Modifiable plus tard ; l'identifiant interne du site, lui, ne change jamais.</p></div>
            <div class="field-group"><label for="site-desc">Description</label><textarea id="site-desc" name="description" rows="2" maxlength="500" placeholder="À quoi sert ce site ?"></textarea></div>
            <div class="field-group"><label for="site-type">Type de site</label><select id="site-type" name="site_type"><% Object.entries(siteTypes).forEach(([k, label]) => { %><option value="<%= k %>"><%= label %></option><% }) %></select></div>
          </div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-mk-modal-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Créer le site</button></div>
        </form>
      </dialog>
      <%- include("partials/modal-reopen", { id: "nouveau" }) %>
    <% } %>
<%- include("partials/bottom") %>
