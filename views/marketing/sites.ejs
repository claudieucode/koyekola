<%- include("partials/top", { title, active }) %>
<%
  const VUES = [["actifs", "Actifs"], ["archives", "Archivés"], ["supprimes", "Supprimés"], ["tous", "Tous"]];
  const VIDE = { actifs: "Aucun site actif", archives: "Aucun site archivé", supprimes: "La corbeille est vide", tous: "Aucun site" };
  const href = (v) => "/marketing/site-web/sites?vue=" + v + (q ? "&q=" + encodeURIComponent(q) : "");
%>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Mes sites</h1><p class="mk-head-sub">Le point d'entrée de tous vos sites. Chaque site a son propre espace d'administration : ses pages, son design system, ses contenus, ses contacts et son équipe restent séparés de ceux des autres sites. Ouvrez un site pour travailler dans son espace ; le site principal s'ouvre de la même façon.</p></div><% if (canWrite) { %><a class="btn btn-primary btn-sm" href="/marketing/ia/studio">Assistant IA</a> <a class="btn btn-outline btn-sm" href="/marketing/site-web/assistant">Assistant de création</a> <button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouveau">Créer un site</button><% } %></div>

    <div class="mk-stats mk-stats-4" aria-label="Vue d'ensemble des sites">
      <div class="mk-stat"><span class="mk-stat-label">Sites actifs</span><span class="mk-stat-value"><%= mkh.fmt(totals.actifs + (main ? 1 : 0)) %></span><span class="mk-stat-hint">site principal compris</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Sites archivés</span><span class="mk-stat-value"><%= mkh.fmt(totals.archives) %></span><span class="mk-stat-hint">pages hors ligne, rien d'effacé</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Pages en ligne</span><span class="mk-stat-value"><%= mkh.fmt(totals.publiees) %></span><span class="mk-stat-hint">tous les sites actifs</span></div>
      <div class="mk-stat"><span class="mk-stat-label">Modules activés</span><span class="mk-stat-value"><%= mkh.fmt(totals.modules) %></span><span class="mk-stat-hint">par site, à l'initiative de l'équipe</span></div>
    </div>

    <nav class="mk-tabs" aria-label="Filtrer les sites par état">
      <% VUES.forEach(([key, label]) => { %><a class="mk-tab" href="<%= href(key) %>"<%- view === key ? ' aria-current="page"' : "" %>><%= label %> (<%= counts[key] %>)</a><% }) %>
    </nav>

    <form class="mk-filterbar" method="get" action="/marketing/site-web/sites" role="search">
      <input type="hidden" name="vue" value="<%= view %>">
      <div class="mk-search"><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= q %>" maxlength="80" placeholder="Rechercher par nom, identifiant ou description" aria-label="Rechercher un site"></div>
      <button type="submit" class="btn btn-outline btn-sm">Rechercher</button>
      <% if (q) { %><a class="btn btn-ghost btn-sm" href="/marketing/site-web/sites?vue=<%= view %>">Effacer</a><% } %>
      <span class="mk-filter-count"><%= sites.length %> site<%= sites.length > 1 ? "s" : "" %></span>
    </form>

    <% if (main || sites.length) { %>
      <%# Liste des sites : une carte par site, trois zones (A informations · B statistiques · C actions). Le balisage reste un tableau (une ligne <tr data-site> par site) ; CSS : « Mes sites » dans kola-brand.css %>
      <div class="mk-table-wrap mk-site-list"><table class="mk-table mk-site-manager">
        <caption class="sr-only">Mes sites</caption>
        <thead><tr><th scope="col">Site</th><th scope="col">Statistiques</th><th scope="col">Actions</th></tr></thead>
        <tbody>
<% if (main) { %>          <tr data-site="principal">
            <th scope="row" class="mk-site-info">
              <span class="mk-site-title"><a href="<%= main.openHref %>"><%= main.name %></a><span class="mk-status mk-status-ok">Principal</span></span>
              <span class="mk-sub"><%= main.description %></span>
              <span class="mk-site-flags"><span class="mk-status mk-status-ok">Actif</span><span class="mk-site-modules"><span class="mk-sub">Modules :</span> <span class="mk-sub">Tous (site principal)</span></span></span>
            </th>
            <td class="mk-site-figures">
              <dl class="mk-site-stats">
                <div><dt>Pages</dt><dd><%= mkh.fmt(main.pages) %></dd></div>
                <div><dt>En ligne</dt><dd><%= mkh.fmt(main.published) %></dd></div>
                <div><dt>Équipe</dt><dd><%= mkh.fmt(main.members) %></dd></div>
                <div><dt>Contacts</dt><dd title="Contacts non rattachés à un site"><%= mkh.fmt(main.contacts) %></dd></div>
              </dl>
              <p class="mk-site-meta"><span><span class="mk-site-meta-k">Domaine</span> <%= main.domain || "—" %></span><span><span class="mk-site-meta-k">Modifié le</span> <%= main.lastEdit ? String(main.lastEdit).slice(0, 10) : "—" %></span></p>
            </td>
            <td class="mk-site-actions"><div class="mk-actions"><a class="btn btn-outline btn-sm" href="<%= main.openHref %>">Ouvrir<span class="sr-only"> le site principal</span></a></div></td>
          </tr>
<% } %>        <% sites.forEach((st) => {
          const domaine = st.settings && st.settings.seo && st.settings.seo.publicUrl ? st.settings.seo.publicUrl.replace(/^https?:\/\//, "") : "";
          const etat = st.deleted_at ? ["Supprimé", "mk-status-warn"] : st.status === "archived" ? ["Archivé", "mk-status-warn"] : ["Actif", "mk-status-ok"];
          const actif = !st.deleted_at && st.status === "active";
          // Actions du menu ⋮ : mêmes droits et mêmes routes qu'avant (le serveur les revérifie à chaque requête)
          const hasModules = canModules && actif, hasDomains = mk.can("sites.domains") && actif;
          const hasCopy = canWrite && actif, hasRestore = canWrite && !st.deleted_at && !actif, hasDelete = hasRestore && canDelete;
          const hasSettings = actif && mk.can("forms.read");
          const hasMenu = hasSettings || hasModules || hasDomains || hasCopy || hasRestore;
        %>
          <tr data-site="<%= st.id %>">
            <th scope="row" class="mk-site-info">
              <span class="mk-site-title"><a href="/marketing/site-web/sites/<%= st.id %>"><%= st.name %></a></span>
              <span class="mk-sub"><code><%= st.slug %></code><%= st.site_type ? " · " + (siteTypes[st.site_type] || st.site_type) : "" %><%= st.description ? " · " + st.description : "" %></span>
              <span class="mk-site-flags"><span class="mk-status <%= etat[1] %>"><%= etat[0] %></span><% if (actif) { %><span class="mk-status" title="<%= st.published > 0 ? "Au moins une page de ce site est en ligne" : "Aucune page en ligne : le site est en cours de préparation" %>"><%= st.published > 0 ? "Publié" : "En préparation" %></span><% } %><span class="mk-site-modules"><span class="mk-sub">Modules :</span> <% if (!st.modules.length) { %><span class="mk-sub">Aucun</span><% } else { %><span class="mk-chips"><% st.modules.forEach((m) => { %><span class="mk-status"><%= m.label %></span> <% }) %></span><% } %></span></span>
            </th>
            <td class="mk-site-figures">
              <dl class="mk-site-stats">
                <div><dt>Pages</dt><dd><%= mkh.fmt(st.pages) %></dd></div>
                <div><dt>En ligne</dt><dd><%= mkh.fmt(st.published) %></dd></div>
                <div><dt>Équipe</dt><dd><%= mkh.fmt(st.members) %></dd></div>
                <div><dt>Contacts</dt><dd><%= mkh.fmt(st.contacts) %></dd></div>
              </dl>
              <p class="mk-site-meta"><span><span class="mk-site-meta-k">Domaine</span> <%= domaine || "—" %></span><span title="Créé le <%= st.created_at ? String(st.created_at).slice(0, 10) : '—' %>"><span class="mk-site-meta-k">Modifié le</span> <%= st.lastEdit ? String(st.lastEdit).slice(0, 10) : (st.created_at ? String(st.created_at).slice(0, 10) : "—") %></span></p>
            </td>
            <td class="mk-site-actions"><div class="mk-actions">
              <% if (!st.deleted_at) { %><a class="btn btn-outline btn-sm" href="/marketing/site-web/sites/<%= st.id %>/tableau-de-bord">Ouvrir<span class="sr-only"> <%= st.name %></span></a><% } %>
              <% if (canWrite && st.deleted_at) { %><form action="/marketing/site-web/sites/<%= st.id %>/recuperer" method="post"><button type="submit" class="btn btn-outline btn-sm">Récupérer<span class="sr-only"> <%= st.name %></span></button></form><% } %>
              <% if (hasMenu) { %>
              <div class="mk-dropdown" data-mk-dropdown>
                <button type="button" class="icon-btn btn-sm mk-site-more" aria-haspopup="menu" aria-expanded="false" aria-controls="menu-site-<%= st.id %>" aria-label="Autres actions pour le site <%= st.name %>"><%- icon("moreVertical", { size: 18 }) %></button>
                <div class="mk-menu" id="menu-site-<%= st.id %>" role="menu" hidden>
                  <% if (hasSettings) { %><a role="menuitem" href="/marketing/site-web/sites/<%= st.id %>/reglages">Réglages<span class="sr-only"> de <%= st.name %></span></a><% } %>
                  <% if (hasModules) { %><a role="menuitem" href="/marketing/site-web/sites/<%= st.id %>/modules">Modules<span class="sr-only"> de <%= st.name %></span></a><% } %>
                  <% if (hasDomains) { %><a role="menuitem" href="/marketing/site-web/sites/<%= st.id %>/domaines">Domaines<span class="sr-only"> de <%= st.name %></span></a><% } %>
                  <% if (hasCopy) { %>
                    <form action="/marketing/site-web/sites/<%= st.id %>/dupliquer" method="post" role="none"><input type="hidden" name="contenu" value="pages"><button type="submit" role="menuitem" title="Copie le design system, les réglages et les pages (en brouillon)">Dupliquer<span class="sr-only"> <%= st.name %></span></button></form>
                    <form action="/marketing/site-web/sites/<%= st.id %>/archiver" method="post" role="none"><button type="submit" role="menuitem" class="mk-menu-danger" data-mk-confirm="Les pages en ligne de « <%= st.name %> » passent hors ligne. Rien n'est effacé et vous pourrez le restaurer.">Archiver<span class="sr-only"> <%= st.name %></span></button></form>
                  <% } %>
                  <% if (hasRestore) { %><form action="/marketing/site-web/sites/<%= st.id %>/restaurer" method="post" role="none"><button type="submit" role="menuitem">Restaurer<span class="sr-only"> <%= st.name %></span></button></form><% } %>
                  <% if (hasDelete) { %><a role="menuitem" class="mk-menu-danger" href="/marketing/site-web/sites/<%= st.id %>#zone-sensible">Supprimer…<span class="sr-only"> <%= st.name %></span></a><% } %>
                </div>
              </div>
              <% } %>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    <% } %>

    <% if (!sites.length) { %>
      <div class="mk-empty"><%- illu("globe", { className: "kx-empty-ill" }) %>
        <h2><%= q ? "Aucun site ne correspond à « " + q + " »" : VIDE[view] %></h2>
        <p><%= q ? "Essayez un autre mot, ou changez de filtre." : view === "supprimes" ? "Un site supprimé reste ici, récupérable." : view === "archives" ? "Un site archivé a ses pages hors ligne ; rien n'est effacé." : "Créez votre premier site : vous y rattacherez des pages et réglerez son design system." %></p>
        <% if (canWrite && !q && (view === "actifs" || view === "tous")) { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouveau">Créer un site</button></div><% } %></div>
    <% } %>

    <% if (canWrite) { %>
      <dialog class="mk-dialog mk-modal" id="nouveau" data-mk-modal data-mk-modal-hash="nouveau" aria-labelledby="site-new-title">
        <form action="/marketing/site-web/sites" method="post" data-mk-once>
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="site-new-title">Créer un site</h2><p class="mk-dialog-desc">Le site démarre avec le design system par défaut de KOLAKISA, que vous pourrez modifier.</p></div>
            <button type="button" class="mk-dialog-close" data-mk-modal-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body">
            <div class="field-group"><label for="site-name">Nom du site *</label><input id="site-name" type="text" name="name" maxlength="100" required placeholder="Académie Photoshop"></div>
            <div class="field-group"><label for="site-slug">Identifiant lisible</label><input id="site-slug" type="text" name="slug" maxlength="60" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="academie-photoshop"><p class="field-hint">Facultatif : créé d'après le nom. Lettres minuscules, chiffres et tirets. Modifiable plus tard ; l'identifiant interne du site, lui, ne change jamais.</p></div>
            <div class="field-group"><label for="site-desc">Description</label><textarea id="site-desc" name="description" rows="2" maxlength="500" placeholder="À quoi sert ce site ?"></textarea></div>
            <div class="field-group"><label for="site-type">Type de site</label><select id="site-type" name="site_type"><% Object.entries(siteTypes).forEach(([k, label]) => { %><option value="<%= k %>"><%= label %></option><% }) %></select></div>
          </div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-mk-modal-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Créer le site</button></div>
        </form>
      </dialog>
      <%- include("partials/modal-reopen", { id: "nouveau" }) %>
    <% } %>
<%- include("partials/bottom") %>
