<%#
  KOLAKISA CMS → Utilisateurs (palier 9). Modes : list (équipe : recherche, statut, rôle, site, tri, pagination), invite, invitations, mysites.
  Données réelles (users, mk_org_members, mk_site_members, mk_invitations) ; aucune donnée simulée.
%><%- include("partials/top", { title, active }) %>
<%
  const fd = (v) => (v ? String(v).slice(0, 10).split("-").reverse().join("/") : "—");
  const fdt = (v) => (v ? fd(v) + " à " + String(v).slice(11, 16) + " UTC" : "—");
  const keep = (over = {}) => { const p = new URLSearchParams(); const o = { q: f.q, role: f.role, site: f.site, tri: f.tri === "nom" ? "" : f.tri, statut: f.statut, ...over }; Object.entries(o).forEach(([k, v]) => { if (v) p.set(k, v); }); const t = p.toString(); return BASE + (t ? "?" + t : ""); };
  const stClass = { active: "mk-status-ok", suspended: "mk-status-warn", disabled: "mk-status-off" };
  const stLabel = { active: "Actif", suspended: "Suspendu", disabled: "Désactivé" };
%>
<% if (mode === "list") { %>
    <%- include("partials/kx-hero-open", { title: "Utilisateurs", lead: "L'équipe qui gère le site : comptes du site auxquels un rôle donne accès au CMS, globalement ou pour un seul site.", compact: true }) %>
      <% if (canCreate) { %><a class="btn btn-primary btn-sm" href="<%= BASE %>/ajouter"><%- icon("plus", { size: 16 }) %>Inviter</a><% } %><a class="btn btn-outline btn-sm" href="<%= BASE %>/roles">Rôles</a>
    <%- include("partials/kx-hero-close", { art: "utilisateurs" }) %>
    <nav class="mk-tabs mk-cms-tabs" aria-label="Filtrer par statut">
      <% tabs.forEach(([k, name, ck]) => { %><a class="mk-tab" href="<%= keep({ statut: k, page: "" }) %>"<%- f.statut === k ? ' aria-current="page"' : "" %>><%= name %> <span class="mk-tab-count"><%= counts[ck] || 0 %></span></a>
      <% }) %>
    </nav>
    <form class="mk-cms-toolbar mk-cms-filters" method="get" action="<%= BASE %>" role="search" aria-label="Rechercher et filtrer l'équipe">
      <input type="hidden" name="statut" value="<%= f.statut %>">
      <label class="mk-search"><span class="sr-only">Rechercher (nom, e-mail)</span><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= f.q %>" placeholder="Rechercher une personne"></label>
      <label class="sr-only" for="u-role">Rôle</label>
      <select id="u-role" name="role"><option value="">Tous les rôles</option><% roles.forEach((r) => { %><option value="<%= r.key %>"<%= f.role === r.key ? " selected" : "" %>><%= r.name %></option><% }) %></select>
      <% if (sites.length) { %><label class="sr-only" for="u-site">Site</label><select id="u-site" name="site"><option value="">Tous les sites</option><% sites.forEach((s) => { %><option value="<%= s.id %>"<%= String(f.site) === String(s.id) ? " selected" : "" %>><%= s.name %></option><% }) %></select><% } %>
      <label class="sr-only" for="u-tri">Trier par</label>
      <select id="u-tri" name="tri"><% [["nom", "Nom A → Z"], ["recent", "Plus récents"], ["activite", "Activité récente"]].forEach(([k, name]) => { %><option value="<%= k %>"<%= f.tri === k ? " selected" : "" %>><%= name %></option><% }) %></select>
      <button type="submit" class="btn btn-outline btn-sm">Filtrer</button><% if (f.q || f.role || f.site) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ q: "", role: "", site: "" }) %>">Réinitialiser</a><% } %>
    </form>
    <% if (f.statut === "en-attente") { %>
      <% if (!invitations.length) { %><div class="mk-empty"><%- illu("mail", { className: "kx-empty-ill" }) %><h2>Aucune invitation en attente.</h2><p>Les personnes invitées qui n'ont pas encore créé leur compte apparaissent ici.</p></div>
      <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table"><caption class="sr-only">Invitations en attente</caption>
        <thead><tr><th scope="col">E-mail</th><th scope="col">Rôle</th><th scope="col">Site</th><th scope="col">Expire le</th></tr></thead>
        <tbody><% invitations.forEach((i) => { %><tr><th scope="row" data-label="E-mail"><%= i.email %></th><td data-label="Rôle"><%= roleName(i.role) %></td><td data-label="Site"><%= i.site_name || "Toute l'équipe" %></td><td data-label="Expire le"><%= fdt(i.expires_at) %></td></tr><% }) %></tbody></table></div>
      <% } %>
    <% } else if (!rows.length) { %>
      <div class="mk-empty"><%- illu("users", { className: "kx-empty-ill" }) %><h2>Aucun résultat.</h2><p>Aucune personne ne correspond à ces critères.</p></div>
    <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table mk-us-table">
        <caption class="sr-only">Équipe</caption>
        <thead><tr><th scope="col">Nom</th><th scope="col">Rôle</th><th scope="col">Sites</th><th scope="col">Statut</th><th scope="col">Dernière activité</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% rows.forEach((u) => { %>
          <tr><th scope="row" data-label="Nom"><span class="mk-tx-name"><a href="<%= BASE %>/<%= u.id %>"><%= u.username %></a><span class="mk-sub"><%= u.email %></span></span></th>
            <td data-label="Rôle"><%= u.org_role ? roleName(u.org_role) : "—" %></td>
            <td data-label="Sites"><%= u.sites.length ? u.sites.map((s) => s.name + " (" + roleName(s.role) + ")").join(", ") : (u.org_role ? "Tous" : "—") %></td>
            <td data-label="Statut"><span class="mk-status <%= stClass[u.status] || "mk-status-off" %>"><%= stLabel[u.status] || u.status %></span></td>
            <td data-label="Dernière activité"><%= u.last_seen_at ? fdt(u.last_seen_at) : "Jamais" %></td>
            <td class="mk-row-actions"><a class="btn btn-outline btn-sm" href="<%= BASE %>/<%= u.id %>">Voir</a></td></tr>
        <% }) %></tbody></table></div>
      <nav class="mk-cms-pager" aria-label="Pagination"><span><%= result.total %> personne<%= result.total > 1 ? "s" : "" %></span>
        <% if (result.pages > 1) { %><span class="mk-cms-pager-nav">
          <% if (result.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: result.page - 1 }) %>">Précédent</a><% } %>
          <span>Page <%= result.page %> sur <%= result.pages %></span>
          <% if (result.page < result.pages) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: result.page + 1 }) %>">Suivant</a><% } %></span><% } %></nav>
    <% } %>

<% } else if (mode === "invite") { %>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Inviter quelqu'un</h1><p class="mk-head-sub">La personne reçoit un e-mail avec un lien personnel (valable <%= days %> jours, à usage unique) pour créer son compte. Si elle a déjà un compte, l'accès lui est donné tout de suite. Vous ne pouvez attribuer que des rôles dont vous possédez tous les droits.</p></div><div class="mk-actions"><a class="btn btn-outline btn-sm" href="<%= BASE %>">← Utilisateurs</a></div></div>
    <form method="post" action="<%= BASE %>/inviter" class="mk-form mk-us-form">
      <div class="field-group"><label for="iv-email">Adresse e-mail *</label><input id="iv-email" type="email" name="email" required maxlength="120" autocomplete="off"></div>
      <div class="field-group"><label for="iv-role">Rôle *</label>
        <select id="iv-role" name="role" required><% roles.forEach((r) => { %><option value="<%= r.key %>"<%= r.ok ? "" : " disabled" %><%= r.key === "viewer" ? " selected" : "" %>><%= r.name %><%= r.ok ? "" : " (droits supérieurs aux vôtres)" %></option><% }) %></select></div>
      <div class="field-group"><label for="iv-site">Accès</label>
        <select id="iv-site" name="site_id"><option value="">Toute l'équipe (tous les sites)</option><% sites.forEach((s) => { %><option value="<%= s.id %>">Seulement le site « <%= s.name %> »</option><% }) %></select>
        <span class="field-hint">Un accès limité à un site ne donne aucun droit sur les autres sites.</span></div>
      <div class="mk-actions"><button type="submit" class="btn btn-primary btn-sm">Envoyer l'invitation</button></div>
    </form>

<% } else if (mode === "invitations") { %>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Invitations</h1><p class="mk-head-sub">Invitations envoyées pour rejoindre l'équipe. Un lien ne fonctionne qu'une fois ; « Renvoyer » crée un nouveau lien et annule l'ancien.</p></div><div class="mk-actions"><% if (canCreate) { %><a class="btn btn-primary btn-sm" href="<%= BASE %>/ajouter">Inviter</a><% } %></div></div>
    <% if (!invitations.length) { %><div class="mk-empty"><%- illu("mail", { className: "kx-empty-ill" }) %><h2>Aucune invitation.</h2><p>Les invitations apparaissent ici dès que vous invitez quelqu'un.</p></div>
    <% } else { %>
    <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table"><caption class="sr-only">Invitations</caption>
      <thead><tr><th scope="col">E-mail</th><th scope="col">Rôle</th><th scope="col">Site</th><th scope="col">État</th><th scope="col">Envoyée le</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody><% invitations.forEach((i) => { const states = { pending: ["En attente", "mk-status-warn"], accepted: ["Acceptée", "mk-status-ok"], revoked: ["Révoquée", "mk-status-off"], expired: ["Expirée", "mk-status-off"] }; %>
        <tr><th scope="row" data-label="E-mail"><%= i.email %></th><td data-label="Rôle"><%= roleName(i.role) %></td><td data-label="Site"><%= i.site_name || "Toute l'équipe" %></td>
          <td data-label="État"><span class="mk-status <%= states[i.state][1] %>"><%= states[i.state][0] %></span></td><td data-label="Envoyée le"><%= fdt(i.created_at) %><% if (i.invited_by_name) { %><span class="mk-sub">par <%= i.invited_by_name %></span><% } %></td>
          <td class="mk-row-actions"><% if (canCreate && (i.state === "pending" || i.state === "expired")) { %><form method="post" action="<%= BASE %>/invitations/<%= i.id %>/renvoyer" class="mk-cm-form"><button type="submit" class="btn btn-outline btn-sm">Renvoyer</button></form>
            <% if (i.state === "pending") { %><form method="post" action="<%= BASE %>/invitations/<%= i.id %>/revoquer" class="mk-cm-form"><button type="submit" class="btn btn-ghost btn-sm" data-mk-confirm="Le lien de cette invitation ne fonctionnera plus." data-mk-confirm-title="Révoquer l'invitation ?" data-mk-confirm-ok="Révoquer">Révoquer</button></form><% } %><% } %></td></tr>
      <% }) %></tbody></table></div>
    <% } %>

<% } else if (mode === "mysites") { %>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Mes sites</h1><p class="mk-head-sub">Les sites auxquels votre compte donne accès, avec votre rôle sur chacun.</p></div></div>
    <% if (!mine.length) { %><div class="mk-empty"><%- illu("globe", { className: "kx-empty-ill" }) %><h2>Aucun site.</h2><p>Votre compte n'a accès à aucun site pour l'instant.</p></div>
    <% } else { %><ul class="mk-cms-list"><% mine.forEach((s) => { %><li><span><a href="/marketing/site-web/sites/<%= s.site_id %>"><strong><%= s.site_name %></strong></a> · <%= roleName(s.role) %></span></li><% }) %></ul><% } %>
<% } %>
<%- include("partials/bottom") %>
