<%- include("partials/top", { title, active }) %>
<% const canWrite = mk.can("forms.write"); %>
    <div class="mk-head"><h1>Pages</h1><% if (canWrite && state !== "corbeille") { %><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouvelle">Nouvelle page</button><% } %></div>
    <p class="mk-lead">Toutes vos pages web hébergées par KOLAKISA (adresse /p/…) : pages de vos sites et pages d'atterrissage. Chaque modification est enregistrée en brouillon ; les visiteurs ne la voient qu'après « Publier ».</p>
    <%
      // Adresse de la liste avec ses filtres (les liens d'onglets, de pages et le retour des actions groupées la conservent)
      const keep = (over = {}) => { const p = new URLSearchParams(); const f = { etat: state === "toutes" ? "" : state, q: filters.q, site: filters.site, auteur: filters.auteur, tri: filters.tri === "modifiee" ? "" : filters.tri, ...over }; Object.entries(f).forEach(([k, v]) => { if (v) p.set(k, v); }); const t = p.toString(); return "/marketing/pages" + (t ? "?" + t : ""); };
      const tabs = [["toutes", "Toutes"], ["publiees", "Publiées"], ["brouillons", "Brouillons"], ["corbeille", "Corbeille"]];
      const fmt = (v) => (v ? String(v).slice(0, 10).split("-").reverse().join("/") : "—");
      const filtered = Boolean(filters.q || filters.site || filters.auteur);
      const inTrash = state === "corbeille";
    %>
    <nav class="mk-tabs mk-cms-tabs" aria-label="Filtrer les pages par état">
      <% tabs.forEach(([k, label]) => { %><a class="mk-tab" href="<%= keep({ etat: k === "toutes" ? "" : k, page: "" }) %>"<%- state === k ? ' aria-current="page"' : "" %>><%= label %> <span class="mk-tab-count"><%= result.counts[k] %></span></a>
      <% }) %>
    </nav>
    <% if (inTrash) { %><p class="field-hint">La corbeille garde les pages hors ligne, avec leurs statistiques et leurs versions. Restaurez une page pour la retrouver ; seule la suppression définitive les efface.</p><% } %>
    <form class="mk-cms-toolbar mk-cms-filters" method="get" action="/marketing/pages" role="search" aria-label="Rechercher et filtrer les pages">
      <% if (state !== "toutes") { %><input type="hidden" name="etat" value="<%= state %>"><% } %>
      <label class="mk-search"><span class="sr-only">Rechercher une page (titre ou adresse)</span><%- icon("search", { size: 16 }) %><input type="search" name="q" value="<%= filters.q %>" placeholder="Rechercher par titre ou adresse"></label>
      <label class="sr-only" for="pg-site">Site</label>
      <select id="pg-site" name="site"><option value="">Tous les sites</option><option value="none"<%= filters.site === "none" ? " selected" : "" %>>Sans site</option><% sites.forEach((st) => { %><option value="<%= st.id %>"<%= String(st.id) === filters.site ? " selected" : "" %>><%= st.name %></option><% }) %></select>
      <% if (authors.length > 1) { %><label class="sr-only" for="pg-auteur">Auteur</label>
      <select id="pg-auteur" name="auteur"><option value="">Tous les auteurs</option><% authors.forEach((u) => { %><option value="<%= u.id %>"<%= String(u.id) === filters.auteur ? " selected" : "" %>><%= u.username %></option><% }) %></select><% } %>
      <label class="sr-only" for="pg-tri">Trier par</label>
      <select id="pg-tri" name="tri"><% [["modifiee", "Plus récemment modifiées"], ["titre", "Titre (A → Z)"], ["creee", "Plus récemment créées"], ["publiee", "Dernières publications"]].forEach(([k, label]) => { %><option value="<%= k %>"<%= filters.tri === k ? " selected" : "" %>><%= label %></option><% }) %></select>
      <button type="submit" class="btn btn-outline btn-sm">Filtrer</button><% if (filtered) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ q: "", site: "", auteur: "", page: "" }) %>">Réinitialiser</a><% } %>
    </form>
    <% if (!pages.length) { %>
      <div class="mk-empty"><%- icon("layout", { size: 32 }) %><h2><%= filtered ? "Aucune page trouvée" : inTrash ? "La corbeille est vide" : state === "publiees" ? "Aucune page publiée" : state === "brouillons" ? "Aucun brouillon" : "Aucune page" %></h2>
        <p><%= filtered ? "Aucune page ne correspond à ces critères." : inTrash ? "Les pages mises à la corbeille apparaissent ici ; vous pouvez les restaurer." : state === "toutes" ? "Créez votre première page pour commencer : elle s'ouvre dans l'éditeur visuel, et rien n'est en ligne avant la publication." : "Aucune page dans cet état." %></p>
        <% if (canWrite && !inTrash && !filtered && state === "toutes") { %><div class="mk-actions"><button type="button" class="btn btn-primary btn-sm" data-mk-modal-open="nouvelle">Nouvelle page</button></div><% } %></div>
    <% } else { %>
      <% if (canWrite) { %>
      <form id="pages-bulk" class="mk-cms-bulk" action="/marketing/pages/actions" method="post" data-cms-bulk>
        <input type="hidden" name="retour" value="<%= keep({ page: result.page > 1 ? result.page : "" }) %>">
        <label class="sr-only" for="pg-bulk">Action groupée</label>
        <select id="pg-bulk" name="action" disabled>
          <option value="">Actions groupées</option>
          <% if (inTrash) { %><option value="restaurer">Restaurer</option><% if (canDelete) { %><option value="supprimer">Supprimer définitivement</option><% } %>
          <% } else { %><% if (canPublish) { %><option value="publier">Publier</option><option value="depublier">Mettre hors ligne</option><% } %><option value="corbeille">Mettre à la corbeille</option><% } %>
        </select>
        <button type="submit" class="btn btn-outline btn-sm" disabled>Appliquer</button>
        <span class="mk-sub" data-cms-bulk-count aria-live="polite"></span>
      </form>
      <% } %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable mk-cms-table">
        <caption class="sr-only"><%= inTrash ? "Pages dans la corbeille" : "Pages" %></caption>
        <thead><tr><% if (canWrite) { %><th scope="col" class="mk-cms-check-col"><input type="checkbox" data-cms-select-all aria-label="Tout sélectionner"></th><% } %><th scope="col">Titre</th><th scope="col">État</th><th scope="col">Auteur</th><th scope="col">Site</th><th scope="col">Modifiée</th><th scope="col">Publiée</th><th scope="col" class="mk-cms-actions-col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% pages.forEach((p) => { const menuId = "pg-menu-" + p.id; const stClass = inTrash ? "mk-status-off" : STATUS_CLASS[p.status]; %>
          <tr><% if (canWrite) { %><td class="mk-cms-check-col" data-label="Sélection"><input type="checkbox" name="ids" value="<%= p.id %>" form="pages-bulk" data-cms-row aria-label="Sélectionner « <%= p.name %> »"></td><% } %>
            <th scope="row" data-label="Titre"><a href="/marketing/pages/<%= p.id %>"><%= p.name %></a>
              <span class="mk-sub">/p/<%= p.slug %><% if (p.parent_name) { %> · sous-page de « <%= p.parent_name %> »<% } %><% if (p.has_draft && !inTrash) { %> · modifications non publiées<% } %><% if (p.funnels && p.funnels.length) { %> · utilisée dans <%= p.funnels.length > 1 ? "les tunnels" : "le tunnel" %> « <%= p.funnels.join(" », « ") %> »<% } %></span></th>
            <td data-label="État"><span class="mk-status <%= stClass %>"><%= inTrash ? "Corbeille" : STATUSES[p.status] %></span></td>
            <td data-label="Auteur"><%= p.author || "—" %></td><td data-label="Site"><%= p.site_name || "—" %></td>
            <td data-label="Modifiée"><%= fmt(p.updated_at) %></td><td data-label="Publiée"><%= fmt(p.published_at) %></td>
            <td class="mk-row-actions mk-cms-actions-col"><div class="mk-cms-rowbtns">
              <% if (canWrite && !inTrash) { %><a class="btn btn-outline btn-sm" href="/marketing/pages/<%= p.id %>/editeur?retour=pages">Page Builder</a><% } %>
              <% if (canWrite && inTrash) { %><form class="mk-inline" action="/marketing/pages/<%= p.id %>/restaurer" method="post"><button type="submit" class="btn btn-outline btn-sm">Restaurer</button></form><% } %>
              <div class="mk-dropdown" data-mk-dropdown>
                <button type="button" class="btn btn-ghost btn-sm mk-cms-more" aria-haspopup="menu" aria-expanded="false" aria-controls="<%= menuId %>" aria-label="Plus d'actions pour « <%= p.name %> »"><%- icon("moreHorizontal", { size: 18 }) %></button>
                <div class="mk-menu" id="<%= menuId %>" role="menu" hidden>
                  <a role="menuitem" href="/marketing/pages/<%= p.id %>">Modifier les réglages</a>
                  <% if (mk.can("revisions.view")) { %><a role="menuitem" href="/marketing/site-web/historique/page/<%= p.id %>">Historique</a><% } %>
                  <% if (!inTrash) { %><a role="menuitem" href="/marketing/pages/<%= p.id %>/apercu" target="_blank" rel="noopener">Prévisualiser</a><% } %>
                  <% if (!inTrash && p.status === "published") { %><a role="menuitem" href="/p/<%= p.slug %>" target="_blank" rel="noopener">Voir la page en ligne</a><% } %>
                  <% if (canWrite && !inTrash) { %>
                    <% if (canPublish && p.status !== "published") { %><form action="/marketing/pages/<%= p.id %>/publier" method="post" role="none"><button type="submit" role="menuitem">Publier</button></form><% } %>
                    <% if (canPublish && p.status === "published") { %><form action="/marketing/pages/<%= p.id %>/depublier" method="post" role="none"><button type="submit" role="menuitem">Mettre hors ligne</button></form><% } %>
                    <form action="/marketing/pages/<%= p.id %>/dupliquer" method="post" role="none"><button type="submit" role="menuitem">Dupliquer</button></form>
                    <form action="/marketing/pages/<%= p.id %>/archiver" method="post" role="none"><button type="submit" role="menuitem" data-mk-confirm="La page « <%= p.name %> » passera hors ligne et ira à la corbeille. Vous pourrez la restaurer.">Mettre à la corbeille</button></form>
                  <% } %>
                  <% if (inTrash && canDelete) { %><form action="/marketing/pages/<%= p.id %>/supprimer" method="post" role="none"><button type="submit" role="menuitem" data-mk-confirm="« <%= p.name %> » sera supprimée définitivement, avec ses statistiques et ses versions. Cette action est irréversible.">Supprimer définitivement</button></form><% } %>
                </div>
              </div>
            </div></td></tr>
        <% }) %></tbody>
      </table></div>
      <nav class="mk-cms-pager" aria-label="Pagination">
        <span><%= result.total %> page<%= result.total > 1 ? "s" : "" %></span>
        <% if (result.pages > 1) { %><span class="mk-cms-pager-nav">
          <% if (result.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: result.page - 1 }) %>">Précédent</a><% } %>
          <span>Page <%= result.page %> sur <%= result.pages %></span>
          <% if (result.page < result.pages) { %><a class="btn btn-ghost btn-sm" href="<%= keep({ page: result.page + 1 }) %>">Suivant</a><% } %></span><% } %>
      </nav>
    <% } %>
    <% if (canWrite) { %>
      <dialog class="mk-dialog mk-modal" id="nouvelle" data-mk-modal data-mk-modal-hash="nouvelle" aria-labelledby="lp-new-title">
        <form action="/marketing/pages" method="post"><input type="hidden" name="ouvrir" value="editeur">
          <header class="mk-dialog-head"><div class="mk-dialog-titles"><h2 id="lp-new-title">Nouvelle page</h2><p class="mk-dialog-desc">Un nom pour vous retrouver ; vous composerez la page ensuite. Rien n'est mis en ligne avant la publication.</p></div>
            <button type="button" class="mk-dialog-close" data-mk-modal-close aria-label="Fermer"><%- icon("close", { size: 18 }) %></button></header>
          <div class="mk-dialog-body"><div class="field-group"><label for="lp-name">Nom de la page *</label><input id="lp-name" type="text" name="name" maxlength="100" required placeholder="Guide gratuit : bien débuter en photo"></div>
            <fieldset class="mk-tpl-choice"><legend>Modèle de départ</legend>
              <label class="mk-tpl"><input type="radio" name="template" value="" checked><span><strong>Page vierge</strong><span class="mk-sub">Point de départ minimal, à composer dans l'éditeur visuel.</span></span></label>
              <% userTemplates.forEach((t) => { %><label class="mk-tpl"><input type="radio" name="template" value="mine:<%= t.id %>"><span><strong><%= t.name %></strong><span class="mk-sub">Mes modèles · <%= t.category %><%= t.description ? " · " + t.description : "" %></span></span></label><% }) %>
              <% templates.forEach((t) => { %><label class="mk-tpl"><input type="radio" name="template" value="<%= t.key %>"><span><strong><%= t.name %></strong><span class="mk-sub"><%= t.category %> · <%= t.description %></span></span></label><% }) %>
            </fieldset>
            <% if (sites.length) { %><div class="field-group"><label for="lp-new-site">Site</label><select id="lp-new-site" name="site_id"><option value="">Aucun (page d'atterrissage isolée)</option><% sites.forEach((st) => { %><option value="<%= st.id %>"><%= st.name %></option><% }) %></select></div><% } %></div>
          <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-mk-modal-close>Annuler</button><button type="submit" class="btn btn-primary btn-sm">Créer et ouvrir l’éditeur</button></div>
        </form>
      </dialog>
      <%- include("partials/modal-reopen", { id: "nouvelle" }) %>
    <% } %>
    <% if (userTemplates.length) { %>
      <section class="mk-panel" id="mes-modeles" aria-labelledby="lp-mine">
        <h2 id="lp-mine">Mes modèles de pages</h2>
        <p class="field-hint">Enregistrés depuis l'éditeur (menu ≡ › « Enregistrer comme modèle »), proposés dans « Nouvelle page ». Supprimer un modèle ne change pas les pages déjà créées avec lui.</p>
        <ul class="mk-lp-versions"><% userTemplates.forEach((t) => { %><li><span><strong><%= t.name %></strong> <span class="mk-sub"><%= t.category %> · <%= t.content.sections.length %> section(s)</span></span>
          <% if (canWrite) { %><span class="mk-row-actions"><form action="/marketing/site-web/modeles/<%= t.id %>/supprimer" method="post"><button type="submit" class="btn btn-ghost btn-sm" data-mk-confirm="Le modèle « <%= t.name %> » ne sera plus proposé. Les pages déjà créées avec lui ne changent pas." data-mk-confirm-title="Supprimer ce modèle ?" data-mk-confirm-ok="Supprimer">Supprimer<span class="sr-only"> le modèle <%= t.name %></span></button></form></span><% } %></li><% }) %></ul>
      </section>
    <% } %>
<%- include("partials/bottom") %>
