<%- include("partials/top", { title, active }) %>
<% const canWrite = mk.can("templates.write"); %>
    <p class="mk-back"><a href="/marketing/modeles">← Modèles</a></p>
    <div class="mk-head"><h1>Bibliothèque de modèles</h1></div>
    <p class="mk-lead">Des points de départ à personnaliser dans l'éditeur par blocs. Les aperçus utilisent des données d'exemple ; les adresses « exemple.fr » sont à remplacer par les vôtres.</p>

    <nav class="mk-tabs" aria-label="Catégories de la bibliothèque">
      <% groups.forEach((g) => { %><a class="mk-tab" href="#cat-<%= g.category.key %>"><%= g.category.label %> <span class="mk-tab-count"><%= g.starters.length %></span></a>
      <% }) %>
    </nav>

    <% groups.forEach((g) => { %>
      <section class="mk-lib-section" id="cat-<%= g.category.key %>" aria-labelledby="h-<%= g.category.key %>">
        <h2 id="h-<%= g.category.key %>" class="mk-h2"><%= g.category.label %></h2>
        <div class="mk-lib-grid">
          <% g.starters.forEach((s) => { %>
            <article class="mk-lib-card">
              <div class="mk-lib-preview"><iframe class="mk-lib-frame" src="/marketing/modeles/bibliotheque/<%= s.key %>/apercu" sandbox="" loading="lazy" tabindex="-1" title="Aperçu : <%= s.label %>"></iframe></div>
              <div class="mk-lib-body">
                <h3><%= s.label %></h3>
                <p class="field-hint"><%= s.description %></p>
                <p class="mk-lib-meta"><span class="mk-status <%= s.kind === "transactional" ? "mk-status-info" : "" %>"><%= kindLabel[s.kind] %></span> <span class="field-hint"><%= s.blockTypes.length %> blocs</span></p>
                <% if (canWrite) { %>
                  <form action="/marketing/modeles" method="post" class="mk-lib-form">
                    <input type="hidden" name="starter" value="<%= s.key %>">
                    <input type="hidden" name="kind" value="<%= s.kind %>">
                    <label for="n-<%= s.key %>" class="sr-only">Nom du nouveau modèle « <%= s.label %> »</label>
                    <input id="n-<%= s.key %>" type="text" name="name" maxlength="100" required value="<%= s.label %>">
                    <button type="submit" class="btn btn-primary btn-sm">Utiliser ce modèle</button>
                  </form>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>
<%- include("partials/bottom") %>
