<%- include("partials/top", { title, active }) %>
    <p class="mk-back"><a href="/marketing/automatisations">← Automatisations</a></p>
    <div class="mk-head"><h1>Historique des passages <span class="mk-count"><%= mkh.fmt(result.total) %></span></h1></div>
    <p class="mk-lead">Chaque ligne est un contact entré dans un scénario. Tout vient de la base : états, dates, erreurs. Un contact n'entre qu'une fois dans un même scénario.</p>
    <form class="mk-filterbar" method="get" action="/marketing/automatisations/historique" role="search">
      <div class="field-group"><label for="h-scenario">Scénario</label>
        <select id="h-scenario" name="scenario"><option value="">Tous</option><% automations.forEach((a) => { %><option value="<%= a.id %>" <%= f.automation === a.id ? "selected" : "" %>><%= a.name %></option><% }) %></select></div>
      <div class="field-group"><label for="h-etat">État</label>
        <select id="h-etat" name="etat"><option value="">Tous</option><% Object.entries(STATUS_LABELS).forEach(([k, label]) => { %><option value="<%= k %>" <%= f.status === k ? "selected" : "" %>><%= label %></option><% }) %></select></div>
      <div class="field-group"><label for="h-q">Contact</label><input id="h-q" type="search" name="q" value="<%= f.q %>" maxlength="100" placeholder="E-mail ou nom"></div>
      <div class="field-group"><label for="h-du">Entrés du</label><input id="h-du" type="date" name="du" value="<%= f.from %>"></div>
      <div class="field-group"><label for="h-au">au</label><input id="h-au" type="date" name="au" value="<%= f.to %>"></div>
      <label class="checkbox-row mk-filter-check" for="h-err"><input id="h-err" type="checkbox" name="erreurs" value="1" <%= f.onlyErrors ? "checked" : "" %>> Avec une erreur</label>
      <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
      <a href="/marketing/automatisations/historique" class="btn btn-ghost btn-sm">Réinitialiser</a>
    </form>
    <% if (!rows.length) { %>
      <div class="mk-empty"><%- icon("zap", { size: 32 }) %><h2>Aucun passage</h2><p>Aucun contact n'est encore entré dans un scénario avec ces critères.</p></div>
    <% } else { %>
      <div class="mk-table-wrap"><table class="mk-table mk-datatable">
        <caption class="sr-only">Passages des contacts dans les scénarios</caption>
        <thead><tr><th scope="col">Scénario</th><th scope="col">Contact</th><th scope="col">État</th><th scope="col">Prochaine étape</th><th scope="col">Entré le</th><th scope="col">Terminé le</th><th scope="col">Erreur</th></tr></thead>
        <tbody><% rows.forEach((r) => { %>
          <tr>
            <td data-label="Scénario"><a href="/marketing/automatisations/<%= r.automationId %>/passages/<%= r.id %>"><%= r.automation %></a> <span class="field-hint">v<%= r.version || 1 %></span></td>
            <td data-label="Contact" class="mk-cell-email"><a href="/marketing/contacts/<%= r.contactId %>"><%= r.contact.email %></a></td>
            <td data-label="État"><%= r.state === "waiting" ? "En attente" : r.state === "due" ? "À exécuter" : r.statusLabel %></td>
            <td data-label="Prochaine étape"><%= r.nextStep ? r.nextStep + (r.nextAt && r.state === "waiting" ? " — " + mkh.fdatetime(new Date(r.nextAt).toISOString().replace("T", " ").slice(0, 19)) : "") : "—" %></td>
            <td data-label="Entré le"><%= mkh.fdate(new Date(r.enteredAt).toISOString()) %></td>
            <td data-label="Terminé le"><%= r.finishedAt ? mkh.fdate(new Date(r.finishedAt).toISOString()) : "—" %></td>
            <td data-label="Erreur"><%= r.error || "—" %></td>
          </tr>
        <% }) %></tbody>
      </table></div>
      <div class="mk-pager"><span>Page <%= result.page %> sur <%= result.pages %></span>
        <% if (result.pages > 1) { %><nav class="mk-pager-links" aria-label="Pagination">
          <% if (result.page > 1) { %><a href="<%= qs({ page: result.page - 1 }) %>" rel="prev">Précédent</a><% } %>
          <% if (result.page < result.pages) { %><a href="<%= qs({ page: result.page + 1 }) %>" rel="next">Suivant</a><% } %>
        </nav><% } %></div>
    <% } %>
<%- include("partials/bottom") %>
