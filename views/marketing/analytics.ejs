<%- include("partials/top", { title, active }) %>
<%
  const o = overview;
  const c = o.counts, r = o.rates;
  const url = (days) => `/marketing/analytics?periode=${days}`;
  const periodLabel = { 7: "7 derniers jours", 30: "30 derniers jours", 90: "90 derniers jours" };
%>
    <div class="mk-head">
      <div class="mk-head-main"><h1>Analytics</h1><p class="mk-head-sub">Vos envois marketing, toutes campagnes confondues, sur la période choisie. Les chiffres viennent du journal des événements : ils ne dépendent pas d'une campagne encore en cours.</p></div></div>

    <nav class="mk-tabs" aria-label="Période">
      <% o.period.options.forEach((d) => { %><a class="mk-tab" href="<%= url(d) %>"<%- o.period.days === d ? ' aria-current="page"' : "" %>><%= periodLabel[d] %></a><% }) %>
    </nav>

    <% if (c.sent === 0) { %>
      <div class="mk-empty">
        <%- icon("activity", { size: 32 }) %>
        <h2>Aucun envoi sur cette période</h2>
        <p>Lancez une campagne ou activez un scénario pour voir apparaître ici les taux d'ouverture, de clic et de rebond.</p>
        <% if (mk.can("campaigns.write")) { %><div class="mk-actions"><a class="btn btn-primary btn-sm" href="/marketing/campagnes/nouvelle">Créer une campagne</a></div><% } %>
      </div>
    <% } else { %>
      <div class="mk-stats mk-stats-3">
        <div class="mk-stat"><span class="mk-stat-label">Envoyés</span><span class="mk-stat-value"><%= mkh.fmt(c.sent) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.delivered) %> délivré<%= c.delivered > 1 ? "s" : "" %> (<%= mkh.rate(r.delivery) %>)</span></div>
        <div class="mk-stat"><span class="mk-stat-label">Taux d'ouverture</span><span class="mk-stat-value"><%= mkh.rate(r.open) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.uniqueOpens) %> ouverture<%= c.uniqueOpens > 1 ? "s" : "" %> unique<%= c.uniqueOpens > 1 ? "s" : "" %> — indicatif</span></div>
        <div class="mk-stat"><span class="mk-stat-label">Taux de clic</span><span class="mk-stat-value"><%= mkh.rate(r.click) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.uniqueClicks) %> clic<%= c.uniqueClicks > 1 ? "s" : "" %> unique<%= c.uniqueClicks > 1 ? "s" : "" %></span></div>
        <div class="mk-stat"><span class="mk-stat-label">Taux de rebond</span><span class="mk-stat-value"><%= mkh.rate(r.bounce) %></span><% if (o.flags.highBounce) { %><span class="mk-status mk-status-warn">Au-dessus du seuil habituel (2 %)</span><% } else { %><span class="mk-stat-hint"><%= mkh.fmt(c.bounced) %> rebond<%= c.bounced > 1 ? "s" : "" %></span><% } %></div>
        <div class="mk-stat"><span class="mk-stat-label">Taux de plainte</span><span class="mk-stat-value"><%= mkh.rate(r.complaint) %></span><% if (o.flags.highComplaint) { %><span class="mk-status mk-status-warn">Au-dessus du seuil habituel (0,1 %)</span><% } else { %><span class="mk-stat-hint"><%= mkh.fmt(c.complained) %> plainte<%= c.complained > 1 ? "s" : "" %></span><% } %></div>
        <div class="mk-stat"><span class="mk-stat-label">Désinscriptions</span><span class="mk-stat-value"><%= mkh.rate(r.unsubscribe) %></span><span class="mk-stat-hint"><%= mkh.fmt(c.unsubscribed) %> sur la période</span></div>
      </div>

      <section class="mk-panel" aria-labelledby="trend-title">
        <h2 id="trend-title">Envois dans le temps</h2>
        <%- mkh.columnChart(o.trend, { title: `E-mails envoyés (${periodLabel[o.period.days]})`, unit: " e-mail(s) envoyé(s)" }) %>
        <p class="field-hint"><%= o.period.days > 30 ? "Une colonne par semaine glissante" : "Une colonne par jour" %>, la plus récente à droite. Sur ordinateur, survolez une colonne pour voir son nombre exact.</p>
      </section>

        <section class="mk-panel" aria-labelledby="camp-title">
          <h2 id="camp-title">Campagnes de la période</h2>
          <% if (!o.campaigns.items.length) { %>
            <p class="field-hint">Aucune campagne terminée sur cette période.</p>
          <% } else { %>
            <div class="mk-table-wrap">
              <table class="mk-table mk-datatable">
                <caption class="sr-only">Campagnes terminées sur la période, les plus récentes d'abord</caption>
                <thead><tr><th scope="col">Campagne</th><th scope="col" class="mk-num">Envoyés</th><th scope="col" class="mk-num">Ouvertures</th><th scope="col" class="mk-num">Clics</th><th scope="col" class="mk-num">Rebonds</th></tr></thead>
                <tbody>
                  <% o.campaigns.items.forEach((k) => { %>
                    <tr>
                      <td data-label="Campagne"><% if (mk.can("campaigns.read")) { %><a href="/marketing/campagnes/<%= k.id %>"><%= k.name %></a><% } else { %><%= k.name %><% } %></td>
                      <td class="mk-num" data-label="Envoyés"><%= mkh.fmt(k.sent) %></td>
                      <td class="mk-num" data-label="Ouvertures"><%= mkh.rate(k.openRate) %></td>
                      <td class="mk-num" data-label="Clics"><%= mkh.rate(k.clickRate) %></td>
                      <td class="mk-num" data-label="Rebonds"><%= mkh.rate(k.bounceRate) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (o.campaigns.truncated) { %><p class="field-hint">Liste limitée aux 50 campagnes les plus récentes de la période.</p><% } %>
          <% } %>
          <% if (mk.can("campaigns.read")) { %><p class="mk-more"><a href="/marketing/campagnes">Toutes les campagnes</a></p><% } %>
        </section>

        <section class="mk-panel" aria-labelledby="links-title">
          <h2 id="links-title">Liens les plus cliqués</h2>
          <% if (!o.links.length) { %>
            <p class="field-hint">Aucun clic suivi sur cette période.</p>
          <% } else { %>
            <ul class="mk-breakdown">
              <% o.links.forEach((l) => { %>
                <li><span class="mk-link-url"><%= l.url %></span> <strong><%= mkh.fmt(l.uniqueClicks) %></strong></li>
              <% }) %>
            </ul>
          <% } %>
        </section>
    <% } %>

    <p class="field-hint"><% o.notes.forEach((n) => { %><%= n %> <% }) %></p>
<%- include("partials/bottom") %>
