<%- include("partials/top", { title, active }) %>
<% const archived = site.status === "archived" || Boolean(site.deleted_at); const dis = canWrite && !archived ? "" : " disabled"; const t = site.tokens; const STATUS = { draft: "Brouillon", published: "En ligne", unpublished: "Hors ligne" }; const STATUS_CLASS = { draft: "", published: "mk-status-ok", unpublished: "mk-status-warn" }; %>
    <div class="mk-head"><div class="mk-builder-title"><h1><%= site.name %></h1><% if (site.deleted_at) { %><span class="mk-status mk-status-warn">Supprimé</span><% } else if (archived) { %><span class="mk-status mk-status-warn">Archivé</span><% } %></div>
      <% if (canWrite) { %><div class="mk-actions">
        <% if (!mk.ctx.siteScope && mk.can("sites.modules")) { %><a class="btn btn-outline btn-sm" href="/marketing/site-web/sites/<%= site.id %>/modules">Modules</a><% } %>
        <% if (site.deleted_at) { %><form action="/marketing/site-web/sites/<%= site.id %>/recuperer" method="post"><button type="submit" class="btn btn-primary btn-sm">Récupérer le site</button></form>
        <% } else if (archived) { %><form action="/marketing/site-web/sites/<%= site.id %>/restaurer" method="post"><button type="submit" class="btn btn-primary btn-sm">Restaurer le site</button></form>
        <% } else { %>
          <form action="/marketing/site-web/sites/<%= site.id %>/dupliquer" method="post" class="mk-actions"><select name="contenu" aria-label="Contenu à copier"><option value="pages">Réglages + pages (brouillons)</option><option value="configuration">Réglages seulement</option></select><button type="submit" class="btn btn-outline btn-sm">Dupliquer</button></form>
          <form action="/marketing/site-web/sites/<%= site.id %>/archiver" method="post"><button type="submit" class="btn btn-outline btn-sm" data-mk-confirm="Les pages en ligne du site passent hors ligne. Rien n'est effacé : vous pourrez restaurer le site, puis republier ses pages." data-mk-confirm-title="Archiver ce site ?" data-mk-confirm-ok="Archiver">Archiver</button></form>
        <% } %>
      </div><% } %>
    </div>

    <div class="mk-grid-2">
      <section class="mk-panel" aria-labelledby="site-settings">
        <h2 id="site-settings">Réglages</h2>
        <form action="/marketing/site-web/sites/<%= site.id %>" method="post" class="mk-form">
          <div class="field-group"><label for="site-name">Nom du site</label><input id="site-name" type="text" name="name" maxlength="100" required value="<%= site.name %>"<%= dis %>></div>
          <div class="field-group"><label for="site-slug">Identifiant lisible</label><input id="site-slug" type="text" name="slug" maxlength="60" pattern="[a-z0-9]+(-[a-z0-9]+)*" required value="<%= site.slug %>"<%= dis %>><p class="field-hint">Lettres minuscules, chiffres et tirets. L'identifiant interne (n° <%= site.id %>) ne change jamais, même si vous renommez le site.</p></div>
          <div class="field-group"><label for="site-desc">Description</label><textarea id="site-desc" name="description" rows="2" maxlength="500"<%= dis %>><%= site.description %></textarea></div>
          <div class="field-group"><label for="site-type">Type de site</label><select id="site-type" name="site_type"<%= dis %>><% Object.entries(siteTypes).forEach(([k, label]) => { %><option value="<%= k %>"<%= site.site_type === k ? " selected" : "" %>><%= label %></option><% }) %></select></div>
          <div class="field-group"><label for="site-home">Page d'accueil</label>
            <select id="site-home" name="home_page_id"<%= dis %>><option value="">Aucune</option><% sitePages.forEach((p) => { %><option value="<%= p.id %>"<%= site.home_page_id === p.id ? " selected" : "" %>><%= p.name %></option><% }) %></select></div>
          <p class="field-hint">Adresse des pages : <code>/p/…</code> sur le domaine du site KOLAKISA. Domaine personnalisé : pas encore disponible (il demande une configuration chez l'hébergeur et sera ajouté dans une prochaine étape).</p>
          <% if (canWrite && !archived) { %><div class="mk-actions"><button type="submit" class="btn btn-primary btn-sm">Enregistrer</button></div><% } %>
        </form>
      </section>

      <section class="mk-panel" aria-labelledby="site-pages">
        <h2 id="site-pages">Pages du site</h2>
        <% if (!sitePages.length) { %><p class="field-hint">Aucune page dans ce site.</p><% } else { %>
          <ul class="mk-sw-recent">
            <% sitePages.forEach((p) => { %><li><a href="/marketing/pages/<%= p.id %>"><%= p.name %></a><% if (site.home_page_id === p.id) { %> <span class="mk-status">Accueil</span><% } %>
              <span class="mk-sub"><span class="mk-status <%= STATUS_CLASS[p.status] %>"><%= STATUS[p.status] %></span> /p/<%= p.slug %><%= p.has_draft ? " · modifications non publiées" : "" %> · <%= mkh.fmt(p.visitors) %> visiteur(s) · <%= mkh.fmt(p.signups) %> inscription(s)</span></li><% }) %>
          </ul>
        <% } %>
        <% if (canWrite && !archived) { %>
          <p><a class="btn btn-outline btn-sm" href="/marketing/site-web/sites/<%= site.id %>/pages#nouvelle">Nouvelle page dans ce site</a></p>
          <p class="field-hint">Une page existante se rattache au site depuis ses réglages (champ « Site »).</p>
        <% } %>
      </section>
    </div>

    <%# ---------- En-tête du site : état réel, pages concernées, exceptions, variantes ---------- %>
    <% const H = headerOverview; const stLabel = (st) => (st === "published" ? "En ligne" : st === "unpublished" ? "Hors ligne" : "Brouillon"); %>
    <section class="mk-panel" id="entete" aria-labelledby="site-entete">
      <h2 id="site-entete">En-tête du site</h2>
      <% if (!H.header) { %>
        <p class="mk-lead">Ce site n'a pas encore d'en-tête. Un en-tête s'affiche en haut de <strong>toutes</strong> les pages du site ; certaines pages peuvent ensuite faire exception.</p>
        <% if (canWrite) { %><form action="/marketing/site-web/sites/<%= site.id %>/entete/creer" method="post"><button type="submit" class="btn btn-primary btn-sm">Créer un en-tête</button></form>
        <p class="field-hint">Ou choisissez un composant déjà enregistré dans « En-tête et pied de page », plus bas.</p><% } %>
      <% } else { %>
        <dl class="mk-facts" data-header-facts>
          <div><dt>En-tête</dt><dd data-header-name><%= H.header.name %></dd></div>
          <div><dt>Statut</dt><dd data-header-status><%= H.status === "published" ? "Publié" : "Aucun" %></dd></div>
          <div><dt>Type</dt><dd data-header-type><%= H.type === "global" ? "Global" : "" %></dd></div>
          <div><dt>Utilisé par</dt><dd data-header-count><%= H.using.length %> page<%= H.using.length > 1 ? "s" : "" %> sur <%= H.total %></dd></div>
        </dl>
        <p class="field-hint">Un en-tête est un composant synchronisé : le modifier le met à jour sur toutes les pages qui l'utilisent, tout de suite.</p>
        <p><% if (canWrite) { %><a class="btn btn-primary btn-sm" href="/marketing/site-web/composants/<%= H.header.id %>/editeur" data-header-edit>Modifier l'en-tête</a><% } %></p>

        <% const choiceCell = (p, current) => { %>
          <form action="/marketing/site-web/sites/<%= site.id %>/entete/pages/<%= p.id %>" method="post" class="mk-inline-form">
            <label class="sr-only" for="h-<%= p.id %>">En-tête de la page « <%= p.name %> »</label>
            <select id="h-<%= p.id %>" name="choice"<%= canWrite ? "" : " disabled" %>>
              <option value="inherit"<%= current === "inherit" ? " selected" : "" %>>En-tête du site</option>
              <option value="none"<%= current === "none" ? " selected" : "" %>>Aucun en-tête</option>
              <% H.variants.forEach((v) => { %><option value="variant:<%= v.id %>"<%= current === "variant:" + v.id ? " selected" : "" %>>Variante : <%= v.name %></option><% }) %>
            </select>
            <% if (canWrite) { %><button type="submit" class="btn btn-outline btn-sm">Appliquer</button><% } %>
          </form>
        <% }; %>

        <h3>Pages utilisant cet en-tête</h3>
        <% if (!H.using.length) { %><p class="field-hint">Aucune page : toutes les pages du site font exception, ou le site n'a pas encore de page.</p><% } else { %>
        <div class="mk-table-wrap"><table class="mk-table" data-header-using>
          <thead><tr><th scope="col">Page</th><th scope="col">État de la page</th><th scope="col">En-tête</th></tr></thead>
          <tbody><% H.using.forEach((p) => { %><tr><td><span aria-hidden="true">✓</span> <a href="/marketing/pages/<%= p.id %>"><%= p.name %></a></td><td><%= stLabel(p.status) %></td><td><% choiceCell(p, "inherit") %></td></tr><% }) %></tbody>
        </table></div><% } %>

        <h3>Exceptions</h3>
        <% if (!H.exceptions.length) { %><p class="field-hint">Aucune exception : toutes les pages du site affichent l'en-tête du site. Choisissez « Aucun en-tête » ou une variante pour une page (tunnel, page de campagne…) dans la liste ci-dessus.</p><% } else { %>
        <div class="mk-table-wrap"><table class="mk-table" data-header-exceptions>
          <thead><tr><th scope="col">Page</th><th scope="col">En-tête</th><th scope="col">Changer</th></tr></thead>
          <tbody><% H.exceptions.forEach((p) => { %><tr><td>• <a href="/marketing/pages/<%= p.id %>"><%= p.name %></a></td><td><%= p.mode === "none" ? "Aucun en-tête" : "Variante : " + p.variant.name %></td><td><% choiceCell(p, p.mode === "none" ? "none" : "variant:" + p.variant.id) %></td></tr><% }) %></tbody>
        </table></div><% } %>

        <h3>Variantes</h3>
        <% if (!H.variants.length) { %><p class="field-hint">Une variante est une copie de l'en-tête que vous pouvez modifier sans toucher à l'en-tête du site, puis affecter à certaines pages.</p><% } else { %>
        <ul class="mk-list" data-header-variants><% H.variants.forEach((v) => { %><li><%= v.name %> — <%= v.pages %> page<%= v.pages > 1 ? "s" : "" %><% if (canWrite) { %> · <a href="/marketing/site-web/composants/<%= v.id %>/editeur">Modifier</a><% } %></li><% }) %></ul><% } %>
        <% if (canWrite) { %><form action="/marketing/site-web/sites/<%= site.id %>/entete/variante" method="post" class="mk-inline-form"><button type="submit" class="btn btn-outline btn-sm">Créer une variante</button></form><% } %>
      <% } %>
    </section>

    <section class="mk-panel" id="parties" aria-labelledby="site-parts">
      <h2 id="site-parts">En-tête et pied de page</h2>
      <p class="field-hint">Un composant réutilisable (enregistré depuis l'éditeur : inspecteur › Avancé › « Enregistrer comme composant ») affiché en haut ou en bas de <strong>toutes</strong> les pages de ce site. Le modifier dans une page qui l'utilise le met à jour partout.</p>
      <% if (!components.length) { %><p class="field-hint">Aucun composant pour l'instant : créez par exemple une section avec un menu, puis enregistrez-la comme composant.</p><% } else { %>
      <form action="/marketing/site-web/sites/<%= site.id %>/parties" method="post" class="mk-form-row">
        <div class="field-group"><label for="site-header">En-tête du site</label><select id="site-header" name="header"<%= canWrite ? "" : " disabled" %>><option value="">Aucun</option><% components.forEach((c) => { %><option value="<%= c.id %>"<%= site.header_component_id === c.id ? " selected" : "" %>><%= c.name %><%= c.global ? " (global)" : "" %></option><% }) %></select></div>
        <div class="field-group"><label for="site-footer">Pied de page du site</label><select id="site-footer" name="footer"<%= canWrite ? "" : " disabled" %>><option value="">Aucun</option><% components.forEach((c) => { %><option value="<%= c.id %>"<%= site.footer_component_id === c.id ? " selected" : "" %>><%= c.name %><%= c.global ? " (global)" : "" %></option><% }) %></select></div>
        <% if (canWrite) { %><button type="submit" class="btn btn-primary btn-sm">Enregistrer</button><% } %>
      </form><% } %>
    </section>

    <section class="mk-panel" id="design" aria-labelledby="site-design">
      <h2 id="site-design">Design system</h2>
      <p class="mk-lead">Ces réglages s'appliquent à toutes les pages du site, y compris celles déjà en ligne : modifiez une couleur ici, elle change partout.</p>
      <form action="/marketing/site-web/sites/<%= site.id %>/design" method="post" class="mk-form">
        <fieldset class="mk-sd-group"><legend>Couleurs</legend>
          <div class="mk-sd-colors">
            <% T.COLOR_KEYS.forEach((k) => { %><div class="field-group"><label for="c-<%= k %>"><%= T.COLOR_LABELS[k] %></label><input id="c-<%= k %>" type="color" name="color_<%= k %>" value="<%= t.colors[k] %>"<%= dis %>></div><% }) %>
          </div>
        </fieldset>
        <fieldset class="mk-sd-group"><legend>Typographies</legend>
          <div class="field-row">
            <% [["heading", "Police des titres"], ["body", "Police du texte"]].forEach(([k, label]) => { %><div class="field-group"><label for="f-<%= k %>"><%= label %></label><select id="f-<%= k %>" name="font_<%= k %>"<%= dis %>><% Object.entries(T.FONTS).forEach(([key, f]) => { %><option value="<%= key %>"<%= t.fonts[k] === key ? " selected" : "" %>><%= f.label %></option><% }) %><% if (!Object.hasOwn(T.FONTS, t.fonts[k])) { %><option value="<%= t.fonts[k] %>" selected><%= String(t.fonts[k]).replace(/^font\./, "").replace(/-/g, " ") %></option><% } %></select></div><% }) %>
          </div>
          <div class="mk-table-wrap"><table class="mk-table mk-sd-type">
            <caption class="sr-only">Taille et graisse de chaque style de texte</caption>
            <thead><tr><th scope="col">Style</th><th scope="col">Taille (px)</th><th scope="col">Graisse</th></tr></thead>
            <tbody><% T.TYPE_KEYS.forEach((k) => { %><tr><th scope="row"><%= T.TYPE_LABELS[k] %></th>
              <td><label class="sr-only" for="ts-<%= k %>">Taille du style <%= T.TYPE_LABELS[k] %></label><input id="ts-<%= k %>" type="number" name="type_<%= k %>_size" min="10" max="96" value="<%= t.type[k].size %>"<%= dis %>></td>
              <td><label class="sr-only" for="tw-<%= k %>">Graisse du style <%= T.TYPE_LABELS[k] %></label><select id="tw-<%= k %>" name="type_<%= k %>_weight"<%= dis %>><% [400, 500, 600, 700, 800].forEach((w) => { %><option value="<%= w %>"<%= t.type[k].weight === w ? " selected" : "" %>><%= w %></option><% }) %></select></td></tr><% }) %></tbody>
          </table></div>
        </fieldset>
        <fieldset class="mk-sd-group"><legend>Espacements (px)</legend>
          <div class="mk-sd-colors"><% T.SPACE_KEYS.forEach((k) => { %><div class="field-group"><label for="sp-<%= k %>"><%= k.toUpperCase() %></label><input id="sp-<%= k %>" type="number" name="space_<%= k %>" min="0" max="200" value="<%= t.space[k] %>"<%= dis %>></div><% }) %></div>
        </fieldset>
        <fieldset class="mk-sd-group"><legend>Rayons (px) et ombres</legend>
          <div class="mk-sd-colors">
            <% [["sm", "Petit"], ["md", "Moyen"], ["lg", "Grand"], ["button", "Boutons"], ["field", "Champs"], ["card", "Cartes"]].forEach(([k, label]) => { %><div class="field-group"><label for="r-<%= k %>"><%= label %></label><input id="r-<%= k %>" type="number" name="radius_<%= k %>" min="0" max="48" value="<%= t.radius[k] %>"<%= dis %>></div><% }) %>
            <% [["card", "Ombre des cartes"], ["button", "Ombre des boutons"]].forEach(([k, label]) => { %><div class="field-group"><label for="sh-<%= k %>"><%= label %></label><select id="sh-<%= k %>" name="shadow_<%= k %>"<%= dis %>><% [["none", "Aucune"], ["sm", "Légère"], ["md", "Moyenne"], ["lg", "Forte"]].forEach(([v, l]) => { %><option value="<%= v %>"<%= t.shadow[k] === v ? " selected" : "" %>><%= l %></option><% }) %></select></div><% }) %>
          </div>
        </fieldset>
        <% if (canWrite && !archived) { %><div class="mk-actions">
          <button type="submit" class="btn btn-primary btn-sm">Enregistrer le design system</button>
          <button type="submit" name="reset" value="1" class="btn btn-ghost btn-sm" data-mk-confirm="Toutes les valeurs reviennent à celles de KOLAKISA, sur toutes les pages du site." data-mk-confirm-title="Revenir aux valeurs par défaut ?" data-mk-confirm-ok="Réinitialiser">Valeurs par défaut</button>
        </div><% } %>
      </form>

      <h3 class="mk-journey-sub">Aperçu avec les valeurs enregistrées</h3>
      <div class="mk-sd-preview" style="<%= cssVars %>">
        <p class="mk-sd-h1">Titre de page</p>
        <p class="mk-sd-h2">Intertitre de section</p>
        <p class="mk-sd-body">Texte courant de vos pages : il utilise la police, la taille et l'interligne choisis ci-dessus.</p>
        <div class="mk-sd-card"><p class="mk-sd-h3">Carte</p><p class="mk-sd-caption">Légende : rayon, bordure et ombre des cartes.</p><span class="mk-sd-btn">Bouton principal</span></div>
      </div>
    </section>
    <% if (canWrite && canDelete && archived && !site.deleted_at) { %>
    <section class="mk-panel" id="zone-sensible" aria-labelledby="site-danger">
      <h2 id="site-danger">Supprimer ce site</h2>
      <p class="field-hint">Le site disparaît de vos listes mais reste récupérable dans <em>Mes sites → Supprimés</em> : ses pages et ses accès ne sont pas effacés. Seul un site archivé peut être supprimé.</p>
      <form action="/marketing/site-web/sites/<%= site.id %>/supprimer" method="post" class="mk-form">
        <div class="field-group"><label for="site-confirm">Tapez le nom du site pour confirmer : <strong><%= site.name %></strong></label><input id="site-confirm" type="text" name="confirmation" autocomplete="off" required></div>
        <div class="mk-actions"><button type="submit" class="btn btn-outline btn-sm">Supprimer le site</button></div>
      </form>
    </section>
    <% } %>
    <section class="mk-panel" aria-labelledby="site-soon"><h2 id="site-soon">À venir pour ce site</h2>
      <p class="field-hint">Pas encore disponibles : articles propres au site, médiathèque propre au site, domaine et SEO par site depuis cet espace, modules activables. Ils seront ajoutés aux prochains paliers ; rien ici ne les simule.</p></section>
<script src="<%= asset('/js/font-manager.js') %>"></script>
<script>(function () { document.documentElement.setAttribute("data-kfonts-site", "<%= site.id %>"); ["f-heading", "f-body"].forEach(function (id) { var s = document.getElementById(id); if (s && window.KFonts) window.KFonts.enhance(s, { label: "Police", site: true }); }); })();</script>
<%- include("partials/bottom") %>
