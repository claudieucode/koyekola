<%- include("partials/top", { title, active, compactNav: true }) %>
<%# Éditeur d'e-mails (Campagnes → Modèles d'e-mails) : barre d'outils, onglets (blocs, structure, médias, styles,
    message, vérification), canevas = rendu réel de l'e-mail (aperçu serveur annoté), réglages du bloc sélectionné.
    Le script public/js/marketing-editor.js pilote tout ; le serveur valide, normalise et rend (rien n'est « cru »). %>
    <div class="mk-builder<%= readOnly ? ' is-readonly' : '' %>" id="mk-editor">
      <header class="mk-b-top">
        <div class="mk-b-top-start">
          <a class="mk-b-back" href="/marketing/modeles" aria-label="Retour aux modèles" data-tip="Retour aux modèles"><%- icon("arrowLeft", { size: 18 }) %></a>
          <div class="mk-b-name">
            <label for="t-name" class="sr-only">Nom du modèle</label>
            <input id="t-name" type="text" maxlength="100" value="<%= template.name %>" title="<%= template.name %>" <%= readOnly ? "disabled" : "" %>>
          </div>
        </div>
        <div class="mk-b-top-mid">
          <span id="mk-status" class="mk-b-status" data-state="saved" role="status" aria-live="polite">Enregistré · version <%= template.version %></span>
          <button type="button" class="btn btn-outline btn-sm mk-b-retry" id="mk-retry" hidden>Réessayer</button>
        </div>
        <div class="mk-b-tools">
          <% if (!readOnly) { %>
            <div class="mk-b-history" role="group" aria-label="Historique des modifications">
              <button type="button" class="mk-b-icon" id="mk-undo" aria-label="Annuler la dernière modification (Ctrl+Z)" data-tip="Annuler" disabled><%- icon("undo", { size: 18 }) %></button>
              <button type="button" class="mk-b-icon" id="mk-redo" aria-label="Rétablir (Ctrl+Maj+Z)" data-tip="Rétablir" disabled><%- icon("redo", { size: 18 }) %></button>
            </div>
          <% } %>
          <button type="button" class="btn btn-outline btn-sm mk-b-btn" id="mk-open-preview" aria-label="Prévisualiser l'e-mail" data-tip="Prévisualiser"><%- icon("eye", { size: 16 }) %><span class="mk-b-btn-label">Prévisualiser</span></button>
          <% if (!readOnly) { %>
            <button type="button" class="btn btn-outline btn-sm mk-b-btn" id="mk-open-test" aria-label="Envoyer un e-mail de test" data-tip="Envoyer un test"><%- icon("send", { size: 16 }) %><span class="mk-b-btn-label">Envoyer un test</span></button>
            <button type="button" class="btn btn-primary btn-sm mk-b-save" id="mk-save" aria-keyshortcuts="Control+S">Enregistrer</button>
          <% } %>
          <div class="mk-b-more">
            <button type="button" class="mk-b-icon" id="mk-more" aria-haspopup="menu" aria-expanded="false" aria-controls="mk-more-menu" aria-label="Plus d'actions" data-tip="Plus d'actions"><%- icon("moreHorizontal", { size: 18 }) %></button>
            <div class="mk-menu" id="mk-more-menu" role="menu" hidden>
              <button type="button" role="menuitem" id="mk-open-versions"><%- icon("history", { size: 16 }) %> Versions précédentes (<%= versions.length %>)</button>
              <% if (!readOnly) { %>
                <form action="/marketing/modeles/<%= template.id %>/dupliquer" method="post" role="none"><button type="submit" role="menuitem"><%- icon("copy", { size: 16 }) %> Dupliquer ce modèle</button></form>
                <form action="/marketing/modeles/<%= template.id %>/supprimer" method="post" role="none"><button type="submit" role="menuitem" class="mk-menu-danger" data-mk-confirm="Le modèle « <%= template.name %> » sera supprimé. Les campagnes déjà lancées gardent leur contenu." data-mk-confirm-title="Supprimer ce modèle ?" data-mk-confirm-ok="Supprimer"><%- icon("trash", { size: 16 }) %> Supprimer ce modèle</button></form>
              <% } %>
            </div>
          </div>
        </div>
      </header>
      <noscript><p class="form-error">L'éditeur d'e-mails demande JavaScript.</p></noscript>
      <p id="mk-editor-error" class="form-error" role="alert" hidden></p>

      <div class="mk-b-body">
        <nav class="mk-b-rail" role="tablist" aria-label="Outils de l'éditeur" aria-orientation="vertical">
          <% const firstPane = readOnly ? "structure" : "blocks"; [["blocks", "plus", "Blocs"], ["structure", "layers", "Structure"], ["media", "image", "Médias"], ["styles", "palette", "Styles"], ["message", "settings", "Message"], ["check", "checkCircle", "Vérification"]].forEach(([key, ic, label]) => { if (readOnly && ["blocks", "media"].includes(key)) return; %>
            <button type="button" role="tab" class="mk-b-tab" id="tab-<%= key %>" data-pane="<%= key %>" aria-controls="pane-<%= key %>" aria-selected="<%= key === firstPane ? "true" : "false" %>" tabindex="<%= key === firstPane ? "0" : "-1" %>">
              <span class="mk-b-tab-icon" aria-hidden="true"><%- icon(ic, { size: 18 }) %></span><span class="mk-b-tab-label"><%= label %></span><% if (key === "check") { %><span class="mk-b-badge" id="mk-check-count" hidden></span><% } %>
            </button>
          <% }) %>
        </nav>

        <section class="mk-b-side" aria-label="Panneau des outils">
          <% if (!readOnly) { %>
          <div class="mk-b-pane" id="pane-blocks" role="tabpanel" aria-labelledby="tab-blocks">
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Blocs</h2>
              <p class="mk-b-pane-hint">Cliquez pour ajouter après le bloc sélectionné, ou glissez dans l'e-mail.</p>
            </div>
            <nav class="mk-palette" id="mk-palette" aria-label="Ajouter un bloc">
              <% palette.forEach((g) => { %>
                <div class="mk-palette-group">
                  <h3 class="mk-palette-title"><%= g.title %></h3>
                  <div class="mk-palette-list">
                    <% g.blocks.forEach(([type, label]) => { const b = blockInfo[type]; %><button type="button" class="mk-palette-btn" data-add="<%= type %>" draggable="true" aria-label="Ajouter un bloc « <%= label %> » : <%= b[2] %>" title="<%= b[2] %>"><span class="mk-palette-icon" aria-hidden="true"><%- icon(b[1], { size: 18 }) %></span><span class="mk-palette-label"><%= label %></span></button><% }) %>
                    <% (g.presets || []).forEach(([key, label]) => { const b = presetInfo[key]; %><button type="button" class="mk-palette-btn" data-add-preset="<%= key %>" draggable="true" aria-label="Ajouter « <%= label %> » : <%= b[2] %>" title="<%= b[2] %>"><span class="mk-palette-icon" aria-hidden="true"><%- icon(b[1], { size: 18 }) %></span><span class="mk-palette-label"><%= label %></span></button><% }) %>
                  </div>
                </div>
              <% }) %>
            </nav>
            <p class="mk-b-pane-foot">Astuce : glissez aussi une image ou un PDF de votre ordinateur directement dans l'e-mail.</p>
          </div>
          <% } %>
          <div class="mk-b-pane" id="pane-structure" role="tabpanel" aria-labelledby="tab-structure"<%= readOnly ? "" : " hidden" %>>
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Structure <span class="mk-b-count" id="mk-structure-count"></span></h2>
              <p class="mk-b-pane-hint"><% if (readOnly) { %>L'ordre des blocs du message.<% } else { %>Glissez une ligne par sa poignée pour la déplacer (ou Alt + flèche haut / bas). Cliquez sur une ligne pour la modifier.<% } %></p>
            </div>
            <ol class="mk-structure" id="mk-structure" aria-label="Blocs du message"></ol>
          </div>
          <% if (!readOnly) { %>
          <div class="mk-b-pane" id="pane-media" role="tabpanel" aria-labelledby="tab-media" hidden>
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Médiathèque</h2>
              <p class="mk-b-pane-hint">Cliquez sur « Insérer » pour l'ajouter à l'e-mail (ou remplacer l'image du bloc sélectionné).</p>
            </div>
            <div class="mk-media-drop" id="mk-media-drop">
              <span class="mk-media-drop-icon" aria-hidden="true"><%- icon("upload", { size: 20 }) %></span>
              <p class="mk-media-drop-title">Déposez des images ou des PDF ici</p>
              <p class="mk-media-drop-hint">JPEG, PNG, GIF, WebP (5&nbsp;Mo) · PDF (10&nbsp;Mo)</p>
              <label class="btn btn-outline btn-sm mk-media-pick">Importer depuis l'ordinateur<input type="file" id="mk-media-file" accept="image/jpeg,image/png,image/gif,image/webp,application/pdf" multiple class="sr-only"></label>
            </div>
            <div class="mk-media-tools">
              <div class="mk-media-search">
                <span class="mk-media-search-icon" aria-hidden="true"><%- icon("search", { size: 16 }) %></span>
                <label for="mk-media-q" class="sr-only">Rechercher un média</label>
                <input type="search" id="mk-media-q" placeholder="Rechercher…">
              </div>
              <label for="mk-media-kind" class="sr-only">Type de média</label>
              <select id="mk-media-kind"><option value="">Tous</option><option value="image">Images</option><option value="document">Documents</option></select>
            </div>
            <p class="mk-media-status" id="mk-media-status" role="status" aria-live="polite"></p>
            <ul class="mk-media-grid" id="mk-media-grid" aria-label="Médias"></ul>
            <button type="button" class="btn btn-outline btn-sm mk-media-more" id="mk-media-more" hidden>Afficher plus</button>
          </div>
          <% } %>
          <div class="mk-b-pane" id="pane-styles" role="tabpanel" aria-labelledby="tab-styles" hidden>
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Styles globaux</h2>
              <p class="mk-b-pane-hint">Appliqués à tout le message ; un bouton peut avoir sa propre couleur.</p>
            </div>
            <section class="mk-b-section" aria-labelledby="mk-styles-colors">
              <h3 class="mk-b-section-title" id="mk-styles-colors">Couleurs</h3>
              <% [["t-bg", "Fond de page"], ["t-cbg", "Fond du message"], ["t-text", "Couleur du texte"], ["t-accent", "Couleur principale", "Liens, boutons, coupons"], ["t-secondary", "Couleur secondaire", "Séparateurs"]].forEach(([id, label, hint]) => { %>
                <div class="mk-style-row">
                  <label for="<%= id %>" class="mk-style-label"><%= label %><% if (hint) { %><span class="mk-style-hint"><%= hint %></span><% } %></label>
                  <div class="mk-style-color">
                    <input id="<%= id %>" type="color">
                    <label for="<%= id %>-hex" class="sr-only"><%= label %> (code hexadécimal)</label>
                    <input id="<%= id %>-hex" class="mk-style-hex" type="text" maxlength="7" spellcheck="false" autocomplete="off" data-hex-for="<%= id %>" <%= readOnly ? "disabled" : "" %>>
                  </div>
                </div>
              <% }) %>
            </section>
            <section class="mk-b-section" aria-labelledby="mk-styles-type">
              <h3 class="mk-b-section-title" id="mk-styles-type">Typographie</h3>
              <div class="field-group"><label for="t-font">Police principale</label><select id="t-font"><option value="system">Sans empattement (système)</option><option value="arial">Arial</option><option value="verdana">Verdana</option><option value="trebuchet">Trebuchet MS</option><option value="tahoma">Tahoma</option><option value="serif">Georgia (avec empattement)</option><option value="times">Times New Roman</option><option value="courier">Courier New</option></select><span class="field-hint">Polices présentes sur tous les appareils : l'e-mail s'affiche partout pareil.</span></div>
            </section>
            <section class="mk-b-section" aria-labelledby="mk-styles-layout">
              <h3 class="mk-b-section-title" id="mk-styles-layout">Mise en page</h3>
              <div class="field-group"><label for="t-maxwidth">Largeur du message (px)</label><input id="t-maxwidth" type="number" min="480" max="720" step="10" aria-describedby="t-maxwidth-hint"><span class="field-hint" id="t-maxwidth-hint">Entre 480 et 720 px (600 : standard).</span></div>
              <div class="field-group"><label for="t-radius">Arrondi des boutons et encadrés (px)</label><input id="t-radius" type="number" min="0" max="24" step="1" aria-describedby="t-radius-hint"><span class="field-hint" id="t-radius-hint">Entre 0 (carré) et 24 px.</span></div>
              <div class="field-group"><label for="t-spacing">Espacement entre les blocs</label><select id="t-spacing"><option value="compact">Serré</option><option value="normal">Normal</option><option value="large">Aéré</option></select><span class="field-hint">Chaque bloc peut avoir ses propres marges (réglages du bloc).</span></div>
            </section>
            <% if (!readOnly) { %><button type="button" class="mk-b-ghost" id="mk-theme-reset"><%- icon("undo", { size: 16 }) %> Réinitialiser le style</button><% } %>
          </div>
          <div class="mk-b-pane" id="pane-message" role="tabpanel" aria-labelledby="tab-message" hidden>
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Message</h2>
              <p class="mk-b-pane-hint">Ce que voit le destinataire avant d'ouvrir l'e-mail, et le pied de page.</p>
            </div>
            <section class="mk-b-section" aria-labelledby="mk-msg-info">
              <h3 class="mk-b-section-title" id="mk-msg-info">Informations du message</h3>
              <div class="field-group"><label for="t-subject">Objet <span class="mk-count" data-count-for="t-subject"></span></label><textarea id="t-subject" rows="1" maxlength="200" data-var-target data-single-line class="mk-autogrow"></textarea></div>
              <div class="field-group"><label for="t-preheader">Préheader <span class="mk-count" data-count-for="t-preheader"></span></label><textarea id="t-preheader" rows="1" maxlength="200" data-var-target data-single-line class="mk-autogrow"></textarea><span class="field-hint">Texte affiché après l'objet dans la boîte de réception.</span></div>
            </section>
            <section class="mk-b-section" aria-labelledby="mk-msg-config">
              <h3 class="mk-b-section-title" id="mk-msg-config">Configuration</h3>
              <div class="field-group"><label for="t-kind">Type</label><select id="t-kind"><option value="marketing">Marketing</option><option value="transactional">Transactionnel</option></select></div>
              <div class="field-group"><label for="t-category">Catégorie</label><select id="t-category"><option value="">Aucune catégorie</option><% categories.forEach((c) => { %><option value="<%= c.key %>"><%= c.label %></option><% }) %></select></div>
            </section>
            <section class="mk-b-section" aria-labelledby="mk-msg-footer">
              <h3 class="mk-b-section-title" id="mk-msg-footer">Pied de page</h3>
              <div class="field-group"><label for="t-footer">Phrase d'introduction</label><textarea id="t-footer" rows="3" maxlength="1000" data-var-target class="mk-autogrow" placeholder="Vous recevez cet e-mail parce que vous êtes en relation avec {{org.name}}."></textarea><span class="field-hint">Ajoutés automatiquement : le lien « Se désinscrire », le lien des préférences et l'adresse postale de l'organisation.</span></div>
            </section>
            <section class="mk-b-section" aria-labelledby="mk-msg-vars">
              <h3 class="mk-b-section-title" id="mk-msg-vars">Variables</h3>
              <div class="field-group mk-blocks-bar">
                <label for="mk-var">Insérer une variable</label>
                <select id="mk-var" <%= readOnly ? "disabled" : "" %>><option value="">Choisir une variable…</option></select>
                <span class="field-hint">Placez d'abord le curseur dans un champ de texte (objet, titre, texte…).</span>
              </div>
            </section>
          </div>
          <div class="mk-b-pane" id="pane-check" role="tabpanel" aria-labelledby="tab-check" hidden>
            <div class="mk-b-pane-head">
              <h2 class="mk-b-pane-title">Vérification</h2>
              <p class="mk-b-pane-hint">Mise à jour à chaque modification. Cliquez sur un problème pour aller au bloc ou au champ concerné.</p>
            </div>
            <div id="mk-check" aria-live="polite"></div>
          </div>
        </section>

        <% if (!readOnly) { %><div class="mk-ctxbar" id="mk-ctxbar" role="toolbar" aria-label="Outils du bloc sélectionné"></div><% } %>
        <main class="mk-b-stage" aria-label="E-mail en cours de conception">
          <div class="mk-b-stagebar">
            <div class="mk-sizes" role="group" aria-label="Largeur d'affichage">
              <button type="button" class="mk-b-icon" data-size="600" aria-pressed="true" aria-label="Bureau (600 px)" data-tip="Bureau"><%- icon("monitor", { size: 18 }) %></button>
              <button type="button" class="mk-b-icon" data-size="480" aria-pressed="false" aria-label="Tablette (480 px)" data-tip="Tablette"><%- icon("tablet", { size: 18 }) %></button>
              <button type="button" class="mk-b-icon" data-size="375" aria-pressed="false" aria-label="Mobile (375 px)" data-tip="Mobile"><%- icon("smartphone", { size: 18 }) %></button>
            </div>
            <p class="mk-preview-subject"><strong>Objet :</strong> <span id="mk-subject"></span></p>
            <button type="button" class="mk-b-zoom" id="mk-zoom" aria-pressed="false" hidden></button>
            <label for="mk-contact" class="sr-only">Contact utilisé pour l'aperçu</label>
            <select id="mk-contact"><option value="">Données d'exemple</option></select>
          </div>
          <div class="mk-b-canvas" id="mk-canvas">
            <iframe id="mk-frame" title="E-mail en cours de conception (cliquez sur un bloc pour le modifier)" sandbox="allow-same-origin" srcdoc=""></iframe>
            <div class="mk-b-blockbar" id="mk-blockbar" role="toolbar" aria-orientation="vertical" aria-label="Actions du bloc sélectionné" hidden></div>
          </div>
          <p class="sr-only" id="mk-live" aria-live="polite"></p>
        </main>

        <aside class="mk-b-props" id="mk-props" aria-label="Réglages du bloc sélectionné"></aside>
      </div>
    </div>

    <dialog class="mk-dialog mk-b-preview" id="mk-preview-dialog" aria-labelledby="mk-preview-title" aria-busy="false">
      <div class="mk-pv-head">
        <h2 id="mk-preview-title">Aperçu de l'e-mail</h2>
        <div class="mk-pv-devices" role="group" aria-label="Appareil simulé">
          <button type="button" class="mk-pv-dev" data-pdevice="desktop" aria-pressed="true"><%- icon("monitor", { size: 16 }) %><span>Bureau</span></button>
          <button type="button" class="mk-pv-dev" data-pdevice="tablet" aria-pressed="false"><%- icon("tablet", { size: 16 }) %><span>Tablette</span></button>
          <button type="button" class="mk-pv-dev" data-pdevice="mobile" aria-pressed="false"><%- icon("smartphone", { size: 16 }) %><span>Mobile</span></button>
          <label class="sr-only" for="mk-pv-width">Largeur d'écran simulée</label>
          <select id="mk-pv-width" class="mk-pv-select" title="Largeur d'écran réelle du rendu"></select>
        </div>
        <div class="mk-pv-tools">
          <label class="sr-only" for="mk-pv-contact">Données utilisées pour les balises de fusion</label>
          <select id="mk-pv-contact" class="mk-pv-select" title="Données des balises de fusion"><option value="">Données d'exemple</option><% (contacts || []).forEach((c) => { %><option value="<%= c.id %>"><%= c.email %></option><% }) %></select>
          <button type="button" class="btn btn-outline btn-sm" id="mk-pv-refresh" title="Régénérer l'aperçu"><%- icon("history", { size: 16 }) %><span class="mk-pv-hide-sm"> Actualiser</span></button>
          <button type="button" class="btn btn-outline btn-sm" id="mk-pv-browser"><%- icon("externalLink", { size: 16 }) %><span class="mk-pv-hide-sm"> Afficher dans le navigateur</span></button>
          <button type="button" class="btn btn-primary btn-sm" data-close-dialog>Retour à l'éditeur</button>
        </div>
      </div>
      <div class="mk-pv-body">
        <div class="mk-pv-stage" id="mk-pv-stage">
          <p class="mk-pv-scale" id="mk-pv-scale" aria-live="polite"></p>
          <div class="mk-pv-device" id="mk-pv-device"><iframe id="mk-preview-frame" title="Aperçu de l'e-mail (rendu réel)" sandbox="allow-same-origin"></iframe></div>
          <p class="mk-pv-status" id="mk-pv-status" role="status"></p>
        </div>
        <aside class="mk-pv-side" aria-label="Informations et vérifications">
          <section class="mk-pv-sec" aria-labelledby="mk-pv-h-info"><h3 id="mk-pv-h-info">Informations de l'e-mail</h3><dl class="mk-pv-info" id="mk-pv-info"></dl></section>
          <section class="mk-pv-sec" aria-labelledby="mk-pv-h-checks"><h3 id="mk-pv-h-checks">Vérifications</h3><p class="mk-pv-global" id="mk-pv-global"></p><ul class="mk-pv-checks" id="mk-pv-checks"></ul></section>
          <% if (!readOnly) { %><section class="mk-pv-sec" aria-labelledby="mk-pv-h-test"><h3 id="mk-pv-h-test">Envoyer un e-mail de test</h3>
            <div class="mk-pv-test"><label class="sr-only" for="mk-pv-test-to">Destinataire du test</label><select id="mk-pv-test-to" class="mk-pv-select"><% recipients.forEach((r) => { %><option value="<%= r %>" <%= r === currentEmail ? "selected" : "" %>><%= r %></option><% }) %></select><button type="button" class="btn btn-primary btn-sm" id="mk-pv-test-send">Envoyer le test</button></div>
            <p class="mk-pv-muted">Uniquement aux membres de l'équipe · objet préfixé [TEST] · version enregistrée (enregistrement automatique avant l'envoi).</p>
            <p class="mk-pv-test-msg" id="mk-pv-test-msg" role="status" aria-live="polite"></p></section><% } %>
          <section class="mk-pv-sec" aria-labelledby="mk-pv-h-links"><h3 id="mk-pv-h-links">Liens <span class="mk-pv-count" id="mk-pv-links-count">0</span></h3><div id="mk-pv-links"></div></section>
          <section class="mk-pv-sec" aria-labelledby="mk-pv-h-tags"><h3 id="mk-pv-h-tags">Balises de fusion</h3><div id="mk-pv-tags"></div></section>
          <details class="mk-pv-sec mk-b-preview-text"><summary>Version texte brut</summary><pre id="mk-text" class="mk-text"></pre></details>
        </aside>
      </div>
    </dialog>

    <% if (!readOnly) { %>
    <dialog class="mk-dialog mk-modal" id="mk-test-dialog" aria-labelledby="mk-test-title" aria-describedby="mk-test-desc">
      <form action="/marketing/modeles/<%= template.id %>/test" method="post">
        <header class="mk-dialog-head">
          <div class="mk-dialog-titles">
            <h2 id="mk-test-title">Envoyer un e-mail de test</h2>
            <p class="mk-dialog-desc" id="mk-test-desc">Envoyé uniquement à un membre de l'équipe, avec des données d'exemple, des liens factices et un objet préfixé « [TEST] ». Le test utilise la version enregistrée.</p>
          </div>
          <button type="button" class="mk-dialog-close" data-close-dialog aria-label="Fermer"><%- icon("close", { size: 18 }) %></button>
        </header>
        <div class="mk-dialog-body">
          <div class="field-group"><label for="test-to">Destinataire</label><select id="test-to" name="to"><% recipients.forEach((r) => { %><option value="<%= r %>" <%= r === currentEmail ? "selected" : "" %>><%= r %></option><% }) %></select></div>
        </div>
        <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-close-dialog>Annuler</button><button type="submit" class="btn btn-primary btn-sm" id="mk-test-send">Envoyer le test</button></div>
      </form>
    </dialog>
    <% } %>

    <dialog class="mk-dialog mk-modal mk-modal-wide" id="mk-versions-dialog" aria-labelledby="mk-versions-title" aria-describedby="mk-versions-desc">
      <header class="mk-dialog-head">
        <div class="mk-dialog-titles">
          <h2 id="mk-versions-title">Versions précédentes</h2>
          <p class="mk-dialog-desc" id="mk-versions-desc">Les 20 dernières versions sont conservées (l'enregistrement automatique en garde au plus une toutes les 10 minutes). Restaurer crée une nouvelle version : rien n'est perdu.</p>
        </div>
        <button type="button" class="mk-dialog-close" data-close-dialog aria-label="Fermer"><%- icon("close", { size: 18 }) %></button>
      </header>
      <div class="mk-dialog-body">
        <% if (versions.length) { %>
          <div class="mk-table-wrap"><table class="mk-table">
            <caption class="sr-only">Versions précédentes</caption>
            <thead><tr><th scope="col">Version</th><th scope="col">Date</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
            <tbody><% versions.forEach((v) => { %>
              <tr><td><%= v.version %></td><td><%= mkh.fdate(v.created_at) %></td>
                <td><% if (!readOnly) { %><form action="/marketing/modeles/<%= template.id %>/restaurer" method="post"><input type="hidden" name="version" value="<%= v.version %>"><button type="submit" class="btn btn-outline btn-sm">Restaurer</button></form><% } %></td></tr>
            <% }) %></tbody>
          </table></div>
        <% } else { %><p class="field-hint">Aucune version précédente pour l'instant.</p><% } %>
      </div>
      <div class="mk-dialog-actions"><button type="button" class="btn btn-outline btn-sm" data-close-dialog>Fermer</button></div>
    </dialog>

    <script type="application/json" id="mk-editor-data"><%- data %></script>
    <script src="<%= asset('/js/mk/fields.js') %>" defer></script>
    <script src="<%= asset('/js/mk/toolbar.js') %>" defer></script>
    <script src="<%= asset('/js/mk/preview.js') %>" defer></script>
    <script src="<%= asset('/js/marketing-editor.js') %>" defer></script>
<%- include("partials/bottom") %>
