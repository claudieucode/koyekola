<%- include("../partials/header", { title: post.title }) %>
<%
  const iso = (d) => d.replace(" ", "T") + "Z";
  const showToc = article.toc.length >= 2;
  // Numérotation du sommaire : aucune, H2 seulement (01, 02…) ou hiérarchique (1, 1.1, 1.1.1)
  const numbering = typeof tocNumbering !== "undefined" ? tocNumbering : "h2";
  const tocNumber = (() => { const c = [0, 0, 0]; return (item) => {
    if (numbering === "none") return "";
    if (numbering === "h2") return item.level === 2 ? String(++c[0]).padStart(2, "0") : "";
    const i = item.level - 2; c[i]++; for (let k = i + 1; k < c.length; k++) c[k] = 0;
    return c.slice(0, i + 1).map((n) => n || 1).join(".");
  }; })();
  const tocItems = article.toc.map((item) => ({ ...item, number: tocNumber(item), cls: `toc-l${item.level}` }));
  const layoutClass = showToc ? "article-layout" : "article-layout article-layout-no-toc";
  const initials = (name) => String(name || "?").trim().slice(0, 1).toUpperCase();
%>
  <div class="article-progress" aria-hidden="true"><span class="article-progress-bar" data-progress-bar></span></div>

  <div class="container article-page">
    <%- include("../partials/breadcrumb", { crumbs }) %>
    <% if (typeof preview !== "undefined" && preview) { %><p class="form-error" role="status">Aperçu : version en cours de rédaction, visible seulement par vous.</p>
    <% } else if (!post.published) { %><p class="form-error" role="status"><%= post.status === "scheduled" ? "Programmé" : post.status === "archived" ? "Archivé" : post.status === "review" ? "En relecture" : "Brouillon" %> : cet article n'est visible que par vous.</p><% } %>

    <div class="<%= layoutClass %>">
      <%# ---------- Gauche : sommaire, progression, partage (ordinateur) ---------- %>
      <aside class="article-left" aria-label="Navigation dans l'article">
        <div class="article-sticky">
          <% if (showToc) { %>
            <nav class="article-toc" aria-labelledby="toc-title">
              <p class="article-toc-title" id="toc-title"><%= typeof tocTitle !== "undefined" ? tocTitle : "Sommaire" %></p>
              <ol class="article-toc-list">
                <% tocItems.forEach((item) => { %><li class="<%= item.cls %>"><a href="#<%= item.id %>" data-toc-link="<%= item.id %>"><% if (item.number) { %><span class="toc-num" aria-hidden="true"><%= item.number %></span><% } %><span><%= item.text %></span></a></li><% }) %>
              </ol>
            </nav>
          <% } %>
          <p class="article-reading">Lecture : <strong data-progress-text>0 %</strong></p>
          <%- include("partials/share", { variant: "vertical", label: "Partager" }) %>
        </div>
      </aside>

      <%# ---------- Centre : l'article ---------- %>
      <article class="article-main" data-article<% if (typeof lang !== "undefined" && lang) { %> lang="<%= lang %>"<% } %>>
        <%# Modèle de thème (Page Builder) : remplace l'en-tête, l'image à la une, le sommaire mobile et le texte ; sinon affichage d'origine %>
        <% if (typeof themeTemplate !== "undefined" && themeTemplate) { %><%- themeTemplate %><% } else { %>
        <header class="article-header">
          <% if (postTerms.primary) { %><a class="article-category" href="<%= postTerms.primary.url %>"><%= postTerms.primary.name %></a><% } else if (post.category) { %><a class="article-category" href="/blog/categorie/<%= categorySlug %>"><%= post.category %></a><% } %>
          <h1 class="post-title"><%= post.title %></h1>
          <% if (post.excerpt) { %><p class="article-lead"><%= post.excerpt %></p><% } %>
          <p class="post-meta article-meta">
            <% if (post.published_at) { %><time datetime="<%= iso(post.published_at) %>"><%= formatDate(post.published_at) %></time><% } %>
            <% if (author) { %><span aria-hidden="true">·</span> <span>par <a href="/blog/auteur/<%= author.id %>"><%= author.username %></a></span><% } %>
            <span aria-hidden="true">·</span> <span class="article-minutes"><%- icon("clock", { size: 14 }) %> <%= minutes %> min de lecture</span>
            <% if (modified) { %><span aria-hidden="true">·</span> <span>Mis à jour le <time datetime="<%= iso(modified) %>"><%= formatDate(modified) %></time></span><% } %>
          </p>
          <%- include("partials/share", { variant: "inline", label: "" }) %>
        </header>

        <% if (post.cover_path) { %>
          <figure class="article-cover">
            <img class="post-cover" src="<%= post.cover_path %>" alt="<%= post.cover_alt || post.title %>" width="1200" height="675" fetchpriority="high" decoding="async">
          </figure>
        <% } %>

        <% if (showToc) { %>
          <details class="article-toc-mobile">
            <summary><%= typeof tocTitle !== "undefined" ? tocTitle : "Sommaire" %> <span class="toc-count">(<%= tocItems.filter((i) => i.level === 2).length %> parties)</span></summary>
            <ol class="article-toc-list">
              <% tocItems.forEach((item) => { %><li class="<%= item.cls %>"><a href="#<%= item.id %>"><% if (item.number) { %><span class="toc-num" aria-hidden="true"><%= item.number %></span><% } %><span><%= item.text %></span></a></li><% }) %>
            </ol>
          </details>
        <% } %>

        <div class="markdown article-content"><%- article.html %></div>
        <% } %>

        <% if (tags.length) { %>
          <ul class="article-tags" aria-label="Étiquettes">
            <% if (postTerms.tags.length) { postTerms.tags.forEach((t) => { %><li><a href="<%= t.url %>">#<%= t.name %></a></li><% }) } else { tags.forEach((t) => { %><li><a href="/blog/etiquette/<%= slugify(t) %>">#<%= t %></a></li><% }) } %>
          </ul>
        <% } %>

        <%- include("partials/share", { variant: "end", label: "Cet article vous a été utile ? Partagez-le :" }) %>

        <% const tplHtml = typeof themeTemplate !== "undefined" && themeTemplate ? String(themeTemplate) : ""; /* éléments déjà présents dans le modèle de thème : pas de doublon */ %>
        <% if (author && !tplHtml.includes("kw-authorbox")) { %>
          <section class="article-author" aria-labelledby="author-title">
            <% if (author.avatar_path) { %><img class="article-author-avatar" src="<%= author.avatar_path %>" alt="" width="72" height="72" loading="lazy">
            <% } else { %><span class="article-author-avatar article-author-initials" style="background:<%= avatarColor(author.username) %>" aria-hidden="true"><%= initials(author.username) %></span><% } %>
            <div>
              <h2 class="article-author-label" id="author-title">À propos de l'auteur</h2>
              <p class="article-author-name"><%= author.username %></p>
              <% if (author.bio) { %><p class="article-author-bio"><%= author.bio %></p><% } %>
              <% if (author.postCount > 1) { %><p><a href="/blog/auteur/<%= author.id %>">Voir ses <%= author.postCount %> articles</a></p><% } %>
            </div>
          </section>
        <% } %>

        <% if ((previous || next) && !tplHtml.includes("kw-postnav")) { %>
          <nav class="article-pager" aria-label="Articles précédent et suivant">
            <% if (previous) { %><a class="article-pager-link" href="/blog/<%= previous.slug %>" rel="prev"><span class="article-pager-dir"><%- icon("arrowLeft", { size: 14 }) %> Article précédent</span><span class="article-pager-title"><%= previous.title %></span></a><% } else { %><span></span><% } %>
            <% if (next) { %><a class="article-pager-link article-pager-next" href="/blog/<%= next.slug %>" rel="next"><span class="article-pager-dir">Article suivant <%- icon("arrowRight", { size: 14 }) %></span><span class="article-pager-title"><%= next.title %></span></a><% } %>
          </nav>
        <% } %>

        <% if (post.comments_enabled) { %>
          <section class="article-comments" id="commentaires" aria-labelledby="comments-title">
            <% if (!tplHtml.includes("kw-postcomments")) { /* liste déjà affichée par l'élément « Commentaires » du modèle */ %>
            <h2 id="comments-title">Commentaires <span class="article-comments-count">(<%= comments.total %>)</span></h2>
            <% if (commentNotice) { %><p class="comment-notice" role="status"><%= commentNotice %></p><% } %>
            <% if (comments.roots.length) { %>
              <ol class="comment-list">
                <% comments.roots.forEach((c) => { %><%- include("_comment", { c, level: 1 }) %><% }) %>
              </ol>
              <% if (comments.pages > 1) { %>
                <nav class="comment-pager" aria-label="Pages de commentaires">
                  <% if (comments.page > 1) { %><a class="btn btn-outline btn-sm" href="?cpage=<%= comments.page - 1 %>#commentaires">Commentaires précédents</a><% } %>
                  <span>Page <%= comments.page %> sur <%= comments.pages %></span>
                  <% if (comments.page < comments.pages) { %><a class="btn btn-outline btn-sm" href="?cpage=<%= comments.page + 1 %>#commentaires">Commentaires suivants</a><% } %>
                </nav>
              <% } %>
            <% } else if (commentsOpen) { %>
              <p class="comment-empty">Aucun commentaire pour l'instant : soyez le premier à réagir.</p>
            <% } else { %>
              <p class="comment-empty">Aucun commentaire.</p>
            <% } %>
            <% } %>
            <% if (commentsOpen && (me || commentCfg.guests_allowed)) { %>
              <form method="post" action="/blog/<%= post.slug %>/commentaires" class="comment-form" id="commentaire-form" novalidate>
                <% if (replyTo) { %>
                  <input type="hidden" name="parent_id" value="<%= replyTo.id %>">
                  <p class="comment-replying" role="status">Réponse à <strong><%= replyTo.name %></strong> · <a href="/blog/<%= post.slug %>#commentaires">Annuler</a></p>
                <% } %>
                <% if (commentError) { %><p class="form-error" role="alert" id="comment-error"><%= commentError %></p><% } %>
                <% if (!me) { %>
                  <div class="comment-form-row">
                    <div><label for="comment-name">Nom *</label><input id="comment-name" type="text" name="author_name" maxlength="60" required autocomplete="name" value="<%= commentForm.name || '' %>"></div>
                    <div><label for="comment-email">E-mail * <span class="field-hint">(jamais affiché)</span></label><input id="comment-email" type="email" name="author_email" maxlength="120" required autocomplete="email" value="<%= commentForm.email || '' %>"></div>
                  </div>
                <% } %>
                <label for="comment-body"><%= replyTo ? "Votre réponse" : "Votre commentaire" %></label>
                <textarea id="comment-body" name="body" rows="4" maxlength="<%= commentMax %>" required<%- commentError ? ' aria-describedby="comment-error"' : '' %> placeholder="Partagez votre avis, une question, une expérience…"><%= commentDraft %></textarea>
                <% if (!me) { %><input type="hidden" name="form_token" value="<%= commentToken %>"><% } %>
                <div class="comment-hp" aria-hidden="true"><label>Ne pas remplir <input type="text" name="contact_url" tabindex="-1" autocomplete="off"></label></div>
                <div class="comment-form-foot"><span class="field-hint"><% if (me) { %>Publié sous le nom <strong><%= me.username %></strong>. <% } %>Texte seul, <%= commentMax %> caractères au plus.<%= commentCfg.moderation === "all" || (commentCfg.moderation === "first" && !me) ? " Les commentaires sont relus avant d'apparaître." : "" %></span><button type="submit" class="btn btn-primary"><%= replyTo ? "Publier la réponse" : "Publier le commentaire" %></button></div>
              </form>
            <% } else if (commentsOpen) { %>
              <div class="comment-login">
                <p>Connectez-vous pour laisser un commentaire. Pas encore membre ? L'inscription est gratuite.</p>
                <div class="comment-login-actions">
                  <a class="btn btn-primary" href="/inscription?redirect=<%= encodeURIComponent(`/blog/${post.slug}#commentaires`) %>">Créer un compte</a>
                  <a class="btn btn-outline" href="/connexion?redirect=<%= encodeURIComponent(`/blog/${post.slug}#commentaires`) %>">Se connecter</a>
                </div>
              </div>
            <% } %>
          </section>
        <% } %>

        <section class="article-final-cta">
          <h2>Prêt à développer vos compétences ?</h2>
          <p>KOLAKISA propose des formations en ligne pour apprendre de nouvelles compétences à votre rythme, avec des exercices concrets et un accès à vie.</p>
          <a href="/catalogue" class="btn btn-primary">Découvrir les formations</a>
        </section>
      </article>

      <%# ---------- Droite : populaires, récents, catégories, newsletter, formations ---------- %>
      <aside class="article-right" aria-label="Plus d'articles">
        <div class="article-sticky">
          <% if (sidebar.popular.length) { %>
            <section class="side-block">
              <h2 class="side-title">Articles populaires</h2>
              <ol class="side-list side-list-numbered"><% sidebar.popular.forEach((p) => { %><li><a href="/blog/<%= p.slug %>"><%= p.title %></a></li><% }) %></ol>
            </section>
          <% } %>
          <% if (sidebar.recent.length) { %>
            <section class="side-block">
              <h2 class="side-title">Articles récents</h2>
              <ul class="side-list"><% sidebar.recent.forEach((p) => { %><li><a href="/blog/<%= p.slug %>"><%= p.title %></a><time datetime="<%= iso(p.published_at) %>"><%= formatDate(p.published_at) %></time></li><% }) %></ul>
            </section>
          <% } %>
          <% if (sidebar.categories.length) { %>
            <section class="side-block">
              <h2 class="side-title">Catégories</h2>
              <ul class="side-chips"><% sidebar.categories.forEach((c) => { %><li><a href="/blog/categorie/<%= c.slug %>"<%- c.slug === categorySlug ? ' aria-current="page"' : "" %>><%= c.name %> <span class="side-count"><%= c.count %></span></a></li><% }) %></ul>
            </section>
          <% } %>
          <% if (sidebar.newsletter) { %>
            <section class="side-block side-newsletter" aria-labelledby="nl-title">
              <h2 class="side-title" id="nl-title">Recevez nos nouveaux articles et conseils</h2>
              <form action="/f/<%= sidebar.newsletter.slug %>" method="post" data-blog-newsletter><input type="hidden" name="tz" data-tz>
                <div class="hp-field" aria-hidden="true"><label for="nl-website">Ne pas remplir</label><input id="nl-website" type="text" name="website" tabindex="-1" autocomplete="off"></div>
                <label class="sr-only" for="nl-email">Votre adresse e-mail</label>
                <input id="nl-email" type="email" name="email" required autocomplete="email" placeholder="Votre adresse e-mail">
                <label class="side-consent"><input type="checkbox" name="consent" value="1" required> <span><%= sidebar.newsletter.consentText %></span></label>
                <button type="submit" class="btn btn-primary btn-block">S'inscrire</button>
                <p class="side-newsletter-msg" role="status" data-newsletter-msg hidden></p>
              </form>
            </section>
          <% } %>
          <section class="side-block side-cta">
            <h2 class="side-title">Envie de développer vos compétences ?</h2>
            <p>Des formations pratiques, à suivre à votre rythme.</p>
            <a href="/catalogue" class="btn btn-outline btn-block">Découvrir les formations</a>
          </section>
        </div>
      </aside>
    </div>

    <% if (similar.length) { %>
      <section class="article-similar" aria-labelledby="similar-title">
        <h2 id="similar-title">Vous pourriez également aimer</h2>
        <div class="post-grid">
          <% similar.forEach((p) => { %>
            <article class="post-card">
              <% if (p.cover_path) { %><a href="/blog/<%= p.slug %>" class="post-card-cover" tabindex="-1" aria-hidden="true"><img src="<%= p.cover_path %>" alt="" loading="lazy" width="640" height="360"></a>
              <% } else { %><span class="post-card-cover post-card-cover-empty" aria-hidden="true"></span><% } %>
              <div class="post-card-body">
                <% if (p.category) { %><span class="post-card-category"><%= p.category %></span><% } %>
                <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
                <p><%= p.summary %></p>
                <p class="post-card-foot"><time datetime="<%= iso(p.published_at) %>"><%= formatDate(p.published_at) %></time> <a href="/blog/<%= p.slug %>" class="post-card-more" aria-label="Lire l'article « <%= p.title %> »">Lire l'article</a></p>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
    <%# Colonne latérale (Apparence → Widgets) : sous l'article sur la page d'un article %>
    <%- typeof widgetZone === "function" ? widgetZone("sidebar") : "" %>
  </div>
  <script src="<%= asset('/js/blog-article.js') %>" defer></script>

<%- include("../partials/footer") %>
