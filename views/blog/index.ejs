<%- include("../partials/header", { title: "Blog" }) %>

  <div class="container page-content">
    <%- include("../partials/breadcrumb", { crumbs }) %>
    <h1>Blog</h1>
    <p class="category-lead">Conseils, actualités et ressources autour de nos formations.</p>

    <% if (posts.length) { %>
      <div class="post-grid">
        <% posts.forEach((post) => { %>
          <article class="post-card">
            <% if (post.cover_path) { %>
              <a href="/blog/<%= post.slug %>" class="post-card-cover" tabindex="-1" aria-hidden="true"><img src="<%= post.cover_path %>" alt="" loading="lazy" width="640" height="360"></a>
            <% } else { %>
              <span class="post-card-cover post-card-cover-empty" aria-hidden="true"></span>
            <% } %>
            <div class="post-card-body">
              <time datetime="<%= post.published_at.replace(' ', 'T') %>Z"><%= formatDate(post.published_at) %></time>
              <h2><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
              <p><%= post.summary %></p>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (pages > 1) { %>
        <nav class="pagination" aria-label="Pagination">
          <% if (page > 1) { %><a class="btn btn-outline btn-sm" href="<%= page - 1 === 1 ? '/blog' : '/blog?page=' + (page - 1) %>" rel="prev">Articles plus récents</a><% } %>
          <span>Page <%= page %> sur <%= pages %></span>
          <% if (page < pages) { %><a class="btn btn-outline btn-sm" href="/blog?page=<%= page + 1 %>" rel="next">Articles plus anciens</a><% } %>
        </nav>
      <% } %>
    <% } else { %>
      <p class="empty-state" style="padding:24px 0;">Aucun article publié pour le moment.</p>
    <% } %>
  </div>

<%- include("../partials/footer") %>
