<%# Boutons de partage (liens de partage officiels, aucun script tiers chargé) + « Copier le lien » + partage natif du téléphone %>
<% const u = encodeURIComponent(shareUrl), t = encodeURIComponent(post.title);
   const shareClass = "share" + (typeof variant !== "undefined" ? " share-" + variant : ""); %>
<div class="<%= shareClass %>" role="group" aria-label="Partager cet article">
  <% if (typeof label !== "undefined" && label) { %><span class="share-label"><%= label %></span><% } %>
  <a class="share-btn share-facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= u %>" target="_blank" rel="noopener noreferrer" aria-label="Partager sur Facebook (nouvelle fenêtre)" title="Facebook">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"/></svg>
  </a>
  <a class="share-btn share-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= u %>" target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn (nouvelle fenêtre)" title="LinkedIn">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.9 8.8H3.8V20h3.1V8.8zM5.4 4a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM20.2 13.6c0-3-1.6-4.9-4.2-4.9-1.3 0-2.3.7-2.8 1.5V8.8h-3V20h3.1v-5.6c0-1.5.6-2.6 2-2.6 1.3 0 1.8 1 1.8 2.6V20h3.1v-6.4z"/></svg>
  </a>
  <a class="share-btn share-x" href="https://x.com/intent/post?url=<%= u %>&amp;text=<%= t %>" target="_blank" rel="noopener noreferrer" aria-label="Partager sur X (nouvelle fenêtre)" title="X">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.9 3h6.4l4.4 5.9L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
  </a>
  <a class="share-btn share-whatsapp" href="https://wa.me/?text=<%= t %>%20<%= u %>" target="_blank" rel="noopener noreferrer" aria-label="Partager sur WhatsApp (nouvelle fenêtre)" title="WhatsApp">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2a9.7 9.7 0 0 0-8.3 14.8L2.4 21.6l4.7-1.2A9.7 9.7 0 1 0 12 2.2zm0 17.7c-1.5 0-2.9-.4-4.2-1.1l-.3-.2-2.8.7.7-2.7-.2-.3A8 8 0 1 1 12 19.9zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1c0 1.2.9 2.4 1 2.6.1.2 1.8 2.7 4.3 3.8 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3z"/></svg>
  </a>
  <button type="button" class="share-btn share-copy" data-copy-link="<%= shareUrl %>" aria-label="Copier le lien de l'article" title="Copier le lien">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.1 0l-3 3a5 5 0 0 0 7.1 7.1l1.7-1.7"/></svg>
    <span class="share-copy-text">Copier le lien</span>
  </button>
  <button type="button" class="share-btn" data-native-share data-title="<%= post.title %>" data-url="<%= shareUrl %>" hidden aria-label="Partager avec une autre application" title="Partager">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
  </button>
</div>
