<%- include("partials/header", { title: "Nouveau mot de passe", seo: { noindex: true } }) %>

  <div class="auth-page">
    <div class="auth-card">
      <% if (invalid) { %>
        <h1>Lien expiré</h1>
        <p class="subtitle">Ce lien n'est plus valable : il a déjà servi, ou il date de plus d'une heure.</p>
        <a class="btn btn-primary btn-block btn-lg" href="/mot-de-passe-oublie">Demander un nouveau lien</a>
      <% } else { %>
        <h1>Nouveau mot de passe</h1>
        <p class="subtitle">Choisissez un mot de passe d'au moins 8 caractères.</p>
        <% if (error) { %><p class="form-error"><%= error %></p><% } %>
        <form action="/reinitialiser-mot-de-passe/<%= token %>" method="post">
          <div class="field-group">
            <label for="f-reset-1">Nouveau mot de passe</label>
            <input id="f-reset-1" type="password" name="password" required minlength="8" maxlength="200" autocomplete="new-password" autofocus>
          </div>
          <div class="field-group">
            <label for="f-reset-2">Confirmez le mot de passe</label>
            <input id="f-reset-2" type="password" name="password_confirm" required minlength="8" maxlength="200" autocomplete="new-password">
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg">Enregistrer le nouveau mot de passe</button>
        </form>
      <% } %>
    </div>
  </div>

<%- include("partials/footer") %>
