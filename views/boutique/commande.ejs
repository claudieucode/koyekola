<%- include("_top") %>
<% const v = values; const a = (k) => v[k] || ""; %>
<h1 class="sh-title">Commande</h1>
<% if (error) { %><p class="sh-error" role="alert"><%= error %></p><% } %>
<div class="sh-layout sh-layout-checkout">
<form class="sh-form" method="post" action="<%= shop.base %>/commande">
  <input type="hidden" name="idempotency_key" value="<%= idempotencyKey %>">
  <input type="hidden" name="expected_total" value="<%= priced.totals.total %>">
  <fieldset><legend>Coordonnées</legend>
    <% if (shop.customer) { %><p>Connecté : <strong><%= shop.customer.email %></strong></p>
    <% } else { %><label>Adresse e-mail<input type="email" name="email" value="<%= v.email %>" required autocomplete="email" maxlength="200"></label><% } %>
  </fieldset>
  <% if (typeof giftInfo !== "undefined" && giftInfo) { %>
  <fieldset><legend>Cadeau de liste</legend>
    <p>Ce panier contient un cadeau pour la liste « <%= giftInfo.titles.join(" », « ") %> ».</p>
    <% if (giftInfo.canDeliver) { %>
    <label class="sh-check"><input type="radio" name="gift_delivery" value="" data-sh-gift-delivery checked> Livrer à mon adresse</label>
    <label class="sh-check"><input type="radio" name="gift_delivery" value="recipient" data-sh-gift-delivery> Livrer chez le bénéficiaire (son adresse reste confidentielle, seul le vendeur la voit)</label>
    <% } %>
  </fieldset>
  <% } %>
  <% if (priced.shipping.required) { %>
  <fieldset data-sh-ship-fieldset><legend>Adresse de livraison</legend>
    <label>Nom complet<input name="ship_name" value="<%= a("ship_name") %>" required autocomplete="name" maxlength="120"></label>
    <label>Adresse<input name="ship_line1" value="<%= a("ship_line1") %>" required autocomplete="address-line1" maxlength="160"></label>
    <label>Complément<input name="ship_line2" value="<%= a("ship_line2") %>" autocomplete="address-line2" maxlength="160"></label>
    <div class="sh-row">
      <label>Code postal<input name="ship_postal_code" value="<%= a("ship_postal_code") %>" required autocomplete="postal-code" maxlength="20"></label>
      <label>Ville<input name="ship_city" value="<%= a("ship_city") %>" required autocomplete="address-level2" maxlength="100"></label>
    </div>
    <div class="sh-row">
      <label>Région (facultatif)<input name="ship_region" value="<%= a("ship_region") %>" autocomplete="address-level1" maxlength="80"></label>
      <label>Pays (code, ex. FR)<input name="ship_country" value="<%= v.country %>" required maxlength="2" minlength="2" autocomplete="country" pattern="[A-Za-z]{2}"></label>
    </div>
    <label>Téléphone (facultatif)<input name="ship_phone" value="<%= a("ship_phone") %>" autocomplete="tel" maxlength="30"></label>
    <p class="sh-hint"><a href="<%= shop.base %>/commande?pays=<%= v.country %>">Recalculer la livraison pour ce pays</a></p>
  </fieldset>
  <fieldset><legend>Méthode de livraison</legend>
    <% if (priced.shipping.error) { %><p class="sh-error" role="alert"><%= priced.shipping.error %></p><% } %>
    <% priced.shipping.options.forEach((o) => { %>
    <label class="sh-check"><input type="radio" name="shipping_method" value="<%= o.id %>" required<%= priced.shipping.chosen && priced.shipping.chosen.id === o.id ? " checked" : "" %>> <%= o.name %> — <%= o.costCents ? money(o.costCents) : "offerte" %></label>
    <% }) %>
  </fieldset>
  <% if (typeof slots !== "undefined" && slots) { %>
  <fieldset><legend>Créneau de livraison</legend>
    <p class="sh-hint">Obligatoire pour : <%= slots.methods.map((m) => m.name).join(", ") %>. Les créneaux affichés sont ceux qui sont réellement disponibles.</p>
    <% if (!slots.days.length) { %><p class="sh-error" role="alert">Aucun créneau n'est disponible pour le moment : cette méthode de livraison ne peut pas être commandée.</p><% } %>
    <% slots.days.forEach((d) => { %><div class="sh-slot-day"><p><strong><%= d.label %></strong></p>
      <% d.slots.forEach((c) => { %><label class="sh-check"><input type="radio" name="delivery_slot" value="<%= c.value %>"<%= v.deliverySlot === c.value ? " checked" : "" %>> <%= c.name ? c.name + " — " : "" %>de <%= c.start %> à <%= c.end %> <small>(<%= c.remaining %> place<%= c.remaining > 1 ? "s" : "" %> disponible<%= c.remaining > 1 ? "s" : "" %>)</small></label><% }) %></div><% }) %>
  </fieldset>
  <% } %>
  <% } %>
  <fieldset><legend>Adresse de facturation</legend>
    <label class="sh-check"><input type="checkbox" name="same_billing" value="1" checked> Identique à l'adresse de livraison<%= priced.shipping.required ? "" : " (non applicable : produits numériques)" %></label>
    <% if (!priced.shipping.required) { %>
    <label>Nom complet<input name="bill_name" value="<%= a("bill_name") %>" maxlength="120"></label>
    <label>Adresse<input name="bill_line1" value="<%= a("bill_line1") %>" maxlength="160"></label>
    <div class="sh-row"><label>Code postal<input name="bill_postal_code" value="<%= a("bill_postal_code") %>" maxlength="20"></label><label>Ville<input name="bill_city" value="<%= a("bill_city") %>" maxlength="100"></label></div>
    <label>Pays (code, ex. FR)<input name="bill_country" value="<%= a("bill_country") || v.country %>" maxlength="2" pattern="[A-Za-z]{2}"></label>
    <% } %>
  </fieldset>
  <fieldset><legend>Paiement</legend>
    <% if (!methods.length) { %><p class="sh-error" role="alert">Aucun moyen de paiement n'est disponible pour le moment.</p><% } %>
    <% methods.forEach((m, i) => { %><label class="sh-check"><input type="radio" name="payment_method" value="<%= m.key %>" required<%= (v.paymentMethod ? v.paymentMethod === m.key : i === 0) ? " checked" : "" %>> <%= m.label %></label><% }) %>
  </fieldset>
  <% if (typeof ageRequired !== "undefined" && ageRequired) { %>
  <fieldset><legend>Produit réservé aux adultes</legend>
    <p class="sh-hint">Votre panier contient un produit réservé aux personnes de <%= ageRequired %> ans et plus. Déclaration sur l'honneur ; la livraison peut exiger une pièce d'identité.</p>
    <label class="sh-check"><input type="checkbox" name="age_confirm" value="1" required> Je confirme avoir au moins <%= ageRequired %> ans</label>
  </fieldset>
  <% } %>
  <button class="sh-btn sh-btn-primary" type="submit"<%= methods.length ? "" : " disabled" %>>Confirmer la commande — <%= money(priced.totals.total) %></button>
</form>
<aside class="sh-summary" aria-label="Récapitulatif">
  <h2>Récapitulatif</h2>
  <ul class="sh-lines"><% priced.lines.forEach((l) => { %><li><%= l.quantity %> × <%= l.name %><%= l.variantLabel ? " (" + l.variantLabel + ")" : "" %><%= l.customText ? " — " + l.customLabel + " : « " + l.customText + " »" : "" %> <span><%= money(l.unitCents * l.quantity) %></span></li><% }) %></ul>
  <dl class="sh-totals">
    <div><dt>Sous-total</dt><dd><%= money(priced.totals.subtotal) %></dd></div>
    <% if (priced.totals.discount) { %><div><dt>Réduction</dt><dd>− <%= money(priced.totals.discount) %></dd></div><% } %>
    <% if (priced.shipping.required) { %><div><dt>Livraison</dt><dd><%= priced.shipping.chosen ? money(priced.shipping.chosen.costCents) : "à choisir" %></dd></div><% } %>
    <% priced.totals.taxLines.forEach((t) => { %><div><dt><%= priced.settings.prices_include_tax ? "dont " : "" %><%= t.name %> (<%= (t.rateBp / 100).toFixed(2).replace(".", ",") %> %)</dt><dd><%= money(t.amountCents) %></dd></div><% }) %>
    <div class="sh-total"><dt>Total</dt><dd><%= money(priced.totals.total) %></dd></div>
  </dl>
</aside>
</div>
<%- include("_bottom") %>
