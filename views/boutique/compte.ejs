<%- include("_top", { noindex: true }) %>
<h1 class="sh-title">Mon compte</h1>
<% if (info) { %><p class="sh-ok" role="status"><%= info %></p><% } %>
<p>Connecté : <strong><%= shop.customer.email %></strong></p>
<form class="sh-form" method="post" action="<%= shop.base %>/compte/profil">
  <label>Nom<input name="name" value="<%= shop.customer.name || "" %>" maxlength="120"></label>
  <label>Téléphone<input name="phone" value="<%= shop.customer.phone || "" %>" maxlength="30"></label>
  <button class="sh-btn" type="submit">Enregistrer</button>
</form>
<% if (typeof hasSubscriptions !== "undefined" && hasSubscriptions) { %><p><a href="<%= shop.base %>/abonnements">Mes abonnements</a></p><% } %>
<h2>Mes commandes</h2>
<% if (!customerOrders.length) { %><p class="sh-empty">Vous n'avez pas encore passé de commande.</p><% } else { %>
<table class="sh-table"><thead><tr><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Statut</th><th scope="col">Total</th></tr></thead><tbody>
<% customerOrders.forEach((o) => { %><tr><th scope="row"><a href="<%= shop.base %>/commande/confirmation/<%= encodeURIComponent(o.number) %>?k=<%= o.key %>"><%= o.number %></a></th><td><%= String(o.created_at).slice(0, 10) %></td><td><%= statusLabels[o.status] %></td><td><%= money(o.total_cents) %></td></tr><% }) %>
</tbody></table>
<% } %>
<h2>Mes données</h2>
<p><a class="sh-btn" href="<%= shop.base %>/compte/donnees">Télécharger mes données (JSON)</a></p>
<details><summary>Supprimer mon compte</summary>
  <p>Votre compte, vos listes et vos paniers seront effacés. Vos commandes et factures sont conservées (obligation légale de conservation comptable) mais ne sont plus rattachées à un compte. Action irréversible.</p>
  <form class="sh-form" method="post" action="<%= shop.base %>/compte/supprimer"><label>Votre mot de passe<input type="password" name="password" required autocomplete="current-password"></label><button class="sh-btn" type="submit">Supprimer définitivement mon compte</button></form>
</details>
<form method="post" action="<%= shop.base %>/compte/deconnexion"><button class="sh-btn" type="submit">Se déconnecter</button></form>
<%- include("_bottom") %>
