<%- include("partials/header", { title: "Commande confirmée" }) %>

  <div class="container confirmation-box">
    <div class="check-badge"><%- icon('check', { size: 34 }) %></div>
    <h1>Merci pour votre achat !</h1>
    <p style="color:var(--muted);">Votre commande #<%= order.id %> a bien été enregistrée. Vos formations sont maintenant disponibles dans votre espace « Mes formations ».</p>

    <div class="card card-pad" style="text-align:left;margin-top:24px;">
      <% items.forEach(item => { %>
        <div class="order-item-row">
          <a href="/cours/<%= item.slug %>" style="text-decoration:none;color:var(--text);font-weight:600;"><%= item.title %></a>
          <span><%= formatPrice(item.price_cents) %></span>
        </div>
      <% }) %>
      <div class="order-item-row" style="border-bottom:none;font-weight:800;">
        <span>Total payé</span>
        <span><%= formatPrice(order.total_cents) %></span>
      </div>
    </div>

    <a href="/mes-cours" class="btn btn-primary btn-lg" style="margin-top:28px;">Accéder à mes formations</a>
  </div>

<%- include("partials/footer") %>
