<%- include("partials/header", { title: "Commande confirmée" }) %>

  <div class="container confirmation-box">
    <div class="check-badge"><%- icon('check', { size: 34 }) %></div>
    <h1>Merci pour votre achat !</h1>
    <p class="kv-error-msg" style="margin-inline:auto;">Votre commande #<%= order.id %> a bien été enregistrée. Vos formations sont maintenant disponibles dans votre espace « Mes formations ».</p>

    <div class="card card-pad kv-receipt">
      <% items.forEach(item => { %>
        <div class="order-item-row">
          <a href="/cours/<%= item.slug %>" style="text-decoration:none;color:var(--text);font-weight:600;"><%= item.title %></a>
          <span><%= formatPrice(item.price_cents) %></span>
        </div>
      <% }) %>
      <% if (order.discount_cents) { %>
        <div class="order-item-row"><span>Code promo « <%= order.coupon_code %> »</span><span>− <%= formatPrice(order.discount_cents) %></span></div>
      <% } %>
      <div class="order-item-row" style="border-bottom:none;font-weight:800;">
        <span>Total payé</span>
        <span><%= formatPrice(order.total_cents) %></span>
      </div>
    </div>

    <p style="margin-top:28px;"><a href="/mes-cours" class="btn btn-primary btn-lg">Accéder à mes formations</a></p>
  </div>

<%- include("partials/footer") %>
