<%- include("../partials/header", { title: "Questions fréquentes" }) %>

  <div class="container page-content">
    <%- include("../partials/breadcrumb", { crumbs }) %>
    <h1>Questions fréquentes</h1>
    <% if (faqs.length) { %>
      <%- include("../partials/faq-list", { faqs }) %>
    <% } else { %>
      <div class="empty-state">
        <span class="kv-empty-ico" aria-hidden="true"><%- icon("help", { size: 26 }) %></span>
        <h3>Aucune question pour le moment</h3>
        <p>N'hésitez pas à <a href="/contact">nous écrire</a>.</p>
      </div>
    <% } %>
    <p class="page-cta">Vous ne trouvez pas votre réponse ? <a href="/contact">Contactez-nous</a>.</p>
  </div>

<%- include("../partials/footer") %>
