<%- include("partials/header", { title: step.name }) %>

  <div class="container" style="max-width:640px;">
    <h1 style="margin-top:36px;"><%= step.name %></h1>
    <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
    <% const base = course.price_cents; %>
    <form action="/tunnel/offre/<%= step.id %>/payer" method="post" class="card card-pad" id="offer-form">
      <h2 style="margin-top:0;"><%= course.title %></h2>
      <% if (course.subtitle) { %><p><%= course.subtitle %></p><% } %>
      <p class="summary-row"><span>Prix</span><strong data-base="<%= base %>"><%- include("partials/price", { course }) %></strong></p>
      <% if (bump) { %>
        <label class="checkbox-row" for="offer-bump">
          <input type="checkbox" id="offer-bump" name="bump" data-price="<%= bump.price_cents %>">
          <span><strong><%= step.settings.bumpLabel || ("Ajouter : " + bump.title) %></strong> — <%= formatPrice(bump.price_cents) %><br><small><%= bump.title %></small></span>
        </label>
      <% } %>
      <p class="summary-row total"><span>Total</span><strong id="offer-total"><%= formatPrice(base) %></strong></p>
      <div class="field-group"><label for="offer-code">Code promo</label><input id="offer-code" type="text" name="code" maxlength="40" autocomplete="off" placeholder="Facultatif"></div>
      <input type="hidden" name="expected_total" id="offer-expected" value="<%= base %>">
      <% if (payable) { %>
        <p class="payment-badge"><%- icon('info', { size: 16 }) %> Paiement sécurisé par Stripe : vous serez redirigé vers sa page de paiement. Aucune donnée de carte ne passe par ce site.</p>
        <button type="submit" class="btn btn-primary btn-block btn-lg"<%= base < minAmount && base > 0 ? " disabled" : "" %>>Payer par carte</button>
      <% } else { %>
        <p class="payment-badge"><%- icon('info', { size: 16 }) %> Le paiement en ligne n'est pas encore ouvert : cette offre ne peut pas être payée pour l'instant.</p>
        <button type="submit" class="btn btn-primary btn-block btn-lg" disabled>Payer par carte</button>
      <% } %>
    </form>
    <% if (canDecline) { %>
      <form action="/tunnel/offre/<%= step.id %>/refuser" method="post" style="text-align:center;margin-top:16px;"><button type="submit" class="btn btn-ghost">Non merci, continuer sans cette offre</button></form>
    <% } %>
  </div>
  <script>
    (function () {
      var box = document.getElementById("offer-bump"); if (!box) return;
      var total = document.getElementById("offer-total"), expected = document.getElementById("offer-expected"), base = Number(expected.value), fmt = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });
      box.addEventListener("change", function () { var t = base + (box.checked ? Number(box.dataset.price) : 0); expected.value = t; total.textContent = fmt.format(t / 100); });
    })();
  </script>
<%- include("partials/footer") %>
