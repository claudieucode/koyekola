<%- include("../partials/header", { title: "SEO · Intégrations" }) %>
<%
  const nf = (n) => (n === null || n === undefined ? "Non disponible" : Number(n).toLocaleString("fr-FR", { maximumFractionDigits: 1 }));
  const pct = (n) => (n === null || n === undefined ? "Non disponible" : `${(n * 100).toLocaleString("fr-FR", { maximumFractionDigits: 1 })} %`);
  const pos = (n) => (n === null || n === undefined ? "Non disponible" : n.toLocaleString("fr-FR", { maximumFractionDigits: 1 }));
  const sec = (ms) => (ms === null || ms === undefined ? "Non disponible" : `${(ms / 1000).toLocaleString("fr-FR", { maximumFractionDigits: 2 })} s`);
  const delta = (a, b) => (a === null || b === null || b === undefined ? "" : a - b === 0 ? "=" : `${a - b > 0 ? "+" : ""}${(a - b).toLocaleString("fr-FR", { maximumFractionDigits: 2 })}`);
  const FIELD_CAT = { FAST: "bon", AVERAGE: "à améliorer", SLOW: "mauvais" };
  const badgeClass = (s) => `seo-int-state is-${s.state}`;
%>
<div class="container-wide seo-page">
  <%- include("_nav", { active: "integrations" }) %>
  <% if (msg) { %><p class="form-success" role="status"><%= msg %></p><% } %>
  <% if (err) { %><p class="form-error" role="alert"><%= err %></p><% } %>
  <p class="field-hint">Les chiffres de cette page viennent directement de Google. Tant qu'un service n'est pas connecté, rien n'est affiché à sa place : aucun chiffre n'est estimé ni inventé.</p>

  <section class="content-card">
    <h2>État des connexions</h2>
    <ul class="seo-status">
      <% Object.entries(names).forEach(([key, label]) => { const s = st[key]; %>
        <li><span><%= label %></span><strong class="<%= badgeClass(s) %>"><%= s.label %></strong><% if (s.detail) { %><span class="field-hint seo-int-detail"><%= s.detail %></span><% } %></li>
      <% }) %>
    </ul>
    <% if (!encryption) { %><p class="form-error">Configuration requise : la variable d'environnement ENCRYPTION_KEY n'est pas définie sur le serveur. Sans elle, les clés Google ne peuvent pas être stockées de façon chiffrée.</p><% } %>
  </section>

  <section class="content-card" id="search-console">
    <h2>Google Search Console</h2>
    <% if (st.search_console.state === "connected") { %>
      <form method="get" class="seo-filters"><label class="sr-only" for="i-days">Période</label>
        <select id="i-days" name="jours"><% [7, 28, 90].forEach((d) => { %><option value="<%= d %>" <%= d === days ? "selected" : "" %>><%= d %> derniers jours disponibles</option><% }) %></select>
        <button class="btn btn-outline btn-sm">Afficher</button>
        <button class="btn btn-outline btn-sm" name="actualiser" value="1">Actualiser depuis Google</button></form>
      <% if (gsc && !gsc.ok) { %><p class="form-error"><%= gsc.error %></p><% } %>
      <% if (gsc && gsc.ok) { const g = gsc.data; const c = g.totals.current; const p = g.totals.previous; %>
        <p class="field-hint">Du <%= g.period.current.start %> au <%= g.period.current.end %>, comparé au <%= g.period.previous.start %> → <%= g.period.previous.end %>. Données reçues le <%= g.fetchedAt %> (UTC)<%= g.fromCache ? ", mises en cache 6 h" : "" %>. Search Console publie ses chiffres avec environ 3 jours de retard.</p>
        <div class="seo-scores">
          <div class="seo-score"><span class="seo-score-value"><%= nf(c.clicks) %></span><span class="seo-score-label">Clics (<%= delta(c.clicks, p.clicks) || "—" %>)</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= nf(c.impressions) %></span><span class="seo-score-label">Impressions (<%= delta(c.impressions, p.impressions) || "—" %>)</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= pct(c.ctr) %></span><span class="seo-score-label">Taux de clic</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= pos(c.position) %></span><span class="seo-score-label">Position moyenne</span></div>
        </div>
        <% if (!g.topQueries.length && !g.topPages.length) { %><p>Aucune donnée de recherche sur cette période (site récent ou peu visible dans Google).</p><% } %>
        <% const tables = [["Pages en progression", g.insights.growing, "Clics gagnés par rapport à la période précédente (5 clics ou plus)."], ["Pages en recul", g.insights.declining, "Clics perdus par rapport à la période précédente (5 clics ou plus)."]]; %>
        <% tables.forEach(([title, rows, hint]) => { if (!rows.length) return; %>
          <h3><%= title %></h3><p class="field-hint"><%= hint %></p>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Page</th><th scope="col">Avant</th><th scope="col">Maintenant</th><th scope="col">Écart</th></tr></thead>
            <tbody><% rows.forEach((r) => { %><tr><td><a href="<%= r.page %>" target="_blank" rel="noopener"><%= r.page %></a></td><td><%= nf(r.before) %></td><td><%= nf(r.clicks) %></td><td><%= delta(r.clicks, r.before) %></td></tr><% }) %></tbody></table></div>
        <% }) %>
        <% if (g.insights.lowCtr.length) { %>
          <h3>Recherches à faible taux de clic</h3><p class="field-hint">Au moins 100 impressions mais moins de 2 % de clics : améliorer le titre et la description affichés dans Google peut aider.</p>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Recherche</th><th scope="col">Impressions</th><th scope="col">Taux de clic</th><th scope="col">Position</th></tr></thead>
            <tbody><% g.insights.lowCtr.forEach((r) => { %><tr><td><%= r.query %></td><td><%= nf(r.impressions) %></td><td><%= pct(r.ctr) %></td><td><%= pos(r.position) %></td></tr><% }) %></tbody></table></div>
        <% } %>
        <% if (g.insights.nearTop.length) { %>
          <h3>Opportunités : presque en première page</h3><p class="field-hint">Position moyenne entre 8 et 20 avec au moins 50 impressions : un contenu enrichi ou des liens internes peuvent faire passer en première page.</p>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Recherche</th><th scope="col">Impressions</th><th scope="col">Position</th></tr></thead>
            <tbody><% g.insights.nearTop.forEach((r) => { %><tr><td><%= r.query %></td><td><%= nf(r.impressions) %></td><td><%= pos(r.position) %></td></tr><% }) %></tbody></table></div>
        <% } %>
        <% if (g.insights.emerging.length) { %>
          <h3>Nouvelles recherches</h3><p class="field-hint">Absentes de la période précédente, au moins 20 impressions.</p>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Recherche</th><th scope="col">Impressions</th><th scope="col">Position</th></tr></thead>
            <tbody><% g.insights.emerging.forEach((r) => { %><tr><td><%= r.query %></td><td><%= nf(r.impressions) %></td><td><%= pos(r.position) %></td></tr><% }) %></tbody></table></div>
        <% } %>
        <% if (g.topQueries.length) { %>
          <h3>Principales recherches</h3>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Recherche</th><th scope="col">Clics</th><th scope="col">Impressions</th><th scope="col">Taux de clic</th><th scope="col">Position</th></tr></thead>
            <tbody><% g.topQueries.forEach((r) => { %><tr><td><%= r.query %></td><td><%= nf(r.clicks) %></td><td><%= nf(r.impressions) %></td><td><%= pct(r.ctr) %></td><td><%= pos(r.position) %></td></tr><% }) %></tbody></table></div>
        <% } %>
        <% if (g.topPages.length) { %>
          <h3>Principales pages</h3>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Page</th><th scope="col">Clics</th><th scope="col">Impressions</th><th scope="col">Taux de clic</th><th scope="col">Position</th></tr></thead>
            <tbody><% g.topPages.forEach((r) => { %><tr><td><a href="<%= r.page %>" target="_blank" rel="noopener"><%= r.page %></a></td><td><%= nf(r.clicks) %></td><td><%= nf(r.impressions) %></td><td><%= pct(r.ctr) %></td><td><%= pos(r.position) %></td></tr><% }) %></tbody></table></div>
        <% } %>
      <% } %>
    <% } %>
    <details class="seo-int-config" <%= st.search_console.state === "connected" ? "" : "open" %>>
      <summary>Configuration</summary>
      <ol class="seo-int-steps">
        <li>Dans Google Cloud, créez un <strong>compte de service</strong>, activez l'API « Google Search Console API », puis téléchargez sa clé au format JSON.</li>
        <li>Dans Search Console → Paramètres → Utilisateurs et autorisations, ajoutez l'adresse e-mail du compte de service (droit « Restreint » suffisant).</li>
        <li>Renseignez ci-dessous la propriété et collez le contenu du fichier JSON. La clé est chiffrée sur le serveur et n'est plus jamais affichée.</li>
      </ol>
      <form method="post" action="/formateur/seo/integrations/search_console" data-busy="Vérification auprès de Google…">
        <div class="field-group"><label for="gsc-property">Propriété</label><input type="text" id="gsc-property" name="property" required value="<%= config.search_console.property || "" %>" placeholder="sc-domain:kolakisa.com ou https://kolakisa.com/"></div>
        <div class="field-group"><label for="gsc-key">Clé JSON du compte de service <%= st.search_console.state !== "not_connected" && st.search_console.state !== "config_required" ? "(laisser vide pour garder la clé actuelle)" : "" %></label><textarea id="gsc-key" name="service_account" rows="4" autocomplete="off" spellcheck="false" placeholder='{"type": "service_account", …}'></textarea></div>
        <div class="seo-form-actions"><button class="btn btn-primary" type="submit" <%= encryption ? "" : "disabled" %>>Enregistrer et vérifier</button></div>
      </form>
      <% if (!["not_connected", "config_required"].includes(st.search_console.state)) { %><div class="seo-form-actions">
        <form method="post" action="/formateur/seo/integrations/search_console/tester" class="inline-form"><button class="btn btn-outline btn-sm" type="submit">Tester la connexion</button></form>
        <form method="post" action="/formateur/seo/integrations/search_console" class="inline-form"><input type="hidden" name="action" value="deconnecter"><button class="btn btn-outline btn-sm" type="submit">Déconnecter</button></form>
      </div><% } %>
    </details>
  </section>

  <section class="content-card" id="analytics">
    <h2>Google Analytics 4</h2>
    <% if (st.analytics.state === "connected") { %>
      <% if (ga && !ga.ok) { %><p class="form-error"><%= ga.error %></p><% } %>
      <% if (ga && ga.ok) { const a = ga.data; %>
        <p class="field-hint"><%= a.days %> derniers jours (jusqu'à hier). Données reçues le <%= a.fetchedAt %> (UTC)<%= a.fromCache ? ", mises en cache 6 h" : "" %>.</p>
        <div class="seo-scores">
          <div class="seo-score"><span class="seo-score-value"><%= nf(a.totals.activeUsers) %></span><span class="seo-score-label">Utilisateurs actifs</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= nf(a.totals.sessions) %></span><span class="seo-score-label">Sessions</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= nf(a.totals.screenPageViews) %></span><span class="seo-score-label">Pages vues</span></div>
          <div class="seo-score"><span class="seo-score-value"><%= nf(a.totals.keyEvents) %></span><span class="seo-score-label">Événements clés</span></div>
        </div>
        <% if (a.channels.length) { %><h3>Sources de trafic</h3>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Canal</th><th scope="col">Sessions</th></tr></thead>
            <tbody><% a.channels.forEach((r) => { %><tr><td><%= r.channel %></td><td><%= nf(r.sessions) %></td></tr><% }) %></tbody></table></div><% } %>
        <% if (a.pages.length) { %><h3>Pages les plus vues</h3>
          <div class="seo-table-wrap"><table class="seo-table"><thead><tr><th scope="col">Page</th><th scope="col">Vues</th><th scope="col">Utilisateurs</th></tr></thead>
            <tbody><% a.pages.forEach((r) => { %><tr><td><%= r.path %></td><td><%= nf(r.views) %></td><td><%= nf(r.users) %></td></tr><% }) %></tbody></table></div><% } %>
        <% if (!a.pages.length && !a.channels.length) { %><p>Aucune donnée sur cette période.</p><% } %>
      <% } %>
    <% } %>
    <details class="seo-int-config" <%= st.analytics.state === "connected" ? "" : "open" %>>
      <summary>Configuration</summary>
      <ol class="seo-int-steps">
        <li>Activez l'API « Google Analytics Data API » dans le même projet Google Cloud (le même compte de service peut servir).</li>
        <li>Dans Google Analytics → Administration → Gestion des accès à la propriété, ajoutez l'adresse du compte de service avec le rôle « Lecteur ».</li>
        <li>Renseignez l'identifiant numérique de la propriété (Administration → Paramètres de la propriété).</li>
      </ol>
      <p class="field-hint">Cette connexion sert uniquement à lire les statistiques. Le code de suivi Analytics n'est pas ajouté au site par cette page.</p>
      <form method="post" action="/formateur/seo/integrations/analytics" data-busy="Vérification auprès de Google…">
        <div class="field-group"><label for="ga-property">Identifiant de propriété</label><input type="text" id="ga-property" name="property_id" required inputmode="numeric" value="<%= config.analytics.propertyId || "" %>" placeholder="123456789"></div>
        <div class="field-group"><label for="ga-key">Clé JSON du compte de service <%= st.analytics.state !== "not_connected" && st.analytics.state !== "config_required" ? "(laisser vide pour garder la clé actuelle)" : "" %></label><textarea id="ga-key" name="service_account" rows="4" autocomplete="off" spellcheck="false" placeholder='{"type": "service_account", …}'></textarea></div>
        <div class="seo-form-actions"><button class="btn btn-primary" type="submit" <%= encryption ? "" : "disabled" %>>Enregistrer et vérifier</button></div>
      </form>
      <% if (!["not_connected", "config_required"].includes(st.analytics.state)) { %><div class="seo-form-actions">
        <form method="post" action="/formateur/seo/integrations/analytics/tester" class="inline-form"><button class="btn btn-outline btn-sm" type="submit">Tester la connexion</button></form>
        <form method="post" action="/formateur/seo/integrations/analytics" class="inline-form"><input type="hidden" name="action" value="deconnecter"><button class="btn btn-outline btn-sm" type="submit">Déconnecter</button></form>
      </div><% } %>
    </details>
  </section>

  <section class="content-card" id="pagespeed">
    <h2>PageSpeed Insights (vitesse des pages)</h2>
    <% if (!siteUrl) { %><p class="form-error">Configuration requise : SITE_URL n'est pas définie, Google ne peut pas analyser le site.</p><% } else { %>
      <p class="field-hint">Google charge réellement la page <%= siteUrl %>… depuis ses serveurs (environ 30 secondes). Sans clé d'API, le quota gratuit partagé peut être atteint.</p>
      <form method="post" action="/formateur/seo/integrations/pagespeed/analyser" class="seo-filters" data-busy="Analyse en cours chez Google (environ 30 s)…">
        <label class="sr-only" for="psi-path">Adresse à analyser</label><input type="text" id="psi-path" name="path" value="/" placeholder="/blog/mon-article">
        <label class="sr-only" for="psi-strategy">Appareil</label><select id="psi-strategy" name="strategy"><option value="mobile">Mobile</option><option value="desktop">Ordinateur</option></select>
        <button class="btn btn-primary btn-sm" type="submit">Analyser</button>
      </form>
    <% } %>
    <% if (!psi.length) { %><p>Aucune analyse pour l'instant.</p><% } else { %>
      <div class="seo-table-wrap"><table class="seo-table">
        <thead><tr><th scope="col">Date (UTC)</th><th scope="col">Adresse</th><th scope="col">Appareil</th><th scope="col">Performance</th><th scope="col">LCP</th><th scope="col">CLS</th><th scope="col">TBT</th><th scope="col">Visiteurs réels (CrUX)</th></tr></thead>
        <tbody><% psi.forEach((r) => { const d = r.data; %><tr>
          <td><%= r.fetched_at %></td><td><%= r.url.replace(siteUrl, "") || "/" %></td><td><%= r.strategy === "desktop" ? "Ordinateur" : "Mobile" %></td>
          <% if (!r.ok) { %><td colspan="5" class="form-error"><%= r.error %></td><% } else { %>
            <td><strong><%= d.performance === null ? "Non disponible" : `${d.performance} / 100` %></strong></td><td><%= sec(d.lab.lcp) %></td><td><%= d.lab.cls === null ? "Non disponible" : d.lab.cls.toLocaleString("fr-FR", { maximumFractionDigits: 3 }) %></td><td><%= d.lab.tbt === null ? "Non disponible" : `${Math.round(d.lab.tbt)} ms` %></td>
            <td><% if (!d.fieldAvailable) { %>Non disponible (pas assez de visites mesurées par Google)<% } else { %>
              LCP <%= d.field.lcp ? `${sec(d.field.lcp.value)} (${FIELD_CAT[d.field.lcp.category] || d.field.lcp.category})` : "Non disponible" %> ·
              INP <%= d.field.inp ? `${d.field.inp.value} ms (${FIELD_CAT[d.field.inp.category] || d.field.inp.category})` : "Non disponible" %> ·
              CLS <%= d.field.cls ? `${(d.field.cls.value / 100).toLocaleString("fr-FR")} (${FIELD_CAT[d.field.cls.category] || d.field.cls.category})` : "Non disponible" %><% } %></td>
          <% } %></tr>
          <% if (r.ok && d.opportunities.length) { %><tr><td colspan="8" class="field-hint">Pistes d'amélioration : <%= d.opportunities.map((o) => `${o.title}${o.savingsMs ? ` (≈ ${Math.round(o.savingsMs)} ms)` : ""}`).join(" · ") %></td></tr><% } %>
        <% }) %></tbody>
      </table></div>
    <% } %>
    <details class="seo-int-config">
      <summary>Clé d'API (facultative)</summary>
      <p class="field-hint">Une clé gratuite (Google Cloud → API « PageSpeed Insights API » → Identifiants) donne un quota personnel. Elle est chiffrée sur le serveur.</p>
      <form method="post" action="/formateur/seo/integrations/pagespeed">
        <div class="field-group"><label for="psi-key">Clé d'API</label><input type="text" id="psi-key" name="api_key" autocomplete="off" spellcheck="false" placeholder="<%= st.pagespeed.hasKey ? "Clé enregistrée — saisir pour remplacer (vide = retirer)" : "AIza…" %>"></div>
        <div class="seo-form-actions"><button class="btn btn-primary btn-sm" type="submit" <%= encryption ? "" : "disabled" %>>Enregistrer</button></div>
      </form>
    </details>
  </section>
</div>
<script src="<%= asset('/js/seo-admin.js') %>" defer></script>
<%- include("../partials/footer") %>
