<%- include("../partials/header", { title: "SEO · Rapports" }) %>
<% const scored = audits.filter((a) => a.scores && a.scores.overall).slice().reverse();
   const last = audits[0];
   const psiOk = psi.filter((r) => r.ok && r.data && r.data.performance !== null).slice().reverse();
   const psiMobile = psiOk.filter((r) => r.strategy !== "desktop"); %>
<%- include("_head", { section: "Rapports", title: "Rapports SEO", intro: "L'évolution de votre référencement, construite uniquement à partir des données enregistrées." }) %>

<ul class="seo-stats">
  <li><span>Score SEO</span><strong><%= last && last.scores && last.scores.overall ? last.scores.overall.score : "—" %></strong></li>
  <li><span>Pages analysées</span><strong><%= last ? last.pages : "—" %></strong></li>
  <li><span>Problèmes ouverts</span><strong><%= summary.latest_audit ? summary.latest_audit.open_issues : "—" %></strong></li>
  <li><span>Adresses indexables</span><strong><%= summary.sitemap.included %></strong></li>
</ul>

<div class="seo-grid is-even">
  <section class="dpanel">
    <h2>Évolution du score</h2>
    <% if (scored.length >= 2) { %>
      <%- include("_chart", { title: "Score SEO global", points: scored.map((a) => ({ label: formatDate(a.finished_at), value: a.scores.overall.score })) }) %>
    <% } else { %>
      <%- include("_empty", { ico: "barChart", title: "Pas encore d'historique", text: scored.length ? "Un seul audit terminé : la courbe apparaîtra dès le deuxième." : "Aucun audit terminé pour l'instant.", action: `<form method="post" action="/formateur/seo/audit" data-busy="Audit en cours…"><input type="hidden" name="kind" value="full"><button class="btn btn-outline btn-sm" type="submit">Lancer un audit</button></form>` }) %>
    <% } %>
  </section>
  <section class="dpanel">
    <h2>Par catégorie (dernier audit)</h2>
    <% if (!last || !last.scores) { %><%- include("_empty", { ico: "barChart", title: "Aucune donnée", text: "Les notes par catégorie (indexation, métadonnées, technique…) apparaissent après un audit." }) %>
    <% } else { %>
      <ul class="seo-bars">
        <% Object.entries(categories).forEach(([k, label]) => { const s = last.scores[k]; const v = s ? s.score : null; const tone = v === null ? "none" : v >= 75 ? "good" : v >= 50 ? "warn" : "bad"; const barClass = `seo-bar tone-${tone}`; %>
          <li class="<%= barClass %>"><span class="seo-bar-label"><%= label %></span><span class="seo-bar-track" aria-hidden="true"><span style="width: <%= v || 0 %>%"></span></span><span class="seo-bar-value"><%= v === null ? "—" : v %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<section class="dpanel">
  <h2>Vitesse des pages (PageSpeed, mobile)</h2>
  <% if (psiMobile.length >= 2) { %>
    <%- include("_chart", { title: "Performance PageSpeed mobile", points: psiMobile.map((r) => ({ label: `${r.fetched_at.slice(0, 10)} ${r.url.replace(/^https?:\/\/[^/]+/, "") || "/"}`, value: r.data.performance })) }) %>
  <% } else { %>
    <%- include("_empty", { ico: "zap", title: "Pas assez de mesures", text: psiMobile.length ? "Une seule mesure mobile : lancez-en une autre pour voir l'évolution." : "Aucune mesure PageSpeed enregistrée.", action: `<a class="btn btn-outline btn-sm" href="/formateur/seo/integrations#pagespeed">Mesurer une page</a>` }) %>
  <% } %>
</section>

<section class="dpanel">
  <div class="dash-section-head"><h2>Téléchargements</h2><a href="/formateur/seo/rapports/synthese.json">Synthèse (JSON)</a></div>
  <p class="seo-muted">Construits au moment du téléchargement. Les fichiers CSV s'ouvrent dans Excel, Numbers ou Google Sheets. Aucune clé ni donnée secrète n'est exportée.</p>
  <% if (audits.length) { %>
    <div class="dtable-wrap"><table class="dtable seo-table-modern"><thead><tr><th scope="col">Audit</th><th scope="col">Terminé le (UTC)</th><th scope="col">Pages</th><th scope="col">Problèmes</th><th scope="col">Télécharger</th></tr></thead>
      <tbody><% audits.forEach((a) => { %><tr><td>n° <%= a.id %> — <%= kinds[a.kind] || a.kind %></td><td><%= a.finished_at %></td><td><%= a.pages %></td><td><%= a.issues %></td>
        <td class="seo-row-actions"><a class="btn btn-outline btn-sm" href="/formateur/seo/rapports/audit-<%= a.id %>.csv">CSV</a><a class="btn btn-outline btn-sm" href="/formateur/seo/rapports/audit-<%= a.id %>.json">JSON</a></td></tr><% }) %></tbody></table></div>
    <form method="get" action="/formateur/seo/rapports/audit-<%= audits[0].id %>.csv" class="seo-inline-row">
      <label for="r-cat">Une seule catégorie (dernier audit)</label><select id="r-cat" name="categorie"><% Object.entries(categories).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select>
      <button class="btn btn-outline btn-sm" type="submit">Télécharger (CSV)</button>
    </form>
  <% } %>
  <ul class="seo-exports">
    <li><a href="/formateur/seo/redirections.csv"><%- icon('arrowRightLeft', { size: 18 }) %><span><strong>Redirections</strong><small>Sources, destinations, utilisations</small></span></a></li>
    <li><a href="/formateur/seo/rapports/erreurs-404.csv"><%- icon('alertCircle', { size: 18 }) %><span><strong>Erreurs 404</strong><small>Adresses introuvables, visites, pages d'origine</small></span></a></li>
    <li><a href="/formateur/seo/rapports/journal.csv"><%- icon('history', { size: 18 }) %><span><strong>Journal SEO</strong><small>Qui a changé quoi, avant / après</small></span></a></li>
    <li><a href="/formateur/seo/rapports/pagespeed.csv"><%- icon('zap', { size: 18 }) %><span><strong>Mesures PageSpeed</strong><small>Historique de vitesse des pages</small></span></a></li>
  </ul>
</section>
<%- include("../partials/footer") %>
