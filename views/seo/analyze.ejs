<%- include("../partials/header", { title: "SEO · Analyse d'une page" }) %>
<div class="container-wide seo-page">
  <%- include("_nav", { active: "audit" }) %>
  <section class="content-card">
    <h2>Analyse de <a href="<%= path %>" target="_blank" rel="noopener"><%= path %></a></h2>
    <form method="get" class="seo-filters"><label class="sr-only" for="an-path">Adresse</label><input type="text" id="an-path" name="path" value="<%= path %>"><button class="btn btn-outline btn-sm">Analyser</button></form>
    <% if (result.status !== 200) { %><p class="form-error">La page répond <%= result.status || "rien" %><%= result.error ? ` (${result.error})` : "" %> : analyse impossible.</p>
    <% } else if (!result.issues.length) { %><p class="form-success">Aucun problème relevé sur cette page par les règles applicables à une page seule.</p>
    <% } else { %>
      <ul class="seo-issues"><% result.issues.forEach((i) => { const rule = rules[i.rule_id]; const issueClass = `seo-issue sev-${i.severity}`; %><li class="<%= issueClass %>"><div class="seo-issue-head"><span class="seo-sev"><%= severities[i.severity].label %></span><strong><%= rule.title %></strong><span class="field-hint"><%= categories[i.category] %></span></div><p><%= i.detail %></p><p class="field-hint"><%= rule.recommendation %></p></li><% }) %></ul>
    <% } %>
    <p class="field-hint">Les règles qui demandent tout le site (pages orphelines, doublons, cannibalisation) ne sont évaluées que par un scan complet.</p>
  </section>
</div>
<%- include("../partials/footer") %>
