<%- include("../partials/header", { title: "SEO · Robots et sitemap" }) %>
<%- include("_head", { section: "Robots & Sitemap", title: "Robots & Sitemap", intro: "Ce que votre site indique aux moteurs de recherche : les pages à explorer et celles à éviter.", audit: false }) %>
<% const robotsBad = robotsProblems.filter((p) => p.level !== "info"); %>

<div class="seo-modules">
  <section class="dpanel seo-module">
    <div class="seo-module-head"><span class="seo-module-icon" aria-hidden="true"><%- icon('network', { size: 20 }) %></span><div><h2>Sitemap XML</h2><span class="seo-state tone-good">Actif</span></div></div>
    <dl class="seo-facts is-compact">
      <div><dt>Adresses incluses</dt><dd><%= included.length %></dd></div>
      <div><dt>Exclues</dt><dd><%= excluded.length %></dd></div>
      <div><dt>Génération</dt><dd>À chaque demande</dd></div>
    </dl>
    <p class="seo-muted">Construit en direct depuis la base : contenus publiés et indexables uniquement. Il est donc toujours à jour, sans régénération.</p>
    <div class="seo-module-actions"><a class="btn btn-outline btn-sm" href="/sitemap.xml" target="_blank" rel="noopener"><%- icon('externalLink', { size: 14 }) %> Ouvrir sitemap.xml</a><a class="btn btn-outline btn-sm" href="/formateur/seo/reglages#seo-index_blog_tags">Réglages d'indexation</a></div>
  </section>

  <section class="dpanel seo-module">
    <div class="seo-module-head"><span class="seo-module-icon" aria-hidden="true"><%- icon('bot', { size: 20 }) %></span><div><h2>Robots.txt</h2><% if (conflicts.length || robotsBad.length) { %><span class="seo-state tone-bad">À vérifier</span><% } else { %><span class="seo-state tone-good">Actif</span><% } %></div></div>
    <dl class="seo-facts is-compact">
      <div><dt>Conflits avec le sitemap</dt><dd><%= conflicts.length %></dd></div>
      <div><dt>Problèmes de syntaxe</dt><dd><%= robotsBad.length %></dd></div>
    </dl>
    <% if (!conflicts.length) { %><p class="seo-ok"><%- icon('checkCircle', { size: 16 }) %> Aucun conflit : toutes les adresses du plan du site sont autorisées à Google.</p><% } %>
    <div class="seo-module-actions"><a class="btn btn-primary btn-sm" href="/formateur/seo/reglages#seo-robots_custom">Modifier</a><a class="btn btn-outline btn-sm" href="/robots.txt" target="_blank" rel="noopener"><%- icon('externalLink', { size: 14 }) %> Ouvrir robots.txt</a></div>
  </section>
</div>

<% robotsProblems.forEach((p) => { %><div class="seo-alert-box <%= p.level === "info" ? "is-info" : "is-error" %>"><%- icon(p.level === "info" ? 'info' : 'alertTriangle', { size: 18 }) %><div><%= p.message %></div></div><% }) %>
<% if (conflicts.length) { %><div class="seo-alert-box is-error" role="alert"><%- icon('alertTriangle', { size: 18 }) %><div><strong>Conflit : <%= conflicts.length %> adresse(s) du plan du site interdite(s) à Google par robots.txt</strong><ul><% conflicts.slice(0, 50).forEach((c) => { %><li><%= c %></li><% }) %></ul></div></div><% } %>

<section class="dpanel">
  <div class="dash-section-head"><h2>Contenu publié de robots.txt</h2><a href="/formateur/seo/reglages#seo-robots_custom">Modifier les règles</a></div>
  <pre class="seo-code-view" aria-label="robots.txt"><% robotsText.split("\n").forEach((line, i) => { %><span class="seo-code-line"><span class="seo-code-num" aria-hidden="true"><%= i + 1 %></span><%= line %></span><% }) %></pre>
</section>

<section class="dpanel">
  <div class="seo-tabs-local" data-tabs>
    <div class="seo-tablist" role="tablist" aria-label="Adresses du plan du site">
      <button type="button" role="tab" id="tab-in" aria-controls="panel-in" aria-selected="true">Incluses (<%= included.length %>)</button>
      <button type="button" role="tab" id="tab-out" aria-controls="panel-out" aria-selected="false">Exclues (<%= excluded.length %>)</button>
    </div>
    <div role="tabpanel" id="panel-in" aria-labelledby="tab-in">
      <div class="dtable-wrap"><table class="dtable seo-table-modern">
        <thead><tr><th scope="col">Adresse</th><th scope="col">Type</th><th scope="col">Modifié le</th><th scope="col">Images</th></tr></thead>
        <tbody><% included.forEach((e) => { %><tr><td><a href="<%= e.path %>" target="_blank" rel="noopener"><%= e.path %></a></td><td><%= e.type %></td><td><%= e.lastmod || "—" %></td><td><%= (e.images || []).length %></td></tr><% }) %></tbody>
      </table></div>
    </div>
    <div role="tabpanel" id="panel-out" aria-labelledby="tab-out">
      <% if (!excluded.length) { %><%- include("_empty", { ico: "checkCircle", title: "Aucune adresse publique exclue", text: "Toutes les pages publiques indexables figurent dans le plan du site." }) %><% } else { %>
      <div class="dtable-wrap"><table class="dtable seo-table-modern"><thead><tr><th scope="col">Adresse</th><th scope="col">Type</th><th scope="col">Raison</th></tr></thead>
        <tbody><% excluded.forEach((e) => { %><tr><td><%= e.path %></td><td><%= e.type %></td><td><%= e.reason %></td></tr><% }) %></tbody></table></div>
      <% } %>
    </div>
  </div>
</section>
<%- include("../partials/footer") %>
