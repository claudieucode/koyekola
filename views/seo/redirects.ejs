<%- include("../partials/header", { title: "SEO · Redirections" }) %>
<% const MSG = { cree: "Redirection créée : elle fonctionne immédiatement.", modifiee: "Redirection modifiée.", supprimee: "Redirection supprimée.", raccourcie: "Chaîne raccourcie : la redirection mène désormais directement à la destination finale." }; %>
<div class="container-wide seo-page">
  <%- include("_nav", { active: "redirects" }) %>
  <% if (saved && MSG[saved]) { %><p class="form-success" role="status"><%= MSG[saved] %></p><% } %>
  <% if (errors.length) { %><div class="form-error" role="alert"><strong>Rien n'a été enregistré :</strong><ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <% if (report) { %><div class="<%= report.errors.length ? "form-error" : "form-success" %>" role="status"><strong><%= report.created %> redirection(s) importée(s).</strong><% if (report.errors.length) { %><ul><% report.errors.slice(0, 30).forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %></div><% } %>

  <section class="content-card">
    <h2><%= edit ? "Modifier la redirection" : "Nouvelle redirection" %></h2>
    <% const f = edit ? { source: edit.source_path, target: edit.target, status: edit.status, note: edit.note, enabled: edit.enabled } : form; %>
    <form method="post" action="/formateur/seo/redirections<%= edit ? `/${edit.id}` : "" %>" class="seo-redirect-form">
      <% if (form.from404) { %><input type="hidden" name="from404" value="<%= form.from404 %>"><% } %>
      <div class="field-group"><label for="r-source">Ancienne adresse</label><input type="text" id="r-source" name="source" required value="<%= f.source || "" %>" placeholder="/ancienne-page"></div>
      <div class="field-group"><label for="r-target">Nouvelle adresse</label><input type="text" id="r-target" name="target" required value="<%= f.target || "" %>" placeholder="/nouvelle-page ou https://…"></div>
      <div class="field-group"><label for="r-status">Type</label><select id="r-status" name="status"><option value="301" <%= String(f.status) !== "302" ? "selected" : "" %>>301 — définitive (conseillé)</option><option value="302" <%= String(f.status) === "302" ? "selected" : "" %>>302 — temporaire</option></select></div>
      <div class="field-group"><label for="r-note">Note <span class="field-hint">(facultatif)</span></label><input type="text" id="r-note" name="note" maxlength="200" value="<%= f.note || "" %>"></div>
      <% if (edit) { %><input type="hidden" name="enabled" value="0"><label class="checkbox-row" for="r-enabled"><input type="checkbox" id="r-enabled" name="enabled" value="1" <%= f.enabled ? "checked" : "" %>> <span>Active</span></label><% } %>
      <div class="seo-form-actions"><button type="submit" class="btn btn-primary"><%= edit ? "Enregistrer" : "Créer la redirection" %></button><% if (edit) { %><a class="btn btn-outline" href="/formateur/seo/redirections">Annuler</a><% } %></div>
    </form>
    <p class="field-hint">La redirection s'exécute sur le serveur, avant toute page. Les espaces privés (connexion, administration, fichiers) ne peuvent pas être redirigés ; une boucle est refusée.</p>
  </section>

  <% if (chains.length) { %>
    <section class="content-card">
      <h2>Chaînes et boucles détectées (<%= chains.length %>)</h2>
      <p class="field-hint">Une chaîne fait passer le visiteur (et Google) par plusieurs redirections : mieux vaut mener directement à la destination finale.</p>
      <ul class="seo-chain-list">
        <% chains.forEach((c) => { %><li class="<%= c.loop ? "is-bad" : "" %>"><code><%= c.path.join(" → ") %></code> <%= c.loop ? "— boucle" : "" %>
          <% if (!c.loop && c.id) { %><form method="post" action="/formateur/seo/redirections/<%= c.id %>/raccourcir" class="inline-form"><button class="btn btn-outline btn-sm" type="submit">Raccourcir en <%= c.source %> → <%= c.final %></button></form><% } else if (!c.id) { %><span class="field-hint">(changement d'adresse automatique : modifiez la redirection qui suit)</span><% } %></li><% }) %>
      </ul>
    </section>
  <% } %>

  <section class="content-card">
    <h2>Redirections (<%= list.length %>)</h2>
    <form method="get" class="seo-filters" role="search"><label class="sr-only" for="r-q">Rechercher</label><input type="search" id="r-q" name="q" value="<%= q %>" placeholder="Rechercher une adresse…"><button class="btn btn-outline btn-sm">Rechercher</button>
      <a class="btn btn-outline btn-sm" href="/formateur/seo/redirections.csv">Exporter (CSV)</a></form>
    <% if (!list.length) { %><p>Aucune redirection pour l'instant.</p><% } else { %>
    <div class="seo-table-wrap"><table class="seo-table">
      <thead><tr><th scope="col">Ancienne adresse</th><th scope="col">Nouvelle adresse</th><th scope="col">Type</th><th scope="col">Utilisations</th><th scope="col">État</th><th scope="col"></th></tr></thead>
      <tbody>
        <% list.forEach((r) => { %>
          <tr>
            <td><a href="<%= r.source_path %>" target="_blank" rel="noopener"><%= r.source_path %></a><% if (r.note) { %><br><span class="field-hint"><%= r.note %></span><% } %></td>
            <td><%= r.target %></td><td><%= r.status %></td>
            <td><%= r.hits %><% if (r.last_hit_at) { %><br><span class="field-hint">dernière : <%= formatDateTime(r.last_hit_at) %></span><% } %></td>
            <td><%= r.enabled ? "Active" : "Désactivée" %></td>
            <td class="seo-actions"><a class="btn btn-outline btn-sm" href="/formateur/seo/redirections?modifier=<%= r.id %>">Modifier</a>
              <form method="post" action="/formateur/seo/redirections/<%= r.id %>/supprimer" class="inline-form" data-confirm="Supprimer cette redirection ?"><button class="btn-link" type="submit">Supprimer</button></form></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% } %>
  </section>

  <section class="content-card">
    <h2>Importer des redirections</h2>
    <form method="post" action="/formateur/seo/redirections/import">
      <div class="field-group"><label for="r-csv">Une redirection par ligne : <code>ancienne,nouvelle,301,note</code></label><textarea id="r-csv" name="csv" rows="5" placeholder="/ancien-article,/blog/nouvel-article,301"></textarea></div>
      <button class="btn btn-outline" type="submit">Importer</button>
    </form>
  </section>
</div>
<script src="<%= asset('/js/seo-admin.js') %>" defer></script>
<%- include("../partials/footer") %>
