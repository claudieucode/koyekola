<%# En-tête d'une page de l'espace SEO : fil d'Ariane discret, titre, phrase d'aide, action principale et menu « ⋯ ».
    Le fil d'Ariane est affiché par la coquille (partials/dash-open.ejs). Paramètres : title, intro, actions (HTML facultatif),
    audit (false pour masquer « Lancer un audit »). %>
<div class="dash-head seo-head">
  <div><h1><%= title %></h1><% if (typeof intro !== "undefined" && intro) { %><p><%= intro %></p><% } %></div>
  <div class="dash-head-actions">
    <% if (typeof actions !== "undefined" && actions) { %><%- actions %><% } %>
    <% if (typeof audit === "undefined" || audit !== false) { %>
      <form method="post" action="/formateur/seo/audit" data-busy="Audit en cours…" class="dash-inline-form"><input type="hidden" name="kind" value="full"><button type="submit" class="btn btn-primary"><%- icon('searchCheck', { size: 16 }) %> Lancer un audit</button></form>
    <% } %>
    <div class="dmenu seo-head-menu">
      <button type="button" class="dmenu-btn" aria-haspopup="true" aria-expanded="false" aria-label="Autres outils SEO" title="Autres outils SEO"><%- icon('moreVertical', { size: 18 }) %></button>
      <div class="dmenu-list" role="menu" hidden>
        <% if (typeof menu !== "undefined" && menu) { %><%- menu %><hr><% } %>
        <a role="menuitem" href="/formateur/seo/analyse?path=%2F"><%- icon('search', { size: 16 }) %> Analyser une page</a>
        <a role="menuitem" href="/formateur/seo/regles"><%- icon('list', { size: 16 }) %> Règles de l'audit</a>
        <a role="menuitem" href="/formateur/seo/rapports/synthese.json"><%- icon('download', { size: 16 }) %> Télécharger la synthèse</a>
        <hr>
        <a role="menuitem" href="/sitemap.xml" target="_blank" rel="noopener"><%- icon('network', { size: 16 }) %> Ouvrir sitemap.xml</a>
        <a role="menuitem" href="/robots.txt" target="_blank" rel="noopener"><%- icon('bot', { size: 16 }) %> Ouvrir robots.txt</a>
      </div>
    </div>
  </div>
</div>
