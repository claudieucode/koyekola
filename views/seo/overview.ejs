<%- include("../partials/header", { title: "SEO · Vue d'ensemble" }) %>
<div class="container-wide seo-page">
  <%- include("_nav", { active: "overview" }) %>

  <section class="content-card">
    <h2>Dernier audit</h2>
    <% if (!audits.length) { %><p>Non disponible : aucun audit n'a encore été lancé. <a class="btn btn-primary btn-sm" href="/formateur/seo/audit">Lancer le premier scan</a></p>
    <% } else { %>
      <p class="field-hint"><%= audits[0].pages %> page(s) lue(s) le <%= formatDateTime(audits[0].finished_at) %> · <%= audits[0].issues %> problème(s). <a href="/formateur/seo/audit?id=<%= audits[0].id %>">Voir le détail</a></p>
      <%- include("_scores", { scores: audits[0].scores, categories }) %>
      <% if (audits.length > 1) { %><h3>Évolution de la note globale</h3><ul class="seo-history"><% audits.slice().reverse().forEach((a) => { %><li><span><%= formatDate(a.finished_at) %></span><strong><%= a.scores && a.scores.overall ? a.scores.overall.score : "—" %></strong></li><% }) %></ul><% } %>
    <% } %>
  </section>

  <section class="content-card" id="surveillance">
    <h2>Surveillance</h2>
    <% if (!monitorAt) { %><p>Non configuré : la surveillance n'a encore jamais tourné. Elle passe chaque jour automatiquement ; vous pouvez la lancer depuis l'onglet <a href="/formateur/seo/taches#tache-monitor">Tâches</a>.</p>
    <% } else if (!alerts.length) { %><p class="form-success">Aucun changement à signaler. Dernier passage : <%= formatDateTime(monitorAt) %>.</p>
    <% } else { %>
      <p class="field-hint">Changements constatés entre deux passages (dernier : <%= formatDateTime(monitorAt) %>).</p>
      <ul class="seo-alerts">
        <% alerts.forEach((a) => { const cls = `seo-alert is-${a.severity}`; %><li class="<%= cls %>"><span class="seo-alert-sev"><%= severities[a.severity] ? severities[a.severity].label : a.severity %></span><span class="seo-alert-msg"><%= a.message %> <small class="field-hint"><%= formatDateTime(a.created_at) %></small></span>
          <form method="post" action="/formateur/seo/alertes/vues" class="inline-form"><input type="hidden" name="id" value="<%= a.id %>"><button class="btn btn-ghost btn-sm" type="submit">Vu</button></form></li><% }) %>
      </ul>
      <form method="post" action="/formateur/seo/alertes/vues" class="inline-form"><button class="btn btn-outline btn-sm" type="submit">Tout marquer comme vu</button></form>
    <% } %>
  </section>

  <section class="content-card">
    <h2>Contenus publics</h2>
    <p class="field-hint">Comptés dans la base du site. « Personnalisés » : contenus ayant au moins un réglage SEO propre ; les autres utilisent les modèles automatiques.</p>
    <div class="seo-table-wrap"><table class="seo-table">
      <thead><tr><th scope="col">Type</th><th scope="col">Pages publiques</th><th scope="col">Personnalisés</th><th scope="col"></th></tr></thead>
      <tbody>
        <% Object.entries(labels).forEach(([type, label]) => { if (!counts[type]) return; %>
          <tr><td><%= label %></td><td><%= counts[type] %></td><td><%= type === "post" ? "Réglés dans l'éditeur d'articles" : (custom[type] || 0) %></td><td><a href="/formateur/seo/contenus?type=<%= type %>">Voir</a></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </section>

  <section class="content-card">
    <h2>Configuration du site</h2>
    <ul class="seo-status">
      <% status.forEach((s) => { %><li class="<%= s.ok ? "is-ok" : "is-missing" %>"><span><%= s.label %></span><strong><%= s.value %></strong></li><% }) %>
    </ul>
    <p><a class="btn btn-outline btn-sm" href="/formateur/seo/reglages">Ouvrir les réglages</a></p>
  </section>

  <section class="content-card">
    <h2>Dernières modifications SEO</h2>
    <% if (!changes.length) { %><p class="field-hint">Aucune modification enregistrée pour l'instant.</p>
    <% } else { %><%- include("_changes", { changes, fieldLabels, showEntity: true, labels }) %><p><a href="/formateur/seo/journal">Tout le journal</a></p><% } %>
  </section>
</div>
<%- include("../partials/footer") %>
