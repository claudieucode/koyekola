<%# Carte d'une formation dans « Mon espace ». Paramètre : course (avec student_count, lesson_count, sales_count…) %>
<% const status = course.archived ? ["is-archived", "Archivée"] : course.published ? ["is-published", "Publiée"] : ["is-draft", "Brouillon"];
   const statusClass = `dash-status ${status[0]}`;
   const sold = course.sales_count > 0 || course.student_count > 0; %>
<article class="dcard">
  <a class="dcard-thumb" href="/formateur/cours/<%= course.id %>" tabindex="-1" aria-hidden="true"><% if (course.thumbnail_path) { %><img src="<%= course.thumbnail_path %>" alt="" loading="lazy" decoding="async" width="640" height="360"><% } else { %><%- icon('book', { size: 34 }) %><% } %></a>
  <div class="dcard-body">
    <h3 class="dcard-title"><a href="/formateur/cours/<%= course.id %>"><%= course.title %></a></h3>
    <div class="dcard-meta"><span class="<%= statusClass %>"><%= status[1] %></span><span class="dcard-price"><%= formatPrice(course.price_cents) %></span></div>
    <div class="dcard-meta">
      <span><%- icon('users', { size: 14 }) %> <%= course.student_count %> élève<%= course.student_count > 1 ? "s" : "" %></span>
      <span><%- icon('list', { size: 14 }) %> <%= course.lesson_count %> sous-chapitre<%= course.lesson_count > 1 ? "s" : "" %></span>
      <span><%- icon('coin', { size: 14 }) %> <%= formatAmount(course.revenue_cents) %></span>
    </div>
  </div>
  <div class="dcard-actions">
    <a href="/formateur/cours/<%= course.id %>/modifier" class="btn btn-primary btn-sm">Modifier</a>
    <% if (!course.archived) { %><a href="/cours/<%= course.slug %>" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Aperçu</a><% } %>
    <%- include("_course-menu", { course, sold }) %>
  </div>
</article>
