<%- include("../partials/header", { title: post ? "Modifier l'article" : "Nouvel article" }) %>
<%
  const v = (key, fallback = "") => (post && post[key] !== null && post[key] !== undefined ? post[key] : fallback);
  const checked = (key, fallback) => ((post ? post[key] : fallback) ? "checked" : "");
  const authorId = post && post.author_id ? post.author_id : currentUserId;
  const status = post ? post.status : "draft";
  const toUtcInput = (d) => (d ? d.replace(" ", "T").slice(0, 16) : "");
  const languageNames = { fr: "Français", en: "Anglais", es: "Espagnol", pt: "Portugais", de: "Allemand", it: "Italien", ln: "Lingala" };
  const pageData = {
    postId: post ? post.id : null, slug: post ? post.slug : "", status, publishedAt: post ? post.published_at : null, everPublished: Boolean(post && post.published_at),
    updatedAt: post ? post.updated_at : null, createdAt: post ? post.created_at : null, siteUrl, aiConfigured, newsletterReady,
    categories: categories.map((c) => c.name), subcategories, tags, courses, revisions, statuses,
    autosave: autosave ? { savedAt: autosave.saved_at, data: autosave.data } : null,
    coverPath: post ? post.cover_path : null, ogImagePath: post ? post.og_image_path : null, twitterImagePath: post ? post.twitter_image_path : null,
  };
  const json = JSON.stringify(pageData).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
%>
  <link rel="stylesheet" href="<%= asset('/css/blog-editor.css') %>">
  <div class="be" data-blog-editor>
    <form id="be-form" action="<%= post ? '/formateur/blog/' + post.id + '/modifier' : '/formateur/blog/nouveau' %>" method="post" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="content_format" value="html" data-js-only>
      <input type="hidden" name="status" value="<%= status %>" data-field="status">
      <input type="hidden" name="published_at_utc" value="" data-field="published-at">
      <input type="hidden" name="cover_media" value="" data-field="cover-media">
      <input type="hidden" name="og_image_media" value="" data-field="og-media">
      <input type="hidden" name="twitter_image_media" value="" data-field="twitter-media">
      <input type="hidden" name="remove_cover" value="" data-field="remove-cover">
      <input type="hidden" name="remove_og_image" value="" data-field="remove-og">
      <input type="hidden" name="remove_twitter_image" value="" data-field="remove-twitter">

      <div class="be-topbar">
        <a href="/formateur/blog" class="be-back"><%- icon('arrowLeft', { size: 16 }) %> Articles</a>
        <span class="be-badge" data-status-badge><%= statuses[status] %></span>
        <span class="be-save-state" role="status" aria-live="polite" data-save-state><%= saved ? "Enregistré" : post ? "Enregistré" : "Nouvel article" %></span>
        <span class="be-spacer"></span>
        <div class="be-menu-wrap">
          <button type="button" class="btn btn-outline btn-sm" data-preview-toggle aria-haspopup="true" aria-expanded="false">Aperçu</button>
          <div class="be-menu" data-preview-menu hidden>
            <button type="button" data-preview="desktop">Ordinateur</button>
            <button type="button" data-preview="tablet">Tablette</button>
            <button type="button" data-preview="mobile">Mobile</button>
            <button type="button" data-preview="google">Résultat Google</button>
            <button type="button" data-preview="social">Partage Facebook / LinkedIn / X</button>
          </div>
        </div>
        <button type="submit" class="btn btn-outline btn-sm" data-save>Enregistrer</button>
        <button type="button" class="btn btn-primary btn-sm" data-publish><%= status === "published" ? "Mettre à jour" : "Publier…" %></button>
      </div>
      <% if (saved) { %><p class="form-success be-flash" role="status">Article enregistré.<% if (post && !post.published) { %> Il reste hors ligne tant qu'il n'est pas publié.<% } %></p><% } %>
      <div class="be-restore" data-restore hidden role="alert">
        <p data-restore-text>Une version plus récente, enregistrée automatiquement, existe.</p>
        <button type="button" class="btn btn-primary btn-sm" data-restore-yes>Restaurer cette version</button>
        <button type="button" class="btn btn-ghost btn-sm" data-restore-no>Ignorer</button>
      </div>

      <div class="be-layout">
        <div class="be-main">
          <label for="post-title" class="be-label-title">Titre de l'article <span class="be-hint">(H1, unique sur la page)</span></label>
          <textarea id="post-title" name="title" class="be-title" rows="1" maxlength="150" required placeholder="Un titre clair qui dit ce que le lecteur va apprendre"><%= v('title') %></textarea>
          <label for="post-excerpt" class="be-label">Résumé <span class="be-hint">(chapeau sous le titre, liste du blog ; 300 caractères)</span></label>
          <textarea id="post-excerpt" name="excerpt" class="be-excerpt" rows="2" maxlength="300" placeholder="En deux phrases : ce que l'article apporte."><%= v('excerpt') %></textarea>

          <div class="be-toolbar" role="toolbar" aria-label="Mise en forme" data-toolbar hidden></div>
          <div class="be-selection-bar" data-block-bar hidden></div>
          <div class="be-canvas"><div id="be-editor" class="be-editor"></div></div>
          <label for="post-content" class="be-label" data-content-label>Contenu</label>
          <textarea id="post-content" name="content" rows="20" class="be-fallback"><%= editorHtml %></textarea>
          <p class="be-stats" data-stats></p>
        </div>

        <aside class="be-panels" aria-label="Réglages de l'article">
          <div class="be-tabs" role="tablist" aria-label="Panneaux">
            <% [["contenu", "Contenu"], ["seo", "SEO"], ["social", "Social"], ["structure", "Structure"], ["media", "Média"], ["publication", "Publication"], ["ia", "IA"]].forEach(([key, label], i) => { %>
              <button type="button" role="tab" id="tab-<%= key %>" aria-controls="panel-<%= key %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>" data-tab="<%= key %>"><%= label %><% if (key === "seo") { %> <span class="be-tab-dot" data-seo-dot></span><% } %></button>
            <% }) %>
          </div>

          <%# ---------- CONTENU ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-contenu" aria-labelledby="tab-contenu">
            <div class="field-group">
              <label for="post-author">Auteur</label>
              <select id="post-author" name="author_id"><% instructors.forEach((u) => { %><option value="<%= u.id %>" <%= u.id === authorId ? "selected" : "" %>><%= u.username %></option><% }) %></select>
            </div>
            <div class="field-group">
              <label for="post-category">Catégorie</label>
              <input id="post-category" type="text" name="category" value="<%= v('category') %>" maxlength="60" list="dl-categories" autocomplete="off" placeholder="Ex. Marketing digital">
              <datalist id="dl-categories"><% categories.forEach((c) => { %><option value="<%= c.name %>"><% }) %><% ["Graphisme", "Vidéo", "Intelligence artificielle", "Marketing digital", "SEO", "E-commerce", "Développement web", "Formation & apprentissage"].forEach((n) => { if (!categories.some((c) => c.name.toLowerCase() === n.toLowerCase())) { %><option value="<%= n %>"><% } }) %></datalist>
              <span class="field-hint">Une catégorie existante écrite autrement (majuscules, accents) est reconnue : pas de doublon.</span>
            </div>
            <div class="field-group">
              <label for="post-subcategory">Sous-catégorie <span class="be-hint">(facultatif)</span></label>
              <input id="post-subcategory" type="text" name="subcategory" value="<%= v('subcategory') %>" maxlength="60" list="dl-subcategories" autocomplete="off">
              <datalist id="dl-subcategories"></datalist>
            </div>
            <div class="field-group">
              <label for="post-tags-input">Étiquettes</label>
              <div class="be-tags" data-tags>
                <ul class="be-tag-list" data-tag-list></ul>
                <input id="post-tags-input" type="text" list="dl-tags" autocomplete="off" placeholder="Ajouter puis Entrée" data-tag-input>
              </div>
              <datalist id="dl-tags"><% tags.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
              <input id="post-tags" type="hidden" name="tags" value="<%= v('tags') %>" data-tags-value>
            </div>
            <div class="be-row">
              <div class="field-group">
                <label for="post-language">Langue</label>
                <select id="post-language" name="language"><% languages.forEach((l) => { %><option value="<%= l %>" <%= v('language', 'fr') === l ? "selected" : "" %>><%= languageNames[l] || l %></option><% }) %></select>
              </div>
              <div class="field-group">
                <label for="post-minutes">Temps de lecture <span class="be-hint">(min)</span></label>
                <input id="post-minutes" type="number" name="reading_minutes" min="1" max="120" value="<%= v('reading_minutes') %>" inputmode="numeric" placeholder="auto" data-minutes>
              </div>
            </div>
            <p class="field-hint" data-minutes-hint></p>
            <label class="checkbox-row"><input type="checkbox" name="featured" value="1" <%= checked('featured', 0) %>> Article vedette (affiché « À la une » en tête du blog)</label>
          </section>

          <%# ---------- SEO ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-seo" aria-labelledby="tab-seo" hidden>
            <p class="be-note">Remplissez ce que vous pouvez : chaque champ vide a une valeur par défaut raisonnable.</p>
            <div class="field-group">
              <label for="post-keyword">Mot-clé principal</label>
              <input id="post-keyword" type="text" name="focus_keyword" value="<%= v('focus_keyword') %>" maxlength="80" placeholder="Ex. formation en ligne" data-analyze>
            </div>
            <div class="field-group">
              <label for="post-keywords2">Mots-clés secondaires <span class="be-hint">(séparés par des virgules)</span></label>
              <input id="post-keywords2" type="text" name="secondary_keywords" value="<%= v('secondary_keywords') %>" maxlength="400" data-analyze>
            </div>
            <div class="field-group">
              <label for="post-seo-title">Titre SEO <span class="be-count" data-count-for="post-seo-title" data-max="60"></span></label>
              <input id="post-seo-title" type="text" name="seo_title" value="<%= v('seo_title') %>" maxlength="70" placeholder="Sinon : le titre de l'article" data-analyze>
            </div>
            <div class="field-group">
              <label for="post-seo-desc">Meta description <span class="be-count" data-count-for="post-seo-desc" data-max="160"></span></label>
              <textarea id="post-seo-desc" name="seo_description" rows="3" maxlength="160" placeholder="120 à 160 caractères qui donnent envie de cliquer" data-analyze><%= v('seo_description') %></textarea>
            </div>
            <div class="field-group">
              <label for="post-slug">Adresse (slug)</label>
              <div class="be-slug"><span>/blog/</span><input id="post-slug" type="text" name="slug" value="<%= v('slug') %>" maxlength="120" <%= post && post.published_at ? "readonly" : "" %> placeholder="tirée du titre" data-analyze></div>
              <% if (post && post.published_at) { %><span class="field-hint">Figée depuis la publication : les liens déjà partagés continuent de fonctionner.</span><% } %>
            </div>
            <div class="field-group">
              <label for="post-canonical">Adresse canonique <span class="be-hint">(seulement pour un article déjà publié ailleurs)</span></label>
              <input id="post-canonical" type="url" name="canonical_url" value="<%= v('canonical_url') %>" maxlength="500" placeholder="Vide : l'adresse de l'article" data-analyze>
            </div>
            <fieldset class="be-fieldset">
              <legend>Moteurs de recherche</legend>
              <input type="hidden" name="robots_index" value="0"><label class="checkbox-row"><input type="checkbox" name="robots_index" value="1" <%= checked('robots_index', 1) %>> Indexer (afficher dans Google)</label>
              <input type="hidden" name="robots_follow" value="0"><label class="checkbox-row"><input type="checkbox" name="robots_follow" value="1" <%= checked('robots_follow', 1) %>> Suivre les liens de l'article</label>
            </fieldset>
            <h3 class="be-h3">Aperçu Google</h3>
            <div class="be-google" data-google-preview aria-hidden="true"></div>
            <h3 class="be-h3">Analyse <span class="be-hint">— repères internes, pas un score de Google</span></h3>
            <div class="be-analysis" data-analysis aria-live="polite"></div>
          </section>

          <%# ---------- SOCIAL ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-social" aria-labelledby="tab-social" hidden>
            <h3 class="be-h3">Facebook, LinkedIn, WhatsApp (Open Graph)</h3>
            <div class="field-group"><label for="post-og-title">Titre <span class="be-count" data-count-for="post-og-title" data-max="95"></span></label><input id="post-og-title" type="text" name="og_title" value="<%= v('og_title') %>" maxlength="95" placeholder="Sinon : titre SEO ou titre"></div>
            <div class="field-group"><label for="post-og-desc">Description <span class="be-count" data-count-for="post-og-desc" data-max="200"></span></label><textarea id="post-og-desc" name="og_description" rows="2" maxlength="200" placeholder="Sinon : meta description ou résumé"><%= v('og_description') %></textarea></div>
            <div class="field-group">
              <label for="post-og-image">Image de partage <span class="be-hint">(1200 × 630 conseillé ; sinon l'image principale)</span></label>
              <div class="be-image-pick" data-image-pick="og"></div>
              <input id="post-og-image" type="file" name="og_image" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
            </div>
            <p class="field-hint">Adresse partagée : celle de l'article. Type : article.</p>
            <div class="be-social-preview" data-social-preview="og" aria-hidden="true"></div>
            <h3 class="be-h3">X (Twitter)</h3>
            <div class="field-group"><label for="post-tw-card">Format de la carte</label>
              <select id="post-tw-card" name="twitter_card"><option value="summary_large_image" <%= v('twitter_card', 'summary_large_image') !== 'summary' ? 'selected' : '' %>>Grande image</option><option value="summary" <%= v('twitter_card') === 'summary' ? 'selected' : '' %>>Petite image</option></select></div>
            <div class="field-group"><label for="post-tw-title">Titre <span class="be-count" data-count-for="post-tw-title" data-max="70"></span></label><input id="post-tw-title" type="text" name="twitter_title" value="<%= v('twitter_title') %>" maxlength="70" placeholder="Sinon : le titre de partage"></div>
            <div class="field-group"><label for="post-tw-desc">Description</label><textarea id="post-tw-desc" name="twitter_description" rows="2" maxlength="200" placeholder="Sinon : la description de partage"><%= v('twitter_description') %></textarea></div>
            <div class="field-group">
              <label for="post-tw-image">Image <span class="be-hint">(sinon l'image de partage)</span></label>
              <div class="be-image-pick" data-image-pick="twitter"></div>
              <input id="post-tw-image" type="file" name="twitter_image" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
            </div>
            <div class="be-social-preview" data-social-preview="x" aria-hidden="true"></div>
          </section>

          <%# ---------- STRUCTURE ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-structure" aria-labelledby="tab-structure" hidden>
            <h3 class="be-h3">Sommaire</h3>
            <input type="hidden" name="toc_enabled" value="0"><label class="checkbox-row"><input type="checkbox" name="toc_enabled" value="1" <%= checked('toc_enabled', 1) %> data-toc-option> Afficher un sommaire</label>
            <div class="be-row">
              <div class="field-group"><label for="post-toc-depth">Titres inclus</label><select id="post-toc-depth" name="toc_depth" data-toc-option><option value="3" <%= v('toc_depth', 3) != 2 ? 'selected' : '' %>>H2 + H3</option><option value="2" <%= v('toc_depth') == 2 ? 'selected' : '' %>>H2 seulement</option></select></div>
              <div class="field-group"><label for="post-toc-title">Titre du sommaire</label><input id="post-toc-title" type="text" name="toc_title" value="<%= v('toc_title') %>" maxlength="60" placeholder="Sommaire" data-toc-option></div>
            </div>
            <ol class="be-outline" data-outline></ol>
            <h3 class="be-h3">Fil d'Ariane</h3>
            <p class="be-crumbs" data-crumbs></p>
            <h3 class="be-h3">Données structurées (Schema.org)</h3>
            <div class="field-group"><label for="post-schema">Type d'article</label><select id="post-schema" name="schema_type"><option value="BlogPosting" <%= v('schema_type', 'BlogPosting') !== 'Article' ? 'selected' : '' %>>BlogPosting (article de blog)</option><option value="Article" <%= v('schema_type') === 'Article' ? 'selected' : '' %>>Article (contenu de fond)</option></select></div>
            <ul class="be-schema" data-schema></ul>
            <h3 class="be-h3">Maillage interne</h3>
            <p class="field-hint">Des liens vers vos formations et articles, proposés d'après le texte. Rien n'est ajouté sans votre accord : sélectionnez d'abord le mot à lier dans l'article.</p>
            <button type="button" class="btn btn-outline btn-sm" data-suggest>Proposer des liens</button>
            <ul class="be-suggestions" data-suggestions aria-live="polite"></ul>
          </section>

          <%# ---------- MÉDIA ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-media" aria-labelledby="tab-media" hidden>
            <h3 class="be-h3">Image principale</h3>
            <div class="be-image-pick" data-image-pick="cover"></div>
            <div class="field-group">
              <label for="post-cover">Envoyer une image <span class="be-hint">(1200 × 675 conseillé)</span></label>
              <input id="post-cover" type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
            </div>
            <div class="field-group">
              <label for="post-cover-alt">Texte alternatif de l'image principale</label>
              <input id="post-cover-alt" type="text" name="cover_alt" value="<%= v('cover_alt') %>" maxlength="200" placeholder="Décrivez ce que montre l'image" data-analyze>
            </div>
            <button type="button" class="btn btn-outline btn-sm" data-open-library>Ouvrir la médiathèque</button>
            <h3 class="be-h3">Images de l'article</h3>
            <ul class="be-image-list" data-image-list></ul>
          </section>

          <%# ---------- PUBLICATION ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-publication" aria-labelledby="tab-publication" hidden>
            <div class="field-group">
              <label for="post-status">Statut</label>
              <select id="post-status" data-status-select><% Object.entries(statuses).forEach(([k, label]) => { %><option value="<%= k %>" <%= status === k ? "selected" : "" %>><%= label %></option><% }) %></select>
            </div>
            <div class="field-group" data-date-group>
              <label for="post-date">Date de publication <span class="be-hint">(heure locale)</span></label>
              <input id="post-date" type="datetime-local" value="<%= toUtcInput(post ? post.published_at : null) %>" data-date-input data-utc="<%= post && post.published_at ? 1 : 0 %>">
              <span class="field-hint" data-date-hint></span>
            </div>
            <p class="be-dates" data-dates></p>
            <h3 class="be-h3">Liste de contrôle</h3>
            <ul class="be-checklist" data-checklist></ul>
            <input type="hidden" name="reviewed" value="0"><label class="checkbox-row"><input type="checkbox" name="reviewed" value="1" <%= checked('reviewed', 0) %> data-reviewed> J'ai relu l'article</label>
            <h3 class="be-h3">Historique des versions</h3>
            <ul class="be-versions" data-versions></ul>
          </section>

          <%# ---------- IA ---------- %>
          <section class="be-panel" role="tabpanel" id="panel-ia" aria-labelledby="tab-ia" hidden>
            <% if (!aiConfigured) { %>
              <div class="be-note">
                <p><strong>Assistant IA non activé.</strong> Il fonctionne avec Claude (Anthropic). Pour l'activer : créez une clé sur <a href="https://console.anthropic.com" target="_blank" rel="noopener noreferrer">console.anthropic.com</a>, puis ajoutez la variable <code>ANTHROPIC_API_KEY</code> dans la configuration de votre site sur Hostinger. Chaque demande est facturée par Anthropic (quelques centimes).</p>
              </div>
            <% } %>
            <p class="field-hint">L'IA propose, vous décidez : rien n'est modifié sans votre clic sur « Accepter ». Pour « Réécrire », « Corriger », « Développer », « Simplifier » et « Lisibilité », sélectionnez d'abord le passage dans l'article.</p>
            <div class="be-ai-actions" data-ai-actions>
              <% [["titre", "Améliorer le titre"], ["reecrire", "Réécrire"], ["corriger", "Corriger"], ["resumer", "Résumer"], ["developper", "Développer"], ["simplifier", "Simplifier"], ["lisibilite", "Lisibilité"], ["faq", "Générer une FAQ"], ["meta", "Meta description"], ["mots_cles", "Mots-clés"], ["liens", "Liens internes"]].forEach(([k, label]) => { %>
                <button type="button" class="btn btn-outline btn-sm" data-ai="<%= k %>" <%= aiConfigured ? "" : "disabled" %>><%= label %></button>
              <% }) %>
            </div>
            <div class="be-ai-result" data-ai-result aria-live="polite"></div>
          </section>
        </aside>
      </div>
    </form>
  </div>
  <script type="application/json" id="be-data"><%- json %></script>
  <script src="<%= asset('/js/blog-editor.js') %>" defer></script>

<%- include("../partials/footer") %>
