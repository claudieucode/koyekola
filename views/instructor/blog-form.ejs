<%
  // Éditeur d'article en plein écran, dans l'esprit de l'éditeur de blocs Gutenberg (WordPress) : barre supérieure, zone
  // d'écriture centrée, barre latérale « Article / Bloc », panneau d'insertion et vue en liste à gauche.
  const v = (key, fallback = "") => (post && post[key] !== null && post[key] !== undefined ? post[key] : fallback);
  const checked = (key, fallback) => ((post ? post[key] : fallback) ? "checked" : "");
  const authorId = post && post.author_id ? post.author_id : currentUserId;
  const status = post ? post.status : "draft";
  const toUtcInput = (d) => (d ? d.replace(" ", "T").slice(0, 16) : "");
  const languageNames = { fr: "Français", en: "Anglais", es: "Espagnol", pt: "Portugais", de: "Allemand", it: "Italien", ln: "Lingala" };
  const pageData = {
    postId: post ? post.id : null, slug: post ? post.slug : "", status, publishedAt: post ? post.published_at : null, everPublished: Boolean(post && post.published_at),
    updatedAt: post ? post.updated_at : null, rev: typeof rev !== "undefined" ? rev : null, createdAt: post ? post.created_at : null, siteUrl, aiConfigured, newsletterReady,
    categories: categories.map((c) => c.name), subcategories, tags, courses, revisions, revisionTotal, authors: instructors.map((u) => ({ id: u.id, name: u.username })), statuses,
    autosave: autosave ? { savedAt: autosave.saved_at, data: autosave.data } : null,
    coverPath: post ? post.cover_path : null, ogImagePath: post ? post.og_image_path : null, twitterImagePath: post ? post.twitter_image_path : null,
    editorTheme, editorThemes, seoWorkspace, editorPrefs, funScript: asset('/js/seo-fun.js'), weekStart: typeof weekStart !== "undefined" ? weekStart : "monday",
  };
  const json = JSON.stringify(pageData).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
  const panel = (key, title, open) => `<div class="wp-panel${open ? " is-open" : ""}" data-panel="${key}"><h2 class="wp-panel-title"><button type="button" aria-expanded="${open ? "true" : "false"}" aria-controls="wp-panel-${key}" data-panel-toggle>${title}<span class="wp-chevron" aria-hidden="true"></span></button></h2><div class="wp-panel-body" id="wp-panel-${key}"${open ? "" : " hidden"}>`;
%><!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <%# Doublon de l'en-tête HTTP (le CDN de l'hébergeur remplace la politique envoyée par le serveur) %>
  <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= post ? `Modifier l'article « ${post.title} »` : "Nouvel article" %> · KOLAKISA</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%- include("../partials/font-preload") %>
  <script src="<%= asset('/js/kb-motion.js') %>" defer></script>
  <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/blog-editor.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/media-picker.css') %>">
  <meta name="mk-media-site" content="<%= siteId ? siteId : "principal" %>"><%# MEDIA-ROUTING : médiathèque de l'article (son site, ou le site principal) %>
  <link rel="stylesheet" href="<%= asset('/css/taxonomy-picker.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/kola-brand-editors.css') %>">
</head>
<body class="wp-body"<%- editorTheme.key !== "clair" ? ` data-ed-theme="${editorTheme.key}" data-ed-contrast="${editorTheme.contrast}" style="--ed-base: ${editorTheme.color}"` : "" %>>
  <div class="be wp" data-blog-editor>
    <%# Titre de la page pour les lecteurs d'écran (le titre visible est le champ « Titre de l'article ») %>
    <h1 class="sr-only"><%= post ? "Modifier l'article" : "Nouvel article" %></h1>
    <form id="be-form"<%- siteId ? ' data-site="' + siteId + '"' : "" %> action="<%= post ? '/formateur/blog/' + post.id + '/modifier' : '/formateur/blog/nouveau' + (siteId ? '?site=' + siteId : '') %>" method="post" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="content_format" value="html">
      <input type="hidden" name="status" value="<%= status %>" data-field="status">
      <input type="hidden" name="published_at_utc" value="" data-field="published-at">
      <input type="hidden" name="cover_media" value="">
      <input type="hidden" name="og_image_media" value="">
      <input type="hidden" name="twitter_image_media" value="">
      <input type="hidden" name="remove_cover" value="">
      <input type="hidden" name="remove_og_image" value="">
      <input type="hidden" name="remove_twitter_image" value="">


      <%# ---------- Barre supérieure ---------- %>
      <header class="wp-header" role="region" aria-label="Barre d'outils de l'éditeur">
        <a href="<%= siteId ? '/marketing/site-web/articles?site=' + siteId : (restrictedSite ? '/marketing/site-web/articles?site=' + restrictedSite : '/formateur/blog') %>" class="wp-site-icon" aria-label="KOLAKISA Blog Studio : retour aux articles" title="Retour aux articles"><span class="wp-brand-mark" aria-hidden="true">K</span><span class="wp-brand-name" aria-hidden="true">KOLAKISA<small>Blog Studio</small></span></a>
        <div class="wp-header-left">
          <button type="button" class="wp-btn-icon wp-inserter-toggle" data-toggle-inserter aria-pressed="false" aria-label="Ajouter un bloc" title="Ajouter un bloc"><%- icon("plus", { size: 20 }) %></button>
          <button type="button" class="wp-btn-icon" data-undo aria-label="Annuler" title="Annuler (Ctrl+Z)"><%- icon("undo", { size: 20 }) %></button>
          <button type="button" class="wp-btn-icon" data-redo aria-label="Rétablir" title="Rétablir (Ctrl+Maj+Z)"><%- icon("redo", { size: 20 }) %></button>
          <%# Mode d'édition : deux interfaces pour le MÊME article (même contenu, même enregistrement) %>
          <div class="wp-mode-switch" role="radiogroup" aria-label="Mode d'édition">
            <button type="button" role="radio" aria-checked="true" data-edit-mode="blocks" title="Construction par blocs"><%- icon("layers", { size: 16 }) %><span>Blocs</span></button>
            <button type="button" role="radio" aria-checked="false" data-edit-mode="document" title="Rédaction documentaire (traitement de texte)"><%- icon("fileText", { size: 16 }) %><span>Document</span></button>
          </div>
        </div>
        <div class="wp-header-center">
          <button type="button" class="wp-document-bar" data-focus-title><span class="wp-doc-title" data-doc-title><%= v('title') || "Sans titre" %></span><span class="wp-doc-status" data-doc-status data-status="<%= status %>"><%= statuses[status] || status %></span><span class="wp-doc-stats" data-stats></span></button>
        </div>
        <div class="wp-header-right">
          <span class="wp-save-state" role="status" aria-live="polite" data-save-state><%= saved || post ? "Enregistré" : "" %></span>
          <button type="submit" class="wp-btn-tertiary" data-save>Enregistrer<span class="wp-btn-long"> le brouillon</span></button>
          <div class="wp-dropdown wp-preview-dropdown">
            <button type="button" class="wp-btn-icon" data-preview-toggle aria-haspopup="true" aria-expanded="false" aria-label="Aperçu" title="Aperçu"><%- icon("monitor", { size: 20 }) %></button>
            <div class="wp-menu" data-preview-menu hidden role="menu">
              <p class="wp-menu-label">Largeur de la zone d'écriture</p>
              <button type="button" role="menuitemradio" aria-checked="true" data-preview="desktop">Ordinateur</button>
              <button type="button" role="menuitemradio" aria-checked="false" data-preview="tablet">Tablette</button>
              <button type="button" role="menuitemradio" aria-checked="false" data-preview="mobile">Mobile</button>
              <hr>
              <button type="button" role="menuitem" data-preview="frame">Aperçu du site dans une fenêtre</button>
              <button type="button" role="menuitem" data-preview="tab">Prévisualiser dans un nouvel onglet ↗</button>
              <button type="button" role="menuitem" data-preview="google">Aperçu dans Google</button>
              <button type="button" role="menuitem" data-preview="social">Aperçu sur les réseaux sociaux</button>
            </div>
          </div>
          <a class="wp-btn-secondary wp-view-post" data-view-post href="<%= post ? '/blog/' + post.slug : '#' %>" target="_blank" rel="noopener" <%= post && post.published ? "" : "hidden" %> title="Ouvrir l'article sur le site, comme le voient les visiteurs">Voir l'article <span aria-hidden="true">↗</span></a>
          <button type="button" class="wp-btn-primary" data-publish><%= status === "published" ? "Mettre à jour" : status === "scheduled" ? "Planifier…" : "Publier" %></button>
          <button type="button" class="wp-btn-icon" data-toggle-sidebar aria-pressed="true" aria-label="Réglages" title="Réglages"><%- icon("sliders", { size: 20 }) %></button>
          <div class="wp-dropdown wsp-menu-wrap">
            <button type="button" class="wp-btn-icon" data-wsp-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Espace de travail SEO" title="Espace de travail SEO (Cmd+Maj+K : commandes)"><%- icon("layout", { size: 20 }) %></button>
            <div class="wp-menu wsp-menu" data-wsp-menu hidden role="menu" aria-label="Espace de travail SEO"></div>
          </div>
          <div class="wp-dropdown">
            <button type="button" class="wp-btn-icon" data-options-toggle aria-haspopup="true" aria-expanded="false" aria-label="Options" title="Options"><%- icon("moreVertical", { size: 20 }) %></button>
            <div class="wp-menu" data-options-menu hidden role="menu">
              <p class="wp-menu-label">Éditeur</p>
              <button type="button" role="menuitemradio" aria-checked="true" data-mode="visual">Éditeur visuel</button>
              <button type="button" role="menuitemradio" aria-checked="false" data-mode="code">Éditeur de code</button>
              <hr>
              <p class="wp-menu-label">Affichage</p>
              <button type="button" role="menuitemcheckbox" aria-checked="false" data-option="focus">Mode concentration</button>
              <button type="button" role="menuitemcheckbox" aria-checked="false" data-option="toptoolbar">Barre d'outils fixe en haut</button>
              <button type="button" role="menuitemcheckbox" aria-checked="false" data-option="distraction">Mode sans distraction<kbd>Ctrl+Maj+\</kbd></button>
              <button type="button" role="menuitem" data-option="fullscreen">Plein écran<kbd>Ctrl+Maj+Alt+F</kbd></button>
              <hr>
              <p class="wp-menu-label wp-mobile-only">Aperçu</p>
              <button type="button" role="menuitem" class="wp-mobile-only" data-preview="tab">Prévisualiser l'article ↗</button>
              <button type="button" role="menuitem" class="wp-mobile-only" data-preview="frame">Aperçu du site</button>
              <hr class="wp-mobile-only">
              <button type="button" role="menuitem" data-option="settings">⚙ Réglages de l'éditeur…</button>
              <button type="button" role="menuitem" data-option="appearance">Apparence de l'éditeur…</button>
              <button type="button" role="menuitem" data-option="shortcuts">Raccourcis clavier</button>
              <a role="menuitem" href="<%= siteId ? '/marketing/site-web/articles?site=' + siteId : (restrictedSite ? '/marketing/site-web/articles?site=' + restrictedSite : '/formateur/blog') %>">Retour aux articles</a>
              <a role="menuitem" href="/formateur">Mon espace (vue d'ensemble)</a>
            </div>
          </div>
        </div>
      </header>
      <% if (saved) { %><p class="wp-notice wp-notice-success" role="status" data-notice>Article enregistré.<% if (post && !post.published) { %> Il reste hors ligne tant qu'il n'est pas publié.<% } %> <button type="button" class="wp-notice-close" aria-label="Fermer" data-notice-close>×</button></p><% } %>
      <div class="wp-notice wp-notice-warning" data-restore hidden role="alert">
        <span data-restore-text>Une version plus récente, enregistrée automatiquement, existe.</span>
        <button type="button" class="wp-btn-link" data-restore-yes>Restaurer la sauvegarde</button>
        <button type="button" class="wp-btn-link" data-restore-no>Ignorer</button>
      </div>

      <div class="wp-layout">
        <%# ---------- Rail d'outils (gauche) ---------- %>
        <nav class="wp-rail" aria-label="Outils">
          <button type="button" class="wp-rail-btn" data-rail="list" aria-pressed="false" title="Structure de l'article"><span class="wp-rail-icon" aria-hidden="true"><%- icon("layers", { size: 20 }) %></span><span class="wp-rail-label">Structure</span></button>
          <button type="button" class="wp-rail-btn" data-rail="media" aria-pressed="false" title="Médias de l'article"><span class="wp-rail-icon" aria-hidden="true"><%- icon("image", { size: 20 }) %></span><span class="wp-rail-label">Médias</span></button>
          <button type="button" class="wp-rail-btn" data-rail="seo" aria-pressed="false" title="Référencement (SEO)"><span class="wp-rail-icon" aria-hidden="true"><%- icon("searchCheck", { size: 20 }) %></span><span class="wp-rail-label">SEO</span><span class="wp-rail-score" data-rail-score></span></button>
          <button type="button" class="wp-rail-btn" data-rail="ai" aria-pressed="false" title="Assistant IA"><span class="wp-rail-icon" aria-hidden="true"><%- icon("bot", { size: 20 }) %></span><span class="wp-rail-label">IA</span></button>
        </nav>

        <%# ---------- Panneau gauche : insertion, structure, médias, IA ---------- %>
        <aside class="wp-secondary" data-secondary hidden aria-label="Panneau latéral gauche">
          <div class="wp-secondary-head"><span data-secondary-title></span><button type="button" class="wp-btn-icon" data-secondary-close aria-label="Fermer le panneau">×</button></div>
          <div class="wp-secondary-dynamic" data-secondary-dynamic></div>
          <div class="wp-secondary-body" data-secondary-view="media" hidden>
            <p class="wp-help">Les images utilisées dans l'article. Un texte alternatif manquant est signalé.</p>
            <ul class="be-image-list" data-image-list></ul>
            <button type="button" class="wp-btn-secondary" data-open-library>Ouvrir la médiathèque</button>
          </div>
          <div class="wp-secondary-body" data-secondary-view="ai" hidden>
            <% if (!aiConfigured) { %>
              <p class="wp-help"><strong>Non activé.</strong> Créez une clé sur <a href="https://console.anthropic.com" target="_blank" rel="noopener noreferrer">console.anthropic.com</a>, puis ajoutez la variable <code>ANTHROPIC_API_KEY</code> dans la configuration du site sur Hostinger (quelques centimes par demande).</p>
            <% } %>
            <p class="wp-help">L'IA propose, vous décidez : rien ne change sans votre clic sur « Accepter ». Pour Réécrire, Corriger, Développer, Simplifier et Lisibilité, sélectionnez d'abord le passage.</p>
            <div class="be-ai-actions" data-ai-actions>
              <% [["titre", "Améliorer le titre"], ["reecrire", "Réécrire"], ["corriger", "Corriger"], ["resumer", "Résumer"], ["developper", "Développer"], ["simplifier", "Simplifier"], ["lisibilite", "Lisibilité"], ["faq", "Générer une FAQ"], ["meta", "Méta description"], ["mots_cles", "Mots-clés"], ["liens", "Liens internes"]].forEach(([k, label]) => { %>
                <button type="button" class="wp-btn-secondary" data-ai="<%= k %>" <%= aiConfigured ? "" : "disabled" %>><%= label %></button>
              <% }) %>
            </div>
            <div class="be-ai-result" data-ai-result aria-live="polite"></div>
          </div>
        </aside>

        <%# ---------- Espace de travail SEO : zone d'ancrage gauche (vide par défaut) ---------- %>
        <div class="wsp-dock wsp-dock-side wsp-dock-left" data-dock="left" hidden role="region" aria-label="Panneaux SEO ancrés à gauche"></div>

        <div class="wsp-center" data-wsp-center>
        <%# ---------- Zone d'écriture ---------- %>
        <div class="wp-canvas" data-canvas>
          <div class="wp-top-toolbar" data-top-toolbar hidden></div>
          <div class="wp-content">
            <label for="post-title" class="sr-only">Titre de l'article</label>
            <textarea id="post-title" name="title" class="wp-title" rows="1" maxlength="150" required placeholder="Ajouter un titre"><%= v('title') %></textarea>
            <div class="wp-block-toolbar" data-block-toolbar hidden role="toolbar" aria-label="Outils du bloc"></div>
            <div id="be-editor" class="wp-editor"></div>
            <label for="post-content" class="sr-only" data-content-label>Contenu (HTML)</label>
            <textarea id="post-content" name="content" rows="24" class="wp-code-editor" placeholder="Saisissez le code HTML de l'article"><%= editorHtml %></textarea>
          </div>
        </div>

        <%# ---------- Espace de travail SEO : zone d'ancrage basse, fenêtres flottantes, panneaux fermés ---------- %>
        <div class="wsp-dock wsp-dock-bottom" data-dock="bottom" hidden role="region" aria-label="Panneaux SEO ancrés en bas"></div>
        </div>
        <div class="wsp-float-layer" data-wsp-floats></div>
        <div class="wsp-parking" data-wsp-parking hidden></div>

        <%# ---------- Barre latérale : Article / SEO / Bloc ---------- %>
        <aside class="wp-sidebar" data-sidebar aria-label="Réglages de l'éditeur">
          <div class="wp-sidebar-tabs" role="tablist">
            <button type="button" role="tab" id="tab-article" aria-controls="panel-article" aria-selected="true" data-sidebar-tab="article">Article</button>
            <button type="button" role="tab" id="tab-seo" aria-controls="panel-seo" aria-selected="false" tabindex="-1" data-sidebar-tab="seo">SEO <span class="be-tab-dot" data-seo-dot></span></button>
            <button type="button" role="tab" id="tab-bloc" aria-controls="panel-bloc" aria-selected="false" tabindex="-1" data-sidebar-tab="bloc">Bloc</button>
            <button type="button" role="tab" id="tab-notes" aria-controls="panel-notes" aria-selected="false" tabindex="-1" data-sidebar-tab="notes">Notes <span class="be-tab-dot" data-notes-dot hidden></span></button>
            <button type="button" class="wp-btn-icon wp-sidebar-close" data-toggle-sidebar aria-label="Fermer les réglages" title="Fermer les réglages">×</button>
          </div>

          <%# ===== Onglet Article ===== %>
          <div role="tabpanel" id="panel-article" aria-labelledby="tab-article" data-sidebar-panel="article">
            <div class="wp-post-card">
              <div class="wp-image-pick" data-image-pick="cover"></div>
              <label for="post-cover" class="sr-only">Téléverser l'image mise en avant</label>
              <input id="post-cover" class="wp-file" type="file" name="thumbnail" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
              <label for="post-cover-alt" class="wp-label">Texte alternatif de l'image</label>
              <input id="post-cover-alt" type="text" name="cover_alt" value="<%= v('cover_alt') %>" maxlength="200" placeholder="Décrivez ce que montre l'image" data-analyze>
              <p class="wp-post-card-title" data-card-title><%= v('title') || "Sans titre" %></p>
              <p class="wp-post-card-meta" data-dates></p>
              <label for="post-excerpt" class="wp-label">Extrait</label>
              <textarea id="post-excerpt" name="excerpt" rows="3" maxlength="300" placeholder="Ajouter un extrait…"><%= v('excerpt') %></textarea>
              <span class="wp-help">Chapeau sous le titre et résumé dans la liste du blog (300 caractères).</span>
            </div>
            <div class="wp-summary">
              <div class="wp-summary-row"><label for="post-status">Statut</label>
                <select id="post-status" data-status-select><% Object.entries(statuses).forEach(([k, label]) => { %><option value="<%= k %>" <%= status === k ? "selected" : "" %>><%= label %></option><% }) %></select></div>
              <div class="wp-summary-row"><label for="post-date">Publication</label>
                <input id="post-date" type="datetime-local" value="<%= toUtcInput(post ? post.published_at : null) %>" data-date-input data-utc="<%= post && post.published_at ? 1 : 0 %>" aria-describedby="post-date-hint"></div>
              <p class="wp-help" id="post-date-hint" data-date-hint></p>
              <div class="wp-summary-row"><label for="post-slug">Lien</label>
                <span class="wp-slug"><span>/blog/</span><input id="post-slug" type="text" name="slug" value="<%= v('slug') %>" maxlength="120" placeholder="tiré du titre" aria-describedby="post-slug-hint" data-analyze></span></div>
              <p class="wp-help" id="post-slug-hint" data-slug-hint><%= post && post.published_at ? "Article en ligne : si vous changez le lien, l'ancienne adresse redirigera vers la nouvelle." : "Lettres, chiffres et tirets ; vide = tiré du titre." %></p>
              <div class="wp-summary-row"><label for="post-author">Auteur</label>
                <select id="post-author" name="author_id"><% instructors.forEach((u) => { %><option value="<%= u.id %>" <%= u.id === authorId ? "selected" : "" %>><%= u.username %></option><% }) %></select></div>
              <div class="wp-summary-row"><label for="post-language">Langue</label>
                <select id="post-language" name="language"><% languages.forEach((l) => { %><option value="<%= l %>" <%= v('language', 'fr') === l ? "selected" : "" %>><%= languageNames[l] || l %></option><% }) %></select></div>
              <label class="wp-checkbox"><input type="checkbox" name="featured" value="1" <%= checked('featured', 0) %>> Mettre en avant (« À la une » sur le blog)</label>
              <input type="hidden" name="comments_enabled" value="0"><label class="wp-checkbox"><input type="checkbox" name="comments_enabled" value="1" <%= checked('comments_enabled', 1) %>> Autoriser les commentaires (membres inscrits)</label>
            </div>

            <%- panel("categories", "Catégories et étiquettes", true) %>
              <%# Classement par la taxonomie du CMS (public/js/taxonomy-picker.js) : catégorie principale, catégories, étiquettes avec
                  recherche et création rapide. Les anciens champs texte restent dans la page (masqués) : l'éditeur les lit encore ; le
                  sélecteur les tient à jour (miroir) et l'enregistrement utilise les identifiants. %>
              <div class="tx-picker" data-taxo>
                <script type="application/json" id="taxo-data"><%- JSON.stringify(taxo).replace(/</g, "\\u003c") %></script>
                <label class="wp-label" for="tx-primary">Catégorie principale</label>
                <select id="tx-primary" name="primary_category_id" data-taxo-primary></select>
                <span class="wp-label" id="tx-cats-label">Catégories</span>
                <input type="search" class="tx-search" placeholder="Rechercher une catégorie…" aria-label="Rechercher une catégorie" data-taxo-cat-search autocomplete="off">
                <ul class="tx-cats" aria-labelledby="tx-cats-label" data-taxo-cats></ul>
                <input type="hidden" name="category_ids" data-taxo-category-ids>
                <details class="tx-new" data-taxo-new>
                  <summary>Ajouter une catégorie</summary>
                  <div class="tx-new-body">
                    <label class="wp-label" for="tx-new-name">Nom</label><input id="tx-new-name" type="text" maxlength="60" data-taxo-new-name autocomplete="off">
                    <label class="wp-label" for="tx-new-parent">Catégorie parente</label><select id="tx-new-parent" data-taxo-new-parent></select>
                    <button type="button" class="wp-btn-secondary" data-taxo-new-add>Créer la catégorie</button>
                    <p class="wp-help" role="status" aria-live="polite" data-taxo-new-status></p>
                  </div>
                </details>
                <label class="wp-label" for="tx-tag-input">Étiquettes</label>
                <ul class="tx-tags" data-taxo-tags aria-label="Étiquettes choisies"></ul>
                <div class="tx-tag-box"><input id="tx-tag-input" type="text" maxlength="40" placeholder="Ajouter une étiquette…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="tx-suggest" aria-autocomplete="list" data-taxo-tag-input>
                  <ul id="tx-suggest" class="tx-suggest" role="listbox" aria-label="Suggestions d'étiquettes" hidden data-taxo-suggest></ul></div>
                <input type="hidden" name="tag_ids" data-taxo-tag-ids>
                <p class="wp-help" role="status" aria-live="polite" data-taxo-status>Entrée pour ajouter ; une étiquette qui n'existe pas est créée.</p>
              </div>
              <div hidden data-legacy-taxonomy>
              <label for="post-category" class="wp-label">Catégorie</label>
              <input id="post-category" type="text" name="category" value="<%= v('category') %>" maxlength="60" list="dl-categories" autocomplete="off" placeholder="Rechercher ou créer une catégorie">
              <datalist id="dl-categories"><% categories.forEach((c) => { %><option value="<%= c.name %>"><% }) %><% ["Graphisme", "Vidéo", "Intelligence artificielle", "Marketing digital", "SEO", "E-commerce", "Développement web", "Formation & apprentissage"].forEach((n) => { if (!categories.some((c) => c.name.toLowerCase() === n.toLowerCase())) { %><option value="<%= n %>"><% } }) %></datalist>
              <ul class="wp-term-list" data-category-list><% categories.forEach((c) => { %><li><button type="button" class="wp-btn-link" data-pick-category="<%= c.name %>"><%= c.name %></button> <span class="wp-help">(<%= c.count %>)</span></li><% }) %></ul>
              <label for="post-subcategory" class="wp-label">Sous-catégorie</label>
              <input id="post-subcategory" type="text" name="subcategory" value="<%= v('subcategory') %>" maxlength="60" list="dl-subcategories" autocomplete="off">
              <datalist id="dl-subcategories"></datalist>
              <label for="post-tags-input" class="wp-label">Étiquettes</label>
              <div class="wp-tokens" data-tags><ul class="wp-token-list" data-tag-list></ul><input id="post-tags-input" type="text" list="dl-tags" autocomplete="off" placeholder="Ajouter…" data-tag-input></div>
              <datalist id="dl-tags"><% tags.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
              <input id="post-tags" type="hidden" name="tags" value="<%= v('tags') %>" data-tags-value>
              <span class="wp-help">Virgule ou Entrée pour valider une étiquette.</span></div>
            </div></div>

            <%- panel("checklist", "Avant de publier", false) %>
              <ul class="be-checklist" data-checklist></ul>
              <input type="hidden" name="reviewed" value="0"><label class="wp-checkbox"><input type="checkbox" name="reviewed" value="1" <%= checked('reviewed', 0) %> data-reviewed> J'ai relu l'article</label>
            </div></div>

            <%- panel("revisions", 'Révisions <span class="wp-count" data-revision-count></span>', false) %>
              <ul class="be-versions" data-versions></ul>
            </div></div>
          </div>

          <%# ===== Onglet SEO ===== %>
          <div role="tabpanel" id="panel-seo" aria-labelledby="tab-seo" data-sidebar-panel="seo" hidden>
            <div class="wsp-dock-right" data-dock="right">
            <%- panel("score", "Note SEO", true) %>
              <div class="wp-seo-score" data-seo-score>
                <svg class="wp-seo-ring" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" class="wp-seo-ring-bg"/><circle cx="32" cy="32" r="27" class="wp-seo-ring-value" data-seo-ring/></svg>
                <div><p class="wp-seo-score-value"><span data-seo-value>–</span><small> / 100</small></p><p class="wp-help" data-seo-verdict>Repère interne, pas une note de Google.</p></div>
              </div>
              <div class="wsp-factors" data-seo-factors></div>
            </div></div>

            <%- panel("reco", "Recommandations", true) %>
              <div class="wp-seo-todo" data-seo-todo></div>
            </div></div>

            <%- panel("seo-site", "Exploration du site (audit)", true) %>
              <p class="wp-help">Problèmes trouvés sur la page publiée de cet article par l'audit de Mon espace → SEO, et analyse à la demande de la page réellement en ligne.</p>
              <div class="wp-seo-site" data-seo-site aria-live="polite"></div>
              <div class="wp-seo-site-actions">
                <button type="button" class="wp-btn-secondary" data-seo-analyse>Analyser la page en ligne</button>
                <a class="wp-btn-link" href="/formateur/seo" target="_blank" rel="noopener" data-seo-space>Ouvrir l'espace SEO</a>
              </div>
            </div></div>

            <%- panel("keyword", "Mots-clés", true) %>
              <label for="post-keyword" class="wp-label">Mot-clé principal</label>
              <input id="post-keyword" type="text" name="focus_keyword" value="<%= v('focus_keyword') %>" maxlength="80" placeholder="Ex. formation en ligne" data-analyze>
              <label for="post-keywords2" class="wp-label">Mots-clés secondaires</label>
              <input id="post-keywords2" type="text" name="secondary_keywords" value="<%= v('secondary_keywords') %>" maxlength="400" placeholder="Séparés par des virgules" data-analyze>
              <div class="wsp-kw" data-wsp-keywords aria-live="polite"></div>
              <div class="wsp-kw-gsc" data-wsp-keywords-gsc></div>
            </div></div>

            <%- panel("google", "Apparence dans Google", true) %>
              <div class="wp-segmented wp-google-device" role="group" aria-label="Appareil"><button type="button" aria-pressed="true" data-google-device="desktop">Ordinateur</button><button type="button" aria-pressed="false" data-google-device="mobile">Mobile</button></div>
              <div class="be-google" data-google-preview aria-hidden="true"></div>
              <label for="post-seo-title" class="wp-label">Titre SEO <span class="be-count" data-count-for="post-seo-title" data-max="60"></span></label>
              <input id="post-seo-title" type="text" name="seo_title" value="<%= v('seo_title') %>" maxlength="70" placeholder="Sinon : le titre de l'article" data-analyze>
              <span class="wp-meter" data-meter-for="post-seo-title" data-min="30" data-max="60"><span></span></span>
              <label for="post-seo-desc" class="wp-label">Méta description <span class="be-count" data-count-for="post-seo-desc" data-max="160"></span></label>
              <textarea id="post-seo-desc" name="seo_description" rows="3" maxlength="160" placeholder="120 à 160 caractères qui donnent envie de cliquer" data-analyze><%= v('seo_description') %></textarea>
              <span class="wp-meter" data-meter-for="post-seo-desc" data-min="120" data-max="160"><span></span></span>
              <p class="wp-help">Adresse : <strong data-seo-slug></strong> — se modifie dans l'onglet Article (champ « Lien »).</p>
            </div></div>

            <%- panel("analysis", "Analyse du contenu", false) %>
              <dl class="wsp-stats" data-wsp-content></dl>
              <div class="be-analysis" data-analysis aria-live="polite"></div>
            </div></div>

            <%- panel("social", "Aperçu social", false) %>
              <label for="post-og-title" class="wp-label">Titre (Facebook, LinkedIn, WhatsApp) <span class="be-count" data-count-for="post-og-title" data-max="95"></span></label>
              <input id="post-og-title" type="text" name="og_title" value="<%= v('og_title') %>" maxlength="95" placeholder="Sinon : titre SEO ou titre">
              <label for="post-og-desc" class="wp-label">Description <span class="be-count" data-count-for="post-og-desc" data-max="200"></span></label>
              <textarea id="post-og-desc" name="og_description" rows="2" maxlength="200" placeholder="Sinon : méta description ou extrait"><%= v('og_description') %></textarea>
              <p class="wp-label">Image de partage <span class="wp-help">(1200 × 630 ; sinon l'image mise en avant)</span></p>
              <div class="wp-image-pick" data-image-pick="og"></div>
              <label for="post-og-image" class="sr-only">Téléverser l'image de partage</label>
              <input id="post-og-image" class="wp-file" type="file" name="og_image" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
              <div class="be-social-preview" data-social-preview="og" aria-hidden="true"></div>
              <label for="post-tw-card" class="wp-label">Carte X (Twitter)</label>
              <select id="post-tw-card" name="twitter_card"><option value="summary_large_image" <%= v('twitter_card', 'summary_large_image') !== 'summary' ? 'selected' : '' %>>Grande image</option><option value="summary" <%= v('twitter_card') === 'summary' ? 'selected' : '' %>>Petite image</option></select>
              <label for="post-tw-title" class="wp-label">Titre sur X <span class="be-count" data-count-for="post-tw-title" data-max="70"></span></label>
              <input id="post-tw-title" type="text" name="twitter_title" value="<%= v('twitter_title') %>" maxlength="70" placeholder="Sinon : le titre de partage">
              <label for="post-tw-desc" class="wp-label">Description sur X</label>
              <textarea id="post-tw-desc" name="twitter_description" rows="2" maxlength="200" placeholder="Sinon : la description de partage"><%= v('twitter_description') %></textarea>
              <p class="wp-label">Image sur X</p>
              <div class="wp-image-pick" data-image-pick="twitter"></div>
              <label for="post-tw-image" class="sr-only">Téléverser l'image pour X</label>
              <input id="post-tw-image" class="wp-file" type="file" name="twitter_image" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
              <div class="be-social-preview" data-social-preview="x" aria-hidden="true"></div>
            </div></div>

            <%- panel("structure", "Sommaire et données structurées", false) %>
              <input type="hidden" name="toc_enabled" value="0"><label class="wp-checkbox"><input type="checkbox" name="toc_enabled" value="1" <%= checked('toc_enabled', 1) %> data-toc-option> Afficher un sommaire</label>
              <label for="post-toc-depth" class="wp-label">Titres inclus</label>
              <select id="post-toc-depth" name="toc_depth" data-toc-option><option value="3" <%= v('toc_depth', 3) == 3 ? 'selected' : '' %>>H2 + H3</option><option value="2" <%= v('toc_depth') == 2 ? 'selected' : '' %>>H2 seulement</option><option value="4" <%= v('toc_depth') == 4 ? 'selected' : '' %>>H2 → H4</option></select>
              <label for="post-toc-numbering" class="wp-label">Numérotation</label>
              <select id="post-toc-numbering" name="toc_numbering" data-toc-option><option value="h2" <%= v('toc_numbering', 'h2') === 'h2' ? 'selected' : '' %>>Parties seulement (01, 02…)</option><option value="full" <%= v('toc_numbering') === 'full' ? 'selected' : '' %>>Hiérarchique (1, 1.1, 1.1.1)</option><option value="none" <%= v('toc_numbering') === 'none' ? 'selected' : '' %>>Aucune</option></select>
              <label for="post-toc-title" class="wp-label">Titre du sommaire</label>
              <input id="post-toc-title" type="text" name="toc_title" value="<%= v('toc_title') %>" maxlength="60" placeholder="Sommaire" data-toc-option>
              <p class="wp-label">Fil d'Ariane</p>
              <p class="be-crumbs" data-crumbs></p>
              <label for="post-schema" class="wp-label">Type de données structurées</label>
              <select id="post-schema" name="schema_type"><option value="BlogPosting" <%= v('schema_type', 'BlogPosting') !== 'Article' ? 'selected' : '' %>>BlogPosting (article de blog)</option><option value="Article" <%= v('schema_type') === 'Article' ? 'selected' : '' %>>Article (contenu de fond)</option></select>
              <ul class="be-schema" data-schema></ul>
            </div></div>

            <%- panel("links", "Liens internes", false) %>
              <p class="wp-help">Liens proposés d'après le texte. Sélectionnez d'abord le mot à lier dans l'article.</p>
              <button type="button" class="wp-btn-secondary" data-suggest>Proposer des liens</button>
              <ul class="be-suggestions" data-suggestions aria-live="polite"></ul>
            </div></div>

            <%- panel("indexing", "Indexation et lecture", false) %>
              <label for="post-canonical" class="wp-label">URL canonique</label>
              <input id="post-canonical" type="url" name="canonical_url" value="<%= v('canonical_url') %>" maxlength="500" placeholder="Vide : l'adresse de l'article" data-analyze>
              <input type="hidden" name="robots_index" value="0"><label class="wp-checkbox"><input type="checkbox" name="robots_index" value="1" <%= checked('robots_index', 1) %>> Autoriser les moteurs de recherche à afficher l'article</label>
              <input type="hidden" name="robots_follow" value="0"><label class="wp-checkbox"><input type="checkbox" name="robots_follow" value="1" <%= checked('robots_follow', 1) %>> Suivre les liens de l'article</label>
              <label for="post-minutes" class="wp-label">Temps de lecture (minutes) <span class="wp-help">— vide = automatique</span></label>
              <input id="post-minutes" type="number" name="reading_minutes" min="1" max="120" value="<%= v('reading_minutes') %>" inputmode="numeric" placeholder="auto">
              <p class="wp-help" data-minutes-hint></p>
            </div></div>

            <%- panel("seo-history", "Historique SEO", false) %>
              <p class="wp-help">Chaque modification SEO enregistrée de cet article : qui, quand, avant → après. Aussi dans Mon espace → SEO → Journal.</p>
              <ul class="be-versions" data-seo-history></ul>
            </div></div>

            <%- panel("opportunities", "Opportunités", false) %>
              <p class="wp-help">Uniquement ce que le moteur a réellement détecté (audit du site, Search Console), avec la source de chaque élément.</p>
              <div data-wsp-part="opportunities" aria-live="polite"></div>
            </div></div>

            <%- panel("technical", "SEO technique", false) %>
              <p class="wp-help">Page réellement servie aux visiteurs : statut, canonical, robots, plan du site, redirections, données structurées.</p>
              <div data-wsp-part="technical" aria-live="polite"></div>
            </div></div>

            <%- panel("images", "Images", false) %>
              <p class="wp-help">Images du texte en cours : fichier présent sur le site, dimensions, poids, texte alternatif.</p>
              <div data-wsp-part="images" aria-live="polite"></div>
            </div></div>

            <%- panel("performance", "Performance", false) %>
              <p class="wp-help">Vitesse de la page de l'article mesurée par Google PageSpeed Insights.</p>
              <div data-wsp-part="performance" aria-live="polite"></div>
            </div></div>

            <%- panel("gsc", "Search Console", false) %>
              <p class="wp-help">Clics, impressions, position et recherches de cette page, d'après Google Search Console.</p>
              <div data-wsp-part="gsc" aria-live="polite"></div>
            </div></div>

            <%- panel("external", "Données externes", false) %>
              <p class="wp-help">Services réellement intégrés au site et leur état vérifié.</p>
              <div data-wsp-part="external" aria-live="polite"></div>
            </div></div>
            </div>
          </div>

          <%# ===== Onglet Notes (commentaires de travail, jamais publiés) ===== %>
          <div role="tabpanel" id="panel-notes" aria-labelledby="tab-notes" data-sidebar-panel="notes" hidden>
            <div data-notes-body><p class="wp-help">Chargement des notes…</p></div>
          </div>

          <%# ===== Onglet Bloc ===== %>
          <div role="tabpanel" id="panel-bloc" aria-labelledby="tab-bloc" data-sidebar-panel="bloc" hidden>
            <div data-block-inspector><p class="wp-help wp-empty-inspector">Aucun bloc sélectionné.</p></div>
          </div>
        </aside>
      </div>
    </form>
  </div>
  <script type="application/json" id="be-data"><%- json %></script>
  <script src="<%= asset('/js/floating.js') %>" defer></script>
  <script src="<%= asset('/js/kwmedia.js') %>" defer></script>
  <script src="<%= asset('/js/media-picker.js') %>" defer></script>
  <script src="<%= asset('/js/blog-editor.js') %>" defer></script>
  <script src="<%= asset('/js/taxonomy-picker.js') %>" defer></script>
</body>
</html>
