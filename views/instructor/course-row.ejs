<%# Une ligne de la liste des formations du tableau de bord. Paramètre : course %>
<div class="course-manage-row">
  <div class="thumb"><% if (course.thumbnail_path) { %><img src="<%= course.thumbnail_path %>" alt="" loading="lazy" decoding="async" width="640" height="360"><% } else { %><%- icon('book', { size: 28 }) %><% } %></div>
  <div class="info">
    <p class="title"><%= course.title %>
      <% if (course.archived) { %><span class="badge badge-muted">Archivée</span>
      <% } else if (course.published) { %><span class="badge badge-success">Publiée</span>
      <% } else { %><span class="badge badge-warning">Brouillon</span><% } %>
    </p>
    <div class="stats">
      <span><%- icon('users', { size: 14 }) %> <%= course.student_count %> élèves</span>
      <span><%- icon('video', { size: 14 }) %> <%= course.lesson_count %> sous-chapitres</span>
      <span><%- icon('coin', { size: 14 }) %> <%= formatPrice(course.revenue_cents) %> de revenu</span>
      <span><%= formatPrice(course.price_cents) %></span>
    </div>
  </div>
  <div class="actions">
    <a href="/formateur/cours/<%= course.id %>/curriculum" class="btn btn-outline btn-sm">Chapitres</a>
    <a href="/formateur/cours/<%= course.id %>/modifier" class="btn btn-outline btn-sm">Modifier</a>
    <a href="/formateur/cours/<%= course.id %>/faq" class="btn btn-outline btn-sm">FAQ</a>
    <% if (!course.archived) { %><a href="/cours/<%= course.slug %>" class="btn btn-outline btn-sm">Aperçu</a><% } %>
    <form action="/formateur/cours/<%= course.id %>/dupliquer" method="post" class="inline-form">
      <button type="submit" class="btn btn-outline btn-sm" title="Crée une copie en brouillon : chapitres, leçons, quiz et fichiers">Dupliquer</button>
    </form>
    <% if (course.archived) { %>
      <form action="/formateur/cours/<%= course.id %>/restaurer" method="post" class="inline-form">
        <button type="submit" class="btn btn-secondary btn-sm">Restaurer</button>
      </form>
    <% } else { %>
      <form action="/formateur/cours/<%= course.id %>/archiver" method="post" class="inline-form" onsubmit="return confirm('Archiver cette formation ? Elle quitte le catalogue et ne peut plus être achetée, mais ses étudiants gardent leur accès.');">
        <button type="submit" class="btn btn-outline btn-sm">Archiver</button>
      </form>
    <% } %>
    <% if (course.sales_count > 0 || course.student_count > 0) { %>
      <span class="field-hint" title="Une formation achetée ne peut pas être supprimée : archivez-la pour la retirer du catalogue.">Déjà vendue</span>
    <% } else { %>
      <form action="/formateur/cours/<%= course.id %>/supprimer" method="post" class="inline-form" onsubmit="return confirm('Supprimer définitivement cette formation ?');">
        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
      </form>
    <% } %>
  </div>
</div>
