<%- include("../partials/header", { title: course ? "FAQ de la formation" : "Questions fréquentes" }) %>
<% const back = course ? `/formateur/cours/${course.id}/faq` : "/formateur/faq"; %>
  <div class="container fa">
    <% if (course) { %><%- include("_course-head", { course, tab: "faq" }) %><h2>FAQ de la formation</h2><% } else { %><h1>Questions fréquentes du site</h1><% } %>
    <p class="field-hint"><%= course ? "Ces questions s'affichent sur la page de cette formation." : "Ces questions s'affichent sur la page « Questions fréquentes »." %> Seules les questions <strong>publiées</strong> sont visibles des visiteurs.
      <a href="<%= course ? "/cours/" + course.slug + "#faq" : "/faq" %>" target="_blank" rel="noopener">Voir sur le site <span class="sr-only">(nouvel onglet)</span></a></p>
    <% if (flash) { %><p class="fa-flash" role="status"><%= flash.text %></p><% } %>

    <% if (faqs.length) { %>
      <p class="fa-count"><strong><%= faqs.length %></strong> question<%= faqs.length > 1 ? "s" : "" %> · <%= faqs.filter((f) => f.published).length %> publiée<%= faqs.filter((f) => f.published).length > 1 ? "s" : "" %></p>
      <ol class="fa-list">
        <% faqs.forEach((faq, i) => { %>
          <li class="fa-item<%= faq.published ? "" : " is-draft" %>">
            <div class="fa-main">
              <p class="fa-q"><%= faq.question %></p>
              <p class="fa-meta"><span class="fa-badge<%= faq.published ? " is-live" : "" %>"><%= faq.published ? "Publiée" : "Brouillon (non visible)" %></span><% if (faq.category) { %><span class="fa-badge"><%= faq.category %></span><% } %></p>
              <p class="fa-a"><%= faq.answer.length > 220 ? faq.answer.slice(0, 220) + "…" : faq.answer %></p>
            </div>
            <div class="fa-actions">
              <form action="/formateur/faq/<%= faq.id %>/monter" method="post"><button class="btn btn-ghost btn-sm" type="submit"<%= i === 0 ? " disabled" : "" %> aria-label="Monter la question : <%= faq.question %>"><%- icon("arrowUp", { size: 15 }) %></button></form>
              <form action="/formateur/faq/<%= faq.id %>/descendre" method="post"><button class="btn btn-ghost btn-sm" type="submit"<%= i === faqs.length - 1 ? " disabled" : "" %> aria-label="Descendre la question : <%= faq.question %>"><%- icon("arrowDown", { size: 15 }) %></button></form>
              <a class="btn btn-outline btn-sm" href="/formateur/faq/<%= faq.id %>/modifier">Modifier<span class="sr-only"> la question : <%= faq.question %></span></a>
              <form action="/formateur/faq/<%= faq.id %>/publier" method="post"><input type="hidden" name="published" value="<%= faq.published ? "0" : "1" %>"><button class="btn btn-outline btn-sm" type="submit"><%= faq.published ? "Dépublier" : "Publier" %><span class="sr-only"> la question : <%= faq.question %></span></button></form>
              <form action="/formateur/faq/<%= faq.id %>/supprimer" method="post" data-confirm="Supprimer définitivement cette question ?"><button type="submit" class="btn btn-danger btn-sm" aria-label="Supprimer la question : <%= faq.question %>">Supprimer</button></form>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } else { %>
      <div class="empty-state fa-empty"><span class="kv-empty-ico" aria-hidden="true"><%- icon("help", { size: 26 }) %></span><h2>Aucune question pour le moment</h2><p>Ajoutez votre première question ci-dessous.</p></div>
    <% } %>

    <form action="/formateur/faq/ajouter" method="post" class="content-card fa-form" novalidate>
      <h2>Ajouter une question</h2>
      <%- include("_faq-fields", { course, errors, values, categories, idp: "faq" }) %>
      <button type="submit" class="btn btn-primary">Ajouter</button>
    </form>
  </div>
  <script src="<%= asset('/js/faq-admin.js') %>" defer></script>
<%- include("../partials/footer") %>
