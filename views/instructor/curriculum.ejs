<% const totalLessons = sections.reduce((s, sec) => s + sec.lessons.length, 0); const totalMinutes = sections.reduce((s, sec) => s + sec.lessons.reduce((n, l) => n + (l.duration_minutes || 0), 0), 0); %>
<%- include("../partials/header", { title: "Constructeur — " + course.title }) %>

  <div class="container-wide">
    <%- include("_course-head", { course, tab: "chapters" }) %>

    <div class="curriculum-header">
      <div>
        <h2 class="cur-title">Programme</h2>
        <p class="cur-summary" data-cur-summary><%= sections.length %> chapitre<%= sections.length > 1 ? "s" : "" %> · <%= totalLessons %> sous-chapitre<%= totalLessons > 1 ? "s" : "" %><% if (totalMinutes) { %> · <%= totalMinutes >= 60 ? Math.floor(totalMinutes / 60) + " h " + String(totalMinutes % 60).padStart(2, "0") : totalMinutes + " min" %><% } %></p>
      </div>
      <div class="publish-status">
        <% if (course.published) { %>
          <span class="badge badge-success">Publiée</span>
        <% } else { %>
          <span class="badge badge-warning">Brouillon — non visible dans le catalogue</span>
        <% } %>
        <form action="/formateur/cours/<%= course.id %>/publier" method="post" class="inline-form">
          <button type="submit" class="btn <%= course.published ? 'btn-outline' : 'btn-success' %>" <%= (!course.published && totalLessons === 0) ? "disabled title='Ajoutez au moins un sous-chapitre avant de publier'" : "" %>>
            <%= course.published ? "Dépublier" : "Publier la formation" %>
          </button>
        </form>
        <a href="/formateur/cours/<%= course.id %>/modifier" class="btn btn-outline">Modifier les infos</a>
      </div>
    </div>
  </div>

  <div class="container-wide builder-layout">
    <aside class="builder-outline" data-course-id="<%= course.id %>" aria-label="Plan de la formation">
      <div class="cur-bar">
        <p class="cur-status" role="status" aria-live="polite" data-cur-status></p>
        <% if (sections.length > 1) { %><button type="button" class="cur-link" data-cur-toggle-all aria-pressed="false">Tout replier</button><% } %>
      </div>
      <% if (sections.length === 0) { %>
        <p class="cur-empty" data-cur-empty>Aucun chapitre pour l'instant. Donnez un titre au premier chapitre ci-dessous, puis ajoutez-y vos sous-chapitres.</p>
      <% } %>
      <div id="sectionList" class="cur-sections">
        <% sections.forEach((section, sIndex) => { const mins = section.lessons.reduce((n, l) => n + (l.duration_minutes || 0), 0); %>
          <section class="chapter-block" draggable="true" data-section-id="<%= section.id %>" data-title="<%= section.title %>" aria-labelledby="chapter-title-<%= section.id %>">
            <div class="chapter-block-header">
              <button type="button" class="cur-fold" data-cur-fold aria-expanded="true" aria-controls="chapter-body-<%= section.id %>" aria-label="Replier le chapitre <%= section.title %>"><%- icon('chevronDown', { size: 16 }) %></button>
              <span class="cur-num" data-cur-num aria-hidden="true"><%= sIndex + 1 %></span>
              <div class="cur-heading">
                <h3 class="chapter-name" id="chapter-title-<%= section.id %>"><span class="sr-only">Chapitre <span data-cur-num-sr><%= sIndex + 1 %></span> : </span><span data-cur-title><%= section.title %></span></h3>
                <p class="cur-meta" data-cur-meta><%= section.lessons.length %> sous-chapitre<%= section.lessons.length > 1 ? "s" : "" %><% if (mins) { %> · <%= mins %> min<% } %></p>
              </div>
              <div class="cur-actions">
                <form action="/formateur/sections/<%= section.id %>/deplacer" method="post" class="inline-form"><input type="hidden" name="direction" value="haut"><button type="submit" class="cur-tool" data-cur-move="up" aria-label="Monter le chapitre <%= section.title %>" title="Monter"><%- icon('arrowUp', { size: 15 }) %></button></form>
                <form action="/formateur/sections/<%= section.id %>/deplacer" method="post" class="inline-form"><input type="hidden" name="direction" value="bas"><button type="submit" class="cur-tool" data-cur-move="down" aria-label="Descendre le chapitre <%= section.title %>" title="Descendre"><%- icon('arrowDown', { size: 15 }) %></button></form>
                <button type="button" class="cur-tool" data-cur-rename aria-label="Renommer le chapitre <%= section.title %>" title="Renommer"><%- icon('edit', { size: 15 }) %></button>
                <form action="/formateur/sections/<%= section.id %>/supprimer" method="post" class="inline-form" data-cur-confirm data-confirm-title="Supprimer le chapitre « <%= section.title %> » ?" data-confirm-text="<%= section.lessons.length ? "Ses " + section.lessons.length + " sous-chapitre" + (section.lessons.length > 1 ? "s" : "") + ", leurs vidéos, ressources et quiz seront supprimés définitivement." : "Ce chapitre est vide." %>">
                  <button type="submit" class="cur-tool cur-tool-danger" aria-label="Supprimer le chapitre <%= section.title %>" title="Supprimer"><%- icon('trash', { size: 15 }) %></button>
                </form>
              </div>
            </div>

            <div class="chapter-body" id="chapter-body-<%= section.id %>">
              <div class="lesson-list" data-section-id="<%= section.id %>">
                <% if (!section.lessons.length) { %><p class="cur-lesson-empty" data-cur-lesson-empty>Aucun sous-chapitre dans ce chapitre.</p><% } %>
                <% section.lessons.forEach(lesson => { const hasVideo = !!(lesson.video_path || lesson.video_url); const active = selected && selected.lesson.id === lesson.id; %>
                  <div class="cur-lesson<%= active ? ' is-active' : '' %>" draggable="true" data-lesson-id="<%= lesson.id %>" data-min="<%= lesson.duration_minutes || 0 %>">
                    <a class="lesson-item <%= active ? 'is-active' : '' %>" draggable="false" href="?lecon=<%= lesson.id %>"<%- active ? ' aria-current="page"' : "" %>>
                      <span class="drag-handle" aria-hidden="true"><%- icon('grip', { size: 14 }) %></span>
                      <span class="lesson-item-icon <%= hasVideo ? '' : 'is-empty' %>" aria-hidden="true"><%- icon('video', { size: 14 }) %></span>
                      <span class="lesson-item-title"><%= lesson.title %></span>
                      <span class="sr-only"><%= hasVideo ? "Vidéo ajoutée." : "Pas encore de vidéo." %></span>
                      <% if (lesson.quiz) { %><span class="mini-badge">Quiz</span><% } %>
                      <% if (lesson.is_preview) { %><span class="mini-badge mini-badge-soft">Aperçu</span><% } %>
                      <% if (lesson.duration_minutes) { %><span class="lesson-min"><%= lesson.duration_minutes %> min</span><% } %>
                    </a>
                    <span class="lesson-tools">
                      <form action="/formateur/lecons/<%= lesson.id %>/deplacer" method="post" class="inline-form"><input type="hidden" name="direction" value="haut"><button type="submit" class="cur-tool" data-cur-move="up" aria-label="Monter le sous-chapitre <%= lesson.title %>" title="Monter"><%- icon('arrowUp', { size: 14 }) %></button></form>
                      <form action="/formateur/lecons/<%= lesson.id %>/deplacer" method="post" class="inline-form"><input type="hidden" name="direction" value="bas"><button type="submit" class="cur-tool" data-cur-move="down" aria-label="Descendre le sous-chapitre <%= lesson.title %>" title="Descendre"><%- icon('arrowDown', { size: 14 }) %></button></form>
                    </span>
                  </div>
                <% }) %>
              </div>

              <form action="/formateur/sections/<%= section.id %>/lecons" method="post" class="quick-add-form" data-cur-add="lesson">
                <input type="text" name="title" placeholder="+ Ajouter un sous-chapitre" aria-label="Ajouter un sous-chapitre au chapitre <%= section.title %>" required maxlength="120" autocomplete="off">
              </form>
            </div>
          </section>
        <% }) %>
      </div>

      <form action="/formateur/cours/<%= course.id %>/sections" method="post" class="quick-add-form quick-add-chapter" data-cur-add="chapter">
        <input type="text" name="title" placeholder="+ Ajouter un chapitre" aria-label="Ajouter un chapitre" required maxlength="120" autocomplete="off">
      </form>
    </aside>

    <section class="builder-editor">
      <% if (!selected) { %>
        <div class="empty-state" style="padding:100px 20px;">
          <h3>Sélectionnez un sous-chapitre</h3>
          <p>Cliquez sur un élément à gauche pour l'éditer, ou créez-en un nouveau.</p>
        </div>
      <% } else { %>
        <% if (saved) { %><p class="form-success">Modifications enregistrées.</p><% } %>

        <form action="/formateur/lecons/<%= selected.lesson.id %>/modifier" method="post" enctype="multipart/form-data" class="content-card">
          <div class="field-group">
            <label for="f-curriculum-1">Titre du sous-chapitre</label>
            <input id="f-curriculum-1" type="text" name="title" value="<%= selected.lesson.title %>" required maxlength="120">
          </div>
          <div class="field-group">
            <label for="f-lesson-section">Chapitre</label>
            <select id="f-lesson-section" name="section_id">
              <% sections.forEach((sec, i) => { %><option value="<%= sec.id %>"<%= sec.id === selected.lesson.section_id ? " selected" : "" %>>Chapitre <%= i + 1 %> — <%= sec.title %></option><% }) %>
            </select>
          </div>
          <div class="field-group">
            <label for="f-curriculum-2">Contenu de la leçon <span class="field-hint">(affiché sous la vidéo ; **gras**, *italique*, ## titre, - liste, [lien](https://…))</span></label>
            <textarea id="f-curriculum-2" name="description" rows="8"><%= selected.lesson.description %></textarea>
          </div>
          <div class="field-row">
            <div class="field-group">
              <label for="f-curriculum-3">Durée (min)</label>
              <input id="f-curriculum-3" type="number" name="duration_minutes" min="0" value="<%= selected.lesson.duration_minutes %>">
            </div>
            <div class="field-group" style="justify-content:flex-end;">
              <label class="checkbox-row"><input type="checkbox" name="is_preview" value="1" <%= selected.lesson.is_preview ? "checked" : "" %>> Aperçu gratuit (visible sans achat)</label>
            </div>
          </div>

          <div class="field-group">
            <label for="f-video-file">Vidéo</label>
            <% if (selected.lesson.video_path || selected.lesson.video_url) { %>
              <p class="field-hint" style="margin:0 0 6px;">
                Actuelle : <%= selected.lesson.video_path ? "fichier vidéo uploadé" : selected.lesson.video_url %>
                &nbsp;<label style="font-weight:400;"><input type="checkbox" name="remove_video" value="1"> supprimer</label>
              </p>
            <% } %>
            <input id="f-video-file" type="file" name="video" accept="video/mp4,video/webm,video/quicktime,video/x-m4v,video/ogg">
            <label for="f-video-url" class="field-hint" style="display:block;margin:8px 0 4px;">Ou coller un lien YouTube / Vimeo / .mp4, ou l'identifiant d'une vidéo Bunny Stream :</label>
            <input id="f-video-url" type="url" name="video_url" placeholder="https://www.youtube.com/watch?v=… ou 32d140e2-e4f4-4eec-9d53-20371e9be607">
            <p class="field-hint" style="margin:4px 0 0;"><strong>Bunny Stream</strong> protège la vidéo : seul un élève connecté ayant acheté la formation reçoit un lien de lecture temporaire. Avec YouTube « non répertoriée » ou Vimeo, toute personne qui a le lien peut regarder, même sans avoir acheté.</p>
          </div>

          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </form>

        <div class="content-card">
          <h2 style="font-size:1.05rem;margin-top:0;">Ressources de la leçon</h2>
          <p class="field-hint" style="margin-top:-6px;">Fichiers à télécharger (PDF, archives…), images (affichées dans la leçon) et liens utiles.</p>
          <% if (selected.attachments.length) { %>
            <ul class="attachment-admin-list">
              <% selected.attachments.forEach((a) => { %>
                <li>
                  <span class="attachment-name"><%- icon(a.kind === 'link' ? 'arrowRight' : 'clip', { size: 15 }) %> <%= a.title %> <span class="field-hint">(<%= a.kind === 'link' ? a.url : 'fichier' %>)</span></span>
                  <form action="/formateur/pieces-jointes/<%= a.id %>/supprimer" method="post" class="inline-form" data-cur-confirm data-confirm-title="Supprimer cette ressource ?" data-confirm-text="Le fichier ou le lien sera retiré de la leçon.">
                    <button type="submit" class="icon-btn small" title="Supprimer la ressource" aria-label="Supprimer <%= a.title %>"><%- icon('trash', { size: 15 }) %></button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
          <form action="/formateur/lecons/<%= selected.lesson.id %>/pieces-jointes" method="post" enctype="multipart/form-data" class="add-lesson-form">
            <div class="field-row">
              <div class="field-group"><label for="f-att-title">Titre <span class="field-hint">(facultatif)</span></label><input id="f-att-title" type="text" name="title" maxlength="120"></div>
              <div class="field-group"><label for="f-att-file">Fichier</label><input id="f-att-file" type="file" name="attachment" required></div>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm">Ajouter le fichier</button>
          </form>
          <form action="/formateur/lecons/<%= selected.lesson.id %>/liens" method="post" class="add-lesson-form" style="margin-top:16px;">
            <div class="field-row">
              <div class="field-group"><label for="f-link-title">Titre du lien <span class="field-hint">(facultatif)</span></label><input id="f-link-title" type="text" name="title" maxlength="120"></div>
              <div class="field-group"><label for="f-link-url">Adresse du lien</label><input id="f-link-url" type="url" name="url" placeholder="https://…" required></div>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm">Ajouter le lien</button>
          </form>
        </div>

        <div class="content-card">
          <h2 style="font-size:1.05rem;margin-top:0;">Quiz</h2>
          <% if (!selected.quiz) { %>
            <p class="field-hint">Ajoutez un quiz pour que l'étudiant doive le réussir avant que ce sous-chapitre soit marqué terminé.</p>
            <form action="/formateur/lecons/<%= selected.lesson.id %>/quiz" method="post">
              <button type="submit" class="btn btn-secondary">+ Ajouter un quiz</button>
            </form>
          <% } else { %>
            <div class="quiz-settings">
              <form action="/formateur/quiz/<%= selected.quiz.id %>/parametres" method="post" class="quiz-settings-form">
                <input type="text" name="title" value="<%= selected.quiz.title %>" aria-label="Titre du quiz" class="quiz-title-input">
                <label class="field-hint quiz-setting">
                  Seuil de réussite
                  <input type="number" name="pass_percentage" min="0" max="100" value="<%= selected.quiz.pass_percentage %>" class="quiz-num">%
                </label>
                <label class="field-hint quiz-setting">
                  Tentatives max.
                  <input type="number" name="max_attempts" min="1" max="100" value="<%= selected.quiz.max_attempts || "" %>" placeholder="Illimité" class="quiz-num quiz-num-wide">
                </label>
                <button type="submit" class="btn btn-outline btn-sm">Enregistrer</button>
              </form>
              <form action="/formateur/quiz/<%= selected.quiz.id %>/supprimer" method="post" class="inline-form" data-cur-confirm data-confirm-title="Supprimer ce quiz ?" data-confirm-text="Le quiz, ses questions et les tentatives enregistrées seront supprimés.">
                <button type="submit" class="btn btn-danger btn-sm">Supprimer le quiz</button>
              </form>
            </div>

            <% selected.quiz.questions.forEach((q, qi) => { %>
              <div class="quiz-question-row">
                <div style="display:flex;justify-content:space-between;gap:10px;">
                  <strong>Q<%= qi + 1 %>. <%= q.question %></strong>
                  <form action="/formateur/quiz-questions/<%= q.id %>/supprimer" method="post" class="inline-form" data-cur-confirm data-confirm-title="Supprimer cette question ?" data-confirm-text="La question et ses réponses seront supprimées.">
                    <button type="submit" class="btn btn-ghost btn-sm">Supprimer</button>
                  </form>
                </div>
                <ul class="quiz-option-list">
                  <% q.options.forEach(o => { %>
                    <li class="<%= o.is_correct ? 'is-correct' : '' %>"><%= o.is_correct ? "✓ " : "" %><%= o.option_text %></li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>

            <form action="/formateur/quiz/<%= selected.quiz.id %>/questions" method="post" class="add-lesson-form" style="margin-top:10px;">
              <div class="field-group">
                <label for="f-curriculum-4">Nouvelle question</label>
                <input id="f-curriculum-4" type="text" name="question" required maxlength="200" placeholder="Ex. Que fait ce mot-clé ?">
              </div>
              <div class="field-row" style="flex-wrap:wrap;">
                <div class="field-group" style="min-width:180px;"><label for="f-curriculum-5">Réponse A</label><input id="f-curriculum-5" type="text" name="option_1" maxlength="120"></div>
                <div class="field-group" style="min-width:180px;"><label for="f-curriculum-6">Réponse B</label><input id="f-curriculum-6" type="text" name="option_2" maxlength="120"></div>
              </div>
              <div class="field-row" style="flex-wrap:wrap;">
                <div class="field-group" style="min-width:180px;"><label for="f-curriculum-7">Réponse C <span class="field-hint">(optionnel)</span></label><input id="f-curriculum-7" type="text" name="option_3" maxlength="120"></div>
                <div class="field-group" style="min-width:180px;"><label for="f-curriculum-8">Réponse D <span class="field-hint">(optionnel)</span></label><input id="f-curriculum-8" type="text" name="option_4" maxlength="120"></div>
              </div>
              <div class="field-group" style="max-width:220px;">
                <label for="f-curriculum-9">Bonne réponse</label>
                <select id="f-curriculum-9" name="correct" required>
                  <option value="1">Réponse A</option>
                  <option value="2">Réponse B</option>
                  <option value="3">Réponse C</option>
                  <option value="4">Réponse D</option>
                </select>
              </div>
              <button type="submit" class="btn btn-secondary" style="align-self:flex-start;">+ Ajouter la question</button>
            </form>
          <% } %>
        </div>

        <form action="/formateur/lecons/<%= selected.lesson.id %>/supprimer" method="post" data-cur-confirm data-confirm-title="Supprimer le sous-chapitre « <%= selected.lesson.title %> » ?" data-confirm-text="Sa vidéo, ses ressources et son quiz seront supprimés définitivement.">
          <button type="submit" class="btn btn-danger">Supprimer ce sous-chapitre</button>
        </form>
      <% } %>
    </section>
  </div>

<dialog class="cur-dialog" id="curDialog" aria-labelledby="curDialogTitle" aria-describedby="curDialogText">
  <form method="dialog">
    <h2 id="curDialogTitle"></h2>
    <p id="curDialogText"></p>
    <div class="cur-dialog-actions">
      <button type="submit" value="cancel" class="btn btn-outline" autofocus>Annuler</button>
      <button type="submit" value="ok" class="btn btn-danger" data-cur-dialog-ok>Supprimer</button>
    </div>
  </form>
</dialog>
<script src="<%= asset('/js/curriculum.js') %>" defer></script>

<%- include("../partials/footer") %>
