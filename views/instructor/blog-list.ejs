<%- include("../partials/header", { title: "Blog" }) %>

  <div class="container">
    <div class="dashboard-toolbar">
      <h1 style="margin:0;">Blog</h1>
      <a href="/formateur/blog/nouveau" class="btn btn-primary">+ Nouvel article</a>
    </div>

    <% if (saved) { %><p class="form-success" role="status">Réglage enregistré.</p><% } %>
    <% if (newsletter) { %>
      <form action="/formateur/blog/newsletter" method="post" class="content-card blog-newsletter-setting">
        <div class="field-group">
          <label for="blog-newsletter">Formulaire d'inscription affiché dans les articles (bloc « newsletter »)</label>
          <select id="blog-newsletter" name="form">
            <option value="">Automatique : le dernier formulaire publié</option>
            <% newsletter.forms.forEach((f) => { %><option value="<%= f.slug %>" <%= newsletter.chosen === f.slug ? "selected" : "" %>><%= f.name %></option><% }) %>
          </select>
          <span class="field-hint"><% if (!newsletter.forms.length) { %>Aucun formulaire publié : créez-en un dans Marketing → Audience → Formulaires d'inscription, sinon le bloc newsletter n'apparaît pas.<% } else { %>Les inscriptions passent par ce formulaire marketing (preuve de consentement, double confirmation).<% } %></span>
        </div>
        <button type="submit" class="btn btn-outline btn-sm">Enregistrer</button>
      </form>
    <% } %>

    <% if (posts.length) { %>
      <ul class="faq-admin-list">
        <% posts.forEach((post) => { %>
          <li>
            <div>
              <p class="faq-admin-question"><%= post.title %></p>
              <p class="faq-admin-answer"><%= post.published ? "Publié le " + formatDate(post.published_at) : post.status === "scheduled" && post.published_at ? "Programmé pour le " + formatDate(post.published_at) : (typeof statuses !== "undefined" && statuses[post.status]) || "Brouillon" %><%= post.category ? " · " + post.category : "" %> · /blog/<%= post.slug %><%= post.views ? " · " + post.views + " lecture" + (post.views > 1 ? "s" : "") : "" %></p>
            </div>
            <div class="row-actions">
              <a class="btn btn-outline btn-sm" href="/formateur/blog/<%= post.id %>/modifier">Modifier</a>
              <a class="btn btn-outline btn-sm" href="/blog/<%= post.slug %>"><%= post.published ? "Voir" : "Aperçu" %></a>
              <form action="/formateur/blog/<%= post.id %>/publier" method="post" class="inline-form">
                <button type="submit" class="btn btn-outline btn-sm"><%= post.published ? "Dépublier" : "Publier" %></button>
              </form>
              <form action="/formateur/blog/<%= post.id %>/supprimer" method="post" class="inline-form" onsubmit="return confirm('Supprimer définitivement cet article ?');">
                <button type="submit" class="btn btn-danger btn-sm" aria-label="Supprimer l'article : <%= post.title %>">Supprimer</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-state" style="padding:24px 0;">Aucun article. Rédigez le premier !</p>
    <% } %>
  </div>

<%- include("../partials/footer") %>
