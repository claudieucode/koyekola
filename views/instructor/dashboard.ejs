<%- include("../partials/header", { title: "Mon espace" }) %>
<div class="dash-head">
  <div>
    <h1>Bonjour <%= currentUser.username %></h1>
    <p>Voici l'essentiel de votre activité sur KOLAKISA.</p>
  </div>
  <div class="dash-head-actions"><a href="/formateur/cours/nouveau" class="btn btn-primary"><%- icon('plus', { size: 16 }) %> Nouvelle formation</a></div>
</div>

<section class="dash-kpis" aria-label="Statistiques">
  <div class="kpi"><span class="kpi-icon"><%- icon('book', { size: 20 }) %></span><span class="kpi-label">Formations créées</span><span class="kpi-value"><%= stats.courses %></span><span class="kpi-trend<%= stats.coursesMonth ? " is-up" : "" %>"><%= stats.coursesMonth ? `+${stats.coursesMonth} ce mois` : "Aucune nouvelle ce mois" %></span></div>
  <div class="kpi"><span class="kpi-icon"><%- icon('checkCircle', { size: 20 }) %></span><span class="kpi-label">Publiées</span><span class="kpi-value"><%= stats.published %></span><span class="kpi-trend"><%= stats.drafts %> brouillon<%= stats.drafts > 1 ? "s" : "" %></span></div>
  <div class="kpi"><span class="kpi-icon"><%- icon('users', { size: 20 }) %></span><span class="kpi-label">Élèves inscrits</span><span class="kpi-value"><%= stats.students %></span><span class="kpi-trend<%= stats.studentsMonth ? " is-up" : "" %>"><%= stats.studentsMonth ? `+${stats.studentsMonth} ce mois` : "Aucune inscription ce mois" %></span></div>
  <div class="kpi"><span class="kpi-icon"><%- icon('coin', { size: 20 }) %></span><span class="kpi-label">Revenus</span><span class="kpi-value"><%= formatAmount(stats.revenueCents) %></span><span class="kpi-trend<%= stats.revenueMonthCents ? " is-up" : "" %>"><%= stats.revenueMonthCents ? `+${formatAmount(stats.revenueMonthCents)} ce mois` : "Aucune vente ce mois" %></span></div>
</section>

<div class="dash-grid-2 dash-section">
  <section>
    <div class="dash-section-head"><h2>Mes formations</h2><a href="/formateur/formations">Tout voir (<%= courses.filter((c) => !c.archived).length %>)</a></div>
    <% if (!courses.length) { %>
      <div class="dash-empty"><h3>Vous n'avez pas encore de formation</h3><p>Créez votre première formation pour commencer à enseigner sur KOLAKISA.</p><a href="/formateur/cours/nouveau" class="btn btn-primary">Créer ma première formation</a></div>
    <% } else if (!recent.length) { %>
      <div class="dash-empty"><p>Toutes vos formations sont archivées.</p><a href="/formateur/formations?statut=archivees" class="btn btn-outline btn-sm">Voir les archives</a></div>
    <% } else { %>
      <div class="dash-cards"><% recent.forEach((course) => { %><%- include("_course-card", { course }) %><% }) %></div>
    <% } %>
  </section>
  <aside>
    <div class="dpanel">
      <div class="dash-section-head"><h2>Messages</h2><a href="/formateur/messages">Ouvrir<%= unreadMessages ? ` (${unreadMessages} non lu${unreadMessages > 1 ? "s" : ""})` : "" %></a></div>
      <% if (!messages.length) { %><p class="field-hint">Aucun message reçu pour l'instant.</p><% } else { %>
        <ul class="dlist"><% messages.forEach((m) => { %><li><span class="grow"><strong><%= m.name %></strong><% if (!m.read_at) { %> <span class="dash-badge" aria-label="non lu">•</span><% } %><br><small><%= m.subject || "Sans objet" %> · <%= formatDate(m.created_at) %></small></span></li><% }) %></ul>
      <% } %>
    </div>
    <div class="dpanel">
      <h2>Raccourcis</h2>
      <ul class="dlist">
        <li><%- icon('fileText', { size: 18 }) %><a class="grow" href="/formateur/blog/nouveau">Écrire un article</a></li>
        <li><%- icon('send', { size: 18 }) %><a class="grow" href="/marketing">Envoyer une campagne</a></li>
        <li><%- icon('search', { size: 18 }) %><a class="grow" href="/formateur/seo">Vérifier le référencement</a></li>
        <li><%- icon('sliders', { size: 18 }) %><a class="grow" href="/formateur/apparence">Personnaliser l'apparence</a></li>
      </ul>
    </div>
  </aside>
</div>
<%- include("../partials/footer") %>
