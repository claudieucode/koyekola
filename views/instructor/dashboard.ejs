<%#
  Vue d'ensemble de « Mon espace » (/formateur). Données RÉELLES uniquement : statistiques (services/dashboard.stats), rythme des ventes sur 30 jours, activité récente et
  éléments à traiter (services/dashboard.overview). Aucune valeur n'est simulée : une période sans vente affiche un état vide explicite, jamais une tendance inventée.
  Composition : ligne 1 = revenus (le rythme des ventes) + « À traiter » ; ligne 2 = formations (tableau compact) + activité récente.
%><%- include("../partials/header", { title: "Mon espace" }) %>
<%
  const money = (cents) => formatAmount(cents);
  const monthDone = stats.revenueMonthCents > 0;
  const day = (ymd) => new Date(ymd + "T12:00:00Z").toLocaleDateString("fr-FR", { timeZone: "UTC", day: "numeric", month: "short" });
  const dayLong = (ymd) => new Date(ymd + "T12:00:00Z").toLocaleDateString("fr-FR", { timeZone: "UTC", weekday: "long", day: "numeric", month: "long" });
  const peak = ov.totals.peak;
  const plural = (n, one, many) => `${n} ${n > 1 ? many : one}`;
  const lede = [];
  if (stats.courses) lede.push(monthDone ? `Ce mois-ci : ${money(stats.revenueMonthCents)} de revenus, ${plural(stats.studentsMonth, "nouvel élève", "nouveaux élèves")}.` : "Aucune vente depuis le début du mois.");
  lede.push(todo.length ? "Quelques éléments vous attendent." : (stats.courses ? "Rien ne vous attend : tout est à jour." : "Votre espace est prêt : créez votre première formation."));
%>
<header class="ov-head">
  <div>
    <h1>Bonjour <%= currentUser.username %></h1>
    <p class="ov-lede"><%= lede.join(" ") %></p>
  </div>
  <a href="/formateur/cours/nouveau" class="btn btn-primary"><%- icon('plus', { size: 16 }) %> Nouvelle formation</a>
</header>

<div class="ov-grid">
 <div class="ov-main">
  <section class="ov-card ov-lead" aria-labelledby="ov-rev">
    <div class="ov-lead-top">
      <div>
        <h2 id="ov-rev">Revenus du mois</h2>
        <p class="ov-big"><%= money(stats.revenueMonthCents) %></p>
        <% if (stats.revenueCents !== stats.revenueMonthCents) { %><p class="ov-sub"><%= money(stats.revenueCents) %> depuis le début</p><% } %>
      </div>
      <p class="ov-readout" data-ov-readout aria-live="polite" data-default="<%= ov.totals.sales ? `${plural(ov.totals.sales, "vente", "ventes")} · ${money(ov.totals.cents)} sur 30 jours` : "" %>"><%= ov.totals.sales ? `${plural(ov.totals.sales, "vente", "ventes")} · ${money(ov.totals.cents)} sur 30 jours` : "" %></p>
    </div>

    <% if (!ov.totals.sales) { %>
      <div class="ov-chart-empty">
        <p><strong>Aucune vente sur les 30 derniers jours.</strong> <%= stats.published ? "Vos formations publiées peuvent être achetées dès maintenant." : "Publiez une formation pour qu'elle puisse être achetée." %></p>
        <a class="btn btn-outline btn-sm" href="<%= stats.published ? "/formateur/formations?statut=publiees" : "/formateur/formations" %>"><%= stats.published ? "Voir mes formations publiées" : "Voir mes formations" %></a>
      </div>
    <% } else { %>
      <div class="ov-chart" role="group" aria-label="Ventes par jour sur les 30 derniers jours. Flèches gauche et droite pour parcourir les jours avec ventes." data-ov-chart>
        <% const lastSale = ov.series.map((d) => d.sales > 0).lastIndexOf(true);
           ov.series.forEach((d, i) => { const h = d.cents ? Math.max(8, Math.round((d.cents / peak) * 100)) : 0;
           const label = d.sales ? `${dayLong(d.day)} : ${plural(d.sales, "vente", "ventes")}, ${money(d.cents)}` : `${dayLong(d.day)} : aucune vente`; %>
          <span class="ov-bar<%= d.sales ? "" : " is-zero" %><%= d.day === ov.today ? " is-today" : "" %>" style="--h: <%= h %>%; --i: <%= i %>" data-label="<%= label %>"<% if (d.sales) { %> tabindex="<%= i === lastSale ? 0 : -1 %>" role="img" aria-label="<%= label %>"<% } else { %> aria-hidden="true"<% } %>></span>
        <% }) %>
      </div>
      <div class="ov-axis" aria-hidden="true"><span><%= day(ov.periodStart) %></span><span>Aujourd'hui</span></div>
    <% } %>

    <dl class="ov-facts">
      <div><dt>Élèves inscrits</dt><dd><%= stats.students %></dd><dd class="ov-note"><%= stats.studentsMonth ? `+${stats.studentsMonth} ce mois-ci` : "aucun ce mois-ci" %></dd></div>
      <div><dt>Formations</dt><dd><%= stats.courses %></dd><dd class="ov-note"><%= stats.published %> publiée<%= stats.published > 1 ? "s" : "" %><%= stats.drafts ? `, ${stats.drafts} en brouillon` : "" %></dd></div>
      <div><dt>Ventes sur 30 jours</dt><dd><%= ov.totals.sales %></dd><dd class="ov-note"><%= ov.totals.sales ? money(ov.totals.cents) : "aucune" %></dd></div>
    </dl>
  </section>

  <section class="ov-card ov-courses" aria-labelledby="ov-courses">
    <div class="ov-card-head"><h2 id="ov-courses">Mes formations</h2><% if (courses.length) { %><a href="/formateur/formations">Tout voir (<%= visible.length %>)</a><% } %></div>
    <% if (!courses.length) { %>
      <div class="ov-onboard">
        <p><strong>Vous n'avez pas encore de formation.</strong> Trois étapes suffisent pour la mettre en ligne :</p>
        <ol class="ov-steps">
          <li><a href="/formateur/cours/nouveau">Créer la formation</a><span>titre, prix, description</span></li>
          <li><span class="ov-step-t">Ajouter chapitres et sous-chapitres</span><span>depuis la page de la formation</span></li>
          <li><span class="ov-step-t">Publier</span><span>elle entre alors au catalogue</span></li>
        </ol>
        <a href="/formateur/cours/nouveau" class="btn btn-primary">Créer ma première formation</a>
      </div>
    <% } else if (!visible.length) { %>
      <p class="ov-empty">Toutes vos formations sont archivées. <a href="/formateur/formations?statut=archivees">Voir les archives</a></p>
    <% } else { %>
      <table class="ov-table">
        <caption class="sr-only">Vos formations les plus récentes</caption>
        <thead><tr><th scope="col">Formation</th><th scope="col" class="ov-num">Élèves</th><th scope="col" class="ov-num">Revenus</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% visible.slice(0, 6).forEach((course) => { %><%- include("_course-row", { course }) %><% }) %></tbody>
      </table>
    <% } %>
  </section>

 </div>
 <div class="ov-rail">
  <section class="ov-card ov-todo" aria-labelledby="ov-todo">
    <h2 id="ov-todo">À traiter</h2>
    <% if (!todo.length) { %>
      <p class="ov-empty">Rien à traiter pour le moment.</p>
    <% } else { %>
      <ul class="ov-todo-list">
        <% todo.forEach((t) => { %><li><a href="<%= t.href %>"><span class="ov-todo-n"><%= t.n %></span><span class="ov-todo-t"><%= t.n > 1 ? t.many : t.one %></span><%- icon('arrowRight', { size: 16 }) %></a></li><% }) %>
      </ul>
    <% } %>
  </section>

  <section class="ov-card ov-activity" aria-labelledby="ov-act">
    <h2 id="ov-act">Activité récente</h2>
    <% if (!ov.activity.length) { %>
      <p class="ov-empty">Aucune activité pour le moment. Les ventes et les messages apparaîtront ici.</p>
    <% } else { %>
      <ol class="ov-feed">
        <% ov.activity.forEach((e) => { %>
          <li class="ov-ev ov-ev--<%= e.kind %>">
            <span class="ov-ev-ico" aria-hidden="true"><%- icon(e.kind === "sale" ? "cart" : "mail", { size: 16 }) %></span>
            <a class="ov-ev-body" href="<%= e.href %>">
              <% if (e.kind === "sale") { %><span><strong><%= e.who %></strong> a acheté «&nbsp;<%= e.what %>&nbsp;»</span><% } else { %><span><strong><%= e.who %></strong> vous a écrit : <%= e.what %><% if (e.unread) { %> <span class="ov-unread">non lu</span><% } %></span><% } %>
              <time datetime="<%= e.when.iso %>"><%= e.when.text %><% if (e.kind === "sale") { %> · <%= money(e.cents) %><% } %></time>
            </a>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </section>
 </div>
</div>

<nav class="ov-quick" aria-label="Raccourcis">
  <a href="<%= dash && dash.site && dash.site.ok ? dash.site.withSite("/formateur/blog/nouveau", dash.site.siteId) : "/formateur/blog/nouveau" %>"><%- icon('fileText', { size: 16 }) %> Écrire un article</a>
  <a href="/marketing"><%- icon('send', { size: 16 }) %> Envoyer une campagne</a>
  <a href="/formateur/seo"><%- icon('search', { size: 16 }) %> Vérifier le référencement</a>
  <a href="/formateur/apparence"><%- icon('sliders', { size: 16 }) %> Apparence du site</a>
</nav>
<script src="<%= asset('/js/dash-overview.js') %>" defer></script>
<%- include("../partials/footer") %>
