<%- include("../partials/header", { title: course.title }) %>
<%- include("_course-head", { course, tab }) %>
<% const pct = (done) => (stats.lessons ? Math.round((100 * done) / stats.lessons) : 0); %>
<% if (tab === "overview") { %>
  <section class="dash-kpis" aria-label="Statistiques de la formation">
    <div class="kpi"><span class="kpi-icon"><%- icon('users', { size: 20 }) %></span><span class="kpi-label">Élèves</span><span class="kpi-value"><%= stats.students %></span><span class="kpi-trend<%= stats.students_month ? " is-up" : "" %>"><%= stats.students_month ? `+${stats.students_month} ce mois` : "Aucune inscription ce mois" %></span></div>
    <div class="kpi"><span class="kpi-icon"><%- icon('coin', { size: 20 }) %></span><span class="kpi-label">Revenus</span><span class="kpi-value"><%= formatAmount(stats.revenue_cents) %></span><span class="kpi-trend"><%= stats.sales %> vente<%= stats.sales > 1 ? "s" : "" %></span></div>
    <div class="kpi"><span class="kpi-icon"><%- icon('list', { size: 20 }) %></span><span class="kpi-label">Chapitres</span><span class="kpi-value"><%= stats.sections %></span><span class="kpi-trend"><%= stats.lessons %> sous-chapitre<%= stats.lessons > 1 ? "s" : "" %></span></div>
    <div class="kpi"><span class="kpi-icon"><%- icon('tag', { size: 20 }) %></span><span class="kpi-label">Prix</span><span class="kpi-value"><%= formatPrice(course.price_cents) %></span><span class="kpi-trend"><%= course.category %></span></div>
  </section>
  <div class="dash-grid-2 dash-section">
    <div class="dpanel"><div class="dash-section-head"><h2>Dernières inscriptions</h2><a href="/formateur/cours/<%= course.id %>/etudiants">Tous les étudiants</a></div>
      <% if (!enrollments.length) { %><p class="field-hint">Aucun étudiant inscrit pour l'instant.</p><% } else { %><ul class="dlist"><% enrollments.forEach((e) => { %><li><span class="grow"><strong><%= e.username %></strong><br><small>Inscrit le <%= formatDate(e.created_at) %> · progression <%= pct(e.done) %> %</small></span></li><% }) %></ul><% } %></div>
    <div class="dpanel"><div class="dash-section-head"><h2>Dernières ventes</h2><a href="/formateur/cours/<%= course.id %>/ventes">Toutes les ventes</a></div>
      <% if (!sales.length) { %><p class="field-hint">Aucune vente pour l'instant.</p><% } else { %><ul class="dlist"><% sales.forEach((v) => { %><li><span class="grow"><strong><%= formatPrice(v.price_cents) %></strong> · <%= v.username %><br><small><%= formatDate(v.created_at) %></small></span></li><% }) %></ul><% } %></div>
  </div>
<% } else if (tab === "students") { %>
  <div class="dpanel">
    <h2>Étudiants (<%= enrollments.length %>)</h2>
    <% if (!enrollments.length) { %><p class="field-hint">Aucun étudiant inscrit pour l'instant.</p><% } else { %>
    <div class="dtable-wrap"><table class="dtable"><thead><tr><th scope="col">Étudiant</th><th scope="col">E-mail</th><th scope="col">Inscription</th><th scope="col">Progression</th></tr></thead>
      <tbody><% enrollments.forEach((e) => { %><tr><td><%= e.username %></td><td><%= e.email %></td><td><%= formatDate(e.created_at) %></td><td><%= pct(e.done) %> % (<%= e.done %> / <%= stats.lessons %>)</td></tr><% }) %></tbody></table></div>
    <% } %>
  </div>
<% } else if (tab === "sales") { %>
  <div class="dpanel">
    <h2>Ventes (<%= sales.length %>) · <%= formatAmount(stats.revenue_cents) %></h2>
    <% if (!sales.length) { %><p class="field-hint">Aucune vente pour l'instant.</p><% } else { %>
    <div class="dtable-wrap"><table class="dtable"><thead><tr><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Acheteur</th><th scope="col">Montant</th></tr></thead>
      <tbody><% sales.forEach((v) => { %><tr><td>n° <%= v.order_id %></td><td><%= formatDate(v.created_at) %></td><td><%= v.username %></td><td><%= formatPrice(v.price_cents) %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </div>
<% } %>
<%- include("../partials/footer") %>
