<%# En-tête d'une formation dans « Mon espace » + onglets. Paramètres : course, tab %>
<% const st = course.archived ? ["is-archived", "Archivée"] : course.published ? ["is-published", "Publiée"] : ["is-draft", "Brouillon"]; const stClass = `dash-status ${st[0]}`; %>
<a href="/formateur/formations" class="course-hub-back"><%- icon('arrowLeft', { size: 16 }) %> Retour aux formations</a>
<div class="course-hub-head">
  <div class="course-hub-thumb"><% if (course.thumbnail_path) { %><img src="<%= course.thumbnail_path %>" alt="" width="640" height="360"><% } else { %><%- icon('book', { size: 24 }) %><% } %></div>
  <div class="course-hub-title"><h1><%= course.title %></h1><span class="<%= stClass %>"><%= st[1] %></span></div>
  <div class="dash-head-actions">
    <% if (!course.archived) { %><a href="/cours/<%= course.slug %>" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Aperçu</a><% } %>
    <% if (tab !== "edit") { %><a href="/formateur/cours/<%= course.id %>/modifier" class="btn btn-primary btn-sm">Modifier</a><% } %>
  </div>
</div>
<nav class="course-tabs" aria-label="Gestion de la formation">
  <% [["overview", "Vue d'ensemble", `/formateur/cours/${course.id}`], ["edit", "Contenu et paramètres", `/formateur/cours/${course.id}/modifier`], ["chapters", "Chapitres", `/formateur/cours/${course.id}/curriculum`], ["faq", "FAQ", `/formateur/cours/${course.id}/faq`], ["students", "Étudiants", `/formateur/cours/${course.id}/etudiants`], ["sales", "Ventes", `/formateur/cours/${course.id}/ventes`]].forEach(([key, label, href]) => { %>
    <a href="<%= href %>"<%- key === tab ? ' aria-current="page"' : "" %>><%= label %></a>
  <% }) %>
</nav>
