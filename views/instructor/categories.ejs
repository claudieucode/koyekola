<%- include("../partials/header", { title: "Catégories" }) %>
<div class="dash-head"><div><h1>Catégories</h1><p>Les catégories de vos formations, telles qu'elles apparaissent dans le catalogue et le menu du site.</p></div></div>
<% if (done) { %><p class="form-success" role="status"><%= done %></p><% } %>
<% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
<% if (!categories.length) { %>
  <div class="dash-empty"><p>Aucune catégorie : elles se créent en choisissant la catégorie d'une formation.</p></div>
<% } else { %>
  <div class="dpanel"><div class="dtable-wrap"><table class="dtable">
    <thead><tr><th scope="col">Catégorie</th><th scope="col">Formations</th><th scope="col">Publiées</th><th scope="col">Renommer</th></tr></thead>
    <tbody><% categories.forEach((c, i) => { %>
      <tr><td><a href="/categorie/<%= slugify(c.category) %>" target="_blank" rel="noopener"><%= c.category %></a></td><td><%= c.n %></td><td><%= c.pub || 0 %></td>
        <td><form method="post" action="/formateur/categories/renommer" class="dash-inline-form"><input type="hidden" name="from" value="<%= c.category %>"><label class="sr-only" for="cat-<%= i %>">Nouveau nom pour <%= c.category %></label><input type="text" id="cat-<%= i %>" name="to" value="<%= c.category %>" maxlength="60" required><button type="submit" class="btn btn-outline btn-sm">Renommer</button></form></td></tr>
    <% }) %></tbody>
  </table></div></div>
  <p class="field-hint">Renommer une catégorie la modifie dans toutes vos formations concernées. Pour créer une catégorie, choisissez-la dans « Contenu et paramètres » d'une formation.</p>
<% } %>
<%- include("../partials/footer") %>
