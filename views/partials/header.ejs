<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== "undefined" ? htmlLang : "fr" %>">
<head>
  <meta charset="UTF-8">
  <%# Doublon de l'en-tête HTTP (le CDN de l'hébergeur remplace la politique envoyée par le serveur) %>
  <meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<% /* Balises SEO : calculées par le SEO CORE (src/seo/resolver.js), une seule source pour toute la page */
   const h = seoHead((typeof seo !== "undefined" && seo) || {}, typeof title !== "undefined" ? title : null); %>
  <%- include("seo-head-tags", { h }) %>
  <meta name="theme-color" content="#0277b6">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Blog — flux RSS" href="/blog/feed.xml">
  <script>/* barre de navigation : à gauche par défaut ; « bottom » mémorisé (bouton de position) = barre en bas sur grand écran (CSS ≥ 1280 px, pointeur précis) */ try { if (localStorage.getItem("kbDock") === "bottom") document.documentElement.setAttribute("data-kb-dock", "bottom"); } catch (e) {}</script>
  <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
  <% if (!(typeof dash !== "undefined" && dash)) { %><link rel="stylesheet" href="<%= asset('/css/kola-v3.css') %>"><link rel="stylesheet" href="<%= asset('/css/kola-art.css') %>"><link rel="stylesheet" href="<%= asset('/css/kola-vivid.css') %>"><% } /* design system v3 : site public et espace élève (l'espace formateur garde son habillage dashboard) */ %>
  <% const ap = typeof appearance === "function" ? appearance() : null; %><% if (ap && ap.css) { %><style id="kw-appearance"><%- ap.css %></style><% } %>
  <% if (ap && ap.preview) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <% if (typeof dash !== "undefined" && dash) { %><link rel="stylesheet" href="<%= asset('/css/dashboard.css') %>"><link rel="stylesheet" href="<%= asset('/css/app-rail.css') %>"><% if (dash.seo) { %><link rel="stylesheet" href="<%= asset('/css/seo-workspace.css') %>"><% } %><% } %>
  <link rel="stylesheet" href="<%= asset('/css/kola-soft.css') %>"><%# Soft Surface : surfaces douces à la place des contours (jetons --soft-*), chargée en dernier %>
</head>
<body<%- typeof dash !== "undefined" && dash ? ' class="dash-body"' : "" %>>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><linearGradient id="vx-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" style="stop-color:var(--vx-a)"/><stop offset="1" style="stop-color:var(--vx-b)"/></linearGradient></defs></svg>
  <a class="skip-link" href="#main">Aller au contenu principal</a>
<% if (typeof dash !== "undefined" && dash) { %><%- include("dash-open") %><% } else { %>

  <% const apH = ap ? ap.header : { logo: { mode: "text", text: "KOLAKISA" }, search: true, cart: true, account: true, announcement: { enabled: false }, cta: { enabled: false }, mobile: { showCta: true } }; %>
  <% if (ap && ap.preview) { %><div class="kw-preview-bar" role="status">Aperçu du brouillon de l'apparence : visible seulement par l'équipe, pas encore publié.</div><% } %>
  <% if (apH.announcement.enabled) { %><div class="site-announcement" role="region" aria-label="Annonce"><% if (apH.announcement.url) { %><a href="<%= apH.announcement.url %>"<%- /^https?:/.test(apH.announcement.url) ? ' rel="noopener noreferrer" target="_blank"' : "" %>><%= apH.announcement.text %></a><% } else { %><span><%= apH.announcement.text %></span><% } %></div><% } %>
  <header class="site-header">
    <div class="header-inner container-wide">
      <button class="icon-btn only-mobile" id="openMenuBtn" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="headerNav"><%- icon('menu') %></button>

      <% if (apH.logo.mode === "image" && apH.logoImage) { %><a href="/" class="logo logo-img" aria-label="<%= apH.logo.alt || apH.logo.text %> — accueil"><img src="<%= apH.logoImage.src %>" alt="<%= apH.logo.alt %>"<%- apH.logoImage.width ? ` width="${apH.logoImage.width}"` : "" %><%- apH.logoImage.height ? ` height="${apH.logoImage.height}"` : "" %>></a>
      <% } else { %><a href="/" class="logo" data-initial="<%= String(apH.logo.text || "K").trim().slice(0, 1).toUpperCase() %>"><%= apH.logo.text %></a><% } %>

      <% if (apH.search) { %><form action="/catalogue" method="get" class="header-search" role="search">
        <span class="search-icon" aria-hidden="true"><%- icon('search', { size: 16 }) %></span>
        <label for="header-q" class="sr-only">Rechercher une formation</label>
        <input type="text" id="header-q" name="q" placeholder="Rechercher une formation…" value="<%= typeof filters !== 'undefined' ? filters.q : '' %>">
      </form> <% } %>

      <%
  const headerMenu = typeof navMenu === "function" ? navMenu("header") : null, mobileMenu = typeof navMenu === "function" ? navMenu("mobile") : null;
  const navClass = mobileMenu ? "header-nav has-mobile-menu" : "header-nav";
%>
      <nav class="<%= navClass %>" id="headerNav" aria-label="Navigation principale">
        <% if (apH.search) { %><form action="/catalogue" method="get" class="drawer-search" role="search">
          <label for="drawer-q" class="sr-only">Rechercher une formation</label>
          <input type="search" id="drawer-q" name="q" placeholder="Rechercher une formation…" value="<%= typeof filters !== 'undefined' ? filters.q : '' %>">
          <button type="submit" aria-label="Lancer la recherche"><%- icon('search', { size: 18 }) %></button>
        </form><% } %>
        <%# Navigation du CMS : si un menu est affecté à l'en-tête, il remplace les liens d'origine (Catégories, Catalogue, Blog) ; sinon rien ne change %>
        <% if (headerMenu) { %><%- include("nav-menu", { items: headerMenu.items, level: 1, prefix: "hm", menuClass: "nav-menu--header", menuLabel: "Menu principal" }) %><% } else { %>
        <% if (navCategories.length) { %>
          <div class="nav-dropdown nav-legacy">
            <button type="button" class="nav-dropdown-toggle" aria-haspopup="true">
              Catégories <%- icon('chevronDown', { size: 14 }) %>
            </button>
            <div class="nav-dropdown-menu">
              <% navCategories.forEach((cat) => { %>
                <a href="/categorie/<%= slugify(cat) %>"><%= cat %></a>
              <% }) %>
            </div>
          </div>
        <% } %>
        <a class="nav-legacy" href="/catalogue"<%- currentPath === "/catalogue" ? ' aria-current="page"' : "" %>>Catalogue</a>
        <a class="nav-legacy" href="/blog"<%- currentPath === "/blog" || currentPath.startsWith("/blog/") ? ' aria-current="page"' : "" %>>Blog</a>
        <% } %>
        <% if (mobileMenu) { %><%- include("nav-menu", { items: mobileMenu.items, level: 1, prefix: "mm", menuClass: "nav-menu--mobile", menuLabel: "Menu mobile" }) %><% } %>
        <% if (currentUser && currentUser.role === "formateur") { %>
          <a href="/formateur">Mon espace</a>
        <% } else if (currentUser) { %>
          <a href="/mes-cours">Mes formations</a>
          <a href="/support">Aide</a>
        <% } %>
        <% if (apH.cta.enabled && apH.mobile.showCta) { %><a class="btn btn-<%= apH.cta.style === "secondary" ? "secondary" : apH.cta.style === "outline" ? "outline" : "primary" %> btn-block header-cta-mobile" href="<%= apH.cta.url %>"><%= apH.cta.label %></a><% } %>
        <% if (apH.account) { %><div class="mobile-auth-links">
          <% if (currentUser) { %>
            <a href="/mon-compte" class="btn btn-ghost btn-block">Mon compte</a>
            <form action="/deconnexion" method="post"><button type="submit" class="btn btn-outline btn-block">Déconnexion</button></form>
          <% } else { %>
            <a href="/connexion" class="btn btn-outline btn-block">Connexion</a>
            <a href="/inscription" class="btn btn-primary btn-block">Commencer</a>
          <% } %>
        </div><% } %>
      </nav>

      <div class="header-actions">
        <% if (apH.cta.enabled) { %><a class="btn btn-<%= apH.cta.style === "secondary" ? "secondary" : apH.cta.style === "outline" ? "outline" : "primary" %> btn-sm header-cta" href="<%= apH.cta.url %>"><%= apH.cta.label %></a><% } %>
        <% if (currentUser && currentUser.role !== "formateur") { %>
        <a href="/notifications" class="cart-link" aria-label="Notifications<%= notifCount > 0 ? ' (' + notifCount + ' non lue' + (notifCount > 1 ? 's' : '') + ')' : '' %>">
          <%- icon('bell') %>
          <% if (notifCount > 0) { %><span class="cart-badge" aria-hidden="true"><%= notifCount > 99 ? "99+" : notifCount %></span><% } %>
        </a>
        <% } %>
        <% if (apH.cart) { %>        <a href="/panier" class="cart-link" aria-label="Panier<%= cartCount > 0 ? ' (' + cartCount + ')' : '' %>">
          <%- icon('cart') %>
          <% if (cartCount > 0) { %><span class="cart-badge" aria-hidden="true"><%= cartCount %></span><% } %>
        </a><% } %>
        <% if (apH.account) { %><div class="header-auth-actions">
          <% if (currentUser) { %>
            <a class="user-chip" href="/mon-compte" title="Mon compte">
              <span class="avatar avatar-sm" aria-hidden="true" style="background:<%= avatarColor(currentUser.username) %>"><%= currentUser.username.slice(0,1).toUpperCase() %></span>
              <span class="user-chip-name"><%= currentUser.username %></span>
              <span class="sr-only">— Mon compte</span>
            </a>
            <form action="/deconnexion" method="post" class="inline-form">
              <button type="submit" class="btn btn-ghost btn-sm">Déconnexion</button>
            </form>
          <% } else { %>
            <a href="/connexion" class="btn btn-ghost btn-sm">Connexion</a>
            <a href="/inscription" class="btn btn-primary btn-sm">Commencer</a>
          <% } %>
        </div><% } %>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
<% } %>
