<%# Sécurité du compte (adresse, mot de passe) et sessions : partagé par « Mon compte » et le profil du formateur. Données : utils/accountSettingsView. %>
<%
      const e = (k) => (errors && errors[k]) || "";
      const bad = (k) => (e(k) ? ' aria-invalid="true" aria-describedby="ac-err-' + k + '"' : "");
      const err = (k) => (e(k) ? '<p class="field-error" id="ac-err-' + k + '" role="alert">' + String(e(k)).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]) + "</p>" : "");
      const fdt = (ms) => { const d = new Date(ms); return d.toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" }) + " " + d.toLocaleTimeString("fr-FR", { timeZone: "Europe/Paris", hour: "2-digit", minute: "2-digit" }); };
      const others = sessions.filter((s) => !s.current);
    %>
    <section class="card card-pad account-section" aria-labelledby="acc-security">
      <h2 id="acc-security">Sécurité</h2>
      <h3 class="account-sub">Adresse e-mail</h3>
      <p>Adresse actuelle : <strong><%= account.email %></strong> <span class="badge <%= account.email_verified_at ? "badge-success" : "badge-warning" %>"><%= account.email_verified_at ? "Confirmée" : "Non confirmée" %></span></p>
      <% if (!account.email_verified_at) { %>
        <form method="post" action="/mon-compte/confirmer-email" class="account-inline-form">
          <span class="field-hint">Confirmez votre adresse avec le lien reçu à l'inscription.</span>
          <button type="submit" class="btn btn-outline btn-sm">Recevoir un nouveau lien</button>
        </form>
      <% } %>
      <form method="post" action="/mon-compte/email" class="account-form" novalidate>
        <div class="account-grid">
          <div class="field-group"><label for="ac-email">Nouvelle adresse</label><input type="email" id="ac-email" name="email" required maxlength="254" autocomplete="email" value="<%= emailValue || (p.pendingEmail || "") %>"<%- bad("email") %>><%- err("email") %></div>
          <div class="field-group"><label for="ac-email-pwd">Mot de passe actuel</label><input type="password" id="ac-email-pwd" name="current_password" required autocomplete="current-password"<%- bad("emailPassword") %>><%- err("emailPassword") %></div>
        </div>
        <p class="field-hint">Un e-mail de confirmation est envoyé à la nouvelle adresse ; <strong>elle n'est activée qu'après l'ouverture de ce lien</strong>. Votre adresse actuelle reste utilisable d'ici là.</p>
        <button type="submit" class="btn btn-outline">Changer l'adresse</button>
      </form>
      <% if (p.pendingEmail) { %><div class="account-pending" role="status"><span>En attente de confirmation : <strong><%= p.pendingEmail %></strong></span>
        <form method="post" action="/mon-compte/email/annuler"><button type="submit" class="btn btn-ghost btn-sm">Annuler la demande</button></form></div><% } %>

      <h3 class="account-sub">Mot de passe</h3>
      <form method="post" action="/mon-compte/mot-de-passe" class="account-form" novalidate>
        <div class="field-group"><label for="ac-cur">Mot de passe actuel</label><input type="password" id="ac-cur" name="current_password" autocomplete="current-password" required<%- bad("current") %>><%- err("current") %></div>
        <div class="account-grid">
          <div class="field-group"><label for="ac-new">Nouveau mot de passe</label><input type="password" id="ac-new" name="new_password" autocomplete="new-password" minlength="<%= minPassword %>" maxlength="200" required<%- bad("next") %>><%- err("next") %><p class="field-hint"><%= minPassword %> caractères au moins.</p></div>
          <div class="field-group"><label for="ac-conf">Confirmer le nouveau mot de passe</label><input type="password" id="ac-conf" name="confirm_password" autocomplete="new-password" required<%- bad("confirm") %>><%- err("confirm") %></div>
        </div>
        <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
        <p class="field-hint">Vos autres sessions seront déconnectées ; celle-ci reste ouverte. <a href="/mot-de-passe-oublie">Mot de passe oublié ?</a></p>
      </form>
    </section>

    <section class="card card-pad account-section" aria-labelledby="acc-sessions">
      <h2 id="acc-sessions">Sessions</h2>
      <p class="field-hint">Les appareils où vous êtes connecté·e. Déconnectez ceux que vous ne reconnaissez pas ; si cela arrive, changez aussi votre mot de passe.</p>
      <ul class="account-sessions">
        <% sessions.forEach((s) => { %><li><span><strong><%= s.device ? s.device.label : "Appareil inconnu" %></strong><%= s.current ? " · cette session" : "" %><small>Expire le <%= fdt(s.expiresAt) %><%= s.device && s.device.at ? " · ouverte le " + fdt(Date.parse(s.device.at)) : "" %></small></span>
          <% if (!s.current) { %><form method="post" action="/mon-compte/sessions/<%= s.key %>/revoquer"><button type="submit" class="btn btn-ghost btn-sm" aria-label="Déconnecter la session <%= s.device ? s.device.label : "" %>">Déconnecter</button></form><% } %></li><% }) %>
      </ul>
      <% if (others.length) { %><form method="post" action="/mon-compte/sessions/revoquer"><button type="submit" class="btn btn-outline btn-sm">Déconnecter partout ailleurs</button></form>
      <% } else { %><p class="field-hint">Vous n'êtes connecté·e qu'à cet emplacement.</p><% } %>
    </section>

