<%# Coquille de « Mon espace » : barre latérale (repliable, tiroir sur mobile), barre du haut, zone de travail %>
<% const dashClass = dash.module ? `dash has-rail dash-${dash.module.key}` : "dash dash-dock";
   const trail = dash.crumbs(typeof title !== "undefined" ? title : ""); %><div class="<%= dashClass %>" id="dash" style="<%= dash.style %>">
  <script>try { if (localStorage.getItem("kolakisa-dash-collapsed") === "1" && window.innerWidth > 1100) document.getElementById("dash").classList.add("is-collapsed"); } catch (e) { /* stockage indisponible */ }</script>
  <%# barre de navigation permanente : sur toutes les pages de Mon espace (avec un module : rail à gauche ou en bas ; sans module : barre en bas / barre rapide mobile, la colonne du menu étant déjà la navigation générale) %>
  <%- include("app-rail", { railNav: dash.globalNav, railActive: dash.module ? dash.module.key : dash.activeKey, railUnread: dash.unread }) %>
  <aside class="dash-sidebar" id="dashSidebar" aria-label="<%= dash.seo ? "Navigation de l'espace SEO" : "Navigation de Mon espace" %>">
    <div class="dash-brand">
      <% if (dash.module) { %><a href="<%= dash.module.home %>" class="dash-module-head" aria-label="<%= dash.module.label %> — vue d'ensemble du module"><span class="dash-module-icon" aria-hidden="true"><%- icon(dash.module.icon, { size: 18 }) %></span><span class="dash-module-text"><strong><%= dash.module.label %></strong><small><%= dash.module.subtitle %></small></span></a>
      <% } else { %><a href="/formateur" class="dash-logo" aria-label="KOLAKISA — Mon espace"><span class="dash-logo-mark" aria-hidden="true">K</span><span class="dash-logo-text">KOLAKISA</span></a><% } %>
      <button type="button" class="dash-collapse" data-dash-collapse aria-label="Réduire la barre latérale" title="Réduire la barre latérale" aria-pressed="false"><%- icon('panelLeft', { size: 18 }) %></button>
    </div>
    <nav class="dash-nav" aria-label="<%= dash.module ? dash.module.label : "Mon espace" %>">
      <% dash.nav.forEach((g) => { %>
        <p class="dash-group"><%= g.group %></p>
        <ul class="dash-list">
          <% g.items.forEach((it) => { const on = it.key === dash.active; const count = it.badge === "unread" ? dash.unread : it.badge === "tasks" ? dash.tasks : it.badge === "notifications" ? dash.notifications : it.badge === "support" ? dash.support : 0; const countLabel = it.badge === "tasks" ? `${count} tâche(s) à faire` : it.badge === "notifications" ? `${count} notification(s) non lue(s)` : `${count} non lu(s)`; %>
            <li><a href="<%= it.href %>" class="dash-link" data-tip="<%= it.label %>"<%- on ? ' aria-current="page"' : "" %>><%- icon(it.icon, { size: 18 }) %><span class="dash-link-label"><%= it.label %></span><% if (count) { %><span class="dash-badge" aria-label="<%= countLabel %>"><%= count %></span><% } %></a></li>
          <% }) %>
        </ul>
      <% }) %>
    </nav>
<% if (!dash.module) { %>    <div class="dash-sidebar-foot">
      <a href="/" class="dash-link" data-tip="Voir le site"><%- icon('globe', { size: 18 }) %><span class="dash-link-label">Voir le site</span></a>
      <form action="/deconnexion" method="post"><button type="submit" class="dash-link" data-tip="Déconnexion"><%- icon('logout', { size: 18 }) %><span class="dash-link-label">Déconnexion</span></button></form>
    </div><% } %>
  </aside>
  <div class="dash-overlay" data-dash-overlay hidden></div>
  <div class="dash-main">
    <header class="dash-topbar">
      <button type="button" class="dash-menu-btn" data-dash-menu aria-label="Ouvrir le menu" aria-controls="dashSidebar" aria-expanded="false"><%- icon('menu', { size: 20 }) %></button>
      <span class="dash-topbar-brand"><%= dash.module ? dash.module.label : "KOLAKISA" %></span>
      <div class="dash-user">
        <span class="avatar avatar-sm" aria-hidden="true" style="background:<%= avatarColor(currentUser.username) %>"><%= currentUser.username.slice(0, 1).toUpperCase() %></span>
        <span class="dash-user-name"><%= currentUser.username %></span>
      </div>
    </header>
    <% if (dash.site && dash.site.ok && dash.site.scoped) { const ds = dash.site, cur = ds.current; %>
    <%# Sélecteur de site universel : liens réels (fonctionne sans JavaScript), recherche et protection des modifications non enregistrées dans dash-site.js %>
    <div class="dash-sitebar" data-dash-site data-site-count="<%= ds.sites.length %>">
      <span class="dash-sitebar-label" id="dashSiteLabel">Site administré</span>
      <div class="dash-site-pick">
        <button type="button" class="dash-site-btn" data-dash-site-toggle aria-haspopup="listbox" aria-expanded="false" aria-controls="dashSiteList" aria-labelledby="dashSiteLabel dashSiteCurrent">
          <span class="dash-site-mark" aria-hidden="true"><%= cur.name.slice(0, 1).toUpperCase() %></span>
          <span class="dash-site-text" id="dashSiteCurrent"><strong><%= cur.name %></strong><small><%= cur.domain || (cur.main ? "Site principal" : "Sans domaine") %></small></span>
          <%- icon('chevronDown', { size: 16 }) %>
        </button>
        <div class="dash-site-pop" id="dashSiteList" hidden>
          <% if (ds.sites.length > 6) { %><label class="dash-site-search"><span class="sr-only">Rechercher un site</span><input type="search" data-dash-site-search placeholder="Rechercher un site…" autocomplete="off"></label><% } %>
          <ul role="listbox" aria-label="Sites">
            <% ds.sites.forEach((s) => { const on = s.key === cur.key; %>
            <li role="option" aria-selected="<%= on %>" data-site-name="<%= (s.name + ' ' + s.domain).toLowerCase() %>"><a href="<%= ds.withSite(ds.home, s.id) %>" class="dash-site-opt<%= on ? ' is-current' : '' %>"<%- on ? ' aria-current="true"' : '' %>>
              <span class="dash-site-mark" aria-hidden="true"><%= s.name.slice(0, 1).toUpperCase() %></span>
              <span class="dash-site-text"><strong><%= s.name %></strong><small><%= s.domain || (s.main ? "Site principal" : "Sans domaine") %><%= s.main && s.domain ? " · principal" : "" %></small></span>
              <% if (on) { %><span class="dash-site-state">Sélectionné</span><% } %>
            </a></li>
            <% }) %>
          </ul>
          <p class="dash-site-empty" data-dash-site-empty hidden>Aucun site ne correspond.</p>
          <a class="dash-site-all" href="/marketing/site-web/sites">Gérer mes sites</a>
        </div>
      </div>
      <% if (ds.denied) { %><p class="dash-site-denied" role="alert"><%= ds.denied %> Le site « <%= cur.name %> » est affiché à la place.</p><% } %>
    </div>
    <script src="<%= asset('/js/dash-site.js') %>" defer></script>
    <% } %>
    <main id="main" tabindex="-1" class="dash-content">
      <% if (trail.length > 1) { %><nav class="dash-crumbs" aria-label="Fil d'Ariane"><ol>
        <% trail.forEach((c, i) => { const last = i === trail.length - 1; %><li><% if (c.href && !last) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span<%- last ? ' aria-current="page"' : "" %>><%= c.label %></span><% } %></li><% }) %>
      </ol></nav><% } %>
