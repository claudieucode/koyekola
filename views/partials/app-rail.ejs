<%# Rail « Mon espace » : la navigation générale réduite à ses icônes, affichée à gauche des modules qui ont leur propre
    menu (SEO, Marketing). Il garde le contexte : où je suis (module actif), comment revenir (vue d'ensemble), où aller.
    Paramètres : railNav (rubriques), railActive (clé active), railUnread (messages non lus), railStyle (variables du thème). %>
<nav class="app-rail" id="appRail" aria-label="Navigation générale de Mon espace"<% if (typeof railStyle !== "undefined" && railStyle) { %> style="<%= railStyle %>"<% } %>>
  <a href="/formateur" class="app-rail-brand" data-tip="Mon espace — vue d'ensemble" aria-label="Mon espace — vue d'ensemble"><span aria-hidden="true">K</span></a>
  <ul class="app-rail-list">
    <% railNav.forEach((g, gi) => { if (gi) { %><li class="app-rail-sep" role="separator" aria-hidden="true"></li><% } %>
      <% g.items.forEach((it) => { const on = it.key === railActive; const unread = it.badge === "unread" && typeof railUnread !== "undefined" ? railUnread : 0; %>
        <li><a href="<%= it.href %>" class="app-rail-link" data-tip="<%= it.label %>" aria-label="<%= it.label %><%= unread ? ` (${unread} non lu(s))` : "" %>"<%- on ? ' aria-current="true"' : "" %>><%- icon(it.icon, { size: 18 }) %><% if (unread) { %><span class="app-rail-dot" aria-hidden="true"></span><% } %></a></li>
      <% }) %>
    <% }) %>
  </ul>
  <div class="app-rail-foot">
    <a href="/" class="app-rail-link" data-tip="Voir le site" aria-label="Voir le site"><%- icon('globe', { size: 18 }) %></a>
    <form action="/deconnexion" method="post"><button type="submit" class="app-rail-link" data-tip="Déconnexion" aria-label="Déconnexion"><%- icon('logout', { size: 18 }) %></button></form>
  </div>
</nav>
