<%# Carte d'une formation suivie, dans l'espace apprenant. Paramètres : course (avec pct, status, finished, resume), i (rang : les premières images ne sont pas différées) %>
<article class="mc-card" data-mc-card data-status="<%= course.status %>" data-title="<%= course.title.toLowerCase() %>" data-pct="<%= course.pct %>" data-act="<%= course.activity %>" data-rank="<%= i %>">
  <a class="mc-cover" href="/apprendre/<%= course.slug %>" tabindex="-1" aria-hidden="true">
    <% if (course.thumbnail_path) { %><img src="<%= course.thumbnail_path %>" alt="" width="640" height="360" decoding="async" <%- i < 3 ? "" : 'loading="lazy"' %>><span class="mc-cover-ph" hidden><%- icon("graduation", { size: 30 }) %></span><% } else { %><span class="mc-cover-ph"><%- icon("graduation", { size: 30 }) %></span><% } %>
  </a>
  <div class="mc-body">
    <p class="mc-badges">
      <% if (course.status === "finished") { %><span class="mc-badge mc-badge--done"><%- icon("check", { size: 12 }) %> Terminée</span>
      <% } else if (course.status === "started") { %><span class="mc-badge mc-badge--live">En cours</span>
      <% } else { %><span class="mc-badge">À commencer</span><% } %>
      <% if (course.archived) { %><span class="mc-badge">Archivée</span><% } %>
      <% if (!course.published) { %><span class="mc-badge">Hors ligne</span><% } %>
    </p>
    <h3 class="mc-title"><a href="/apprendre/<%= course.slug %>"><%= course.title %></a></h3>
    <p class="mc-by">Par <%= course.instructor_name %></p>
    <div class="mc-bar" role="progressbar" aria-label="Progression de <%= course.title %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= course.pct %>"><span style="width:<%= course.pct %>%"></span></div>
    <p class="mc-meta"><b><%= course.pct %>%</b> · <%= course.completed_lessons %> / <%= course.total_lessons %> sous-chapitres</p>
    <% if (!course.finished && course.resume) { %><p class="mc-last">Dernière leçon : <%= course.resume.title %></p><% } %>
  </div>
  <div class="mc-actions">
    <% if (course.finished) { %>
      <a href="/certificat/<%= course.slug %>" class="btn btn-success btn-sm"><%- icon('trophy', { size: 15 }) %> Certificat</a>
      <a href="/apprendre/<%= course.slug %>" class="btn btn-outline btn-sm">Revoir</a>
    <% } else { %>
      <a href="/apprendre/<%= course.slug %>" class="btn <%= course.status === 'started' ? 'btn-primary' : 'btn-secondary' %> btn-sm"><%= course.status === "started" ? "Continuer" : "Commencer" %><span class="sr-only"> <%= course.title %></span></a>
    <% } %>
  </div>
</article>
