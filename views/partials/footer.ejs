<% if (typeof dash !== "undefined" && dash) { %><%- include("dash-close") %><% } else { %>
  </main>

  <footer class="site-footer">
    <% const footerGridClass = (typeof navMenu === "function" && navMenu("footer") && navMenu("footer").items.length > 0) ? "container-wide footer-grid footer-grid--menu" : "container-wide footer-grid"; %>
    <div class="<%= footerGridClass %>">
      <div class="footer-brand">
        <% const apF = (typeof appearance === "function" && appearance()) ? appearance().footer : null; %>
        <% if (apF && apF.brandResolved.mode === "image" && apF.brandResolved.image) { %><p class="logo footer-logo-img"><img src="<%= apF.brandResolved.image.src %>" alt="<%= apF.brandResolved.alt || apF.brandResolved.text %>"></p>
        <% } else { %><p class="logo" data-initial="<%= String(apF ? apF.brandResolved.text : "KOLAKISA").trim().slice(0, 1).toUpperCase() %>"><%= apF ? apF.brandResolved.text : "KOLAKISA" %></p><% } %>
        <% if (!apF || apF.tagline) { %><p class="footer-tagline"><%= apF ? apF.tagline : "Mes formations en ligne : apprenez à votre rythme, où que vous soyez." %></p><% } %>
      </div>
      <%# Navigation du CMS : un menu affecté au pied de page remplace les colonnes de liens d'origine (même structure : titre + liens) ; sinon rien ne change %>
      <% const footerMenu = typeof navMenu === "function" ? navMenu("footer") : null; %>
      <% if (footerMenu && footerMenu.items.length) {
           // Chaque élément ayant des sous-éléments devient une colonne ; les éléments seuls sont regroupés dans une colonne « Liens »
           const cols = []; let loose = null;
           footerMenu.items.forEach((it) => { if (it.children.length) { cols.push({ head: it, links: it.children }); } else { if (!loose) { loose = { head: null, links: [] }; cols.push(loose); } loose.links.push(it); } });
      %>
        <nav class="footer-menu" aria-label="Liens du pied de page">
        <% cols.forEach((col, ci) => { %>
          <div class="footer-col">
            <% if (col.head) { %><h4><% if (col.head.href) { %><a href="<%= col.head.href %>"<%- col.head.newTab ? ' target="_blank"' : "" %><%- col.head.rel ? ` rel="${col.head.rel}"` : "" %>><%= col.head.label %></a><% } else { %><%= col.head.label %><% } %></h4><% } else { %><h4>Liens</h4><% } %>
            <% col.links.forEach((l) => { %>
              <% if (l.href) { %><a href="<%= l.href %>"<%- l.newTab ? ' target="_blank"' : "" %><%- l.rel ? ` rel="${l.rel}"` : "" %>><%= l.label %></a><% } else { %><span class="footer-group"><%= l.label %></span><% } %>
              <% l.children.forEach((c) => { if (c.href) { %><a class="footer-sublink" href="<%= c.href %>"<%- c.newTab ? ' target="_blank"' : "" %><%- c.rel ? ` rel="${c.rel}"` : "" %>><%= c.label %></a><% } }) %>
            <% }) %>
          </div>
        <% }) %>
        </nav>
      <% } else { %>
      <div class="footer-col">
        <h4>Découvrir</h4>
        <a href="/catalogue">Toutes les formations</a>
        <a href="/inscription">Créer un compte</a>
      </div>
      <div class="footer-col">
        <h4>Catégories</h4>
        <% navCategories.slice(0, 6).forEach((cat) => { %><a href="/categorie/<%= slugify(cat) %>"><%= cat %></a><% }) %>
      </div>
      <div class="footer-col">
        <h4>Informations</h4>
        <a href="/a-propos">À propos</a>
        <a href="/blog">Blog</a>
        <a href="/faq">Questions fréquentes</a>
        <a href="/contact">Contact</a>
      </div>
      <% } %>
    </div>
    <%# Widgets (Apparence → Widgets) : sections 1 et 2 de pied de page du site courant ; rien ne s'affiche si elles sont vides %>
    <% const wf1 = typeof widgetZone === "function" ? widgetZone("footer-1") : "", wf2 = typeof widgetZone === "function" ? widgetZone("footer-2") : ""; %>
    <% if (wf1 || wf2) { %><div class="container-wide footer-widgets"><%- wf1 %><%- wf2 %></div><% } %>
    <div class="container-wide footer-bottom">
      <span><%- apF ? "" : "KOLAKISA &copy; 2026 — projet pédagogique, aucun paiement réel n'est traité." %><%= apF ? apF.copyrightText : "" %></span>
      <% if (!apF || apF.cookies) { %><a href="/cookies" data-kw-consent-open>Cookies</a><% } %>
    </div>
  </footer>

  <div class="mobile-nav-overlay" id="mobileNavOverlay" hidden></div>
  <%- include("consent-banner") %>
<% } %>

  <script src="<%= asset('/js/floating.js') %>" defer></script>
  <script src="<%= asset('/js/main.js') %>" defer></script>
  <% if (typeof navMenu === "function" && (navMenu("header") || navMenu("mobile"))) { %><script src="<%= asset('/js/site-nav.js') %>" defer></script><% } %>
  <% if (!(typeof dash !== "undefined" && dash)) { %><script src="<%= asset('/js/visitor.js') %>" defer></script><% } %>
  <script src="<%= asset('/js/popup.js') %>" defer></script>
  <% if (typeof dash !== "undefined" && dash) { %><script src="<%= asset('/js/dashboard.js') %>" defer></script><% } %>
</body>
</html>
