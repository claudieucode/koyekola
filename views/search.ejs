<%- include("partials/header", { title: title, seo: { noindex: true } }) %>

  <div class="container kv-search">
    <h1>Recherche</h1>
    <form class="kv-error-search" action="/recherche" method="get" role="search">
      <label for="site-search" class="sr-only">Rechercher dans le site</label>
      <input id="site-search" type="search" name="q" value="<%= q %>" maxlength="100" placeholder="Rechercher un article ou une page">
      <button type="submit" class="btn btn-primary">Rechercher</button>
    </form>

    <% if (!q) { %>
      <p class="kv-error-msg">Saisissez un mot pour chercher dans les articles et les pages du site.</p>
    <% } else if (!articles.length && !pages.length) { %>
      <div class="empty-state"><div class="kv-empty-ill" aria-hidden="true"><%- illu("recherche") %></div><h3>Aucun résultat</h3><p>Aucun résultat pour « <%= q %> ».</p><a href="/catalogue" class="btn btn-outline">Voir le catalogue</a></div>
    <% } else { %>
      <% if (articles.length) { %>
        <h2>Articles (<%= articles.length %>)</h2>
        <ul style="list-style:none;padding:0;">
          <% articles.forEach((a) => { %><li style="margin:0 0 14px;"><a href="<%= a.url %>"><strong><%= a.title %></strong></a><br><span style="color:var(--muted);"><%= a.summary %></span></li><% }) %>
        </ul>
      <% } %>
      <% if (pages.length) { %>
        <h2>Pages (<%= pages.length %>)</h2>
        <ul style="list-style:none;padding:0;">
          <% pages.forEach((a) => { %><li style="margin:0 0 14px;"><a href="<%= a.url %>"><strong><%= a.title %></strong></a><% if (a.summary) { %><br><span style="color:var(--muted);"><%= a.summary %></span><% } %></li><% }) %>
        </ul>
      <% } %>
    <% } %>
  </div>

<%- include("partials/footer") %>
