<%- include("../partials/header", { title, seo: { noindex: true, rawTitle: title + " · KOYEKOLA" } }) %>
  <div class="auth-page">
    <div class="auth-card">
      <h1>Ne plus recevoir de SMS</h1>
      <% if (already) { %>
        <p class="subtitle">Le numéro <strong><%= masked %></strong> ne reçoit déjà plus nos SMS.</p>
      <% } else { %>
        <p class="subtitle">Ne plus recevoir les SMS de KOYEKOLA au <strong><%= masked %></strong> ?</p>
        <form method="post">
          <button type="submit" class="btn btn-primary btn-block btn-lg">Confirmer</button>
        </form>
        <p class="form-footer">Vos e-mails et votre accès aux formations ne changent pas.</p>
      <% } %>
    </div>
  </div>
<%- include("../partials/footer") %>
