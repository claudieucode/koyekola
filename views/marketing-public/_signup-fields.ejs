<%# Champs d'inscription d'un formulaire (page du formulaire /f/… et section « inscription » d'une page d'atterrissage) :
    piège à robots, e-mail, champs du formulaire, propriétés, case de consentement (preuve), accord SMS facultatif. p = préfixe des identifiants. %>
<% const p = typeof prefix !== "undefined" && prefix ? prefix : "f"; %>
          <div class="hp-field" aria-hidden="true"><label for="<%= p %>-website">Ne pas remplir</label><input id="<%= p %>-website" type="text" name="website" tabindex="-1" autocomplete="off"></div>
          <div class="field-group"><label for="<%= p %>-email">Adresse e-mail</label><input id="<%= p %>-email" type="email" name="email" value="<%= values.email || '' %>"<%- typeof autofocus === "undefined" || autofocus ? " required autofocus" : " required" %>></div>
          <% form.fields.forEach((key) => { %>
            <div class="field-group"><label for="<%= p %>-<%= key %>"><%= fieldCatalog[key] %></label><input id="<%= p %>-<%= key %>" type="text" name="<%= key %>" maxlength="200" value="<%= values[key] || '' %>"></div>
          <% }) %>
          <% (typeof propertyDefs !== "undefined" ? propertyDefs : []).forEach((d) => { const id = p + "-prop-" + d.key; const v = values[d.name] || ""; %>
            <% if (d.type === "boolean") { %>
              <label class="checkbox-row"><input id="<%= id %>" type="checkbox" name="<%= d.name %>" value="oui"<%- v ? " checked" : "" %>> <%= d.label %></label>
            <% } else if (d.type === "select") { %>
              <div class="field-group"><label for="<%= id %>"><%= d.label %></label><select id="<%= id %>" name="<%= d.name %>">
                <option value="">—</option>
                <% d.options.forEach((o) => { %><option value="<%= o %>"<%- v === o ? " selected" : "" %>><%= o %></option><% }) %>
              </select></div>
            <% } else { %>
              <div class="field-group"><label for="<%= id %>"><%= d.label %></label><input id="<%= id %>" type="<%= d.type === "number" ? "number" : d.type === "date" ? "date" : "text" %>" name="<%= d.name %>" value="<%= v %>"<%- d.type === "text" ? ' maxlength="500"' : d.type === "number" ? ' step="any"' : "" %>></div>
            <% } %>
          <% }) %>
          <label class="checkbox-row optin-row"><input type="checkbox" name="consent" value="1" required> <%= form.consentText %></label>
          <% if (form.smsConsentText) { %>
            <%# Accord SMS : facultatif et SÉPARÉ de l'e-mail (seconde case, jamais pré-cochée) ; numéro demandé à part si le formulaire n'a pas « Téléphone » %>
            <% if (!form.fields.includes("phone")) { %>
              <div class="field-group"><label for="<%= p %>-sms-phone">Numéro de mobile (pour les SMS)</label><input id="<%= p %>-sms-phone" type="tel" name="sms_phone" maxlength="40" autocomplete="tel" value="<%= values.sms_phone || '' %>"></div>
            <% } %>
            <label class="checkbox-row optin-row"><input type="checkbox" name="sms_consent" value="1"<%- values.sms_consent ? " checked" : "" %>> <%= form.smsConsentText %></label>
          <% } %>
