<%# Texte rotatif (widgets/motion-rotating-text.js). Sans JavaScript : premier mot affiché, les autres lisibles par les lecteurs d'écran. Animation : public/js/motion-studio/text-fx.js (rotating). %>
<% const tag = ["h1", "h2", "h3", "h4", "p", "div"].includes(p.tag) ? p.tag : "h2"; const ws = (p.words || []).map((x) => x.text).filter(Boolean); %>
<<%= tag %> class="<%= cls %> kw-ms kw-ms-rot" data-kw-ms-fx="rotating"<%- attrs %>><% if (p.before) { %><span class="kw-ms-rot-pre"><%= p.before %></span> <% } %><span class="kw-ms-rot-slot"><% ws.forEach((t, i) => { %><span class="kw-ms-rot-w<%= i ? " kw-ms-rot-alt" : "" %>"><%= t %></span> <% }) %></span><% if (p.after) { %> <span class="kw-ms-rot-post"><%= p.after %></span><% } %></<%= tag %>>
