<%# Commentaires de l'article : liste approuvée (réponses comprises) lue dans le moteur de commentaires du CMS. Le formulaire
    (membres, invités, modération, anti-spam) reste celui de la page de l'article. d = { post, roots, total, page, pages, replies, maxDepth, open }. %>
<% const post = d && d.post; %>
<% if (!post) { %><% if (isBuilder) { %><section class="<%= cls %>"<%- attrs %>><p class="kw-pc-note">Commentaires : visibles sur un modèle « Article du blog ».</p></section><% } %>
<% } else { %>
<% const day = (v) => new Date(String(v).replace(" ", "T") + "Z").toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
   const one = (c, level) => { %>
  <li class="kw-pc-item" id="commentaire-<%= c.id %>">
    <% if (c.avatar) { %><img class="kw-pc-avatar" src="<%= c.avatar %>" alt="" width="40" height="40" loading="lazy"><% } else { %><span class="kw-pc-avatar kw-pc-initial" aria-hidden="true"><%= String(c.name || "?").charAt(0).toUpperCase() %></span><% } %>
    <div class="kw-pc-main"><p class="kw-pc-meta"><strong><%= c.name %></strong><% if (c.author) { %> <span class="kw-pc-badge">Auteur</span><% } %> · <time datetime="<%= String(c.at).replace(" ", "T") %>Z"><%= day(c.at) %></time></p>
      <div class="kw-pc-body"><% String(c.body).split(/\n{2,}/).forEach((para) => { %><p><%= para %></p><% }) %></div>
      <% if (d.open && d.replies && level < d.maxDepth) { %><a class="kw-pc-reply" href="/blog/<%= encodeURIComponent(post.slug) %>?repondre=<%= c.id %>#commentaire-form">Répondre</a><% } %>
    </div>
    <% if (c.children.length) { %><ol class="kw-pc-list kw-pc-replies"><% c.children.forEach((r) => { one(r, level + 1); }) %></ol><% } %>
  </li>
<% }; %>
<section class="<%= cls %>"<%- attrs %>>
  <h2 class="kw-pc-heading"><%= p.heading %> <span class="kw-pc-count">(<%= d.total %>)</span></h2>
  <% if (d.roots.length) { %><ol class="kw-pc-list"><% d.roots.forEach((c) => { one(c, 1); }) %></ol>
    <% if (d.pages > 1) { %><nav class="kw-pc-pager" aria-label="Pages de commentaires"><% if (d.page > 1) { %><a href="?cpage=<%= d.page - 1 %>#commentaires">Commentaires précédents</a><% } %><span>Page <%= d.page %> sur <%= d.pages %></span><% if (d.page < d.pages) { %><a href="?cpage=<%= d.page + 1 %>#commentaires">Commentaires suivants</a><% } %></nav><% } %>
  <% } else { %><p class="kw-pc-empty"><%= d.open ? "Aucun commentaire pour l'instant : soyez le premier à réagir." : "Aucun commentaire." %></p><% } %>
</section>
<% } %>
