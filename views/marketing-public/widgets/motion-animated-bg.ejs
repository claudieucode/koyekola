<%# Fond animé (widgets/motion-animated-bg.js). Variables : p, cls, attrs, L (L.link), d (couleurs CSS validées par le serveur). Sans JavaScript : fond fixe, texte lisible. Les calques sont animés par public/js/motion-studio/animated-bg.js. %>
<% const tag = ["h1", "h2", "h3", "p"].includes(p.titleTag) ? p.titleTag : "h2"; const c = d || { c1: "var(--kw-primary, #0277b6)", c2: "var(--kw-secondary, #6d28d9)", c3: "var(--kw-accent, #db2777)" }; %>
<div class="<%= cls %> kw-ms kw-ms-bg is-<%= p.tone === "dark" ? "dark" : "light" %> is-<%= p.align === "left" ? "left" : "center" %>" style="--kw-ms-c1: <%= c.c1 %>; --kw-ms-c2: <%= c.c2 %>; --kw-ms-c3: <%= c.c3 %>; --kw-ms-min: <%= Number(p.minHeight) || 360 %>px"<%- attrs %>>
  <div class="kw-ms-bg-art" aria-hidden="true"><span class="kw-ms-bg-l1"></span><span class="kw-ms-bg-l2"></span><span class="kw-ms-bg-l3"></span><span class="kw-ms-bg-grain"></span></div>
  <div class="kw-ms-bg-body">
    <<%= tag %> class="kw-ms-bg-title"><%= p.title %></<%= tag %>>
    <% if (p.text) { %><p class="kw-ms-bg-text"><%= p.text %></p><% } %>
    <% if (p.buttonLabel && L.link) { %><a class="kw-ms-bg-btn" href="<%= L.link %>"><%= p.buttonLabel %></a><% } %>
  </div>
</div>
