<%# Révélation de texte (widgets/motion-text-reveal.js). Variables : p, cls, attrs (data-kw-ms-module + data-kw-ms), isBuilder. Sans JavaScript : le texte complet est affiché tel quel. Découpage et révélation : public/js/motion-studio/split-text.js. %>
<% const tag = ["h1", "h2", "h3", "h4", "p", "div"].includes(p.tag) ? p.tag : "p"; const rows = String(p.text || "").split(/\n+/); %>
<<%= tag %> class="<%= cls %> kw-ms kw-ms-st" data-kw-ms-split="<%= ["chars", "words", "lines"].includes(p.split) ? p.split : "words" %>"<%- attrs %>><span class="kw-ms-st-src"><% rows.forEach((t, i) => { %><%= t %><% if (i < rows.length - 1) { %><br><% } %><% }) %></span></<%= tag %>>
