<%# Machine à écrire (widgets/motion-typewriter.js). Sans JavaScript : texte avant + première phrase + texte après sont affichés ; les autres phrases sont lisibles par les lecteurs d'écran. Animation : public/js/motion-studio/text-fx.js (typewriter). %>
<% const tag = ["h1", "h2", "h3", "h4", "p", "div"].includes(p.tag) ? p.tag : "h2"; const list = (p.phrases || []).map((x) => x.text).filter(Boolean); const cur = ["bar", "block", "underscore", "none"].includes(p.cursor) ? p.cursor : "bar"; %>
<<%= tag %> class="<%= cls %> kw-ms kw-ms-tpw is-cursor-<%= cur %>" data-kw-ms-fx="typewriter" data-kw-ms-tcursor="<%= cur %>"<%- attrs %>><% if (p.prefix) { %><span class="kw-ms-tpw-pre"><%= p.prefix %></span> <% } %><span class="kw-ms-tpw-p"><%= list[0] %></span><% list.slice(1).forEach((t) => { %> <span class="kw-ms-tpw-alt">, <span class="kw-ms-tpw-p"><%= t %></span></span><% }) %><% if (p.suffix) { %> <span class="kw-ms-tpw-suf"><%= p.suffix %></span><% } %></<%= tag %>>
