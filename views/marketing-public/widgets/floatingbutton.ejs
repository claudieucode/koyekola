<%# Bouton flottant (src/marketing/pages/widgets/floatingbutton.js). Variables : p, d (d.href reconstruit, d.name), cls, attrs, icon(). Dans l'éditeur il reste dans la page (pas fixé à l'écran). %>
<div class="<%= cls %> is-side-<%= p.side === "left" ? "left" : "right" %>"<%- attrs %>><a class="kw-fb-btn" href="<%= d.href %>"<%- /^https:/.test(d.href) ? ' target="_blank" rel="noopener noreferrer"' : "" %> aria-label="<%= p.label || d.name %> (<%= d.name %>)"><span class="kw-fb-icon" aria-hidden="true"><%- icon(p.platform === "email" ? "mail" : "send", { size: 24 }) %></span><span class="kw-fb-label"><%= p.label || d.name %></span></a></div>
