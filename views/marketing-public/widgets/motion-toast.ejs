<%# Notification animée (widgets/motion-toast.js). Variables : p, cls, attrs, isBuilder. Sans JavaScript (et dans l'éditeur) : le message est affiché en clair, en place. public/js/motion-studio/toast.js le remplace par la vraie notification flottante. %>
<% const tone = ["info", "success", "warning", "error"].includes(p.tone) ? p.tone : "info"; const place = ["bottom-right", "bottom-left", "bottom-center", "top-right", "top-left", "top-center"].includes(p.placement) ? p.placement : "bottom-right"; const launch = ["click", "delay", "load"].includes(p.launch) ? p.launch : "click"; %>
<div class="<%= cls %> kw-ms kw-ms-d kw-ms-toast-host" data-kw-ms-launch="<%= launch %>" data-kw-ms-after="<%= Number(p.after) || 5 %>" data-kw-ms-hide="<%= Number(p.hideAfter) || 0 %>" data-kw-ms-place="<%= place %>" data-kw-ms-btn="<%= p.buttonLabel || "Afficher la notification" %>"<%- attrs %>>
  <div class="kw-ms-toast kw-ms-toast-static kw-ms-tone-<%= tone %>" role="<%= tone === "error" ? "alert" : "status" %>"><div class="kw-ms-toast-text"><% if (p.title) { %><strong class="kw-ms-toast-title"><%= p.title %></strong><% } %><span class="kw-ms-toast-msg"><%= p.message %></span></div></div>
</div>
