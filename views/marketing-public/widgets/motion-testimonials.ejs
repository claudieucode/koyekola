<%# Témoignages animés (widgets/motion-testimonials.js). Variables : p, cls, attrs. Sans JavaScript ou en mouvement réduit : tous les témoignages l'un sous l'autre.
    Avec JavaScript (public/js/motion-studio/testimonials.js) : un témoignage à la fois, transition animée, flèches, points, glisser, lecture automatique avec pause. %>
<div class="<%= cls %> kw-ms kw-ms-ts<%= p.arrows ? " has-arrows" : "" %><%= p.dots ? " has-dots" : "" %>" role="region" aria-roledescription="carrousel" aria-label="<%= p.label %>"<%- attrs %>>
  <ul class="kw-ms-ts-list" data-ms-list><% p.items.forEach((t, i) => { %>
    <li class="kw-ms-ts-slide" data-ms-slide aria-roledescription="diapositive" aria-label="<%= i + 1 %> sur <%= p.items.length %>">
      <figure class="kw-ms-ts-fig">
        <% if (t.stars > 0) { %><p class="kw-ms-ts-stars" role="img" aria-label="Note : <%= t.stars %> sur 5"><%= "★".repeat(t.stars) %><span aria-hidden="true"><%= "☆".repeat(5 - t.stars) %></span></p><% } %>
        <blockquote class="kw-ms-ts-quote"><p><%= t.quote %></p></blockquote>
        <figcaption class="kw-ms-ts-who"><% if (t.photo) { %><img class="kw-ms-ts-photo" src="<%= t.photo %>" alt="" loading="lazy" decoding="async"><% } %><span class="kw-ms-ts-id"><strong class="kw-ms-ts-name"><%= t.name %></strong><% if (t.role) { %><span class="kw-ms-ts-role"><%= t.role %></span><% } %></span></figcaption>
      </figure>
    </li><% }) %>
  </ul>
</div>
