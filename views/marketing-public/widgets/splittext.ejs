<%# Texte animé (widgets/splittext.js). Variables : p, cls, attrs. Le texte complet reste lisible (sr-only) ; les morceaux animés sont cachés aux lecteurs d'écran.
    Les décalages sont posés par public/js/landing.js (jamais de style en ligne). %>
<% const tag = ["h1", "h2", "h3", "h4", "p"].includes(p.tag) ? p.tag : "h2"; const units = p.split === "words" ? String(p.text).split(/\s+/).filter(Boolean) : String(p.text).split(/\s+/).filter(Boolean); %>
<<%= tag %> class="<%= cls %> is-<%= p.effect %> is-<%= p.align %>" data-kw-stagger="<%= p.stagger %>" data-kw-dur="<%= p.duration %>" data-kw-trigger="<%= p.trigger %>"<%- attrs %>><span class="sr-only"><%= p.text %></span><span class="kw-st-vis" aria-hidden="true"><% units.forEach((w, wi) => { %><% if (wi) { %> <% } %><span class="kw-st-w"><% if (p.split === "words") { %><span class="kw-st-c"><%= w %></span><% } else { Array.from(w).forEach((ch) => { %><span class="kw-st-c"><%= ch %></span><% }) } %></span><% }) %></span></<%= tag %>>
