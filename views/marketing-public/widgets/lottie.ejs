<%# Animation Lottie (widgets/lottie.js). Variables : p, cls, attrs, L (L.src), isBuilder. Exécution : public/js/landing.js + public/js/vendor/lottie_light.min.js (chargé à la demande). %>
<% if (isBuilder && p.src) { %><div class="<%= cls %> is-<%= p.align %>"<%- attrs %>><div class="kw-lottie-stage" data-kw-lottie="<%= p.src %>" data-kw-trigger="load" data-kw-still="1" data-kw-speed="1" role="img" aria-label="<%= p.alt %> (aperçu : première image)" style="<%= p.height ? `height:${p.height}px` : "" %>"></div></div>
<% } else if (isBuilder) { %><div class="<%= cls %> is-<%= p.align %> kw-lottie-placeholder"<%- attrs %> role="img" aria-label="<%= p.alt %>" style="<%= p.height ? `height:${p.height}px` : "min-height:120px" %>"><span>Animation Lottie : <%= p.alt %></span></div>
<% } else { %><div class="<%= cls %> is-<%= p.align %>"<%- attrs %>><div class="kw-lottie-stage" data-kw-lottie="<%= p.src %>" data-kw-trigger="<%= p.trigger %>" data-kw-speed="<%= p.speed %>"<%- p.loop ? " data-kw-loop" : "" %> role="img" aria-label="<%= p.alt %>" style="<%= p.height ? `height:${p.height}px` : "" %>"></div></div><% } %>
