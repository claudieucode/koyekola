<%# Parallaxe d'image (widgets/motion-image-parallax.js). Variables : p, cls, attrs, isBuilder. Sans JavaScript : image fixe recadrée. Le mouvement est posé par public/js/motion-studio/image-parallax.js. %>
<% const R = { "16-9": "kw-ms-vr-16-9", "4-3": "kw-ms-vr-4-3", "3-2": "kw-ms-vr-3-2", "1-1": "kw-ms-vr-1-1", "3-4": "kw-ms-vr-3-4", "21-9": "kw-ms-vr-21-9" }; const ratio = R[p.ratio] || R["21-9"]; %>
<figure class="<%= cls %> kw-ms kw-ms-pp"<%- attrs %>>
<% if (!p.image) { %><% if (isBuilder) { %><div class="kw-ms-vempty <%= ratio %>">Choisissez une image dans l'onglet Contenu.</div><% } %>
<% } else { %><span class="kw-ms-pp-frame <%= ratio %>"><img class="kw-ms-pp-img" src="<%= p.image %>" alt="<%= p.alt || "" %>" loading="lazy" decoding="async" draggable="false"></span>
<% if (p.caption) { %><figcaption class="kw-ms-vcap"><%= p.caption %></figcaption><% } %><% } %>
</figure>
