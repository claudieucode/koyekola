<%# Bouton Facebook (widgets/facebookbutton.js). Variables : p, cls, attrs, d = { src, width, height }. %>
<div class="<%= cls %> is-<%= p.align %>"<%- attrs %>><% if (d) { %><iframe class="kw-fbbtn-frame" src="<%= d.src %>" width="<%= d.width %>" height="<%= d.height %>" title="Bouton Facebook" loading="lazy" scrolling="no" allow="encrypted-media" referrerpolicy="strict-origin-when-cross-origin"></iframe><% } %></div>
