<%# Diaporama (widgets/carrousels.js). Variables : p, cls, attrs, L (L.slides[i].buttonUrl). Exécution : le carrousel du site (data-kw-carousel). %>
<div class="<%= cls %> <%= p.align === "left" ? "is-left" : "is-center" %><%= p.kenBurns === "in" || p.kenBurns === "out" ? " is-kb-" + p.kenBurns : "" %>" role="region" aria-roledescription="carrousel" aria-label="<%= p.label %>" data-kw-carousel<%- p.dots ? " data-kw-dots" : "" %><%- p.autoplay ? ` data-kw-autoplay="${p.interval}"` : "" %><%- p.loop ? " data-kw-loop" : "" %><%- p.effect === "fade" ? ' data-kw-effect="fade"' : "" %><%- p.perView > 1 ? ` data-kw-per="${p.perView}"` : "" %><%- attrs %>>
  <div class="kw-carousel-track"><% p.slides.forEach((s, i) => { %>
    <figure class="kw-carousel-slide kw-slide" style="min-height:<%= p.height %>px" aria-roledescription="diapositive" aria-label="<%= i + 1 %> sur <%= p.slides.length %>"><% if (s.image) { %><img class="kw-slide-img" src="<%= s.image %>" alt="" loading="<%= i === 0 ? "eager" : "lazy" %>" decoding="async"><% } %><span class="kw-slide-veil" style="opacity:<%= (s.dark || 0) / 100 %>"></span>
      <div class="kw-slide-body"><h3 class="kw-slide-title"><%= s.title %></h3><% if (s.text) { %><p class="kw-slide-text"><%= s.text %></p><% } %><% if (s.buttonLabel && (L.slides[i] || {}).buttonUrl) { %><a class="kw-button" href="<%= L.slides[i].buttonUrl %>"><%= s.buttonLabel %></a><% } %></div>
    </figure><% }) %>
  </div>
</div>
