<%# Titre à mot souligné (widgets/motion-animated-heading.js). Le tracé est écrit dans la page (visible sans JavaScript) ; la forme suit l'effet choisi (n.motion.studio.preset). Animation : text-fx.js (heading). %>
<% const tag = ["h1", "h2", "h3", "h4", "p", "div"].includes(p.tag) ? p.tag : "h2";
   const SHAPES = { underline: ["0 0 100 20", ["M2,13 Q50,17 98,10"]], double: ["0 0 100 20", ["M2,8 Q50,11 98,7", "M2,16 Q50,19 98,13"]], zigzag: ["0 0 100 20", ["M2,13 L12,6 L22,14 L32,6 L42,14 L52,6 L62,14 L72,6 L82,14 L92,6 L98,10"]], curly: ["0 0 100 20", ["M2,10 Q14,2 26,10 T50,10 T74,10 T98,10"]], circle: ["0 0 100 40", ["M52,4 C20,2 4,12 6,22 C8,34 40,38 66,36 C90,34 98,22 92,12 C86,4 60,3 38,6"]], strike: ["0 0 100 10", ["M0,5 L100,5"]] };
   const st = (n && n.motion && n.motion.studio) || {}; const shape = Object.hasOwn(SHAPES, st.preset) || st.preset === "marker" ? st.preset : "underline";
   const th = ["thin", "bold"].includes(p.thickness) ? p.thickness : "normal"; %>
<<%= tag %> class="<%= cls %> kw-ms kw-ms-ahd is-<%= th %>" data-kw-ms-fx="heading"<%- d.color ? ` style="--kw-ah-c: ${d.color}"` : "" %><%- attrs %>><% if (p.before) { %><span class="kw-ms-ahd-before"><%= p.before %></span> <% } %><span class="kw-ms-ahd-word is-<%= shape %>"><% if (shape === "marker") { %><span class="kw-ms-ahd-mark" aria-hidden="true"></span><% } %><span class="kw-ms-ahd-text"><%= p.highlight %></span><% if (shape !== "marker") { %><svg class="kw-ms-ahd-deco" viewBox="<%= SHAPES[shape][0] %>" preserveAspectRatio="none" aria-hidden="true" focusable="false"><% SHAPES[shape][1].forEach((dd) => { %><path d="<%= dd %>"></path><% }) %></svg><% } %></span><% if (p.after) { %> <span class="kw-ms-ahd-after"><%= p.after %></span><% } %></<%= tag %>>
