<%# Mini-panier. d = { count, items?, totalCents? } (tiroir : le contenu du vrai panier du visiteur). %>
<% const count = (d && d.count) || 0; %>
<% const mcMoney = (c) => c ? (c / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit"; const mcItems = (d && d.items) || []; const mcId = (String(cls).match(/kw-n-([a-z0-9]+)/) || [null, "x"])[1]; %>
<% if (p.skin === "drawer" && !isBuilder && !(p.hideEmpty && !count)) { %><div class="<%= cls %> kw-minicart-drawer"<%- attrs %>>
  <button type="button" class="kw-mc-open" aria-haspopup="dialog" data-kw-cart-open="kw-cd-<%= mcId %>" aria-label="<%= p.label || "Panier" %><%= count ? " (" + count + ")" : "" %>">
    <svg class="kw-mc-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
    <% if (p.label) { %><span class="kw-mc-label"><%= p.label %></span><% } %><% if (p.showCount && count) { %><span class="kw-mc-count"><%= count %></span><% } %></button>
  <dialog class="kw-cart-drawer" id="kw-cd-<%= mcId %>" aria-label="<%= p.label || "Panier" %>"><button type="button" class="kw-cart-close" aria-label="Fermer le panier"><span aria-hidden="true">×</span></button>
    <h3 class="kw-cart-title"><%= p.label || "Panier" %></h3>
    <% if (!mcItems.length) { %><p class="kw-cart-empty">Votre panier est vide.</p><% } else { %>
      <ul class="kw-cart-lines"><% mcItems.forEach((c) => { %><li class="kw-cart-line"><a class="kw-cart-name" href="<%= c.url %>"><%= c.title %></a><span class="kw-cart-price"><%= mcMoney(c.priceCents) %></span></li><% }) %></ul>
      <p class="kw-cart-total"><span>Total</span><strong><%= mcMoney(d.totalCents) %></strong></p>
      <div class="kw-cart-actions"><a class="kw-button" href="/commande">Passer la commande</a><a class="kw-cart-edit" href="/panier">Modifier le panier</a></div><% } %></dialog></div>
<% } else if (!(p.hideEmpty && !count && !isBuilder)) { %><a class="<%= cls %>" href="/panier" aria-label="<%= p.label || "Panier" %><%= count ? " (" + count + ")" : "" %>"<%- attrs %>>
  <svg class="kw-mc-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
  <% if (p.label) { %><span class="kw-mc-label"><%= p.label %></span><% } %>
  <% if (p.showCount && count) { %><span class="kw-mc-count"><%= count %></span><% } %>
</a><% } %>
