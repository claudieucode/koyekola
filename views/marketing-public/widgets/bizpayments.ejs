<%# Moyens de paiement (src/marketing/pages/widgets/footer.js). Variables : p, d (items[{key,label}]), cls, attrs, isBuilder. Libellés génériques : aucune marque, aucun logo. %>
<% if (d && d.items && d.items.length) { %>
<div class="<%= cls %> <%= p.look === "plain" ? "is-plain" : "is-pills" %>"<%- attrs %>>
  <% if (p.title) { %><p class="kw-biz-title"><%= p.title %></p><% } %>
  <ul class="kw-biz-pay"><% d.items.forEach((it) => { %><li class="kw-biz-pay-item"><% if (p.showIcon) { %><span class="kw-biz-icon" aria-hidden="true"><%- icon("coin", { size: 16 }) %></span><% } %><%= it.label %></li><% }) %></ul>
</div>
<% } else if (isBuilder) { %>
<div class="<%= cls %> kw-biz-empty"<%- attrs %>><p class="kw-biz-hint">Moyens de paiement : aucun moyen coché. Choisissez-les dans Paramètres → Données de l’entreprise.</p></div>
<% } %>
