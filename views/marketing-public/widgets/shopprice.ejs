<%# Prix du produit (widgets/shop.js) %>
<% if (d && d.closed || !d || d.product === null) { %><% if (isBuilder) { %><section class="<%= cls %>"<%- attrs %>><p class="kw-pb-msg">Prix : s'affiche sur une fiche produit publiée.</p></section><% } %>
<% } else { %><p class="<%= cls %> kw-shprice"<%- attrs %>><% if (d.demo) { %><small class="kw-pb-demo">exemple · </small><% } %><% if (d.from && p.fromLabel) { %><span class="kw-shprice-from"><%= p.fromLabel %></span> <% } %><% if (d.regular) { %><s class="kw-shprice-old"><%= d.regular %></s> <% } %><strong class="kw-shprice-now"><%= d.price %></strong><% if (p.taxNote) { %> <small class="kw-shprice-tax"><%= p.taxNote %></small><% } %></p><% } %>
