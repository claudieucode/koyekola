<%# Disponibilité (widgets/shop.js) %>
<% if (d && d.closed || !d || d.product === null) { %><% if (isBuilder) { %><section class="<%= cls %>"<%- attrs %>><p class="kw-pb-msg">Disponibilité : s'affiche sur une fiche produit publiée.</p></section><% } %>
<% } else { %><p class="<%= cls %> kw-shstock kw-shstock-<%= d.inStock ? "in" : "out" %>"<%- attrs %>><%= d.inStock ? p.inLabel : p.outLabel %></p><% } %>
