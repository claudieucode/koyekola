    <ul class="kw-account-list"><li><a class="kw-account-link" href="<%= href("/mon-compte") %>"><%= p.account %></a></li><% if (p.showCart) { %><li><a class="kw-account-cart" href="<%= href("/panier") %>"><%= p.cart %><% if (p.cartCount) { %> <span class="kw-cart-count" aria-label="<%= p.cartCount %> formation(s)"><%= p.cartCount %></span><% } %></a></li><% } %><li><form action="/deconnexion" method="post"><button type="submit" class="kw-account-logout">Se déconnecter</button></form></li></ul></details></div>
<% } else if (n.type === "account") { %>
  <div class="<%= cls %>"<%- attrs %>><% if (p.loggedIn) { %><a class="kw-account-link" href="<%= href("/mon-compte") %>"><%= p.account %></a><% } else { %><a class="kw-account-link" href="<%= href("/connexion") %>"><%= p.login %></a><% } %><% if (p.showCart) { %><a class="kw-account-cart" href="<%= href("/panier") %>"><%= p.cart %><% if (p.cartCount) { %> <span class="kw-cart-count" aria-label="<%= p.cartCount %> formation(s)"><%= p.cartCount %></span><% } %></a><% } %></div>
<% } else if (n.type === "dyntext") { const tag = p.tag; %>
  <<%= tag %> class="<%= cls %>"<%- attrs %>><%= p.before %><%= p.value || p.fallback %><%= p.after %></<%= tag %>>
<% } else if (n.type === "table") { %>
  <% const body = p.rows.slice(p.header ? 1 : 0, p.footer ? -1 : undefined); const cell = (r, tag) => r.map((c) => `<${tag}${tag === "th" ? ' scope="col"' : ""}>${esc(c)}</${tag}>`).join(""); %>
  <div class="<%= cls %><%= p.striped ? " is-striped" : "" %> <%= `kw-al-${p.align || "left"}` %>"<%- attrs %>><table><% if (p.caption) { %><caption><%= p.caption %></caption><% } %><% if (p.header) { %><thead><tr><%- cell(p.rows[0], "th") %></tr></thead><% } %><% if (body.length) { %><tbody><% body.forEach((r) => { %><tr><%- cell(r, "td") %></tr><% }) %></tbody><% } %><% if (p.footer) { %><tfoot><tr><%- cell(p.rows[p.rows.length - 1], "td") %></tr></tfoot><% } %></table></div>
<% } else if (n.type === "countdown") { const end = new Date(p.until); %>
  <div class="<%= cls %>" data-kw-countdown="<%= p.until %>" data-kw-end-text="<%= p.endText %>"<%- p.mode === "evergreen" ? ` data-kw-cd-evergreen="${p.minutes}" data-kw-cd-key="${n.id}"` : "" %><%- p.expire && !isBuilder ? ` data-kw-expire="${p.expire}"` : "" %><%- p.expire === "redirect" && !isBuilder ? ` data-kw-redirect="${esc(p.redirectUrl)}"` : "" %><%- p.hideUnits ? ` data-kw-hide-units="${p.hideUnits.join(" ")}"` : "" %><%- attrs %>><p class="kw-countdown-fallback">Jusqu'au <%= end.toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short", timeZone: "Europe/Paris" }) %> (heure de Paris)</p></div>
<% } else if (n.type === "addtocart" && p.course) { const price = p.course.priceCents ? (p.course.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit"; %>
  <form class="<%= cls %> kw-buy" method="post" action="/panier/ajouter/<%= p.courseId %>"<%- attrs %>><% if (p.mode === "buy") { %><input type="hidden" name="buyNow" value="1"><% } %><% if (p.showPrice) { %><span class="kw-buy-price"><%= price %></span><% } %><button type="submit" class="kw-button <%= `kw-btn-${p.variant}` %><%= p.size === "sm" ? " kw-btn-sm" : p.size === "lg" ? " kw-btn-lg" : "" %>"<%= preview || isBuilder ? " disabled" : "" %>><%= p.label %></button></form>
<% } else if (n.type === "courserating" && p.course) { const R = p.rating || { count: 0, average: 0 }, whole = Math.round(R.average), avg = R.average.toLocaleString("fr-FR", { minimumFractionDigits: 1, maximumFractionDigits: 1 }); %>
  <p class="<%= cls %> kw-courserating"<%- attrs %>><% if (!R.count) { %><span class="kw-courserating-none"><%= p.empty %></span><% } else { %><span class="kw-stars" role="img" aria-label="Note : <%= avg %> sur 5<%= p.showCount ? ", " + R.count + (R.count > 1 ? " avis" : " avis") : "" %>"><%= "★".repeat(whole) %><span class="kw-stars-off"><%= "★".repeat(5 - whole) %></span></span> <strong><%= avg %></strong><% if (p.showCount) { %> <span class="kw-courserating-count">(<%= R.count %> avis)</span><% } %><% } %></p>
<% } else if (n.type === "course" && p.course) { %>
  <article class="<%= cls %> lp-course<%= p.course.image ? "" : " is-text" %>"<%- attrs %>>
    <% if (p.course.image) { %><img src="<%= p.course.image %>" alt="" loading="lazy" decoding="async"><% } %>
    <div class="lp-course-body"><h3><%= p.course.title %></h3><% if (p.course.subtitle) { %><p><%= p.course.subtitle %></p><% } %>
      <p class="lp-price"><%= p.course.priceCents ? (p.course.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit" %></p>
      <a class="lp-btn" href="<%= href(p.course.url) %>"><%= p.cta %></a></div>
  </article>
<% } else if (n.type === "icon") { %>
  <% if (p.link) { %><a class="<%= cls %>" href="<%= href(p.link) %>" aria-label="<%= p.label %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %><%- attrs %>><%- icon(p.name, { size: Number(p.size) }) %></a>
  <% } else { %><span class="<%= cls %>"<% if (p.label) { %> role="img" aria-label="<%= p.label %>"<% } else { %> aria-hidden="true"<% } %><%- attrs %>><%- icon(p.name, { size: Number(p.size) }) %></span><% } %>
<% } else if (n.type === "toggle") { %>
  <details class="<%= cls %>"<%= p.open ? " open" : "" %><%- attrs %>><summary class="kw-toggle-title"><%= p.title %></summary><div class="kw-toggle-body"><%- renderMarkdown(p.text) %></div></details>
<% } else if (n.type === "alert") { const ai = { info: "info", success: "checkCircle", warning: "alertTriangle", error: "alertCircle" }[p.tone]; %>
  <div class="<%= cls %> <%= `kw-alert-${p.tone}` %>"<%- p.tone === "error" || p.tone === "warning" ? ' role="alert"' : ' role="note"' %><%- p.dismissible ? " data-kw-dismiss" : "" %><%- attrs %>><span class="kw-alert-icon" aria-hidden="true"><%- icon(ai, { size: 20 }) %></span><div class="kw-alert-body"><% if (p.title) { %><strong class="kw-alert-title"><%= p.title %></strong><% } %><%- renderMarkdown(p.text) %></div></div>
<% } else if (n.type === "counter") { const fmt = (v) => { const s = Number(v).toLocaleString("fr-FR", { minimumFractionDigits: p.decimals, maximumFractionDigits: p.decimals }); return p.separator === "dot" ? s.replace(/[\u202f\u00a0]/g, ".") : p.separator === "none" ? s.replace(/[\u202f\u00a0]/g, "") : s; }; %>
  <div class="<%= cls %>"<%- attrs %>><span class="kw-counter-num"<% if (p.duration) { %> data-kw-count="<%= p.value %>" data-kw-decimals="<%= p.decimals %>" data-kw-duration="<%= p.duration %>"<% if (p.delay) { %> data-kw-delay="<%= p.delay %>"<% } %><% if (p.start) { %> data-kw-start="<%= p.start %>"<% } %><% if (p.easing) { %> data-kw-ease="<%= p.easing %>"<% } %><% if (p.separator) { %> data-kw-sep="<%= p.separator %>"<% } %><% } %>><%= p.prefix %><span class="kw-counter-value"><%= fmt(p.value) %></span><% if (p.suffix) { %>&#8239;<%= p.suffix %><% } %></span><span class="kw-counter-label"><%= p.label %></span></div>
<% } else if (n.type === "testimonial") { %>
  <% const sideAvatar = p.avatar && p.avatarPos; %>
  <figure class="<%= cls %><%= sideAvatar ? ' has-side-avatar is-avatar-' + p.avatarPos : '' %>"<%- attrs %>><% if (sideAvatar) { %><img class="kw-avatar kw-avatar-side"<%- ia(p.avatar, p.size) %> alt="" loading="lazy" decoding="async"><% } %><div class="kw-testimonial-main"><% if (p.rating) { %><p class="kw-stars" role="img" aria-label="Note : <%= p.rating %> sur 5"><%= "★".repeat(p.rating) %><span class="kw-stars-off"><%= "★".repeat(5 - p.rating) %></span></p><% } %><blockquote class="kw-testimonial-text"><%- renderMarkdown(p.text) %></blockquote><figcaption class="kw-testimonial-who"><% if (p.avatar && !sideAvatar) { %><img class="kw-avatar"<%- ia(p.avatar, p.size) %> alt="" loading="lazy" decoding="async"><% } %><span><strong><%= p.name %></strong><% if (p.role) { %><span class="kw-testimonial-role"><%= p.role %></span><% } %></span></figcaption></div></figure>
<% } else if (n.type === "pricing") { %>
  <article class="<%= cls %><%= p.highlight ? " is-highlight" : "" %>"<%- attrs %>><% if (p.badge) { %><span class="kw-pricing-badge"><%= p.badge %></span><% } %><h3 class="kw-pricing-title"><%= p.title %></h3><p class="kw-pricing-price"><strong><%= p.price %></strong><% if (p.period) { %><span> <%= p.period %></span><% } %></p><% if (p.description) { %><p class="kw-pricing-desc"><%= p.description %></p><% } %><% if (p.features.length) { %><ul class="kw-pricing-features"><% p.features.forEach((f) => { %><li><%= f %></li><% }) %></ul><% } %><% if (p.ctaUrl) { %><a class="kw-button kw-btn-<%= p.highlight ? "primary" : "outline" %> kw-pricing-cta" href="<%= href(p.ctaUrl) %>"><%= p.ctaLabel %></a><% } %></article>
<% } else if (n.type === "breadcrumb") { %>
  <nav class="<%= cls %> <%= `kw-sep-${p.separator}` %>" aria-label="Fil d'Ariane"<%- attrs %>><ol class="kw-crumbs"><% p.items.forEach((it, k) => { const last = k === p.items.length - 1; %><li><% if (it.url && !last) { %><a href="<%= href(it.url) %>"><%= it.label %></a><% } else { %><span<%- last ? ' aria-current="page"' : "" %>><%= it.label %></span><% } %></li><% }) %></ol></nav>
<% } else if (n.type === "social") { %>
  <ul class="<%= cls %> <%= `kw-social-${p.shape}` %>" aria-label="<%= p.label %>"<%- attrs %>><% p.items.forEach((it) => { %><li><a class="kw-social-link" href="<%= href(it.url) %>"<%- /^https:/.test(it.url) ? ' target="_blank" rel="noopener noreferrer"' : "" %> aria-label="<%= SOCIAL[it.network] %>"><%- include("_social-icon", { network: it.network, size: Math.round(Number(p.size) * 0.55) }) %></a></li><% }) %></ul>
<% } else if (n.type === "sharebuttons") { const U = p.shareUrl || "", E = encodeURIComponent, T = p.message || p.pageTitle || "";
   const share = { facebook: `https://www.facebook.com/sharer/sharer.php?u=${E(U)}`, x: `https://x.com/intent/post?url=${E(U)}&text=${E(T)}`, linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${E(U)}`, whatsapp: `https://wa.me/?text=${E((T ? T + " " : "") + U)}`, telegram: `https://t.me/share/url?url=${E(U)}&text=${E(T)}`, pinterest: `https://www.pinterest.com/pin/create/button/?url=${E(U)}&description=${E(T)}`, reddit: `https://www.reddit.com/submit?url=${E(U)}&title=${E(T)}`, threads: `https://www.threads.net/intent/post?text=${E((T ? T + " " : "") + U)}`, email: `mailto:?subject=${E(T)}&body=${E(U)}` }; %>
  <% if (U || isBuilder) { %><ul class="<%= cls %> kw-social <%= `kw-social-${p.shape}` %>" aria-label="<%= p.label %>"<%- attrs %>><% p.networks.forEach((k) => { %><li><a class="kw-social-link" href="<%= U ? share[k] : "#" %>"<%- U && k !== "email" ? ' target="_blank" rel="noopener noreferrer"' : "" %> aria-label="<%= k === "email" ? "Partager par e-mail" : "Partager sur " + SOCIAL[k] %>"><%- include("_social-icon", { network: k, size: Math.round(Number(p.size) * 0.55) }) %></a></li><% }) %></ul><% } %>
<% } else if (n.type === "modal") { %>
  <div class="<%= cls %><%= p.position && p.position !== "center" ? ` is-${p.position}` : "" %>"<%- attrs %>><button type="button" class="kw-button <%= `kw-btn-${p.variant}` %> kw-modal-open" data-kw-modal-open="kw-m-<%= n.id %>" aria-haspopup="dialog"><%= p.buttonLabel %></button><dialog class="kw-modal <%= `kw-modal-${p.size}` %><%= p.position === "left" || p.position === "right" ? ` kw-offcanvas kw-offcanvas-${p.position}` : p.position === "corner" || p.position === "bar" ? ` kw-popup-${p.position}` : "" %>" id="kw-m-<%= n.id %>" aria-labelledby="kw-m-<%= n.id %>-t"<% if (p.animIn) { %> data-kw-anim-in="<%= p.animIn %>"<% } %><% if (p.animOut) { %> data-kw-anim-out="<%= p.animOut %>"<% } %><% if (p.noScroll) { %> data-kw-noscroll<% } %><% if (p.overlayColor || p.overlayBlur) { %> style="<%= p.overlayColor ? "--kw-ov:" + (String(p.overlayColor).startsWith("token:") ? "var(--kw-" + String(p.overlayColor).slice(6) + ")" : p.overlayColor) + ";" : "" %><%= p.overlayBlur ? "--kw-ov-blur:" + p.overlayBlur + "px;" : "" %>"<% } %><% if (p.auto && !isBuilder) { %> data-kw-auto="<%= p.auto %>" data-kw-auto-freq="<%= p.freq || "session" %>"<% if (p.delay) { %> data-kw-auto-delay="<%= p.delay %>"<% } %><% if (p.scrollAt) { %> data-kw-auto-scroll="<%= p.scrollAt %>"<% } %><% if (p.autoClose) { %> data-kw-auto-close="<%= p.autoClose %>"<% } %><% if (p.lock) { %> data-kw-lock<% } %><% if (p.clicks) { %> data-kw-auto-clicks="<%= p.clicks %>"<% } %><% if (p.target) { %> data-kw-auto-target="<%= p.target %>"<% } %><% if (p.startDate) { %> data-kw-auto-from="<%= p.startDate %>"<% } %><% if (p.endDate) { %> data-kw-auto-until="<%= p.endDate %>"<% } %><% if (p.minViews) { %> data-kw-auto-views="<%= p.minViews %>"<% } %><% if (p.source) { %> data-kw-auto-source="<%= p.source %>"<% } %><% } %>><div class="kw-modal-head"><h2 class="kw-modal-title" id="kw-m-<%= n.id %>-t"><%= p.title %></h2><button type="button" class="kw-modal-close" data-kw-modal-close aria-label="Fermer la fenêtre">×</button></div><div class="kw-modal-body"><%- renderMarkdown(p.text) %></div><% if (p.ctaUrl) { %><p class="kw-modal-foot"><a class="kw-button kw-btn-primary" href="<%= href(p.ctaUrl) %>"><%= p.ctaLabel %></a></p><% } %><% if (p.dismissBtn) { %><p class="kw-modal-foot"><button type="button" class="kw-modal-dismiss" data-kw-modal-dismiss>Ne plus afficher</button></p><% } %></dialog></div>
<% } %>
