<%#
  Un élément d'une section libre (Page Builder), rendu de façon récursive. Mêmes règles que _sections.ejs : aucune
  valeur libre dans la page (le style vient de la classe .kw-n-<id>, générée à partir de valeurs validées), liens comptés
  par href() dans l'ordre d'affichage (même ordre que landing.linksOf). En mode éditeur, chaque élément porte son
  identifiant (sélection, glisser-déposer, édition directe) et les éléments masqués restent visibles en transparence.
%>
<% const ia = (src, size) => { const r = typeof imageSource === "function" ? imageSource(src, size) : { src }; return ` src="${esc(r.src)}"` + (r.srcset ? ` srcset="${esc(r.srcset)}" sizes="${esc(r.sizes)}"` : ""); }; %>
<% const esc = (v) => String(v ?? "").replace(/[&"<>]/g, (c) => ({ "&": "&amp;", '"': "&quot;", "<": "&lt;", ">": "&gt;" })[c]); const SOCIAL = { facebook: "Facebook", instagram: "Instagram", linkedin: "LinkedIn", youtube: "YouTube", x: "X (Twitter)", tiktok: "TikTok", whatsapp: "WhatsApp", email: "E-mail", telegram: "Telegram", pinterest: "Pinterest", reddit: "Reddit", threads: "Threads", website: "Site web" }; %>
<% const p = n.props || {}; const cls = ["kw-node", `kw-${n.type}`, `kw-n-${n.id}`, n.hidden ? "is-hidden" : "", n.locked ? "is-locked" : "", ...(n.hideOn || []).map((b) => `lp-hide-${b}`), n.motion && n.motion.hover ? `kw-hover-${n.motion.hover}` : "", n.classes || "", n.startHidden ? "kw-ix-hidden" : "", n.bgVideo ? "has-bg-video" : ""].filter(Boolean).join(" ");
   const attrs = (n.anchor ? ` id="${n.anchor}"` : "") + (n.motionAttr || "")
     + (n.attrs || []).map((a) => ` ${a.name}="${esc(a.value)}"`).join("")
     + (n.interactions && n.interactions.length ? ` data-kw-ix="${esc(JSON.stringify(n.interactions.map((x) => [x.trigger, x.action, x.target])))}"` : "")
     + (isBuilder && n.schedule ? ` data-schedule-label="Programmé${n.schedule.from ? " dès le " + new Date(n.schedule.from).toLocaleDateString("fr-FR") : ""}${n.schedule.until ? " jusqu'au " + new Date(n.schedule.until).toLocaleDateString("fr-FR") : ""}${n.schedule.days || n.schedule.hours ? " · jours / heures" : ""}"` : "") + (isBuilder ? ` data-node-id="${n.id}" data-node-type="${n.type}"` + (n.audienceLabel ? ` data-audience-label="${String(n.audienceLabel).replace(/[&"<>]/g, (c) => ({ "&": "&amp;", '"': "&quot;", "<": "&lt;", ">": "&gt;" })[c])}"` : "") : "");
   const kidsOne = (c) => { if (c.hidden && !isBuilder) return; %><%- include("_node-safe", { n: c, isBuilder, href, depth: depth + 1 }) %><% };
   // Boucle (grille « répéter pour chaque … ») : chaque résultat dans son enveloppe, message si aucun résultat, pagination par l'adresse
   const kids = () => {
     const info = n.loopInfo;
     // Conteneur en mode « onglets » ou « carrousel » (page publiée seulement : le canevas garde des conteneurs ordinaires, modifiables)
     if (!info && n.type === "container" && p.mode && !isBuilder) {
       const shown = (n.children || []).filter((c) => !c.hidden);
       if (p.mode === "accordion") { shown.forEach((c, i) => { %><div class="kw-nacc-panel" data-kw-title="<%= c.name || "Volet " + (i + 1) %>"><% kidsOne(c); %></div><% }); return; }
       if (p.mode === "tabs") { shown.forEach((c, i) => { %><div class="kw-ntab-panel" data-kw-title="<%= c.name || "Onglet " + (i + 1) %>"><% kidsOne(c); %></div><% }); return; }
       %><div class="kw-carousel-track"><% shown.forEach((c, i) => { %><div class="kw-carousel-slide kw-ncar-slide" aria-roledescription="diapositive" aria-label="<%= i + 1 %> sur <%= shown.length %>"><% kidsOne(c); %></div><% }); %></div><% return;
     }
     if (!info) { (n.children || []).forEach(kidsOne); return; }
     let cur = -1;
     (n.children || []).forEach((c) => { if (c.loopItem !== cur) { if (cur !== -1) { %></div><% } cur = c.loopItem; %><div class="kw-loop-item"><% } kidsOne(c); });
     if (cur !== -1) { %></div><% }
     if (info.empty) { %><p class="kw-dyn-empty kw-loop-empty"><%= info.message %></p><% }
     if (info.paginate) {
       const link = (k) => `?${info.base ? info.base + "&" : ""}lp-${n.id}=${k}`;
       const mode = info.pagination || "numbers";
       const prev = info.pageNo > 1 ? `<a rel="prev" href="${link(info.pageNo - 1)}">‹ Précédent</a>` : "", next = info.pageNo < info.pages ? `<a rel="next" href="${link(info.pageNo + 1)}">Suivant ›</a>` : "";
       const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
       let inner = "";
       if (mode === "prevnext") inner = prev + next;
       else if (mode === "more" || mode === "infinite") inner = next ? `<a class="kw-loop-more" rel="next" href="${esc(link(info.pageNo + 1))}">Voir plus</a>` : "";
       else if (mode === "both") { const pages = []; for (let k = 1; k <= info.pages; k++) if (k === 1 || k === info.pages || Math.abs(k - info.pageNo) <= 2) pages.push(k);
         inner = prev + pages.map((k) => k === info.pageNo ? `<span aria-current="page">${k}</span>` : `<a href="${esc(link(k))}">${k}</a>`).join("") + next; }
       else inner = prev + `<span aria-current="page">${info.pageNo} / ${info.pages}</span>` + next;
       if (inner) { %><nav class="kw-loop-pages" aria-label="Pagination" data-loop="<%= n.id %>" data-mode="<%= mode %>"><%- inner %></nav><% }
     }
   }; %>
<% if (["container", "columns", "column", "grid", "stack", "group"].includes(n.type)) { const boxTag = ["section", "header", "footer", "article", "aside", "nav"].includes(p.tag) ? p.tag : "div"; const boxLink = p.link && !isBuilder ? p.link : ""; %>
  <% if (boxLink) { %><a class="kw-box-link" href="<%= href(boxLink) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><% } %><<%= boxTag %> class="<%= cls %><%= p.full ? " kw-full" : "" %><%= p.band && !p.full ? " kw-band" : "" %><%= n.type === "container" && p.mode && !isBuilder ? (p.mode === "tabs" ? ` kw-ntabs is-${p.tabsLook}` : p.mode === "accordion" ? " kw-nacc" : " kw-ncarousel") : "" %><%= p.loop && p.loop.slider ? " kw-loop-slider" : "" %><%= isBuilder && !(n.children || []).length ? " kw-is-empty" : "" %>"<%- attrs %><%- p.loop && p.loop.slider ? " data-kw-slider" : "" %><%- n.type === "container" && p.dismissible ? " data-kw-dismissible" : "" %><%- n.type === "container" && p.stickRow && !isBuilder ? ` data-kw-stick-row="${p.stickOffset || 0}"` : "" %><%- n.type === "container" && p.mode ? (isBuilder ? ` data-kw-mode="${p.mode}"` : p.mode === "tabs" ? ` data-kw-ntabs data-kw-tabs-look="${p.tabsLook}" data-kw-tabs-start="${p.tabsStart}"` : p.mode === "accordion" ? ` data-kw-nacc data-kw-acc-start="${p.accStart}"${p.accSingle ? " data-kw-acc-single" : ""}` : ` role="region" aria-roledescription="carrousel" aria-label="${esc(n.name || "Carrousel")}" data-kw-carousel${p.dots ? " data-kw-dots" : ""}${p.autoplay ? ` data-kw-autoplay="${p.interval}"` : ""}${p.loop ? " data-kw-loop" : ""}`) : "" %>><% (n.shapes || []).forEach((sh) => { %><span class="kw-shape kw-shape-<%= sh.position %> kw-shp-<%= sh.shape %><%= sh.flip ? " is-flip" : "" %><%= sh.front ? " is-front" : "" %>" aria-hidden="true"></span><% }) %><% if (n.bgSlides) { %><div class="kw-bgslides<%= n.bgSlides.kenBurns ? " is-kb" : "" %>" aria-hidden="true" data-kw-bgslides="<%= n.bgSlides.seconds || 5 %>"><% n.bgSlides.images.forEach((src, i) => { %><img class="kw-bgslide<%= i === 0 ? ' is-on' : '' %>" src="<%= src %>" alt="" loading="<%= i === 0 ? "eager" : "lazy" %>" decoding="async"><% }) %></div><% } %><% if (n.bgVideo) { %><video class="kw-bg-video" src="<%= n.bgVideo.src %><%= n.bgVideo.start || n.bgVideo.end ? "#t=" + (n.bgVideo.start || 0) + (n.bgVideo.end ? "," + n.bgVideo.end : "") : "" %>"<%- n.bgVideo.poster ? ` poster="${esc(n.bgVideo.poster)}"` : "" %> autoplay muted<%= n.bgVideo.once ? "" : " loop" %> playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video><% } %><% if (isBuilder && !(n.children || []).length) { %><button type="button" class="kw-add" data-kw-add aria-label="Ajouter une structure ou un élément ici" title="Ajouter une structure ou un élément">+</button><% } %><% kids() %><% if (n.type === "container" && p.dismissible) { %><button type="button" class="kw-dismiss-btn" data-kw-dismiss aria-label="Fermer cette barre"><span aria-hidden="true">&times;</span></button><% } %></<%= boxTag %>><% if (boxLink) { %></a><% } %>
<% } else if (n.type === "spacer") { %>
  <div class="<%= cls %> <%= `kw-spacer-${p.size}` %>"<%- attrs %> aria-hidden="true"></div>
<% } else if (n.type === "divider" && p.text) { %>
  <div class="<%= cls %> kw-divider-text <%= p.align === "left" ? "is-left" : p.align === "right" ? "is-right" : "is-center" %>" role="separator"<%- attrs %>><span><%= p.text %></span></div>
<% } else if (n.type === "divider") { %>
  <hr class="<%= cls %>"<%- attrs %>>
<% } else if ((n.type === "heading" && !p.text) || (n.type === "text" && !p.html)) { %>
  <% if (isBuilder) { %><div class="<%= cls %> kw-empty-text"<%- attrs %>><p class="kw-empty"><%= n.type === "heading" ? "Titre vide" : "Paragraphe vide" %></p></div><% } %>
<% } else if (n.type === "heading") { %>
  <% const hTag = p.tag || "h" + p.level; %><<%= hTag %> class="<%= cls %>"<%- attrs %><%- !n.anchor && n.tocId ? ` id="${n.tocId}"` : "" %>><% if (p.link && !isBuilder) { %><a class="kw-heading-link" href="<%= href(p.link) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><%= p.text %></a><% } else { %><%= p.text %><% } %></<%= hTag %>>
<% } else if (n.type === "text") { %>
  <div class="<%= cls %><%= p.dropCap ? " kw-dropcap" : "" %>"<%- attrs %>><%- p.html %></div>
<% } else if (n.type === "list") { const tag = p.ordered ? "ol" : "ul"; %>
  <<%= tag %> class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li><%= it %></li><% }) %></<%= tag %>>
<% } else if (n.type === "quote") { %>
  <blockquote class="<%= cls %>"<%- attrs %>><p><%= p.text %></p><% if (p.author) { %><footer>— <%= p.author %></footer><% } %></blockquote>
<% } else if (n.type === "code") { %>
  <% const codeLines = String(p.text || "").split("\n").length; const hlLines = (p.highlight || "").split(",").filter(Boolean).map(Number).filter((x) => x <= codeLines); %>
  <div class="kw-codebox<%= p.lineNumbers ? " has-lines" : "" %><%= hlLines.length ? " has-hl" : "" %>"><% if (p.copy && !isBuilder) { %><button type="button" class="kw-code-copy" data-kw-copy aria-label="Copier le code">Copier</button><% } %><pre class="<%= cls %>"<%- attrs %>><% if (p.lineNumbers) { %><span class="kw-code-nums" aria-hidden="true"><%= Array.from({ length: codeLines }, (_, i) => i + 1).join("\n") %></span><% } %><% hlLines.forEach((l) => { %><span class="kw-code-hl kw-code-hl-<%= l %>" aria-hidden="true"></span><% }) %><% if (p.html !== undefined) { %><code class="language-<%= p.language %>"><%- p.html %></code><% } else { %><code><%= p.text %></code><% } %></pre></div>
<% } else if (n.type === "image" && !String(p.src || "").trim() && !isBuilder) { %><%# image dynamique sans valeur (article sans image à la une) : rien n'est affiché, jamais d'icône d'image cassée %>
<% } else if (n.type === "image") { %>
  <% const imgTag = `<img${ia(p.src, p.size)}${typeof imageDims === "function" ? imageDims(p.src, p.size) : ""} alt="${esc(p.alt)}"${p.title ? ` title="${esc(p.title)}"` : ""} loading="lazy" decoding="async">`; %>
  <figure class="<%= cls %>"<% if (p.lightbox && !p.link && !/^\{\{/.test(p.src)) { %> data-kw-lightbox<% } %><%- attrs %>><% if (p.link) { %><a href="<%= href(p.link) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><%- imgTag %></a><% } else if (p.lightbox && !/^\{\{/.test(p.src)) { %><a href="<%= p.src %>" class="kw-lb-open" aria-label="Agrandir : <%= p.alt || "image" %>"><%- imgTag %></a><% } else { %><%- imgTag %><% } %><% if (p.caption) { %><figcaption><%= p.caption %></figcaption><% } %></figure>
<% } else if (n.type === "gallery") { %>
  <% const galTags = p.filters ? [...new Set(p.images.map((im) => im.tag).filter(Boolean))] : []; %>
  <div class="<%= cls %><%= p.masonry ? " is-masonry" : "" %><%= p.layout === "justified" ? " is-justified is-row-" + (p.rowHeight || "200") : "" %><%= p.columns ? " is-cols-" + p.columns : "" %><%= p.ratio ? " is-ratio-" + p.ratio.replace(":", "-") : "" %><%= p.overlay ? " has-overlay" : "" %>"<% if (p.lightbox) { %> data-kw-lightbox<% } %><% if (galTags.length) { %> data-kw-gal="<%= n.id %>"<% } %><%- attrs %>><% if (galTags.length) { %><div class="kw-gallery-filters" role="group" aria-label="Filtrer la galerie" data-kw-gal-filters="<%= n.id %>"><button type="button" class="kw-gal-filter is-on" data-tag="" aria-pressed="true">Tous</button><% galTags.forEach((t) => { %><button type="button" class="kw-gal-filter" data-tag="<%= t %>" aria-pressed="false"><%= t %></button><% }) %></div><% } %><% p.images.forEach((im) => { const img = `<img${ia(im.src, p.size)} alt="${esc(im.alt)}" loading="lazy" decoding="async">`; %><figure class="kw-gallery-item"<% if (im.tag) { %> data-tag="<%= im.tag %>"<% } %>><% if (im.link) { %><a href="<%= href(im.link) %>"><%- img %></a><% } else if (p.lightbox) { %><a href="<%= im.src %>" class="kw-lb-open" aria-label="Agrandir : <%= im.alt %>"><%- img %></a><% } else { %><%- img %><% } %><% if (im.caption) { %><figcaption><%= im.caption %></figcaption><% } %></figure><% }) %></div>
<% } else if (n.type === "video") { const v = parseVideoUrl(p.url) || (/^\/uploads\/marketing\/\d+\/(?:site-\d{1,9}\/)?(?:\d{4}\/(?:0[1-9]|1[0-2])\/)?[A-Za-z0-9._-]+\.(mp4|webm)$/i.test(p.url || "") ? { kind: "file", src: p.url } : null);
     // Options de lecture : attributs pour un fichier, paramètres du lecteur pour YouTube / Vimeo
     const yt = v && v.kind === "youtube", ytId = yt ? (v.src.match(/\/embed\/([^?]+)/) || [])[1] : null;
     const q = [p.autoplay ? "autoplay=1" : "", p.muted ? (yt ? "mute=1" : "muted=1") : "", p.loop ? "loop=1" + (yt ? `&playlist=${ytId}` : "") : "", p.controls === false ? "controls=0" : "", p.autoplay && yt ? "playsinline=1" : ""].filter(Boolean).join("&");
     const tq = [p.start ? (v && v.kind === "youtube" ? "start=" + p.start : "") : "", p.end && v && v.kind === "youtube" ? "end=" + p.end : ""].filter(Boolean).join("&");
     const embed0 = v && v.src ? v.src + ((q || tq) ? (v.src.includes("?") ? "&" : "?") + [q, tq].filter(Boolean).join("&") : "") : "";
     const embed = embed0 && v.kind === "vimeo" && p.start ? embed0 + "#t=" + p.start + "s" : embed0;
     const fileFrag = v && v.kind === "file" && (p.start || p.end) ? "#t=" + (p.start || 0) + (p.end ? "," + p.end : "") : ""; %>
  <div class="<%= cls %>"<%- attrs %>><% if (v && v.kind === "file") { %><video src="<%= v.src %><%= fileFrag %>"<%= p.controls === false ? "" : " controls" %><%= p.autoplay ? " autoplay playsinline" : "" %><%= p.muted ? " muted" : "" %><%= p.loop ? " loop" : "" %><% if (p.poster) { %> poster="<%= p.poster %>"<% } %> preload="metadata" title="<%= p.title %>"></video>
    <% } else if (v && isBuilder) { %><div class="lp-video-frame lp-video-stand-in" data-embed-src="<%= embed %>"><span class="lp-video-play" aria-hidden="true"></span><span class="lp-video-meta"><strong><%= p.title %></strong> <%= { youtube: "YouTube", vimeo: "Vimeo" }[v.kind] || "Vidéo" %><%= [p.autoplay ? " · lecture automatique" : "", p.loop ? " · en boucle" : "", p.controls === false ? " · sans commandes" : ""].join("") %></span></div>
    <% } else if (v) { %><div class="lp-video-frame"><iframe src="<%= embed %>" title="<%= p.title %>" loading="lazy" allow="<%= p.autoplay ? "autoplay; " : "" %>encrypted-media; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><% } %></div>
<% } else if (n.type === "audio") { %>
  <figure class="<%= cls %>"<%- attrs %>><% if (p.title) { %><figcaption><%= p.title %></figcaption><% } %><audio src="<%= p.src %>" controls preload="none"<%= p.loop ? " loop" : "" %>></audio></figure>
<% } else if (n.type === "button") { %>
  <% const rel = [p.newTab ? "noopener noreferrer" : "", p.rel || ""].filter(Boolean).join(" "); const bi = p.icon ? `<span class="kw-btn-icon" aria-hidden="true">${icon(p.icon, { size: 18 })}</span>` : ""; %>
  <a class="<%= cls %> <%= `kw-btn-${p.variant}` %><%= p.icon ? " has-icon" : "" %><%= p.size ? ` kw-btn-${p.size}` : "" %>" href="<%= href(p.url) %>"<%- p.newTab ? ' target="_blank"' : "" %><%- rel ? ` rel="${rel}"` : "" %><%- attrs %>><% if (!p.icon) { %><%= p.label %><% } else { %><% if (p.iconPos !== "after") { %><%- bi %><% } %><span><%= p.label %></span><% if (p.iconPos === "after") { %><%- bi %><% } %><% } %></a>
<% } else if (n.type === "link") { %>
  <a class="<%= cls %>" href="<%= href(p.url) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %><%- attrs %>><%= p.label %></a>
<% } else if (n.type === "accordion") { %>
  <div class="<%= cls %> <%= `kw-acc-${p.icon || "chevron"}` %>"<%- attrs %>><% p.items.forEach((it, k) => { %><details class="lp-faq-item"<%= p.openFirst && k === 0 ? " open" : "" %><%- p.single ? ` name="kw-acc-${n.id}"` : "" %>><summary><%= it.q %></summary><div class="lp-faq-answer"><%- renderMarkdown(it.a) %></div></details><% }) %></div>
<% } else if (n.type === "tabs") { %>
  <div class="<%= cls %><%= p.vertical ? " is-vertical" : "" %>" data-kw-tabs<%- attrs %>>
    <% p.items.forEach((it, k) => { %><section class="kw-tab-panel" data-kw-tab-title="<%= it.title %>"><% if (it.icon) { %><span class="kw-tab-icon-src" hidden><%- icon(it.icon, { size: 16 }) %></span><% } %><h3 class="kw-tab-title"><%= it.title %></h3><%- renderMarkdown(it.text) %></section><% }) %>
  </div>
<% } else if (n.type === "badge") { %>
  <span class="<%= cls %> <%= `kw-badge-${p.tone}` %>"<%- attrs %>><%= p.text %></span>
<% } else if (n.type === "timeline") { %>
  <ol class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li class="kw-tl-item"><% if (it.date) { %><span class="kw-tl-date"><%= it.date %></span><% } %><strong class="kw-tl-title"><%= it.title %></strong><% if (it.text) { %><p class="kw-tl-text"><%= it.text %></p><% } %></li><% }) %></ol>
<% } else if (n.type === "progress") { %>
  <div class="<%= cls %><%= p.animate ? " kw-progress-anim" : "" %>"<%- attrs %>><div class="kw-progress-head"><span><%= p.label %></span><% if (p.showValue) { %><span><%= p.value %> %</span><% } %></div><div class="kw-progress-track" role="progressbar" aria-label="<%= p.label %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= p.value %>"><span class="kw-progress-bar"></span></div></div>
<% } else if (n.type === "menu") { const linkAttrs = (x) => (x.newTab ? ' target="_blank"' : "") + (x.rel ? ` rel="${x.rel}"` : ""); %>
  <% if (p.cms && !p.items.length) { %><% if (isBuilder) { %><nav class="<%= cls %> kw-menu-empty" aria-label="<%= p.label %>"<%- attrs %>><p class="kw-pm-note">Menu du CMS : aucun menu publié <%= p.cms.source === "name" ? "nommé « " + (p.menuName || "?") + " »" : "à l'emplacement « " + p.cms.location + " »" %> pour ce site. Créez-le et affectez-le dans Apparence → Menus.</p></nav><% } %>
  <% } else { %>
  <% const mLink = (x) => { const ic = x.icon && typeof icon === "function" ? icon(x.icon, { size: 18 }) : ""; const label = esc(x.label); const bd = x.badge ? `<span class="kw-menu-badge">${esc(x.badge)}</span>` : ""; const inner = ic || x.description || bd ? `${ic ? `<span class="kw-menu-icon" aria-hidden="true">${ic}</span>` : ""}<span class="kw-menu-label">${label}${x.description ? `<span class="kw-menu-desc">${esc(x.description)}</span>` : ""}</span>${bd}` : label; return `<a class="kw-menu-link" href="${esc(href(x.url))}"${linkAttrs(x)}${x.titleAttr ? ` title="${esc(x.titleAttr)}"` : ""}>${inner}</a>`; };
     /* trois niveaux au plus (comme le gestionnaire de menus) ; sans icône ni description, le balisage est celui d'origine */
     const mItem = (x, path, level) => { const link = mLink(x); /* la rubrique est numérotée AVANT ses sous-niveaux (suivi des clics : même ordre que linksOf) */ const kids = level < 3 && x.children && x.children.length ? x.children : null; const sid = `kw-sub-${n.id}-${path}`; const mega = level === 1 && x.mega && !isBuilder ? x.mega : null; const mid = `kw-mega-${n.id}-${path}`; const klass = [level === 1 ? "kw-menu-item" : "", kids || mega ? "has-sub" : "", mega ? "has-mega" : "", x.cssClass || ""].filter(Boolean).join(" ");
       const sub = (kids ? `<button type="button" class="kw-sub-toggle" aria-expanded="false" aria-controls="${sid}" aria-label="Sous-menu : ${esc(x.label)}"></button><ul class="kw-submenu${level >= 2 ? " kw-submenu-deep" : ""}" id="${sid}">${kids.map((c, j) => mItem(c, `${path}-${j}`, level + 1)).join("")}</ul>` : "")
