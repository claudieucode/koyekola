<%#
  Un élément d'une section libre (Page Builder), rendu de façon récursive. Mêmes règles que _sections.ejs : aucune
  valeur libre dans la page (le style vient de la classe .kw-n-<id>, générée à partir de valeurs validées), liens comptés
  par href() dans l'ordre d'affichage (même ordre que landing.linksOf). En mode éditeur, chaque élément porte son
  identifiant (sélection, glisser-déposer, édition directe) et les éléments masqués restent visibles en transparence.
%>
<% const esc = (v) => String(v ?? "").replace(/[&"<>]/g, (c) => ({ "&": "&amp;", '"': "&quot;", "<": "&lt;", ">": "&gt;" })[c]); const SOCIAL = { facebook: "Facebook", instagram: "Instagram", linkedin: "LinkedIn", youtube: "YouTube", x: "X (Twitter)", tiktok: "TikTok", whatsapp: "WhatsApp", email: "E-mail", website: "Site web" }; %>
<% const p = n.props || {}; const cls = ["kw-node", `kw-${n.type}`, `kw-n-${n.id}`, n.hidden ? "is-hidden" : "", n.locked ? "is-locked" : "", ...(n.hideOn || []).map((b) => `lp-hide-${b}`), n.motion && n.motion.hover ? `kw-hover-${n.motion.hover}` : "", n.classes || "", n.startHidden ? "kw-ix-hidden" : "", n.bgVideo ? "has-bg-video" : ""].filter(Boolean).join(" ");
   const attrs = (n.anchor ? ` id="${n.anchor}"` : "") + (n.motion && n.motion.entrance ? ` data-kw-anim="${n.motion.entrance}"${n.motion.repeat ? " data-kw-anim-repeat" : ""}` : "")
     + (n.attrs || []).map((a) => ` ${a.name}="${esc(a.value)}"`).join("")
     + (n.interactions && n.interactions.length ? ` data-kw-ix="${esc(JSON.stringify(n.interactions.map((x) => [x.trigger, x.action, x.target])))}"` : "")
     + (isBuilder && n.schedule ? ` data-schedule-label="Programmé${n.schedule.from ? " dès le " + new Date(n.schedule.from).toLocaleDateString("fr-FR") : ""}${n.schedule.until ? " jusqu'au " + new Date(n.schedule.until).toLocaleDateString("fr-FR") : ""}"` : "") + (isBuilder ? ` data-node-id="${n.id}" data-node-type="${n.type}"` + (n.audienceLabel ? ` data-audience-label="${String(n.audienceLabel).replace(/[&"<>]/g, (c) => ({ "&": "&amp;", '"': "&quot;", "<": "&lt;", ">": "&gt;" })[c])}"` : "") : "");
   const kids = () => (n.children || []).forEach((c) => { if (c.hidden && !isBuilder) return; %><%- include("_node", { n: c, isBuilder, href, depth: depth + 1 }) %><% }); %>
<% if (["container", "columns", "column", "grid", "stack", "group"].includes(n.type)) { const boxTag = ["section", "header", "footer", "article", "aside", "nav"].includes(p.tag) ? p.tag : "div"; const boxLink = p.link && !isBuilder ? p.link : ""; %>
  <% if (boxLink) { %><a class="kw-box-link" href="<%= href(boxLink) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><% } %><<%= boxTag %> class="<%= cls %><%= p.full ? " kw-full" : "" %>"<%- attrs %>><% if (n.bgVideo) { %><video class="kw-bg-video" src="<%= n.bgVideo.src %>" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video><% } %><% if (isBuilder && !(n.children || []).length) { %><button type="button" class="kw-add" data-kw-add aria-label="Ajouter une structure ou un élément ici" title="Ajouter une structure ou un élément">+</button><% } %><% kids() %></<%= boxTag %>><% if (boxLink) { %></a><% } %>
<% } else if (n.type === "spacer") { %>
  <div class="<%= cls %> <%= `kw-spacer-${p.size}` %>"<%- attrs %> aria-hidden="true"></div>
<% } else if (n.type === "divider" && p.text) { %>
  <div class="<%= cls %> kw-divider-text <%= p.align === "left" ? "is-left" : p.align === "right" ? "is-right" : "is-center" %>" role="separator"<%- attrs %>><span><%= p.text %></span></div>
<% } else if (n.type === "divider") { %>
  <hr class="<%= cls %>"<%- attrs %>>
<% } else if ((n.type === "heading" && !p.text) || (n.type === "text" && !p.html)) { %>
  <% if (isBuilder) { %><div class="<%= cls %> kw-empty-text"<%- attrs %>><p class="kw-empty"><%= n.type === "heading" ? "Titre vide" : "Paragraphe vide" %></p></div><% } %>
<% } else if (n.type === "heading") { %>
  <h<%= p.level %> class="<%= cls %>"<%- attrs %><%- !n.anchor && n.tocId ? ` id="${n.tocId}"` : "" %>><% if (p.link && !isBuilder) { %><a class="kw-heading-link" href="<%= href(p.link) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><%= p.text %></a><% } else { %><%= p.text %><% } %></h<%= p.level %>>
<% } else if (n.type === "text") { %>
  <div class="<%= cls %>"<%- attrs %>><%- p.html %></div>
<% } else if (n.type === "list") { const tag = p.ordered ? "ol" : "ul"; %>
  <<%= tag %> class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li><%= it %></li><% }) %></<%= tag %>>
<% } else if (n.type === "quote") { %>
  <blockquote class="<%= cls %>"<%- attrs %>><p><%= p.text %></p><% if (p.author) { %><footer>— <%= p.author %></footer><% } %></blockquote>
<% } else if (n.type === "code") { %>
  <pre class="<%= cls %>"<%- attrs %>><code><%= p.text %></code></pre>
<% } else if (n.type === "image") { %>
  <% const imgTag = `<img src="${esc(p.src)}" alt="${esc(p.alt)}"${p.title ? ` title="${esc(p.title)}"` : ""} loading="lazy" decoding="async">`; %>
  <figure class="<%= cls %>"<%- attrs %>><% if (p.link) { %><a href="<%= href(p.link) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %>><%- imgTag %></a><% } else { %><%- imgTag %><% } %><% if (p.caption) { %><figcaption><%= p.caption %></figcaption><% } %></figure>
<% } else if (n.type === "gallery") { %>
  <div class="<%= cls %><%= p.masonry ? " is-masonry" : "" %>"<% if (p.lightbox) { %> data-kw-lightbox<% } %><%- attrs %>><% p.images.forEach((im) => { const img = `<img src="${esc(im.src)}" alt="${esc(im.alt)}" loading="lazy" decoding="async">`; %><figure class="kw-gallery-item"><% if (im.link) { %><a href="<%= href(im.link) %>"><%- img %></a><% } else if (p.lightbox) { %><a href="<%= im.src %>" class="kw-lb-open" aria-label="Agrandir : <%= im.alt %>"><%- img %></a><% } else { %><%- img %><% } %><% if (im.caption) { %><figcaption><%= im.caption %></figcaption><% } %></figure><% }) %></div>
<% } else if (n.type === "video") { const v = parseVideoUrl(p.url);
     // Options de lecture : attributs pour un fichier, paramètres du lecteur pour YouTube / Vimeo
     const yt = v && v.kind === "youtube", ytId = yt ? (v.src.match(/\/embed\/([^?]+)/) || [])[1] : null;
     const q = [p.autoplay ? "autoplay=1" : "", p.muted ? (yt ? "mute=1" : "muted=1") : "", p.loop ? "loop=1" + (yt ? `&playlist=${ytId}` : "") : "", p.controls === false ? "controls=0" : "", p.autoplay && yt ? "playsinline=1" : ""].filter(Boolean).join("&");
     const embed = v && v.src ? v.src + (q ? (v.src.includes("?") ? "&" : "?") + q : "") : ""; %>
  <div class="<%= cls %>"<%- attrs %>><% if (v && v.kind === "file") { %><video src="<%= v.src %>"<%= p.controls === false ? "" : " controls" %><%= p.autoplay ? " autoplay playsinline" : "" %><%= p.muted ? " muted" : "" %><%= p.loop ? " loop" : "" %><% if (p.poster) { %> poster="<%= p.poster %>"<% } %> preload="metadata" title="<%= p.title %>"></video>
    <% } else if (v && isBuilder) { %><div class="lp-video-frame lp-video-stand-in" data-embed-src="<%= embed %>"><span class="lp-video-play" aria-hidden="true"></span><span class="lp-video-meta"><strong><%= p.title %></strong> <%= { youtube: "YouTube", vimeo: "Vimeo" }[v.kind] || "Vidéo" %><%= [p.autoplay ? " · lecture automatique" : "", p.loop ? " · en boucle" : "", p.controls === false ? " · sans commandes" : ""].join("") %></span></div>
    <% } else if (v) { %><div class="lp-video-frame"><iframe src="<%= embed %>" title="<%= p.title %>" loading="lazy" allow="<%= p.autoplay ? "autoplay; " : "" %>encrypted-media; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><% } %></div>
<% } else if (n.type === "audio") { %>
  <figure class="<%= cls %>"<%- attrs %>><% if (p.title) { %><figcaption><%= p.title %></figcaption><% } %><audio src="<%= p.src %>" controls preload="none"<%= p.loop ? " loop" : "" %>></audio></figure>
<% } else if (n.type === "button") { %>
  <% const rel = [p.newTab ? "noopener noreferrer" : "", p.rel || ""].filter(Boolean).join(" "); const bi = p.icon ? `<span class="kw-btn-icon" aria-hidden="true">${icon(p.icon, { size: 18 })}</span>` : ""; %>
  <a class="<%= cls %> <%= `kw-btn-${p.variant}` %><%= p.icon ? " has-icon" : "" %><%= p.size ? ` kw-btn-${p.size}` : "" %>" href="<%= href(p.url) %>"<%- p.newTab ? ' target="_blank"' : "" %><%- rel ? ` rel="${rel}"` : "" %><%- attrs %>><% if (!p.icon) { %><%= p.label %><% } else { %><% if (p.iconPos !== "after") { %><%- bi %><% } %><span><%= p.label %></span><% if (p.iconPos === "after") { %><%- bi %><% } %><% } %></a>
<% } else if (n.type === "link") { %>
  <a class="<%= cls %>" href="<%= href(p.url) %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %><%- attrs %>><%= p.label %></a>
<% } else if (n.type === "accordion") { %>
  <div class="<%= cls %> <%= `kw-acc-${p.icon || "chevron"}` %>"<%- attrs %>><% p.items.forEach((it, k) => { %><details class="lp-faq-item"<%= p.openFirst && k === 0 ? " open" : "" %><%- p.single ? ` name="kw-acc-${n.id}"` : "" %>><summary><%= it.q %></summary><div class="lp-faq-answer"><%- renderMarkdown(it.a) %></div></details><% }) %></div>
<% } else if (n.type === "tabs") { %>
  <div class="<%= cls %><%= p.vertical ? " is-vertical" : "" %>" data-kw-tabs<%- attrs %>>
    <% p.items.forEach((it, k) => { %><section class="kw-tab-panel" data-kw-tab-title="<%= it.title %>"><% if (it.icon) { %><span class="kw-tab-icon-src" hidden><%- icon(it.icon, { size: 16 }) %></span><% } %><h3 class="kw-tab-title"><%= it.title %></h3><%- renderMarkdown(it.text) %></section><% }) %>
  </div>
<% } else if (n.type === "badge") { %>
  <span class="<%= cls %> <%= `kw-badge-${p.tone}` %>"<%- attrs %>><%= p.text %></span>
<% } else if (n.type === "timeline") { %>
  <ol class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li class="kw-tl-item"><% if (it.date) { %><span class="kw-tl-date"><%= it.date %></span><% } %><strong class="kw-tl-title"><%= it.title %></strong><% if (it.text) { %><p class="kw-tl-text"><%= it.text %></p><% } %></li><% }) %></ol>
<% } else if (n.type === "progress") { %>
  <div class="<%= cls %><%= p.animate ? " kw-progress-anim" : "" %>"<%- attrs %>><div class="kw-progress-head"><span><%= p.label %></span><% if (p.showValue) { %><span><%= p.value %> %</span><% } %></div><div class="kw-progress-track" role="progressbar" aria-label="<%= p.label %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= p.value %>"><span class="kw-progress-bar"></span></div></div>
<% } else if (n.type === "menu") { %>
  <nav class="<%= cls %><%= p.vertical ? " is-vertical" : "" %>" aria-label="<%= p.label %>"<% if (p.mobileToggle) { %> data-kw-menu-toggle<% } %><%- attrs %>><ul class="kw-menu-list" id="kw-menu-<%= n.id %>"><% p.items.forEach((it, k) => { %><li class="kw-menu-item<%= it.children ? " has-sub" : "" %>"><a class="kw-menu-link" href="<%= href(it.url) %>"><%= it.label %></a><% if (it.children) { %><button type="button" class="kw-sub-toggle" aria-expanded="false" aria-controls="kw-sub-<%= n.id %>-<%= k %>" aria-label="Sous-menu : <%= it.label %>"></button><ul class="kw-submenu" id="kw-sub-<%= n.id %>-<%= k %>"><% it.children.forEach((c) => { %><li><a class="kw-menu-link" href="<%= href(c.url) %>"><%= c.label %></a></li><% }) %></ul><% } %></li><% }) %></ul></nav>
<% } else if (n.type === "carousel") { %>
  <div class="<%= cls %>" role="region" aria-roledescription="carrousel" aria-label="<%= p.label %>" data-kw-carousel<%- p.dots ? " data-kw-dots" : "" %><%- p.autoplay ? ` data-kw-autoplay="${p.interval}"` : "" %><%- p.loop ? " data-kw-loop" : "" %><%- attrs %>><div class="kw-carousel-track" tabindex="0"><% p.images.forEach((im, k) => { %><figure class="kw-carousel-slide" aria-label="<%= k + 1 %> sur <%= p.images.length %>"><img src="<%= im.src %>" alt="<%= im.alt %>" loading="lazy" decoding="async"><% if (im.caption) { %><figcaption><%= im.caption %></figcaption><% } %></figure><% }) %></div></div>
<% } else if (n.type === "html") { %>
  <div class="<%= cls %>"<%- attrs %>><%- p.html %></div>
<% } else if (n.type === "imagebox" || n.type === "iconbox") { const boxHref = p.link ? href(p.link) : ""; const boxLink = (inner, extra = "") => boxHref ? `<a href="${esc(boxHref)}"${p.newTab ? ' target="_blank" rel="noopener noreferrer"' : ""}${extra}>${inner}</a>` : inner; const media = n.type === "imagebox" ? `<img src="${esc(p.src)}" alt="${esc(p.alt)}" loading="lazy" decoding="async">` : `<span class="kw-iconbox-icon" aria-hidden="true">${icon(p.icon, { size: Number(p.size) })}</span>`; %>
  <div class="<%= cls %> kw-box <%= p.position === "left" ? "is-left" : p.position === "right" ? "is-right" : "is-top" %>"<%- attrs %>><div class="kw-box-media"><%- n.type === "imagebox" ? boxLink(media, ' tabindex="-1" aria-hidden="true"') : media %></div><div class="kw-box-body"><h<%= p.titleLevel %> class="kw-box-title"><%- boxLink(esc(p.title)) %></h<%= p.titleLevel %>><% if (p.text) { %><p class="kw-box-text"><%= p.text %></p><% } %></div></div>
<% } else if (n.type === "rating") { const fr = (v) => String(v).replace(".", ","); %>
  <div class="<%= cls %>"<%- attrs %>><% if (p.title) { %><span class="kw-rating-title"><%= p.title %></span><% } %><span class="kw-rating-stars" role="img" aria-label="Note : <%= fr(p.value) %> sur <%= p.scale %>"><span class="kw-rating-bg" aria-hidden="true"><%= "★".repeat(p.scale) %></span><span class="kw-rating-fill" aria-hidden="true"><%= "★".repeat(p.scale) %></span></span><% if (p.showValue) { %><span class="kw-rating-value" aria-hidden="true"><%= fr(p.value) %>/<%= p.scale %></span><% } %></div>
<% } else if (n.type === "menuanchor") { %>
  <% if (isBuilder) { %><div class="<%= cls %> kw-anchor-mark"<%- attrs %>>⚓ Ancre « #<%= n.anchor || "?" %> »</div><% } else if (n.anchor) { %><div class="<%= cls %>"<%- attrs %>></div><% } %>
<% } else if (n.customView) { const L = {}; n.customView.links.forEach((k) => { if (p[k]) L[k] = href(p[k]); }); %>
  <%- include(n.customView.partial, { n, p, cls, attrs, L, isBuilder }) %>
<% } else if (n.type === "sitelogo") { const inner = p.logo ? `<img class="kw-sitelogo-img" src="${esc(p.logo)}" alt="${esc(p.name)}">` : `<span class="kw-sitelogo-text">${esc(p.name)}</span>`; %>
  <div class="<%= cls %>"<%- attrs %>><% if (p.link && p.homeUrl) { %><a class="kw-sitelogo-link" href="<%= href(p.homeUrl) %>"<%- p.logo ? "" : "" %>><%- inner %></a><% } else { %><%- inner %><% } %><% if (isBuilder && !p.logo) { %><p class="kw-empty">Aucun logo : ajoutez-le dans SEO › Réglages › Organisation (le nom du site s'affiche en attendant).</p><% } %></div>
<% } else if (n.type === "sitetitle") { const tag = ["span", "h1", "h2", "h3"].includes(p.tag) ? p.tag : "p"; %>
  <<%= tag %> class="<%= cls %>"<%- attrs %>><% if (p.link && p.homeUrl) { %><a class="kw-sitetitle-link" href="<%= href(p.homeUrl) %>"><%= p.name %></a><% } else { %><%= p.name %><% } %></<%= tag %>>
<% } else if (n.type === "copyright") { %>
  <p class="<%= cls %>"<%- attrs %>>© <%= p.year %> <%= p.owner %>.<% if (p.text) { %> <%= p.text %><% } %></p>
<% } else if (n.type === "animatedheading") { %>
  <h<%= p.level %> class="<%= cls %>"<%- attrs %>><span class="sr-only"><%= [p.before, p.words.join(", "), p.after].filter(Boolean).join(" ") %></span><span aria-hidden="true"><% if (p.before) { %><%= p.before %> <% } %><span class="kw-rotate <%= p.effect === "type" ? "is-type" : "is-fade" %>" data-kw-words="<%= JSON.stringify(p.words) %>" data-kw-interval="<%= p.interval %>"><%= p.words[0] %></span><% if (p.after) { %> <%= p.after %><% } %></span></h<%= p.level %>>
<% } else if (n.type === "flipbox") { %>
  <div class="<%= cls %> <%= p.effect === "fade" ? "is-fade" : "is-flip" %>" tabindex="0" role="group" aria-label="<%= p.frontTitle %>"<%- attrs %>><div class="kw-flip-inner">
    <div class="kw-flip-face kw-flip-front"><% if (p.icon) { %><span class="kw-flip-icon" aria-hidden="true"><%- icon(p.icon, { size: 40 }) %></span><% } %><h3 class="kw-flip-title"><%= p.frontTitle %></h3><% if (p.frontText) { %><p class="kw-flip-text"><%= p.frontText %></p><% } %></div>
    <div class="kw-flip-face kw-flip-back"><% if (p.backTitle) { %><h3 class="kw-flip-title"><%= p.backTitle %></h3><% } %><% if (p.backText) { %><p class="kw-flip-text"><%= p.backText %></p><% } %><% if (p.ctaUrl) { %><a class="kw-button kw-btn-primary kw-btn-sm" href="<%= href(p.ctaUrl) %>"><%= p.ctaLabel %></a><% } %></div>
  </div></div>
<% } else if (n.type === "pricelist") { %>
  <ul class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li class="kw-pl-item"><div class="kw-pl-head"><% if (it.link) { %><a class="kw-pl-title" href="<%= href(it.link) %>"><%= it.title %></a><% } else { %><span class="kw-pl-title"><%= it.title %></span><% } %><span class="kw-pl-dots" aria-hidden="true"></span><span class="kw-pl-price"><%= it.price %></span></div><% if (it.text) { %><p class="kw-pl-text"><%= it.text %></p><% } %></li><% }) %></ul>
<% } else if (n.type === "toc") { const tag = p.numbered ? "ol" : "ul"; const items = p.items || []; %>
  <% if (items.length || isBuilder) { %><nav class="<%= cls %>" aria-label="<%= p.title %>"<%- attrs %>><p class="kw-toc-title"><%= p.title %></p><% if (!items.length) { %><p class="kw-empty">Aucun titre de niveau 2 à <%= p.depth %> dans la page pour l'instant.</p><% } else { %><<%= tag %> class="kw-toc-list"><% items.forEach((it) => { %><li class="<%= it.level === 2 ? "kw-toc-l2" : it.level === 3 ? "kw-toc-l3" : "kw-toc-l4" %>"><a href="<%= it.href %>"><%= it.text %></a></li><% }) %></<%= tag %>><% } %></nav><% } %>
<% } else if (n.type === "readingprogress") { %>
  <div class="<%= cls %>"<%- attrs %>><div class="kw-readbar <%= p.position === "bottom" ? "is-bottom" : "is-top" %>" aria-hidden="true"><span class="kw-readbar-fill"></span></div><% if (isBuilder) { %><p class="kw-empty">Barre de lecture (<%= p.position === "bottom" ? "en bas" : "en haut" %> de l'écran sur la page publiée)</p><% } %></div>
<% } else if (n.type === "signupform") { const ws = typeof widgetForm !== "undefined" && widgetForm && widgetForm.id === n.id ? widgetForm : null; %>
  <div class="<%= cls %>"<%- attrs %>><div class="kw-signup" id="kw-f-<%= n.id %>"><% if (p.heading) { %><h2 class="kw-signup-title"><%= p.heading %></h2><% } %>
    <% if (!p.form) { %><% if (isBuilder) { %><p class="kw-empty">Formulaire « <%= p.formName || "introuvable" %> » non publié : publiez-le (Audience → Formulaires d'inscription) pour qu'il s'affiche.</p><% } %>
    <% } else if (ws && ws.thanks) { %><p class="lp-thanks" role="status"><%= ws.thanks %></p>
    <% } else { %><% if (p.intro) { %><p class="kw-signup-intro"><%= p.intro %></p><% } %><% if (ws && ws.error) { %><p class="lp-error" role="alert"><%= ws.error %></p><% } %>
      <form class="kw-signup-form" method="post" action="/p/<%= page.slug %>/inscription" novalidate<%- p.form.fileField && p.form.fileField.enabled ? ' enctype="multipart/form-data"' : "" %>><input type="hidden" name="tz" data-tz><input type="hidden" name="w" value="<%= n.id %>">
        <%- include("_signup-fields", { form: p.form, fieldCatalog: p.fieldCatalog, propertyDefs: p.propertyDefs, values: ws && ws.values ? ws.values : {}, prefix: "w" + n.id, autofocus: false }) %>
        <button type="submit" class="kw-button kw-btn-primary kw-signup-submit"<%= preview || isBuilder ? " disabled" : "" %>><%= p.button %></button>
      </form><% } %></div></div>
<% } else if (n.type === "map") { const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(p.address)}&z=${p.zoom}&output=embed`; %>
  <div class="<%= cls %>"<%- attrs %>><% if (isBuilder) { %><div class="kw-map-frame lp-video-stand-in"><span class="lp-video-meta"><strong><%= p.address %></strong> Google Maps · zoom <%= p.zoom %></span></div><% } else { %><iframe class="kw-map-frame" src="<%= mapSrc %>" title="<%= p.title %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><% } %></div>
<% } else if (n.type === "embed") { const e = p.embed; const ecls = e ? `kw-embed-${e.ratio.replace("/", "x")}` : ""; %>
  <div class="<%= cls %> <%= ecls %>"<%- attrs %>><% if (e && isBuilder) { %><div class="kw-embed-frame lp-video-stand-in"><span class="lp-video-meta"><strong><%= p.title %></strong> Contenu intégré · <%= e.label %></span></div><% } else if (e) { %><div class="kw-embed-frame"><iframe src="<%= e.src %>" title="<%= p.title %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="encrypted-media; fullscreen; clipboard-write" sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-presentation"></iframe></div><% } %></div>
<% } else if (n.type === "iconlist") { %>
  <ul class="<%= cls %>"<%- attrs %>><% p.items.forEach((it) => { %><li><span class="kw-iconlist-icon" aria-hidden="true"><%- icon(it.icon, { size: 20 }) %></span><% if (it.link) { %><a href="<%= href(it.link) %>"><%= it.text %></a><% } else { %><span><%= it.text %></span><% } %></li><% }) %></ul>
<% } else if (n.type === "tooltip") { %>
  <span class="<%= cls %> <%= `kw-tip-${p.position}` %>"<%- attrs %>><button type="button" class="kw-tip-trigger" aria-describedby="kw-tip-<%= n.id %>"><%= p.text %></button><span class="kw-tip-bubble" role="tooltip" id="kw-tip-<%= n.id %>"><%= p.tip %></span></span>
<% } else if (n.type === "hotspot") { %>
  <figure class="<%= cls %>"<%- attrs %>><div class="kw-hotspot-stage"><img src="<%= p.src %>" alt="<%= p.alt %>" loading="lazy" decoding="async"><% p.spots.forEach((sp, k) => { %><span class="kw-spot kw-n-<%= n.id %>-s<%= k %>"><button type="button" class="kw-spot-dot" aria-expanded="false" aria-controls="kw-spot-<%= n.id %>-<%= k %>"><span class="sr-only"><%= sp.title %></span><span aria-hidden="true">+</span></button><span class="kw-spot-card" id="kw-spot-<%= n.id %>-<%= k %>" role="note"><strong><%= sp.title %></strong><% if (sp.text) { %> <%= sp.text %><% } %></span></span><% }) %></div></figure>
<% } else if (n.type === "posts") { %>
  <div class="<%= cls %> <%= `kw-posts-${p.layout}` %>"<%- attrs %>><% if (!p.items.length) { %><p class="kw-dyn-empty"><%= p.empty %></p><% } %><% p.items.forEach((it) => { %><article class="kw-post-card"><% if (p.showImage && it.image) { %><img src="<%= it.image %>" alt="" loading="lazy" decoding="async"><% } %><div class="kw-post-body"><% if (p.showDate && it.date) { %><time class="kw-post-date" datetime="<%= new Date(it.date).toISOString() %>"><%= new Date(it.date).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" }) %></time><% } %><h3 class="kw-post-title"><a href="<%= href(it.url) %>"><%= it.title %></a></h3><% if (p.showExcerpt && it.excerpt) { %><p class="kw-post-excerpt"><%= it.excerpt %></p><% } %></div></article><% }) %></div>
<% } else if (n.type === "courselist") { %>
  <div class="<%= cls %>"<%- attrs %>><% if (!p.items.length) { %><p class="kw-dyn-empty"><%= p.empty %></p><% } %><% p.items.forEach((c) => { %><article class="kw-course-card"><% if (c.image) { %><img src="<%= c.image %>" alt="" loading="lazy" decoding="async"><% } %><div class="kw-post-body"><h3 class="kw-post-title"><%= c.title %></h3><% if (c.subtitle) { %><p class="kw-post-excerpt"><%= c.subtitle %></p><% } %><% if (p.showPrice) { %><p class="kw-course-price"><%= c.priceCents ? (c.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit" %></p><% } %><a class="kw-button kw-btn-outline" href="<%= href(c.url) %>"><%= p.cta %><span class="sr-only"> : <%= c.title %></span></a></div></article><% }) %></div>
<% } else if (n.type === "search") { %>
  <form class="<%= cls %>" role="search" action="<%= p.target === "blog" ? "/blog" : "/catalogue" %>" method="get"<%- attrs %>><label class="sr-only" for="kw-q-<%= n.id %>"><%= p.target === "blog" ? "Rechercher dans le blog" : "Rechercher une formation" %></label><input id="kw-q-<%= n.id %>" type="search" name="q" placeholder="<%= p.placeholder %>" autocomplete="off"><button type="submit" class="kw-button kw-btn-primary"><%= p.button %></button></form>
<% } else if (n.type === "account") { %>
  <div class="<%= cls %>"<%- attrs %>><% if (p.loggedIn) { %><a class="kw-account-link" href="<%= href("/mon-compte") %>"><%= p.account %></a><% } else { %><a class="kw-account-link" href="<%= href("/connexion") %>"><%= p.login %></a><% } %><% if (p.showCart) { %><a class="kw-account-cart" href="<%= href("/panier") %>"><%= p.cart %><% if (p.cartCount) { %> <span class="kw-cart-count" aria-label="<%= p.cartCount %> formation(s)"><%= p.cartCount %></span><% } %></a><% } %></div>
<% } else if (n.type === "dyntext") { const tag = p.tag; %>
  <<%= tag %> class="<%= cls %>"<%- attrs %>><%= p.before %><%= p.value || p.fallback %><%= p.after %></<%= tag %>>
<% } else if (n.type === "table") { %>
  <% const body = p.rows.slice(p.header ? 1 : 0, p.footer ? -1 : undefined); const cell = (r, tag) => r.map((c) => `<${tag}${tag === "th" ? ' scope="col"' : ""}>${esc(c)}</${tag}>`).join(""); %>
  <div class="<%= cls %><%= p.striped ? " is-striped" : "" %> <%= `kw-al-${p.align || "left"}` %>"<%- attrs %>><table><% if (p.caption) { %><caption><%= p.caption %></caption><% } %><% if (p.header) { %><thead><tr><%- cell(p.rows[0], "th") %></tr></thead><% } %><% if (body.length) { %><tbody><% body.forEach((r) => { %><tr><%- cell(r, "td") %></tr><% }) %></tbody><% } %><% if (p.footer) { %><tfoot><tr><%- cell(p.rows[p.rows.length - 1], "td") %></tr></tfoot><% } %></table></div>
<% } else if (n.type === "countdown") { const end = new Date(p.until); %>
  <div class="<%= cls %>" data-kw-countdown="<%= p.until %>" data-kw-end-text="<%= p.endText %>"<%- attrs %>><p class="kw-countdown-fallback">Jusqu'au <%= end.toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short", timeZone: "Europe/Paris" }) %> (heure de Paris)</p></div>
<% } else if (n.type === "addtocart" && p.course) { const price = p.course.priceCents ? (p.course.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit"; %>
  <form class="<%= cls %> kw-buy" method="post" action="/panier/ajouter/<%= p.courseId %>"<%- attrs %>><% if (p.mode === "buy") { %><input type="hidden" name="buyNow" value="1"><% } %><% if (p.showPrice) { %><span class="kw-buy-price"><%= price %></span><% } %><button type="submit" class="kw-button <%= `kw-btn-${p.variant}` %><%= p.size === "sm" ? " kw-btn-sm" : p.size === "lg" ? " kw-btn-lg" : "" %>"<%= preview || isBuilder ? " disabled" : "" %>><%= p.label %></button></form>
<% } else if (n.type === "courserating" && p.course) { const R = p.rating || { count: 0, average: 0 }, whole = Math.round(R.average), avg = R.average.toLocaleString("fr-FR", { minimumFractionDigits: 1, maximumFractionDigits: 1 }); %>
  <p class="<%= cls %> kw-courserating"<%- attrs %>><% if (!R.count) { %><span class="kw-courserating-none"><%= p.empty %></span><% } else { %><span class="kw-stars" role="img" aria-label="Note : <%= avg %> sur 5<%= p.showCount ? ", " + R.count + (R.count > 1 ? " avis" : " avis") : "" %>"><%= "★".repeat(whole) %><span class="kw-stars-off"><%= "★".repeat(5 - whole) %></span></span> <strong><%= avg %></strong><% if (p.showCount) { %> <span class="kw-courserating-count">(<%= R.count %> avis)</span><% } %><% } %></p>
<% } else if (n.type === "course" && p.course) { %>
  <article class="<%= cls %> lp-course<%= p.course.image ? "" : " is-text" %>"<%- attrs %>>
    <% if (p.course.image) { %><img src="<%= p.course.image %>" alt="" loading="lazy" decoding="async"><% } %>
    <div class="lp-course-body"><h3><%= p.course.title %></h3><% if (p.course.subtitle) { %><p><%= p.course.subtitle %></p><% } %>
      <p class="lp-price"><%= p.course.priceCents ? (p.course.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit" %></p>
      <a class="lp-btn" href="<%= href(p.course.url) %>"><%= p.cta %></a></div>
  </article>
<% } else if (n.type === "icon") { %>
  <% if (p.link) { %><a class="<%= cls %>" href="<%= href(p.link) %>" aria-label="<%= p.label %>"<%- p.newTab ? ' target="_blank" rel="noopener noreferrer"' : "" %><%- attrs %>><%- icon(p.name, { size: Number(p.size) }) %></a>
  <% } else { %><span class="<%= cls %>"<% if (p.label) { %> role="img" aria-label="<%= p.label %>"<% } else { %> aria-hidden="true"<% } %><%- attrs %>><%- icon(p.name, { size: Number(p.size) }) %></span><% } %>
<% } else if (n.type === "toggle") { %>
  <details class="<%= cls %>"<%= p.open ? " open" : "" %><%- attrs %>><summary class="kw-toggle-title"><%= p.title %></summary><div class="kw-toggle-body"><%- renderMarkdown(p.text) %></div></details>
<% } else if (n.type === "alert") { const ai = { info: "info", success: "checkCircle", warning: "alertTriangle", error: "alertCircle" }[p.tone]; %>
  <div class="<%= cls %> <%= `kw-alert-${p.tone}` %>"<%- p.tone === "error" || p.tone === "warning" ? ' role="alert"' : ' role="note"' %><%- p.dismissible ? " data-kw-dismiss" : "" %><%- attrs %>><span class="kw-alert-icon" aria-hidden="true"><%- icon(ai, { size: 20 }) %></span><div class="kw-alert-body"><% if (p.title) { %><strong class="kw-alert-title"><%= p.title %></strong><% } %><%- renderMarkdown(p.text) %></div></div>
<% } else if (n.type === "counter") { const fmt = (v) => Number(v).toLocaleString("fr-FR", { minimumFractionDigits: p.decimals, maximumFractionDigits: p.decimals }); %>
  <div class="<%= cls %>"<%- attrs %>><span class="kw-counter-num"<% if (p.duration) { %> data-kw-count="<%= p.value %>" data-kw-decimals="<%= p.decimals %>" data-kw-duration="<%= p.duration %>"<% } %>><%= p.prefix %><span class="kw-counter-value"><%= fmt(p.value) %></span><% if (p.suffix) { %>&#8239;<%= p.suffix %><% } %></span><span class="kw-counter-label"><%= p.label %></span></div>
<% } else if (n.type === "testimonial") { %>
  <figure class="<%= cls %>"<%- attrs %>><% if (p.rating) { %><p class="kw-stars" role="img" aria-label="Note : <%= p.rating %> sur 5"><%= "★".repeat(p.rating) %><span class="kw-stars-off"><%= "★".repeat(5 - p.rating) %></span></p><% } %><blockquote class="kw-testimonial-text"><%- renderMarkdown(p.text) %></blockquote><figcaption class="kw-testimonial-who"><% if (p.avatar) { %><img class="kw-avatar" src="<%= p.avatar %>" alt="" loading="lazy" decoding="async"><% } %><span><strong><%= p.name %></strong><% if (p.role) { %><span class="kw-testimonial-role"><%= p.role %></span><% } %></span></figcaption></figure>
<% } else if (n.type === "pricing") { %>
  <article class="<%= cls %><%= p.highlight ? " is-highlight" : "" %>"<%- attrs %>><% if (p.badge) { %><span class="kw-pricing-badge"><%= p.badge %></span><% } %><h3 class="kw-pricing-title"><%= p.title %></h3><p class="kw-pricing-price"><strong><%= p.price %></strong><% if (p.period) { %><span> <%= p.period %></span><% } %></p><% if (p.description) { %><p class="kw-pricing-desc"><%= p.description %></p><% } %><% if (p.features.length) { %><ul class="kw-pricing-features"><% p.features.forEach((f) => { %><li><%= f %></li><% }) %></ul><% } %><% if (p.ctaUrl) { %><a class="kw-button kw-btn-<%= p.highlight ? "primary" : "outline" %> kw-pricing-cta" href="<%= href(p.ctaUrl) %>"><%= p.ctaLabel %></a><% } %></article>
<% } else if (n.type === "breadcrumb") { %>
  <nav class="<%= cls %> <%= `kw-sep-${p.separator}` %>" aria-label="Fil d'Ariane"<%- attrs %>><ol class="kw-crumbs"><% p.items.forEach((it, k) => { const last = k === p.items.length - 1; %><li><% if (it.url && !last) { %><a href="<%= href(it.url) %>"><%= it.label %></a><% } else { %><span<%- last ? ' aria-current="page"' : "" %>><%= it.label %></span><% } %></li><% }) %></ol></nav>
<% } else if (n.type === "social") { %>
  <ul class="<%= cls %> <%= `kw-social-${p.shape}` %>" aria-label="<%= p.label %>"<%- attrs %>><% p.items.forEach((it) => { %><li><a class="kw-social-link" href="<%= href(it.url) %>"<%- /^https:/.test(it.url) ? ' target="_blank" rel="noopener noreferrer"' : "" %> aria-label="<%= SOCIAL[it.network] %>"><%- include("_social-icon", { network: it.network, size: Math.round(Number(p.size) * 0.55) }) %></a></li><% }) %></ul>
<% } else if (n.type === "sharebuttons") { const U = p.shareUrl || "", E = encodeURIComponent, T = p.message || p.pageTitle || "";
   const share = { facebook: `https://www.facebook.com/sharer/sharer.php?u=${E(U)}`, x: `https://x.com/intent/post?url=${E(U)}&text=${E(T)}`, linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${E(U)}`, whatsapp: `https://wa.me/?text=${E((T ? T + " " : "") + U)}`, email: `mailto:?subject=${E(T)}&body=${E(U)}` }; %>
  <% if (U || isBuilder) { %><ul class="<%= cls %> kw-social <%= `kw-social-${p.shape}` %>" aria-label="<%= p.label %>"<%- attrs %>><% p.networks.forEach((k) => { %><li><a class="kw-social-link" href="<%= U ? share[k] : "#" %>"<%- U && k !== "email" ? ' target="_blank" rel="noopener noreferrer"' : "" %> aria-label="<%= k === "email" ? "Partager par e-mail" : "Partager sur " + SOCIAL[k] %>"><%- include("_social-icon", { network: k, size: Math.round(Number(p.size) * 0.55) }) %></a></li><% }) %></ul><% } %>
<% } else if (n.type === "modal") { %>
  <div class="<%= cls %><%= p.position && p.position !== "center" ? ` is-${p.position}` : "" %>"<%- attrs %>><button type="button" class="kw-button <%= `kw-btn-${p.variant}` %> kw-modal-open" data-kw-modal-open="kw-m-<%= n.id %>" aria-haspopup="dialog"><%= p.buttonLabel %></button><dialog class="kw-modal <%= `kw-modal-${p.size}` %><%= p.position && p.position !== "center" ? ` kw-offcanvas kw-offcanvas-${p.position}` : "" %>" id="kw-m-<%= n.id %>" aria-labelledby="kw-m-<%= n.id %>-t"><div class="kw-modal-head"><h2 class="kw-modal-title" id="kw-m-<%= n.id %>-t"><%= p.title %></h2><button type="button" class="kw-modal-close" data-kw-modal-close aria-label="Fermer la fenêtre">×</button></div><div class="kw-modal-body"><%- renderMarkdown(p.text) %></div><% if (p.ctaUrl) { %><p class="kw-modal-foot"><a class="kw-button kw-btn-primary" href="<%= href(p.ctaUrl) %>"><%= p.ctaLabel %></a></p><% } %></dialog></div>
<% } %>
