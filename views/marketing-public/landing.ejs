<%_ const siteX = typeof site !== "undefined" && site ? site : null; const sx = siteX ? siteX.settings : null; _%>
<!doctype html>
<html lang="<%= sx ? sx.extras.language : "fr" %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Balises SEO : calculées par le SEO CORE (src/seo/webPages.js) — une seule source pour l'aperçu, le canevas et la page publique %>
  <% const h = webPageSeo(page, siteX, preview || (typeof builder !== "undefined" && builder)); const siteStyle = typeof previewStyle !== "undefined" && previewStyle ? previewStyle : siteX ? tokensToCss(siteX.tokens) : ""; %>
  <%- include("../partials/seo-head-tags", { h }) %>
  <% if (sx && sx.identity.faviconUrl) { %><link rel="icon" href="<%= sx.identity.faviconUrl %>"<% if (/\.svg(\?|$)/i.test(sx.identity.faviconUrl)) { %> type="image/svg+xml"<% } %>><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
  <link rel="stylesheet" href="<%= asset("/css/landing.css") %>">
  <% if (page.motionStudio && page.motionStudio.css) { %><link rel="stylesheet" href="<%= asset("/css/motion-studio.css") %>"><% } %>
  <%# Styles du thème et de la mise en page du site : avant les styles des éléments, qui restent prioritaires %>
  <% if (siteX && siteX.assets.theme) { %><style id="kw-site-theme"><%- siteX.assets.theme %></style><% } %>
  <%# Thème autonome (paquet) : sa propre feuille de styles, confinée à body[data-kw-pack], chargée après la base neutre et avant le CSS personnalisé du site %>
  <% if (siteX && siteX.assets.pack && siteX.assets.pack.link) { %><%- siteX.assets.pack.link %><% } %>
  <% if (siteX && siteX.assets.pack && siteX.assets.pack.cz) { %><style id="kw-pack-cz"><%- siteX.assets.pack.cz %></style><% } %>
  <% if (siteStyle && typeof fontFacesFor === "function") { const ff = fontFacesFor(siteStyle, siteX ? siteX.id : null); if (ff) { %><style id="kw-site-faces"><%- ff %></style><% } } %>
  <% if (page.nodeCss) { %><style><%- page.nodeCss %></style><% } %>
  <%# CSS personnalisé du site (réglages du site), puis transition entre les pages (jamais dans l'éditeur) %>
  <% if (siteX && siteX.assets.custom) { %><style id="kw-site-custom"><%- siteX.assets.custom %></style><% } %>
  <% if (siteX && siteX.assets.transition && !(typeof builder !== "undefined" && builder)) { %><style><%- siteX.assets.transition %></style><% } %>
<%# Motion Studio lot 3 : transition de CETTE page (API View Transitions, réglage de la page ; après celle du site pour la remplacer), jamais dans l'éditeur %>
  <% if (page.motionCss && !(typeof builder !== "undefined" && builder)) { %><style id="kw-page-transition"><%- page.motionCss %></style><% } %>
<% const kwCode = siteX && siteX.assets.code && !preview && !(typeof builder !== "undefined" && builder) ? siteX.assets.code : null; %>
  <% if (kwCode && kwCode.head) { %><%- kwCode.head %><% } %>
  <%# CSS personnalisé de la page : vérifié (aucune ressource externe), confiné au contenu de la page %>
  <% if (page.customCss) { %><style><%- page.customCss %></style><% } %>
</head>
<% const bAttr = typeof builder !== "undefined" && builder ? " data-kw-builder" : ""; %><% if (siteStyle) { %><body class="lp-body lp-site"<%- bAttr %><%- siteX && siteX.assets.pack ? siteX.assets.pack.attr : "" %><%- siteX ? siteX.assets.lightboxAttrs : "" %> style="<%= siteStyle %> <%= siteX && siteX.assets.pack ? siteX.assets.pack.vars : "" %>--lp-accent: var(--kw-primary); --lp-on-accent: var(--kw-on-primary); --lp-bg: var(--kw-background); --lp-text: var(--kw-text); <%= siteX ? siteX.assets.lightboxVars : "" %>">
<% } else { %><body class="lp-body"<%- bAttr %> style="--lp-accent: <%= page.theme.accent %>; --lp-bg: <%= page.theme.background %>; --lp-text: <%= page.theme.text %>"><% } %>
  <% if (preview && !(typeof builder !== "undefined" && builder)) { %><p class="lp-preview-bar"><%= typeof previewLabel !== "undefined" && previewLabel ? previewLabel + " " : "Aperçu — " %>Les clics et inscriptions ne sont pas enregistrés.</p><% } %>
  <%# En-tête AUTOMATIQUE : le menu affecté à « En-tête du site » s'affiche même sans composant d'en-tête (jamais en double si la page montre déjà ce menu) %>
  <% if (page.autoNav && page.autoNav.header) { %><header class="lp-autohead"><a class="lp-autohead-brand" href="/"><% if (sx && sx.identity.logoUrl) { %><img src="<%= sx.identity.logoUrl %>" alt="<%= siteX.name %>"><% } else { %><%= siteX ? siteX.name : "KOLAKISA" %><% } %></a><%- include("_autonav", { nav: page.autoNav.header, cls: "lp-autohead-nav" }) %></header><% } %>
  <% if (kwCode && kwCode.bodyStart) { %><%- kwCode.bodyStart %><% } %>
  <%# Pied de page : le Theme Builder en fournit un (section « sitePart ») → les widgets de pied et la ligne légale entrent DANS ce pied, jamais un second <footer> %>
  <% const tbFoot = page.sections.some((x) => x.sitePart === "footer" && !x.hidden); const noFoot = typeof funnelContext !== "undefined" && funnelContext && funnelContext.hideFooter; const footLegal = tbFoot && !noFoot ? include("_foot-legal", { siteX, sx, privacyFor: typeof privacyFor === "function" ? privacyFor : null }) : ""; %>
  <main class="lp-main" id="main">
    <% if (thanks && !page.sections.some((x) => x.type === "form")) { %><section class="lp-section"><p class="lp-thanks" role="status"><%= thanks %></p></section><% } %>
    <%- include("_sections", { footLegal, page, form, preview, thanks, error, values, fieldCatalog, propertyDefs, builder: typeof builder !== "undefined" && builder }) %>
  </main>
  <%# Pied de page : la marque du site (logo et nom des réglages du site) ; sans site, la marque de la plateforme %>
  <% if (!(typeof funnelContext !== "undefined" && funnelContext && funnelContext.hideFooter) && !tbFoot) { %><%# Widgets du site (Apparence → Widgets) : sections 1 et 2 de pied de page %><% const wzId = siteX && Number.isInteger(siteX.id) ? siteX.id : null; const wz1 = typeof widgetZoneFor === "function" ? widgetZoneFor(wzId, "footer-1") : "", wz2 = typeof widgetZoneFor === "function" ? widgetZoneFor(wzId, "footer-2") : ""; %><% if (!(typeof builder !== "undefined" && builder) && (wz1 || wz2)) { %><div class="lp-foot-widgets"><%- wz1 %><%- wz2 %></div><% } %><footer class="lp-foot"><% if (page.autoNav && page.autoNav.footer) { %><%- include("_autonav", { nav: page.autoNav.footer, cls: "lp-foot-nav" }) %><% } %><%- include("_foot-legal", { siteX, sx, privacyFor: typeof privacyFor === "function" ? privacyFor : null }) %></footer><% } %>
  <% if (!preview) { %><%- include("../partials/consent-banner") %>
  <script src="<%= asset("/js/visitor.js") %>" defer></script><% } %>
  <script src="<%= asset("/js/landing.js") %>" defer></script>
  <% if (siteX && siteX.assets.pack && siteX.assets.pack.script) { %><%- siteX.assets.pack.script %><% } %>
  <script src="<%= asset("/js/kw-effects.js") %>" defer></script>
  <script src="<%= asset("/js/kw-bgpar.js") %>" defer></script>
  <%# Motion Studio : runtime partagé + adresses (avec empreinte) des modules de CETTE page, chargés à la demande par le runtime %>
  <% if (page.motionStudio) { %><script type="application/json" id="kw-ms-modules"><%- JSON.stringify(Object.fromEntries(page.motionStudio.modules.map((m) => [m, asset("/js/motion-studio/" + m + ".js")]))).replace(/</g, "\\u003c") %></script>
  <script src="<%= asset("/js/kw-motion-studio.js") %>" defer></script><% } %>
  <% if (kwCode && kwCode.bodyEnd) { %><%- kwCode.bodyEnd %><% } %>
</body>
</html>
