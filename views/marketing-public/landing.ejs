<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const seo = (() => { try { return typeof page.seo === "string" ? JSON.parse(page.seo || "{}") : (page.seo || {}); } catch { return {}; } })();
    const abs = (u) => (!u ? "" : /^https:\/\//.test(u) ? u : `${String(process.env.SITE_URL || "").replace(/\/+$/, "")}${u}`);
    const shareImg = seo.ogImage || (page.sections.find((s) => s.type === "hero" && s.image) || {}).image;
    const canonical = seo.canonical || abs(`/p/${page.slug}`);
    const indexable = page.indexable && !seo.noindex && !preview;
    const siteStyle = typeof site !== "undefined" && site ? tokensToCss(site.tokens) : "";
  %>
  <title><%= page.title || page.name %></title>
  <% if (page.description) { %><meta name="description" content="<%= page.description %>"><meta property="og:description" content="<%= page.description %>"><% } %>
  <meta property="og:title" content="<%= page.title || page.name %>">
  <meta property="og:type" content="website">
  <% if (canonical && /^https:/.test(canonical)) { %><link rel="canonical" href="<%= canonical %>"><meta property="og:url" content="<%= canonical %>"><% } %>
  <% if (shareImg) { %><meta property="og:image" content="<%= abs(shareImg) %>"><meta name="twitter:card" content="summary_large_image"><% } else { %><meta name="twitter:card" content="summary"><% } %>
  <meta name="robots" content="<%= indexable ? "index, follow" : "noindex, nofollow" %>">
  <% const faqs = page.sections.filter((x) => x.type === "faq" && !x.hidden).flatMap((x) => x.items); if (indexable && faqs.length) { %>
  <script type="application/ld+json"><%- JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }).replace(/</g, "\\u003c") %></script><% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= asset("/css/landing.css") %>">
</head>
<% if (siteStyle) { %><body class="lp-body lp-site" style="<%= siteStyle %> --lp-accent: var(--kw-primary); --lp-on-accent: var(--kw-on-primary); --lp-bg: var(--kw-background); --lp-text: var(--kw-text)">
<% } else { %><body class="lp-body" style="--lp-accent: <%= page.theme.accent %>; --lp-bg: <%= page.theme.background %>; --lp-text: <%= page.theme.text %>"><% } %>
  <% if (preview && !(typeof builder !== "undefined" && builder)) { %><p class="lp-preview-bar"><%= typeof previewLabel !== "undefined" && previewLabel ? previewLabel + " " : "Aperçu — " %>Les clics et inscriptions ne sont pas enregistrés.</p><% } %>
  <main class="lp-main" id="main">
    <% if (thanks && !page.sections.some((x) => x.type === "form")) { %><section class="lp-section"><p class="lp-thanks" role="status"><%= thanks %></p></section><% } %>
    <%- include("_sections", { page, form, preview, thanks, error, values, fieldCatalog, propertyDefs, builder: typeof builder !== "undefined" && builder }) %>
  </main>
  <footer class="lp-foot"><a href="/">KOLAKISA</a> · <a href="/cookies" data-kw-consent-open>Cookies</a></footer>
  <% if (!preview) { %><%- include("../partials/consent-banner") %>
  <script src="<%= asset("/js/visitor.js") %>" defer></script><% } %>
  <script src="<%= asset("/js/landing.js") %>" defer></script>
</body>
</html>
