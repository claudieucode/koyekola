<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title || page.name %></title>
  <% if (page.description) { %><meta name="description" content="<%= page.description %>"><meta property="og:description" content="<%= page.description %>"><% } %>
  <meta property="og:title" content="<%= page.title || page.name %>">
  <% const heroImg = (page.sections.find((s) => s.type === "hero" && s.image) || {}).image; if (heroImg) { %><meta property="og:image" content="<%= heroImg %>"><% } %>
  <meta name="robots" content="<%= page.indexable && !preview ? "index, follow" : "noindex, nofollow" %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= asset("/css/landing.css") %>">
</head>
<body class="lp-body" style="--lp-accent: <%= page.theme.accent %>; --lp-bg: <%= page.theme.background %>; --lp-text: <%= page.theme.text %>">
  <% if (preview) { %><p class="lp-preview-bar">Aperçu — les clics et inscriptions ne sont pas enregistrés.</p><% } %>
  <main class="lp-main" id="main">
    <% let n = 0; const href = (url) => (preview ? url : `/p/${page.slug}/clic/${n++}`); %>
    <% page.sections.forEach((s, i) => { %>
      <% if (s.type === "hero") { %>
        <header class="lp-hero">
          <% if (s.image) { %><img class="lp-hero-img" src="<%= s.image %>" alt="<%= s.imageAlt %>"><% } %>
          <h1><%= s.title %></h1>
          <% if (s.subtitle) { %><p class="lp-lead"><%= s.subtitle %></p><% } %>
          <% if (s.buttonUrl) { %><p><a class="lp-btn" href="<%= href(s.buttonUrl) %>"><%= s.buttonLabel %></a></p><% } %>
        </header>
      <% } else if (s.type === "text") { %>
        <section class="lp-section lp-text"><%- renderMarkdown(s.markdown) %></section>
      <% } else if (s.type === "image") { %>
        <figure class="lp-section lp-figure">
          <% if (s.link) { %><a href="<%= href(s.link) %>"><img src="<%= s.src %>" alt="<%= s.alt %>" loading="lazy"></a><% } else { %><img src="<%= s.src %>" alt="<%= s.alt %>" loading="lazy"><% } %>
          <% if (s.caption) { %><figcaption><%= s.caption %></figcaption><% } %>
        </figure>
      <% } else if (s.type === "list") { %>
        <section class="lp-section"><% if (s.title) { %><h2><%= s.title %></h2><% } %>
          <ul class="lp-list"><% s.items.forEach((it) => { %><li><%= it %></li><% }) %></ul></section>
      <% } else if (s.type === "course") { %>
        <section class="lp-section lp-course<%= s.course.image ? "" : " is-text" %>">
          <% if (s.course.image) { %><img src="<%= s.course.image %>" alt="" loading="lazy"><% } %>
          <div class="lp-course-body"><h2><%= s.course.title %></h2><% if (s.course.subtitle) { %><p><%= s.course.subtitle %></p><% } %>
            <p class="lp-price"><%= s.course.priceCents ? (s.course.priceCents / 100).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €" : "Gratuit" %></p>
            <a class="lp-btn" href="<%= href(s.course.url) %>"><%= s.cta %></a></div>
        </section>
      <% } else if (s.type === "button") { %>
        <p class="lp-section lp-button is-<%= s.align === "left" ? "left" : "center" %>"><a class="lp-btn" href="<%= href(s.url) %>"><%= s.label %></a></p>
      <% } else if (s.type === "quote") { %>
        <blockquote class="lp-section lp-quote"><p><%= s.text %></p><% if (s.author) { %><footer>— <%= s.author %></footer><% } %></blockquote>
      <% } else if (s.type === "form" && form) { %>
        <section class="lp-section lp-signup" id="inscription" aria-labelledby="lp-signup-<%= i %>">
          <h2 id="lp-signup-<%= i %>"><%= s.heading %></h2>
          <% if (thanks) { %><p class="lp-thanks" role="status"><%= thanks %></p>
          <% } else { %>
            <% if (s.intro) { %><p><%= s.intro %></p><% } %>
            <% if (error) { %><p class="lp-error" role="alert"><%= error %></p><% } %>
            <form method="post" action="/p/<%= page.slug %>/inscription" novalidate><input type="hidden" name="tz" data-tz>
              <%- include("_signup-fields", { form, fieldCatalog, propertyDefs, values, prefix: "lp" + i, autofocus: false }) %>
              <button type="submit" class="lp-btn lp-btn-block"<%= preview ? " disabled" : "" %>>S'inscrire</button>
            </form>
          <% } %>
        </section>
      <% } %>
    <% }) %>
  </main>
  <footer class="lp-foot"><a href="/">KOLAKISA</a></footer>
  <script src="<%= asset("/js/landing.js") %>" defer></script>
</body>
</html>
