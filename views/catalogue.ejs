<%- include("partials/header", { title: "Catalogue", filters }) %>

  <div class="container-wide catalogue-layout">
    <aside class="filter-panel">
      <div class="filter-group">
        <h4>Catégorie</h4>
        <div class="filter-options">
          <a href="/catalogue?<%= new URLSearchParams({ ...filters, category: '' }).toString() %>" class="<%= !filters.category ? 'is-active' : '' %>">Toutes</a>
          <% categories.forEach(c => { %>
            <a href="/catalogue?<%= new URLSearchParams({ ...filters, category: c.category }).toString() %>" class="<%= filters.category === c.category ? 'is-active' : '' %>"><%= c.category %></a>
          <% }) %>
        </div>
      </div>

      <div class="filter-group">
        <h4>Niveau</h4>
        <div class="filter-options">
          <a href="/catalogue?<%= new URLSearchParams({ ...filters, level: '' }).toString() %>" class="<%= !filters.level ? 'is-active' : '' %>">Tous niveaux</a>
          <a href="/catalogue?<%= new URLSearchParams({ ...filters, level: 'debutant' }).toString() %>" class="<%= filters.level === 'debutant' ? 'is-active' : '' %>">Débutant</a>
          <a href="/catalogue?<%= new URLSearchParams({ ...filters, level: 'intermediaire' }).toString() %>" class="<%= filters.level === 'intermediaire' ? 'is-active' : '' %>">Intermédiaire</a>
          <a href="/catalogue?<%= new URLSearchParams({ ...filters, level: 'avance' }).toString() %>" class="<%= filters.level === 'avance' ? 'is-active' : '' %>">Avancé</a>
        </div>
      </div>

      <div class="filter-group">
        <h4>Trier par</h4>
        <form action="/catalogue" method="get">
          <input type="hidden" name="q" value="<%= filters.q %>">
          <input type="hidden" name="category" value="<%= filters.category %>">
          <input type="hidden" name="level" value="<%= filters.level %>">
          <select name="sort" aria-label="Trier les formations" onchange="this.form.submit()">
            <option value="recent" <%= filters.sort === "recent" ? "selected" : "" %>>Plus récentes</option>
            <option value="popular" <%= filters.sort === "popular" ? "selected" : "" %>>Plus populaires</option>
            <option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Mieux notées</option>
            <option value="price_asc" <%= filters.sort === "price_asc" ? "selected" : "" %>>Prix croissant</option>
            <option value="price_desc" <%= filters.sort === "price_desc" ? "selected" : "" %>>Prix décroissant</option>
          </select>
        </form>
      </div>
    </aside>

    <div>
      <h1 style="margin:0 0 4px;font-size:1.6rem;">Toutes les formations</h1>
      <div class="catalogue-results-header">
        <span class="count"><%= courses.length %> formation<%= courses.length > 1 ? "s" : "" %> <% if (filters.q) { %>pour « <%= filters.q %> »<% } %></span>
      </div>

      <% if (courses.length === 0) { %>
        <div class="empty-state">
          <span class="kv-empty-ico" aria-hidden="true"><%- icon("search", { size: 26 }) %></span>
          <h3>Aucune formation ne correspond à votre recherche</h3>
          <p>Essayez d'autres mots-clés ou réinitialisez les filtres.</p>
          <a href="/catalogue" class="btn btn-outline">Réinitialiser</a>
        </div>
      <% } else { %>
        <div class="grid-courses">
          <% courses.forEach(course => { %><%- include("partials/course-card", { course }) %><% }) %>
        </div>
      <% } %>
    </div>
  </div>

<%- include("partials/footer") %>
