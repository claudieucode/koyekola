<%- include("partials/header", { title: "Inscription" }) %>

  <div class="auth-page">
    <div class="auth-card">
      <h1>Créer un compte</h1>
      <p class="subtitle">Créez votre compte pour acheter et suivre les formations.</p>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>

      <form action="/inscription" method="post"><input type="hidden" name="tz" data-tz>
        <% if (typeof redirect !== "undefined" && redirect) { %><input type="hidden" name="redirect" value="<%= redirect %>"><% } %>
        <div class="field-group">
          <label for="f-register-1">Nom d'utilisateur</label>
          <input id="f-register-1" type="text" name="username" value="<%= formValues.username || '' %>" required minlength="3" maxlength="30">
        </div>
        <div class="field-group">
          <label for="f-register-2">Adresse e-mail</label>
          <input id="f-register-2" type="email" name="email" value="<%= formValues.email || '' %>" required>
        </div>
        <div class="field-group">
          <label for="f-register-3">Mot de passe <span class="field-hint">(8 caractères minimum)</span></label>
          <input id="f-register-3" type="password" name="password" required minlength="8">
        </div>
        <div class="field-group">
          <label class="checkbox-row optin-row" for="f-register-4">
            <input id="f-register-4" type="checkbox" name="marketing_optin" value="on" <%= formValues.marketing_optin === "on" ? "checked" : "" %>>
            <span><%= consentText %></span>
          </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Créer mon compte</button>
      </form>
      <p class="form-footer">Déjà inscrit ? <a href="/connexion<%= typeof redirect !== "undefined" && redirect ? `?redirect=${encodeURIComponent(redirect)}` : "" %>">Se connecter</a></p>
    </div>
  </div>

<%- include("partials/footer") %>
