<%- include("partials/header", { title: "Accueil" }) %>

  <section class="hero" data-hero>
    <div class="container-wide">
      <div class="hero-stage">
        <% if (heroImages.length) { %>
          <%# Diaporama décoratif : seule la 1re photo est chargée d'emblée, les autres après le chargement de la page (main.js) %>
          <div class="hero-slides" aria-hidden="true" data-hero-slides>
            <% heroImages.forEach((img, i) => { %>
              <% if (i === 0) { %>
                <img class="hero-slide is-active" src="<%= img.src %>" srcset="<%= img.srcset %>" sizes="100vw" alt="" width="1600" height="1067" fetchpriority="high" decoding="async">
              <% } else { %>
                <img class="hero-slide" data-src="<%= img.src %>" data-srcset="<%= img.srcset %>" sizes="100vw" alt="" width="1600" height="1067" decoding="async">
              <% } %>
            <% }) %>
          </div>
        <% } %>
        <div class="hero-inner">
          <div class="hero-text">
            <h1>Apprenez les compétences dont vous avez besoin pour avancer.</h1>
            <p class="lead">Toutes mes formations vidéo, réunies au même endroit. Suivez un cours où que vous soyez, à vie, sur tous vos appareils.</p>
            <form action="/catalogue" method="get" class="hero-search" role="search">
              <input type="text" name="q" aria-label="Rechercher une formation" placeholder="Que voulez-vous apprendre ?">
              <button type="submit" class="btn btn-primary btn-lg">Rechercher</button>
            </form>
            <% if (categories.length) { %>
              <nav class="hero-chips" aria-label="Catégories à explorer">
                <span>Explorer</span>
                <% categories.slice(0, 4).forEach((c) => { %><a class="chip" href="/categorie/<%= slugify(c.category) %>"><%= c.category %></a><% }) %>
              </nav>
            <% } %>
          </div>
        </div>
        <% if (heroImages.length > 1) { %>
          <button type="button" class="hero-pause" aria-label="Mettre en pause le diaporama" aria-pressed="false" data-hero-pause>
            <span class="hero-pause-icon"><%- icon('pause', { size: 16 }) %></span><span class="hero-play-icon"><%- icon('play', { size: 16 }) %></span>
          </button>
        <% } %>
      </div>
    </div>
    <div class="container-wide hero-stats-wrap">
      <div class="hero-stats">
        <div class="hero-stat"><strong><%= stats.courseCount %></strong><span>formation<%= stats.courseCount > 1 ? "s" : "" %> publiée<%= stats.courseCount > 1 ? "s" : "" %></span></div>
        <div class="hero-stat"><strong><%= stats.studentCount %></strong><span>inscription<%= stats.studentCount > 1 ? "s" : "" %></span></div>
      </div>
    </div>
  </section>

  <div class="category-strip">
    <div class="container-wide">
      <nav class="category-row" aria-label="Catégories">
        <a href="/catalogue" class="category-pill">Toutes les catégories</a>
        <% categories.forEach(c => { %>
          <a href="/categorie/<%= slugify(c.category) %>" class="category-pill"><%= c.category %> · <%= c.count %></a>
        <% }) %>
      </nav>
    </div>
  </div>

  <section class="container-wide st-features" aria-label="Ce que vous trouverez sur la plateforme">
    <article class="st-feature">
      <span class="st-feature-icon" aria-hidden="true"><%- icon('video', { size: 22 }) %></span>
      <h2>Cours vidéo</h2>
      <p>Suivez chaque formation en vidéo, à votre rythme, sur tous vos appareils.</p>
    </article>
    <article class="st-feature">
      <span class="st-feature-icon" aria-hidden="true"><%- icon('quiz', { size: 22 }) %></span>
      <h2>Quiz d'évaluation</h2>
      <p>Validez vos acquis avec des quiz proposés au fil des chapitres.</p>
    </article>
    <article class="st-feature">
      <span class="st-feature-icon" aria-hidden="true"><%- icon('graduation', { size: 22 }) %></span>
      <h2>Certificat de réussite</h2>
      <p>Obtenez un certificat à la fin de votre parcours pour valoriser vos compétences.</p>
    </article>
  </section>

  <section class="container-wide section">
    <div class="section-header">
      <div class="st-heading"><span class="st-eyebrow">Catalogue</span><h2>Formations populaires</h2></div>
      <a href="/catalogue?sort=popular" class="see-all">Voir tout <%- icon('arrowRight', { size: 14 }) %></a>
    </div>
    <% if (featured.length === 0) { %>
      <div class="empty-state"><div class="kv-empty-ill" aria-hidden="true"><%- illu("formations") %></div><p>Aucune formation publiée pour l'instant.</p></div>
    <% } else { %>
      <div class="grid-courses st-grid-3">
        <% featured.forEach(course => { %><%- include("partials/course-card", { course }) %><% }) %>
      </div>
    <% } %>
  </section>

  <section class="container-wide section section-tight">
    <div class="section-header">
      <div class="st-heading"><span class="st-eyebrow">À découvrir</span><h2>Nouveautés</h2></div>
      <a href="/catalogue?sort=recent" class="see-all">Voir tout <%- icon('arrowRight', { size: 14 }) %></a>
    </div>
    <div class="grid-courses st-grid-3">
      <% recent.forEach(course => { %><%- include("partials/course-card", { course }) %><% }) %>
    </div>
  </section>

  <section class="st-steps">
    <div class="container-wide">
      <div class="st-steps-head">
        <span class="st-eyebrow">Comment ça marche</span>
        <h2>Un parcours simple pour apprendre à votre rythme</h2>
      </div>
      <ol class="st-steps-list">
        <li><span class="st-step-num" aria-hidden="true">1</span><h3>Choisissez votre formation</h3><p>Parcourez le catalogue et sélectionnez le cours qui correspond à vos objectifs.</p></li>
        <li><span class="st-step-num" aria-hidden="true">2</span><h3>Apprenez à votre rythme</h3><p>Suivez les vidéos, répondez aux quiz et reprenez où vous vous êtes arrêté.</p></li>
        <li><span class="st-step-num" aria-hidden="true">3</span><h3>Obtenez votre certificat</h3><p>Terminez la formation pour recevoir votre certificat de réussite.</p></li>
      </ol>
    </div>
  </section>

  <% if (creator) { %>
    <section class="container-wide section">
      <div class="creator-band">
        <span class="avatar avatar-lg" style="background:<%= avatarColor(creator.username) %>"><%= creator.username.slice(0,1).toUpperCase() %></span>
        <div class="creator-copy">
          <h2>À propos de <%= creator.username %></h2>
          <p><%= creator.bio || "Créateur de formations sur KOLAKISA." %></p>
        </div>
        <a href="/catalogue" class="btn btn-primary btn-lg">Voir mes formations</a>
      </div>
    </section>
  <% } %>

  <section class="st-cta">
    <div class="container-wide st-cta-inner">
      <h2>Prêt à vous lancer ?</h2>
      <p>Accédez dès aujourd'hui aux formations et avancez à votre rythme.</p>
      <% if (currentUser) { %><a class="btn btn-lg st-cta-btn" href="/catalogue">Découvrir le catalogue</a><% } else { %><a class="btn btn-lg st-cta-btn" href="/inscription">Créer un compte gratuit</a><% } %>
    </div>
  </section>

<%- include("partials/footer") %>
