<%- include("partials/header", { title: "Mot de passe oublié", seo: { noindex: true } }) %>

  <div class="auth-page">
   <div class="kv-auth">
    <%- include("partials/auth-aside", { asideTitle: "Retrouvez l'accès à vos formations." }) %>
    <div class="kv-auth-main">
    <div class="auth-card">
      <h1>Mot de passe oublié</h1>
      <p class="subtitle">Indiquez l'adresse e-mail de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>
      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
      <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
      <form action="/mot-de-passe-oublie" method="post">
        <div class="field-group">
          <label for="f-forgot-email">Adresse e-mail</label>
          <input id="f-forgot-email" type="email" name="email" required autofocus autocomplete="email" maxlength="254" value="<%= email %>">
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Recevoir le lien</button>
      </form>
      <p class="form-footer"><a href="/connexion">Retour à la connexion</a></p>
    </div>
    </div>
   </div>
  </div>

<%- include("partials/footer") %>
