<%- include("partials/header", { title: "Mon compte" }) %>

  <div class="container-wide dashboard-header">
    <h1>Mon compte</h1>
    <p>Votre profil, la sécurité de votre compte et vos données personnelles.</p>
  </div>

  <div class="container-wide kv-account">
    <nav class="kv-account-nav" aria-label="Sections du compte">
      <a href="#acc-profile">Profil</a>
      <a href="#acc-security">Sécurité</a>
      <a href="#acc-sessions">Sessions</a>
      <a href="#acc-data">Mes données</a>
      <a href="#acc-delete" class="is-danger">Supprimer mon compte</a>
    </nav>
  <div class="account-page">
    <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
    <% if (notice) { %><p class="account-notice" role="status"><%= notice %></p><% } %>

    <%
      const e = (k) => (errors && errors[k]) || "";
      const bad = (k) => (e(k) ? ' aria-invalid="true" aria-describedby="ac-err-' + k + '"' : "");
      const err = (k) => (e(k) ? '<p class="field-error" id="ac-err-' + k + '" role="alert">' + String(e(k)).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]) + "</p>" : "");
      const fdt = (ms) => { const d = new Date(ms); return d.toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" }) + " " + d.toLocaleTimeString("fr-FR", { timeZone: "Europe/Paris", hour: "2-digit", minute: "2-digit" }); };
      const others = sessions.filter((s) => !s.current);
    %>
    <section class="card card-pad account-section" aria-labelledby="acc-profile">
      <h2 id="acc-profile">Profil</h2>
      <p class="field-hint">Ces informations n'apparaissent que là où le site les affiche (par exemple à côté de vos avis et de vos commentaires).</p>
      <form method="post" action="/mon-compte/profil" enctype="multipart/form-data" class="account-form" novalidate>
        <div class="account-avatar">
          <% if (p.avatar_path) { %><img src="<%= p.avatar_path %>" alt="Votre photo actuelle" width="72" height="72"><% } else { %><span class="avatar avatar-lg" aria-hidden="true" style="background:<%= avatarColor(p.username) %>"><%= p.username.slice(0, 1).toUpperCase() %></span><% } %>
          <div>
            <label for="ac-file">Photo de profil</label>
            <input type="file" id="ac-file" name="thumbnail" accept="image/jpeg,image/png,image/gif,image/webp,image/avif">
            <p class="field-hint">JPEG, PNG, GIF, WebP ou AVIF · 2 Mo au plus. Le type est vérifié sur le contenu du fichier.</p>
            <% if (p.avatar_path) { %><label class="checkbox-row"><input type="checkbox" name="remove_avatar" value="1"> Supprimer ma photo</label><% } %>
          </div>
        </div>
        <div class="account-grid">
          <div class="field-group"><label for="ac-first">Prénom</label><input type="text" id="ac-first" name="first_name" maxlength="80" autocomplete="given-name" value="<%= p.firstName %>"<%- bad("first_name") %>><%- err("first_name") %></div>
          <div class="field-group"><label for="ac-last">Nom de famille</label><input type="text" id="ac-last" name="last_name" maxlength="80" autocomplete="family-name" value="<%= p.lastName %>"<%- bad("last_name") %>><%- err("last_name") %></div>
          <div class="field-group"><label for="ac-nick">Pseudo <span class="field-hint">(nécessaire)</span></label><input type="text" id="ac-nick" name="nickname" maxlength="80" required value="<%= p.nickname %>"<%- bad("nickname") %>><%- err("nickname") %></div>
          <div class="field-group"><label for="ac-display">Nom à afficher</label><select id="ac-display" name="display_name"<%- bad("display_name") %>><% displayOptions.forEach((o) => { %><option value="<%= o %>"<%= o === (p.displayName || p.nickname) ? " selected" : "" %>><%= o %></option><% }) %></select><%- err("display_name") %></div>
        </div>
        <div class="field-group"><label for="ac-web">Site web</label><input type="text" inputmode="url" id="ac-web" name="website" maxlength="300" placeholder="https://" value="<%= p.website %>"<%- bad("website") %>><%- err("website") %></div>
        <div class="field-group"><label for="ac-bio">À propos de vous <span class="field-hint">(<%= maxBio %> caractères au plus)</span></label><textarea id="ac-bio" name="bio" rows="4" maxlength="<%= maxBio * 4 %>"<%- bad("bio") %>><%= p.bio %></textarea><%- err("bio") %></div>
        <button type="submit" class="btn btn-primary">Enregistrer le profil</button>
      </form>
      <dl class="account-facts">
        <div><dt>Identifiant</dt><dd><%= account.username %></dd></div>
        <div><dt>Compte créé le</dt><dd><%= formatDate(account.created_at) %></dd></div>
        <div><dt>Formations suivies</dt><dd><%= stats.courses %></dd></div>
      </dl>
    </section>

    <%- include("partials/account-security") %>

    <section class="card card-pad account-section" aria-labelledby="acc-data">
      <h2 id="acc-data">Mes données</h2>
      <p>Téléchargez tout ce que le site garde sur vous : compte, formations, commandes, progression, notes, avis, commentaires, favoris, messages envoyés et préférences d'e-mails.</p>
      <a href="/mon-compte/mes-donnees.json" class="btn btn-outline" download><%- icon("download", { size: 17 }) %> Télécharger mes données (JSON)</a>
    </section>

    <section class="card card-pad account-section account-danger" aria-labelledby="acc-delete">
      <h2 id="acc-delete">Supprimer mon compte</h2>
      <% if (!canDelete) { %>
        <p>Le compte du formateur porte les formations et les réglages du site : il ne peut pas être supprimé depuis cette page.</p>
      <% } else { %>
        <p>La suppression est <strong>définitive</strong> : vous perdez l'accès à vos formations<%= stats.courses ? ` (${stats.courses})` : "" %>, à votre progression et à vos certificats. Vos notes, avis, commentaires et favoris sont effacés, ainsi que votre inscription aux e-mails.<%= stats.orders ? " Vos commandes restent dans notre comptabilité, sans votre nom ni votre adresse e-mail." : "" %></p>
        <form method="post" action="/mon-compte/supprimer" class="account-delete-form">
          <div class="field-group">
            <label for="acc-password">Votre mot de passe</label>
            <input id="acc-password" type="password" name="password" autocomplete="current-password" required>
          </div>
          <label class="checkbox-row"><input type="checkbox" name="confirm" required> Je comprends que la suppression est définitive.</label>
          <button type="submit" class="btn btn-danger">Supprimer définitivement mon compte</button>
        </form>
      <% } %>
    </section>
  </div>
  </div>

<%- include("partials/footer") %>
