<%- include("partials/header", { title: "Connexion" }) %>

  <div class="auth-page">
    <div class="auth-card">
      <h1>Content de vous revoir</h1>
      <p class="subtitle">Connectez-vous pour accéder à vos formations.</p>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <% if (typeof notice !== "undefined" && notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
      <form action="/connexion" method="post">
        <input type="hidden" name="redirect" value="<%= redirect %>">
        <div class="field-group">
          <label for="f-login-1">Adresse e-mail</label>
          <input id="f-login-1" type="email" name="email" required autofocus>
        </div>
        <div class="field-group">
          <label for="f-login-2">Mot de passe</label>
          <input id="f-login-2" type="password" name="password" required>
          <a class="field-hint" href="/mot-de-passe-oublie">Mot de passe oublié ?</a>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Se connecter</button>
      </form>
      <p class="form-footer">Pas encore de compte ? <a href="/inscription<%= redirect ? `?redirect=${encodeURIComponent(redirect)}` : "" %>">Créer un compte</a></p>
    </div>
  </div>

<%- include("partials/footer") %>
