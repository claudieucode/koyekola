<%- include("partials/header", { title: "Demande #" + ticket.id, seo: { noindex: true } }) %>

  <div class="container" style="max-width:820px;padding:40px 20px 60px;">
    <p><a href="/support">← Mes demandes</a></p>
    <h1 style="margin-bottom:4px;"><%= ticket.subject %></h1>
    <p style="color:var(--muted);margin-top:0;">Demande #<%= ticket.id %> · <span class="dash-status <%= ticket.status === "closed" ? "is-archived" : ticket.status === "answered" ? "is-published" : "is-draft" %>"><%= statuses[ticket.status] %></span><%= ticket.course_title ? " · " + ticket.course_title : "" %></p>

    <ol class="support-thread" style="list-style:none;padding:0;">
      <% messages.forEach((m) => { %>
        <li class="card card-pad" style="margin-bottom:12px;<%= m.is_staff ? "border-left:4px solid var(--primary);" : "" %>">
          <strong><%= m.is_staff ? "Formateur" : "Vous" %></strong> <small style="color:var(--muted);">· <%= formatDateTime(m.created_at) %></small>
          <p style="white-space:pre-wrap;margin:8px 0 0;"><%= m.body %></p>
        </li>
      <% }) %>
    </ol>

    <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
    <% if (ticket.status === "closed") { %>
      <div class="card card-pad"><p style="margin-top:0;">Cette demande est close. Vous pouvez la rouvrir si le problème persiste.</p>
      <form action="/support/<%= ticket.id %>/rouvrir" method="post"><button type="submit" class="btn btn-primary">Rouvrir la demande</button></form></div>
    <% } else { %>
      <form action="/support/<%= ticket.id %>/repondre" method="post" class="card card-pad">
        <div class="field-group"><label for="r-message">Votre réponse</label><textarea id="r-message" name="message" rows="5" maxlength="5000" required></textarea></div>
        <button type="submit" class="btn btn-primary">Envoyer</button>
      </form>
      <form action="/support/<%= ticket.id %>/fermer" method="post" style="margin-top:12px;"><button type="submit" class="btn btn-outline btn-sm">Marquer comme résolue (clore)</button></form>
    <% } %>
  </div>

<%- include("partials/footer") %>
