<%- include("partials/header", { title: "Notifications", seo: { noindex: true } }) %>

  <div class="container-wide kv-pagehead">
    <div>
      <h1>Notifications</h1>
      <p>Les réponses à vos demandes, vos certificats et vos commandes.</p>
    </div>
    <% if (unread) { %>
      <form class="kv-pagehead-actions" action="/notifications/tout-lire" method="post"><button type="submit" class="btn btn-outline">Tout marquer comme lu (<%= unread %>)</button></form>
    <% } %>
  </div>

  <div class="container-wide learner-space">
    <% if (!list.length) { %>
      <div class="empty-state">
        <div class="kv-empty-ill" aria-hidden="true"><%- illu("commentaires") %></div>
        <h3>Aucune notification pour l'instant</h3>
        <p>Vous serez prévenu(e) ici des réponses à vos demandes, de vos certificats et de vos commandes.</p>
      </div>
    <% } else { %>
      <ul class="kv-list">
        <% list.forEach((n) => { %>
          <li class="kv-row<%= n.read_at ? "" : " is-unread" %>">
            <span class="kv-dot" aria-hidden="true"></span>
            <div class="kv-row-main">
              <strong><%= n.title %></strong><% if (!n.read_at) { %> <span class="dash-status is-draft">Nouveau</span><% } %>
              <% if (n.body) { %><span class="kv-row-text"><%= n.body %></span><% } %>
              <small><%= formatDateTime(n.created_at) %></small>
            </div>
            <% if (n.url || !n.read_at) { %>
              <form class="kv-row-actions" action="/notifications/<%= n.id %>/lue" method="post"><button type="submit" class="btn btn-outline btn-sm"><%= n.url ? "Ouvrir" : "Marquer comme lu" %></button></form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

<%- include("partials/footer") %>
