# --- Obligatoires en ligne ---
NODE_ENV=production
# Une longue phrase secrète aléatoire (32 caractères ou plus). Ne la partagez jamais.
SESSION_SECRET=change-moi-en-production
# Adresse publique du site (avec https://). Sert au lien de l'email de bienvenue, à la protection des formulaires
# et au référencement (adresses canoniques, sitemap.xml, images de partage) : sans elle, Google verrait de mauvaises adresses.
SITE_URL=https://votre-domaine.com

# --- Compte formateur (le vôtre) ---
# Créé automatiquement au premier démarrage si aucun formateur n'existe encore.
# Une fois le compte créé, SUPPRIMEZ FORMATEUR_PASSWORD de la configuration.
FORMATEUR_EMAIL=
FORMATEUR_USERNAME=
FORMATEUR_PASSWORD=

# --- Vidéos protégées Bunny Stream (facultatif, recommandé pour vos formations payantes) ---
# Numéro de votre bibliothèque vidéo Bunny Stream
BUNNY_LIBRARY_ID=
# Clé de sécurité « Embed View Token Authentication » de cette bibliothèque. SECRÈTE : ne la partagez jamais.
BUNNY_TOKEN_KEY=
# Durée de validité d'un lien de lecture, en heures (6 par défaut)
BUNNY_TOKEN_TTL_HOURS=6

# --- Facultatif ---
# Port d'écoute (l'hébergeur le fournit en général ; 3002 par défaut en local)
PORT=3002
# Emplacement de la base et des fichiers envoyés, si l'hébergeur propose un dossier qui survit aux redéploiements.
# Laissez vide pour utiliser les dossiers data/ et uploads/ du projet.
DATA_DIR=
UPLOADS_DIR=

# Envoi d'email (email de bienvenue envoyé après un achat).
# Sans SMTP_HOST, l'email n'est pas envoyé. Hors production, son contenu (liens de réinitialisation compris) s'affiche dans la console ;
# en production, seul un avertissement est journalisé.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Adresse qui reçoit les messages du formulaire de contact (sinon SMTP_FROM). Les messages restent de toute façon lisibles dans Mon espace.
CONTACT_EMAIL=

# --- Marketing (module en construction : voir EMAIL_MARKETING_ARCHITECTURE.md) ---
# Clé de chiffrement des secrets du module marketing (clé d'API du fournisseur d'envoi, secrets de webhook…).
# 64 caractères hexadécimaux. Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Conservez-la précieusement et ne la changez pas : les secrets déjà enregistrés deviendraient illisibles. JAMAIS dans Git.
ENCRYPTION_KEY=
# Travaux en arrière-plan (distribution des événements, futurs envois). « on » pour l'activer ; désactivé par défaut.
# on = traitement en arrière-plan actif : IMPOSSIBLE d'envoyer une campagne sans cela. Prérequis d'un envoi réel : SITE_URL en https,
# ENCRYPTION_KEY, fournisseur choisi dans Marketing → Envoi (voir EMAIL_MARKETING_ENVOI.md).
MARKETING_WORKER=off

# --- Assistant IA de l'éditeur d'articles (facultatif) ---
# Clé créée sur https://console.anthropic.com (Settings → API Keys). Lue UNIQUEMENT par le serveur
# (src/services/blogAi.js) : jamais envoyée au navigateur, jamais écrite dans le code ni dans les journaux.
# Vide = assistant affiché « Non activé », le reste de l'éditeur fonctionne normalement.
ANTHROPIC_API_KEY=

# --- SEO CORE (voir SEO_CORE.md) ---
# Tâches SEO programmées (audit hebdomadaire, surveillance quotidienne, PageSpeed, Search Console, Analytics, nettoyage).
# « on » par défaut ; « off » pour les couper. Les clés Google se saisissent dans Mon espace → SEO → Intégrations
# (chiffrées avec ENCRYPTION_KEY), jamais dans ce fichier.
SEO_JOBS=on

# --- Paiement par carte : Stripe Checkout (voir README, section « Paiement ») ---
# Clé secrète du tableau de bord Stripe (Développeurs → Clés API) : « sk_test_… » pour essayer, « sk_live_… » pour encaisser.
# SECRÈTE : jamais dans Git, jamais dans le code. Sans elle, les commandes payantes sont refusées en ligne.
STRIPE_SECRET_KEY=
# « Secret de signature » du webhook <SITE_URL>/stripe/webhook (« whsec_… »). Sans lui, le webhook refuse tout.
STRIPE_WEBHOOK_SECRET=

# Blog : nombre de révisions gardées par article (les plus récentes ; les plus anciennes au-delà sont supprimées).
# 0 = aucune limite. Par défaut : 100.
# BLOG_MAX_REVISIONS=100

# Paiement : aucun prestataire branché. Les commandes payantes sont refusées par défaut.
# 1 = mode démonstration (commande payante validée SANS paiement) — jamais avec de vrais clients.
# PAIEMENT_SIMULE=

# Sauvegarde automatique quotidienne de la base dans <DATA_DIR>/backups (14 gardées). 0 = désactivée.
# Téléchargement de la base et des fichiers : Mon espace → Centre de gestion → Sauvegardes.
# SAUVEGARDE_AUTO=

# --- Multi-sites et domaines (voir docs/KOLAKISA_INSTALLATION_AND_CONFIGURATION.md §5.3) ---
# Domaine de la plateforme, pour les sous-domaines des sites (ex. exemple.com).
# PLATFORM_DOMAIN=
# Cibles DNS (séparées par des virgules) vers lesquelles un domaine client doit pointer ; sinon les adresses de l'hôte principal sont mesurées.
# DOMAIN_DNS_A=
# DOMAIN_DNS_CNAME=
# Hôtes acceptés en plus des domaines enregistrés (séparés par des virgules).
# HOTES_AUTORISES=
# Indexation : 0 = toujours interdite (ATTENTION : en production, le site serait désindexé) ; 1 = forcée ; vide = automatique selon l'hôte.
# ALLOW_INDEXING=

# --- Réglages avancés (valeurs par défaut sûres : ne les définir que si nécessaire) ---
# IMPORT_SITE_MAX_ROWS=5000
# SITEMAP_SPLIT_AT=5000
# CONTACT_REQUESTS_PER_HOUR=60
# COMMENT_NOTIFY=0 coupe les e-mails de notification de commentaires.
# HEALTH_CHECK_TIMEOUT_MS=20000

# --- À ne JAMAIS définir en production ---
# PAIEMENT_SIMULE, STRIPE_API_BASE, SEO_PSI_URL, SEO_GSC_URL, SEO_GA4_URL, SEO_GOOGLE_TOKEN_URL, KOLA_ERASURE_FAIL, SAUVEGARDE_DELAI_MS.
# (TRUST_PROXY et COOKIE_SECURE n'ont aucun effet : le proxy et le cookie sont réglés dans le code.)


# --- Intégration Mailchimp (Marketing → Mailchimp) -------------------------------------------------------------------------------------------------
# La clé d'API Mailchimp (et la clé Mandrill) se saisissent dans l'écran Marketing → Mailchimp : elles sont enregistrées CHIFFRÉES avec ENCRYPTION_KEY
# (jamais dans ce fichier). Variables facultatives du serveur :
# SITE_URL (HTTPS) sert à construire l'adresse du webhook entrant (https://votre-site/webhooks/mailchimp/<organisation>/<jeton>).
# Intervalle de la synchronisation automatique en millisecondes (60000 minimum ; 3600000 = une heure par défaut)
# MAILCHIMP_SYNC_INTERVAL_MS=3600000
# Serveur de test à la place de https://<centre>.api.mailchimp.com/3.0 (jamais en production : HTTPS obligatoire) et de https://mandrillapp.com/api/1.0
# MAILCHIMP_API_BASE=
# MANDRILL_API_BASE=
